+    // box.new uses large right offset (+500 bars) to simulate extend-right behavior
+    pdPremiumBox  := box.new(bar_index - 50, h4PremiumTop, bar_index + 500, h4PremiumBottom, bgcolor=color.new(color.red, 85), border_color=color.new(color.red, 70), border_width=1)
+    pdDiscountBox := box.new(bar_index - 50, h4DiscountTop, bar_index + 500, h4DiscountBottom, bgcolor=color.new(color.green, 85), border_color=color.new(color.green, 70), border_width=1)
+    // v17.11.1: Premium/Discount threshold boundary lines (subtle dashed)
+    pdPremThreshLine := line.new(bar_index - 50, h4PremiumBottom, bar_index + 50, h4PremiumBottom, color=color.new(color.red, 60), style=line.style_dashed, width=1, extend=extend.right)
+    pdDiscThreshLine := line.new(bar_index - 50, h4DiscountTop, bar_index + 50, h4DiscountTop, color=color.new(color.green, 60), style=line.style_dashed, width=1, extend=extend.right)
+
+// ============================================================================
+// v17.54.1 FIX: MULTI-ZONE SUPPLY & DEMAND (array-based)
+// ============================================================================
+// v17.54.1 restores proper multi-zone rendering for 5M charts.
+// Uses array-based tracking so MULTIPLE Supply and Demand zones are visible
+// simultaneously, matching expected SMC zone density on lower timeframes.
+//
+// Detects significant reversal zones from swing structure:
+// - Demand: Area where price reversed UP after making a swing low with displacement
+// - Supply: Area where price reversed DOWN after making a swing high with displacement
+//
+// Zones are drawn as labeled boxes matching user's design:
+// - Demand: Green fill, Purple border, "⬤ DEMAND" text inside
+// - Supply: Orange fill, Purple border, "⬤ SUPPLY" text inside
+//
+// Zone lifecycle:
+//   1. Created when swing point + displacement threshold met
+//   2. Invalidated when price closes significantly through the zone
+//   3. Maximum 10 active zones per type (oldest trimmed first)
+//   4. All zone boxes redrawn on last bar for clean rendering
+
+int maxZones = 10  // Maximum active zones per type (supply / demand)
+
+// --- Demand zone arrays (bullish reversal areas) ---
+var array<float> dTop    = array.new_float(0)
+var array<float> dBot    = array.new_float(0)
+var array<int>   dBar    = array.new_int(0)
+var array<box>   dBoxes  = array.new_box(0)
+int maxZoneAge = 500  // v17.54.2: Auto-prune zones older than this many bars
+
+// --- Supply zone arrays (bearish reversal areas) ---
+var array<float> sTop    = array.new_float(0)
+var array<float> sBot    = array.new_float(0)
+var array<int>   sBar    = array.new_int(0)
+var array<box>   sBoxes  = array.new_box(0)
+
+// Demand zone: Detect when price sweeps a swing low and reverses up with displacement
+// This creates a "demand" area at the low region where buyers stepped in
+if not na(swLow) and displacement > 0.5
+    float _dBot = swLow
+    float _dTop = swLow + atrValue * 0.5
+    int   _dBar = bar_index - swingLen
+    array.push(dBot, _dBot)
+    array.push(dTop, _dTop)
+    array.push(dBar, _dBar)
+    // Trim to max zones (remove oldest = index 0)
+    if array.size(dTop) > maxZones
+        array.shift(dTop)
+        array.shift(dBot)
+        array.shift(dBar)
+
+// Supply zone: Detect when price sweeps a swing high and reverses down with displacement
+if not na(swHigh) and displacement > 0.5
+    float _sTop = swHigh
+    float _sBot = swHigh - atrValue * 0.5
+    int   _sBar = bar_index - swingLen
+    array.push(sTop, _sTop)
+    array.push(sBot, _sBot)
+    array.push(sBar, _sBar)
+    // Trim to max zones (remove oldest = index 0)
+    if array.size(sTop) > maxZones
+        array.shift(sTop)
+        array.shift(sBot)
+        array.shift(sBar)
+
+// Invalidate demand zones: price breach OR stale age (v17.54.2)
+if array.size(dTop) > 0
+    int _di = array.size(dTop) - 1
+    while _di >= 0
+        bool _priceBreach = close < array.get(dBot, _di) - atrValue * 0.3
+        bool _tooOld      = (bar_index - array.get(dBar, _di)) > maxZoneAge
+        if _priceBreach or _tooOld
+            array.remove(dTop, _di)
+            array.remove(dBot, _di)
+            array.remove(dBar, _di)
+        _di -= 1
+
+// Invalidate supply zones: price breach OR stale age (v17.54.2)
+if array.size(sTop) > 0
+    int _si = array.size(sTop) - 1
+    while _si >= 0
+        bool _priceBreach = close > array.get(sTop, _si) + atrValue * 0.3
+        bool _tooOld      = (bar_index - array.get(sBar, _si)) > maxZoneAge
+        if _priceBreach or _tooOld
+            array.remove(sTop, _si)
+            array.remove(sBot, _si)
+            array.remove(sBar, _si)
+        _si -= 1
+
+// Draw/update all Supply & Demand zone boxes on last bar
+if barstate.islast
+    // Clean up previous boxes
+    for _b in dBoxes
+        box.delete(_b)
+    array.clear(dBoxes)
+    for _b in sBoxes
+        box.delete(_b)
+    array.clear(sBoxes)
+
+    // v17.54.2: Draw Demand zones with proper empty-array guard
+    if array.size(dTop) > 0
+        for _i = 0 to array.size(dTop) - 1
+            array.push(dBoxes, box.new(array.get(dBar, _i), array.get(dTop, _i), bar_index + 10, array.get(dBot, _i), bgcolor=color.new(color.green, 55), border_color=color.new(color.purple, 20), border_width=2, text="⬤ DEMAND", text_size=size.large, text_color=color.new(color.gray, 20), text_halign=text.align_center, text_valign=text.align_center))
+
+    // v17.54.2: Draw Supply zones with proper empty-array guard
