+// ============================================================================
+// v17.54.3 HUD SAFETY FUNCTIONS — Prevent na crashes & out-of-bounds errors
+// ============================================================================
+//
+// HUD Row Map (21 rows, 0-indexed):
+//   Row  0: Header    — "SMC P&D" / version badge
+//   Row  1: Bias      — H4 P&D bias (Bullish/Bearish/Neutral)
+//   Row  2: Align     — Trend alignment status
+//   Row  3: KZ        — Kill Zone status
+//   Row  4: Sniper    — Sniper signal progress
+//   Row  5: POI       — Point of Interest status
+//   Row  6: Momentum  — Momentum direction
+//   Row  7: Guardian  — Guardian filter status
+//   Row  8: Confl     — Confluence score
+//   Row  9: AMD       — AMD phase
+//   Row 10: Trade     — Trade context
+//   Row 11: Entry     — Entry mode
+//   Row 12: Action    — Action step + plan
+//   Row 13: Stage     — Signal stage
+//   Row 14: Alert     — Last alert type
+//   Row 15: Signals   — Signals today count
+//   Row 16: Levels    — Session levels
+//   Row 17: ZoneCfg   — [debug] Zone configuration
+//   Row 18: ZoneHt    — [debug] Zone height / cap status
+//   Row 19: ZoneSt    — [debug] Zone boolean states
+//   Row 20: Ratio     — [debug] Zone ratio check
+//
+// Hard limit constants — exact fit for 21 rows × 2 columns
+int maxHudRows = 21
+int maxHudCols = 2
+
+// Safe text wrapper — prevents na value crashes in HUD cell text
+// Returns "—" for na/null values, str.tostring() for valid values (defensive cast)
+f_safeText(string val) =>
+    na(val) ? "—" : str.tostring(val)
+
+// Safe cell writer — standard rows (size.small, auto-alignment by column)
+// Guards: not na(_table) and _col >= 0 and _row >= 0 and _col < maxHudCols and _row < maxHudRows
+// Col 0 = right-aligned labels, Col 1 = left-aligned values
+f_setCell(table _t, int _col, int _row, string _text, color _txtColor, color _bgColor) =>
+    if not na(_t) and _col >= 0 and _row >= 0 and _col < maxHudCols and _row < maxHudRows
+        table.cell(_t, _col, _row, _text, text_color=_txtColor, text_size=size.small, bgcolor=_bgColor, text_halign=_col == 0 ? text.align_right : text.align_left)
+
+// Safe cell writer — header rows (size.normal for prominence)
+f_setHdrCell(table _t, int _col, int _row, string _text, color _txtColor, color _bgColor) =>
+    if not na(_t) and _col >= 0 and _row >= 0 and _col < maxHudCols and _row < maxHudRows
+        table.cell(_t, _col, _row, _text, text_color=_txtColor, text_size=size.normal, bgcolor=_bgColor, text_halign=_col == 0 ? text.align_right : text.align_left)
+
+// Safe cell writer — debug rows (size.tiny for compact diagnostics)
+f_setDbgCell(table _t, int _col, int _row, string _text, color _txtColor, color _bgColor) =>
+    if not na(_t) and _col >= 0 and _row >= 0 and _col < maxHudCols and _row < maxHudRows
+        table.cell(_t, _col, _row, _text, text_color=_txtColor, text_size=size.tiny, bgcolor=_bgColor, text_halign=_col == 0 ? text.align_right : text.align_left)
