// ============================================================================
// v17.54.4 HUD SAFETY FUNCTIONS — Prevent na crashes & out-of-bounds errors
// ============================================================================
//
// HUD Row Map (26 rows, 0-indexed — v17.56.1 expanded from 25):
//   Row  0: Header    — "SMC P&D" / version badge
//   Row  1: HTF       — H4 structural bias (v17.56.1: was Daily, now H4/240)
//   Row  2: LTF       — M15 structural bias (v17.56.1: was H4, now M15/15)
//   Row  3: Align     — Trend alignment status (WITH TREND / COUNTER TREND)
//   Row  4: KZ        — Kill Zone status
//   Row  5: Sniper    — Sniper signal progress
//   Row  6: POI       — Point of Interest status
//   Row  7: Momentum  — Momentum direction
//   Row  8: Guardian  — Guardian filter status
//   Row  9: Confl     — Confluence score
//   Row 10: AMD       — AMD phase
//   Row 11: Trade     — Trade context
//   Row 12: Entry     — Entry mode
//   Row 13: Action    — Action step + plan
//   Row 14: Stage     — Signal stage
//   Row 15: Alert     — Last alert type
//   Row 16: Signals   — Signals today count
//   Row 17: Levels    — Session levels
//   Row 18: SniperTr  — Sniper trades counter (tracker)
//   Row 19: ActiveTr  — Active trades counter (tracker)
//   Row 20: H4Struct  — [debug] Structural BOS debug (v17.55.0)
//   Row 21: HTFDbg    — [debug] HTF structural debug (v17.56.1: H4 BOS)
//   Row 22: LTFDbg    — [debug] LTF structural debug (v17.56.1: M15 BOS)
//   Row 23: ZoneCfg   — [debug] Zone configuration
//   Row 24: ZoneHt    — [debug] Zone height
//   Row 25: ZoneSt    — [debug] Zone state
//
// Hard limit constants — v17.56.1: expanded to 26 rows for HTF/LTF debug
int maxHudRows = 35   // v17.60.1: +1 row (34) for the optional Alignment Debug row; v17.59 added 30-33
int maxHudCols = 2

// Safe text wrapper — prevents na value crashes in HUD cell text
// Returns "—" for na/null values, str.tostring() for valid values (defensive cast)
f_safeText(string val) =>
    na(val) ? "—" : str.tostring(val)

// Safe cell writer — standard rows (size.normal, auto-alignment by column)
// Guards: not na(_table) and _col >= 0 and _row >= 0 and _col < maxHudCols and _row < maxHudRows
// Col 0 = right-aligned labels, Col 1 = left-aligned values
f_setCell(table _t, int _col, int _row, string _text, color _txtColor, color _bgColor) =>
    if not na(_t) and _col >= 0 and _row >= 0 and _col < maxHudCols and _row < maxHudRows
        table.cell(_t, _col, _row, _text, text_color=_txtColor, text_size=size.normal, bgcolor=_bgColor, text_halign=_col == 0 ? text.align_right : text.align_left)

// Safe cell writer — header rows (v17.65.0: size.normal, reverted from v17.62.0 size.small)
f_setHdrCell(table _t, int _col, int _row, string _text, color _txtColor, color _bgColor) =>
    if not na(_t) and _col >= 0 and _row >= 0 and _col < maxHudCols and _row < maxHudRows
        table.cell(_t, _col, _row, _text, text_color=_txtColor, text_size=size.normal, bgcolor=_bgColor, text_halign=_col == 0 ? text.align_right : text.align_left)

// Safe cell writer — debug rows (size.tiny for compact diagnostics)
f_setDbgCell(table _t, int _col, int _row, string _text, color _txtColor, color _bgColor) =>
    if not na(_t) and _col >= 0 and _row >= 0 and _col < maxHudCols and _row < maxHudRows
        table.cell(_t, _col, _row, _text, text_color=_txtColor, text_size=size.tiny, bgcolor=_bgColor, text_halign=_col == 0 ? text.align_right : text.align_left)

// --- ATR calculation ---
atrLen = 14
atrValue = ta.atr(atrLen)

// --- Pip size detection ---
pipSize = syminfo.mintick * (str.contains(syminfo.ticker, "JPY") ? 100 : (pdCryptoMode or syminfo.type == "crypto" ? 1 : 10))

// --- Time helpers ---
estHour = hour(time, "America/New_York")
// v17.66.0: minute-precision session timing so the open can be 05:30 (not just on-the-hour).
estMinute    = minute(time, "America/New_York")
estMinOfDay  = estHour * 60 + estMinute              // minutes elapsed since EST midnight
nyAMOpenMin  = nyAMStart * 60 + nyAMStartMin         // 05:30 EST by default (5*60 + 30 = 330)

// ============================================================================
// v17.56.7: TRADE SESSION DETECTION (Proper EST/EDT via America/New_York TZ)
// v17.66.0: NY open moved 08:00 → 05:30 EST (minute precision). The combined
//           isTradeSession window (03:00–12:00) is preserved by ending London
//           exactly where NY now begins.
// ============================================================================
// London Session: 3:00 AM - 5:30 AM EST (pre-NY overlap)
// NY Session:     5:30 AM - 12:00 PM EST (NY AM core, early opening overlap)
// isTradeSession: Either London or NY active
// ============================================================================
bool isLondonSession = estMinOfDay >= 3 * 60 and estMinOfDay < nyAMOpenMin
bool isNYSession     = estMinOfDay >= nyAMOpenMin and estMinOfDay < 12 * 60
bool isTradeSession  = isLondonSession or isNYSession

isLondon()  => estHour >= londonStart and estHour < londonEnd
// v17.66.0: NY AM Kill Zone now honours the minute-precision 05:30 open.
isNYAM()    => estMinOfDay >= nyAMOpenMin and estMinOfDay < nyAMEnd * 60
isNYPM()    => estHour >= nyPMStart   and estHour < nyPMEnd
isAsian()   => estHour >= asianStart  and estHour < asianEnd

inKillZone() => isLondon() or isNYAM() or isNYPM() or isAsian()

killZoneCode() =>
    isLondon() ? 1 : isNYAM() ? 2 : isNYPM() ? 3 : isAsian() ? 4 : 0

// --- Day change detection (used for resets across sections) ---
newDay = ta.change(time("D"))

// --- Label size helper ---
getLabelSize() =>
    labelSize == "tiny" ? size.tiny : labelSize == "small" ? size.small : size.normal

// ============================================================================
// SECTION 3: H4 MULTI-TIMEFRAME BIAS
// ============================================================================

// =============================================================================
// v17.55.0: STRUCTURAL BOS ENGINE — f_h4_structure()
// =============================================================================
// Computes H4 bias from swing structure (HH/HL = bullish, LL/LH = bearish).
// Must be defined BEFORE request.security() call that uses it.
// Uses var (persistent) state to track last confirmed swing high/low across bars.
// Returns: [bias, lastSwingHigh, lastSwingLow, flipBar]
//   bias: 1 = bullish, -1 = bearish, 0 = neutral (no structure yet)
//   lastSwingHigh/Low: price levels of the most recent confirmed pivots
//   flipBar: bar_index of the most recent structural flip
// =============================================================================
f_h4_structure(int _pivotLen) =>
    // Detect pivots on H4 data — ta.pivothigh/pivotlow return na when no pivot
    float _swH = ta.pivothigh(high, _pivotLen, _pivotLen)
    float _swL = ta.pivotlow(low, _pivotLen, _pivotLen)

    // Persistent state across bars (var = initialized once, survives bar-to-bar)
    var float _prevSwH  = na       // previous confirmed swing high
    var float _prevSwL  = na       // previous confirmed swing low
    var float _lastSwH  = na       // most recent confirmed swing high
    var float _lastSwL  = na       // most recent confirmed swing low
    var int   _bias     = 0        // current structural bias
    var int   _flipBar  = 0        // bar_index of last structural flip

    // Process new swing high
    if not na(_swH)
        _prevSwH := _lastSwH
        _lastSwH := _swH
        // Check for Higher High (HH) — bullish evidence
        if not na(_prevSwH) and _swH > _prevSwH
            // HH confirmed — if we also have HL, bias flips bullish
            if not na(_lastSwL) and not na(_prevSwL) and _lastSwL > _prevSwL
                if _bias != 1
                    _flipBar := bar_index
                _bias := 1
        // Check for Lower High (LH) — bearish evidence
        if not na(_prevSwH) and _swH < _prevSwH
            // LH confirmed — if we also have LL, bias flips bearish
            if not na(_lastSwL) and not na(_prevSwL) and _lastSwL < _prevSwL
                if _bias != -1
                    _flipBar := bar_index
                _bias := -1

    // Process new swing low
    if not na(_swL)
        _prevSwL := _lastSwL
        _lastSwL := _swL
        // Check for Higher Low (HL) — bullish evidence
        if not na(_prevSwL) and _swL > _prevSwL
            // HL confirmed — if we also have HH, bias flips bullish
            if not na(_lastSwH) and not na(_prevSwH) and _lastSwH > _prevSwH
                if _bias != 1
                    _flipBar := bar_index
                _bias := 1
        // Check for Lower Low (LL) — bearish evidence
        if not na(_prevSwL) and _swL < _prevSwL
            // LL confirmed — if we also have LH, bias flips bearish
            if not na(_lastSwH) and not na(_prevSwH) and _lastSwH < _prevSwH
                if _bias != -1
                    _flipBar := bar_index
                _bias := -1

    [_bias, _lastSwH, _lastSwL, _flipBar]

// =============================================================================
// v17.56.1: f_d1_structure() REMOVED — HTF/LTF both use f_h4_structure()
// =============================================================================
// v17.56.0 had f_d1_structure() as a copy of f_h4_structure() for Daily TF.
// v17.56.1: HTF=H4("240") and LTF=M15("15") both call f_h4_structure() with
// different pivot lengths. No separate function needed.
// =============================================================================

// =============================================================================
// v17.74.0: M15 INTRADAY MSS ENGINE — f_m15_mss()
// =============================================================================
// PURPOSE: Make finalLTFTrend track LIVE M15 intraday structure shifts instead
// of the lagging dual-confirmation (HH+HL / LL+LH) pattern used by
// f_h4_structure(). During powerful M5/M15 markup/markdown legs the old engine
// stayed pinned to a stale structural pivot, keeping the HUD in MONITOR and
// locking the (finalHTFTrend == finalLTFTrend) alert gateway shut.
//
// METHOD (responsive, close-based MSS/BOS — single breach):
//   • Track the most recent CONFIRMED M15 swing high / swing low (pivots).
//   • Flip bias BULLISH the moment price CLOSES above the last swing high
//     (Market Structure Shift Up / reclaim of swing highs).
//   • Flip bias BEARISH the moment price CLOSES below the last swing low
//     (Market Structure Shift Down / break of swing lows).
// A single decisive breach flips the bias — no second confirming pivot is
// required — so the LTF row turns in real-time with the active leg.
//
// Returns: [bias, lastSwingHigh, lastSwingLow, flipBar] — identical tuple shape
// to f_h4_structure() so it is a drop-in replacement inside request.security().
// =============================================================================
f_m15_mss(int _pivotLen, int _rLen) =>
    // Confirmed M15 pivots (na until locked; left=_pivotLen bars, right=_rLen bars)
    // v17.85.29: _rLen is now independent — lower value = faster right-side confirmation.
    float _swH = ta.pivothigh(high, _pivotLen, _rLen)
    float _swL = ta.pivotlow(low, _pivotLen, _rLen)

    // Persistent state across bars
    var float _lastSwH = na     // most recent confirmed swing high
    var float _lastSwL = na     // most recent confirmed swing low
    var int   _bias    = 0      // current MSS bias (1 bull / -1 bear / 0 neutral)
    var int   _flipBar = 0      // bar_index of last structural flip

    // Latch newest confirmed swings
    if not na(_swH)
        _lastSwH := _swH
    if not na(_swL)
        _lastSwL := _swL

    // MSS UP — close reclaims the last swing high → bullish shift
    if not na(_lastSwH) and close > _lastSwH
        if _bias != 1
            _flipBar := bar_index
        _bias := 1
    // MSS DOWN — close breaks the last swing low → bearish shift
    else if not na(_lastSwL) and close < _lastSwL
        if _bias != -1
            _flipBar := bar_index
        _bias := -1

    [_bias, _lastSwH, _lastSwL, _flipBar]

// =============================================================================
// H4 BIAS — TRUE 4H DATA (v17.7 FIX) + ZONE POSITION FIX (v17.8)
// All range, bias, and P/D zone logic computed INSIDE request.security("240")
// so results are IDENTICAL regardless of chart timeframe (5m, 15m, 1h, 4h).
// v17.8: Zone position (PZ/DZ/EQ) now independent of bias direction.
// =============================================================================

// Step 1: H4 dealing-range inputs (v17.79.0 — legacy rolling-window range REMOVED)
// v17.79.0 LEGACY CLEANUP: the old rolling ta.highest/lowest range, the zone-height
// cap and the minimum-height expansion — the 'rogue' math that used to WRITE
// h4RangeHigh / h4RangeLow — have been PHYSICALLY REMOVED. The verified pivot-swing
// engine is now the sole primary P&D source (structural dealing-range / BOS range
// remain as fallbacks). h4RangeHigh / h4RangeLow are declared na here and assigned
// ONLY at the SINGLE OVERRIDE POINT below, so no HUD row can ever read stale math.
int effectiveLookback = zoneSourceInput == "SESSION" ? 6 : zoneSourceInput == "RECENT" ? zoneLookbackBars : 50

// H4 ATR retained — feeds the BOS-range ATR expansion (bosExpansion) and the HUD
// zone-height diagnostic row. It no longer caps or mutates the dealing range.
float h4ATR = request.security(syminfo.tickerid, "240", ta.atr(14), lookahead=barmerge.lookahead_off)

// v17.79.0: maxAllowedHeight / zoneHeightCapped are retained ONLY as HUD diagnostic
// values (the Zone-Height debug row). Nothing is capped anymore, so zoneHeightCapped
// is a constant false and maxAllowedHeight is a pure display metric.
float maxAllowedHeight = nz(h4ATR, 0.001) * maxZoneHeightATR
bool  zoneHeightCapped = false

// Declared na — the SINGLE OVERRIDE POINT below is the ONLY writer of these two.
float h4RangeHigh = na
float h4RangeLow  = na

// ============================================================================
// v17.58: BOS-ANCHORED STRUCTURAL RANGE  (*** BREAKING CHANGE ***)
// ----------------------------------------------------------------------------
// Replaces the rolling ta.highest/lowest window above with a range anchored to
// the most recent H4 Break of Structure (BOS):
//   • Bullish BOS (H4 close > last confirmed pivot high):
//       range bottom = preceding swing low (origin),
//       range top    = broken pivot high + dynamic ATR expansion (termination).
//   • Bearish BOS (H4 close < last confirmed pivot low):
//       range top    = preceding swing high (origin),
//       range bottom = broken pivot low  − dynamic ATR expansion (termination).
// When a valid BOS range exists, it OVERRIDES h4RangeHigh / h4RangeLow so every
// downstream consumer (equilibrium, premium/discount levels, POI, AMD, visuals,
// alert gating) uses the structural range. All request.security() calls use
// closed/confirmed pivots + lookahead_off for non-repainting behavior.
// ============================================================================
// v17.85.9: bosH4High / bosH4Low = the CONFIRMED (closed) H4 bar high/low (high[1]/
// low[1], matching bosH4Close = close[1]). The Structural Leg FSM expands its extreme
// from these instead of the chart-timeframe high/low, so the master H4 range is built
// from CLOSED H4 candles only and renders identically on H4/H1/M15/M5.
[bosPHraw, bosPLraw, bosH4Close, bosH4High, bosH4Low] = request.security(syminfo.tickerid, "240", [ta.pivothigh(high, bosSwingLength, bosSwingLength), ta.pivotlow(low, bosSwingLength, bosSwingLength), close[1], high[1], low[1]], lookahead=barmerge.lookahead_off)

// ============================================================================
// v17.85.9: STRUCTURAL-BOUNDED IMPULSE ORIGIN (fixed deep sweep RETIRED)
// ----------------------------------------------------------------------------
// v17.85.8's fixed 150/200-bar sweep fixed the internal-shelf problem but, being a
// telescope, occasionally anchored a valid CURRENT leg to an unrelated OLDER extreme
// from a previous market era ("a little holiday into last month's price action").
// v17.85.9 gives the engine reading glasses: the origin window is bounded by the
// market's OWN confirmed H4 structural NODES, not a fixed bar count.
//
// The correct question is NOT "what was the lowest low in the last 200 H4 candles?"
// It is "what was the lowest low in the structural BASE that caused the currently
// confirmed bullish displacement?" (and the mirror for bearish).
//
//   BULLISH ORIGIN (demand base):
//     • Base low  = the LOWEST of the last 3 confirmed H4 pivot lows (captures a
//       multi-low / staircase accumulation, not just the most recent shelf).
//     • Parent structural high = the most recent confirmed H4 pivot HIGH that
//       printed BEFORE that base low — the top of the decline into the base. This
//       is the structural fence; it is a real node, never a fixed number of bars.
//     • Origin = the ABSOLUTE lowest low over [parent high … now], so the sweep
//       wick at the base becomes the anchor. Bounded above by a genuine structural
//       high, it can neither stop on an internal shelf NOR wander into last month.
//   BEARISH ORIGIN (supply base): exact mirror (highest of last 3 pivot highs; the
//     confirmed pivot LOW before it fences the scan; absolute highest high wins).
//
// Origin-selection priority (per brief): 1 bounded impulse base → 3 last confirmed
// BOS pivot (bos_lastPL/PH, applied by the FSM's nz() fallback) → 4 confirmed H4
// low/high (warm-up last resort). The deprecated 150/200-bar sweep is NEVER a
// fallback. Latch timing: the FSM freezes the origin ONCE on the flip/CHoCH; at that
// bar no post-base pivot high/low has confirmed yet (it needs bosSwingLength bars),
// so the parent node is still the true top/bottom of the decline into the base.
// Computed INSIDE the H4 security context (lookahead_off) → non-repainting and
// identical on every chart timeframe. A 300-bar safety cap only bounds the loop.
// Returns diagnostics (boundary price/time, scan bars, method) for the debug table.
// ============================================================================
f_h4BoundedImpulseOrigins(int scanEndTime) =>
    float _ph = ta.pivothigh(high, bosSwingLength, bosSwingLength)
    float _pl = ta.pivotlow(low, bosSwingLength, bosSwingLength)
    // v17.85.11 TIMELINE LOCK: translate the caller's scanEndTime (the H4 bar
    // time at which the BOS was confirmed) into a bar OFFSET measured back from
    // the bar currently being evaluated. Every extreme scan below now starts at
    // this offset instead of k=0, so the search window can never extend past the
    // breakout bar into newer internal pullbacks (the anchor-drift bug). When the
    // caller passes the current bar's own time (the normal case), _endOff resolves
    // to 0 and behaviour is identical to prior versions — fully backward safe.
    int _endOff = 0
    if not na(scanEndTime)
        for j = 0 to 300
            if na(time[j])
                break
            if time[j] <= scanEndTime
                _endOff := j
                break
    // Rolling memory of the last 3 CONFIRMED H4 pivots (price + true bar index). A
    // pivot confirms bosSwingLength bars after it prints, so its bar is offset back.
    var float _ph1 = na
    var int   _ph1b = na
    var float _ph2 = na
    var int   _ph2b = na
    var float _ph3 = na
    var int   _ph3b = na
    var float _pl1 = na
    var int   _pl1b = na
    var float _pl2 = na
    var int   _pl2b = na
    var float _pl3 = na
    var int   _pl3b = na
    if not na(_ph)
        _ph3  := _ph2
        _ph3b := _ph2b
        _ph2  := _ph1
        _ph2b := _ph1b
        _ph1  := _ph
        _ph1b := bar_index - bosSwingLength
    if not na(_pl)
        _pl3  := _pl2
        _pl3b := _pl2b
        _pl2  := _pl1
        _pl2b := _pl1b
        _pl1  := _pl
        _pl1b := bar_index - bosSwingLength
    // ---- BULLISH ORIGIN: base low = lowest of last 3 confirmed pivot lows ----
    float _baseLow    = na
    int   _baseLowBar = na
    if not na(_pl1)
        _baseLow    := _pl1
        _baseLowBar := _pl1b
        if not na(_pl2) and _pl2 < _baseLow
            _baseLow    := _pl2
            _baseLowBar := _pl2b
        if not na(_pl3) and _pl3 < _baseLow
            _baseLow    := _pl3
            _baseLowBar := _pl3b
    // Parent structural high = most recent confirmed pivot high BEFORE the base low.
    int   _bullBoundBar = na
    float _bullBoundPx  = na
    if not na(_baseLowBar)
        if not na(_ph1b) and _ph1b < _baseLowBar
            _bullBoundBar := _ph1b
            _bullBoundPx  := _ph1
        else if not na(_ph2b) and _ph2b < _baseLowBar
            _bullBoundBar := _ph2b
            _bullBoundPx  := _ph2
        else if not na(_ph3b) and _ph3b < _baseLowBar
            _bullBoundBar := _ph3b
            _bullBoundPx  := _ph3
    // Absolute lowest low across [parent high … now]; captures the sweep wick.
    float _bullLow  = na
    int   _bullScan = 0
    if not na(_bullBoundBar)
        _bullScan := math.min(math.max(0, bar_index - _bullBoundBar), 300)
        // v17.85.11: scan window is [_endOff … _bullScan] — starts at the locked
        // breakout offset, never at the live bar, so post-BOS pullbacks are excluded.
        for k = _endOff to _bullScan
            if not na(low[k])
                _bullLow := na(_bullLow) ? low[k] : math.min(_bullLow, low[k])
    // v17.85.12 MODULE B — DEEP-SEARCH STRUCTURAL FLOOR: force the origin down to
    // the deepest confirmed structural pivot low of the last-3-pivot group. Without
    // this, the Timeline-Lock window could anchor to a shallow consolidation shelf
    // (e.g. USD/JPY 161.532) instead of the true accumulation base (159.534). The
    // fallback protection level (slOriginLow) would then sit too high, and a normal
    // deep discount pullback (160.478) would close below it → FALSE RESET Bull→Bear.
    // Clamping to _baseLow guarantees the floor is the absolute structural origin.
    if not na(_baseLow)
        _bullLow := na(_bullLow) ? _baseLow : math.min(_bullLow, _baseLow)
    // ---- BEARISH ORIGIN (mirror): base high = highest of last 3 pivot highs ----
    float _baseHigh    = na
    int   _baseHighBar = na
    if not na(_ph1)
        _baseHigh    := _ph1
        _baseHighBar := _ph1b
        if not na(_ph2) and _ph2 > _baseHigh
            _baseHigh    := _ph2
            _baseHighBar := _ph2b
        if not na(_ph3) and _ph3 > _baseHigh
            _baseHigh    := _ph3
            _baseHighBar := _ph3b
    int   _bearBoundBar = na
    float _bearBoundPx  = na
    if not na(_baseHighBar)
        if not na(_pl1b) and _pl1b < _baseHighBar
            _bearBoundBar := _pl1b
            _bearBoundPx  := _pl1
        else if not na(_pl2b) and _pl2b < _baseHighBar
            _bearBoundBar := _pl2b
            _bearBoundPx  := _pl2
        else if not na(_pl3b) and _pl3b < _baseHighBar
            _bearBoundBar := _pl3b
            _bearBoundPx  := _pl3
    float _bearHigh = na
    int   _bearScan = 0
    if not na(_bearBoundBar)
        _bearScan := math.min(math.max(0, bar_index - _bearBoundBar), 300)
        // v17.85.11: scan window is [_endOff … _bearScan] — locked to the breakout.
        for k = _endOff to _bearScan
            if not na(high[k])
                _bearHigh := na(_bearHigh) ? high[k] : math.max(_bearHigh, high[k])
    // v17.85.12 MODULE B — DEEP-SEARCH STRUCTURAL CEILING (mirror of the bull floor):
    // clamp the bear origin UP to the highest confirmed structural pivot high of the
    // last-3-pivot group so a shallow shelf can never lower the ceiling below the
    // true distribution origin (prevents the symmetric false RESET Bear→Bull).
    if not na(_baseHigh)
        _bearHigh := na(_bearHigh) ? _baseHigh : math.max(_bearHigh, _baseHigh)
    // Boundary timestamps + origin-method codes for the debug table.
    //   method 1 = bounded impulse base · 3 = BOS-pivot fallback · 4 = warm-up H4 low/high
    int   _bullMethod = not na(_bullLow) ? 1 : (not na(_pl1) ? 3 : 4)
    int   _bearMethod = not na(_bearHigh) ? 1 : (not na(_ph1) ? 3 : 4)
    int   _bullBoundTime = not na(_bullBoundBar) ? time[_bullScan] : na
    int   _bearBoundTime = not na(_bearBoundBar) ? time[_bearScan] : na
    [_bullLow, _bearHigh, _bullBoundPx, _bearBoundPx, _bullBoundTime, _bearBoundTime, _bullScan, _bearScan, _bullMethod, _bearMethod]
// v17.85.11 TIMELINE LOCK — the resolver is now handed the H4 bar time being
// evaluated (time, in the H4 security context = the confirmed BOS/trigger bar).
// This is the FSM "trigger bar" timestamp: it caps the extreme scan at the
// breakout window so slOriginLow/High latched at an INIT/RESET transition can no
// longer drift to a lower low / higher high made by a pullback AFTER the BOS.
[bosBoundedLow, bosBoundedHigh, bosBoundPxBull, bosBoundPxBear, bosBoundTimeBull, bosBoundTimeBear, bosScanBull, bosScanBear, bosMethodBull, bosMethodBear] = request.security(syminfo.tickerid, "240", f_h4BoundedImpulseOrigins(time), lookahead=barmerge.lookahead_off)

// Pivot memory (most recent two confirmed H4 swing highs / lows)
var float bos_lastPH = na
var float bos_prevPH = na
var float bos_lastPL = na
var float bos_prevPL = na
if not na(bosPHraw)
    bos_prevPH := bos_lastPH
    bos_lastPH := bosPHraw
if not na(bosPLraw)
    bos_prevPL := bos_lastPL
    bos_lastPL := bosPLraw

var int   bosTrend        = 0     // 1 = bullish BOS, -1 = bearish BOS, 0 = none yet
var float bosOrigin       = na    // swing that anchors the far side of the range
var float bosTermination  = na    // broken level extended by dynamic expansion
var float bosRangeHigh    = na
var float bosRangeLow     = na
var int   bosConfirmedBar = na
var int   bosAnchorTime   = na    // v17.59: chart time when the active BOS range was anchored
var float bos_brokenHigh  = na    // pivot-high level already counted as broken
var float bos_brokenLow   = na    // pivot-low level already counted as broken

// ============================================================================
// P&D STRUCTURAL BOS ANCHORING — MACRO ORIGIN  (v17.66.6 OUTWARD-ONLY FIX)
// ----------------------------------------------------------------------------
// The ORIGIN anchor (DISCOUNT bottom in a bull leg / PREMIUM top in a bear leg)
// is anchored to the TRUE macro swing extreme of the leg. It is re-anchored on a
// genuine structural FLIP (when price CLOSES through the locked origin) and,
// within the established leg, it can ONLY EXTEND OUTWARD:
//   Bullish leg → activeOriginLow can only move DOWN (math.min) to a deeper true
//                 low; it can NEVER rise onto a minor pullback / continuation.
//   Bearish leg → activeOriginHigh can only move UP (math.max) to a higher true
//                 high; it can NEVER drop onto a minor pullback / continuation.
//   Bullish leg → bottom = activeOriginLow,  top    = activeTerminationHigh
//   Bearish leg → top    = activeOriginHigh, bottom = activeTerminationLow
// CRITICAL INVARIANT (v17.66.6): activeOriginLow is ONLY ever assigned via
// math.min (down/outward) or a flip re-anchor; activeOriginHigh ONLY via
// math.max (up/outward) or a flip re-anchor. There is NO assignment anywhere
// that can move an origin TOWARD price (the ratchet bug). Verified by grep.
// ============================================================================
var float activeOriginLow       = na   // bull leg: macro swing low that STARTED the leg (HARD-LOCKED)
var float activeTerminationHigh = na   // bull leg: highest high reached (extends with leg)
var float activeOriginHigh      = na   // bear leg: macro swing high that STARTED the leg (HARD-LOCKED)
var float activeTerminationLow  = na   // bear leg: lowest low reached (extends with leg)

// Robust macro structural trend — the SINGLE source of truth for flip vs
// continuation. 1 = bullish leg, -1 = bearish leg, 0 = not yet established.
// It is deliberately noise-resistant: it flips ONLY when the locked origin is
// structurally broken (see transition logic below), NOT on every raw BOS.
var int macroTrend = 0

// v17.75.1: Bar index at which the CURRENT dealing range was last (re-)anchored on
// a confirmed H4 flip/BOS. Used to draw the P&D shading / EQ line from the true
// structural range start (x1) to the current bar — no more floating -50 offset.
var int rangeAnchorBar = na

// Running macro extremes of the CURRENT phase, used to anchor the origin to the
// TRUE swing low/high of the move (not the most recent minor pivot) on a flip.
var float phaseLowestLow   = na
var float phaseHighestHigh = na
// v17.66.8 ORDERING FIX: capture the COMPLETED prior-phase extreme BEFORE this
// bar mutates the running trackers. The flip/BOS anchor logic below reads these
// snapshots, so a flip can only ever anchor to closed prior-phase structure and
// can NEVER be contaminated by the current (flip) bar's own forming extreme.
// The running min/max update is PRESERVED (it still tracks the phase low/high);
// it is simply read via the pre-update snapshot at the flip, not the live value.
float prevPhaseLowestLow   = phaseLowestLow    // prior-phase low  (pre-update snapshot)
float prevPhaseHighestHigh = phaseHighestHigh  // prior-phase high (pre-update snapshot)
phaseLowestLow   := na(phaseLowestLow)   ? low  : math.min(phaseLowestLow,  low)
phaseHighestHigh := na(phaseHighestHigh) ? high : math.max(phaseHighestHigh, high)

float bosExpansion = nz(h4ATR, 0.0) * bosRangeExtend

bool bosBull = not na(bos_lastPH) and not na(bosH4Close) and bosH4Close > bos_lastPH and (na(bos_brokenHigh) or bos_lastPH != bos_brokenHigh)
bool bosBear = not na(bos_lastPL) and not na(bosH4Close) and bosH4Close < bos_lastPL and (na(bos_brokenLow)  or bos_lastPL != bos_brokenLow)

// ---------------------------------------------------------------------------
// LEGACY bosTrend — UNCHANGED per-BOS semantics (drives sequence reset, momentum,
// HUD and webhook). Kept exactly as before so no downstream signal is affected.
// ---------------------------------------------------------------------------
if bosBull
    bosTrend        := 1
    bos_brokenHigh  := bos_lastPH
    bosConfirmedBar := bar_index
    bosAnchorTime   := time
else if bosBear
    bosTrend        := -1
    bos_brokenLow   := bos_lastPL
    bosConfirmedBar := bar_index
    bosAnchorTime   := time

// ----
// MACRO TREND TRANSITIONS — v17.66.9 CHoCH RESET
//   • Not yet established (0): the first confirmed BOS sets the direction.
//   • Bullish (1): flips to Bearish on ANY confirmed bearish BOS (bosBear).
//     This matches the video methodology — a BOS in the opposite direction IS
//     a Change of Character (CHoCH) and warrants a fresh anchor re-draw.
//   • Bearish (-1): mirror — flips to Bullish on ANY confirmed bullish BOS.
//   • The old "origin must be broken" guard is REMOVED. That guard caused the
//     script to hold a fossil anchor (e.g. 0.55086) indefinitely because the
//     absolute origin was never re-tested. Now any structural reversal BOS
//     triggers a clean re-anchor to the most recent phase extreme.
// NOTE: The within-leg "extend outward only" maintenance (math.min / math.max)
//   still prevents the origin from ratcheting toward price on continuation bars.
//   Only a genuine opposite-direction BOS can now trigger a flip + re-anchor.
// ----
bool bullOriginBroken = false   // v17.66.9: guard removed — kept as bool for
bool bearOriginBroken = false   // downstream rangeForceExpanded compatibility

if macroTrend == 0
    if bosBull
        macroTrend := 1
    else if bosBear
        macroTrend := -1
else if macroTrend == 1
    if bosBear                  // ANY bearish BOS = CHoCH → flip + re-anchor
        macroTrend := -1
else if macroTrend == -1
    if bosBull                  // ANY bullish BOS = CHoCH → flip + re-anchor
        macroTrend := 1

// ---------------------------------------------------------------------------
// EXPLICIT TREND FLIP vs CONTINUATION DETECTION (history-based, per spec)
// ---------------------------------------------------------------------------
bool isTrendFlip           = (macroTrend != macroTrend[1]) and (macroTrend != 0)
bool isBullishFlip         = isTrendFlip and (macroTrend == 1)
bool isBearishFlip         = isTrendFlip and (macroTrend == -1)

// === ORIGIN ANCHOR — re-anchor on flip, then EXTEND OUTWARD ONLY within the leg ===
// v17.66.6: The origin is NOT a frozen single value anymore. On a genuine flip it
// is re-anchored to the prior phase's true macro extreme; thereafter, within the
// established leg, it can move in ONE direction only (outward), so it deepens to
// the real swing low/high but can NEVER ratchet toward price (onto a pullback).
if isBullishFlip
    // ORIGIN RE-ANCHOR - Bullish flip: anchor DISCOUNT bottom to the
    // DISPLACEMENT-ORIGIN swing low — the pivot low (bos_lastPL) that was broken
    // to create the bullish BOS. This is the swing that LAUNCHED the bullish
    // displacement, not merely the most recent phase extreme.
    // v17.67.0: was nz(prevPhaseLowestLow, low). bos_lastPL is the last confirmed
    // H4 pivot low (request.security, lookahead_off) preceding the break, so the
    // anchor is the true displacement origin. Fallback to the snapshot/low if na.
    activeOriginLow       := nz(bos_lastPL, nz(prevPhaseLowestLow, low))
    activeTerminationHigh := math.max(high, bos_lastPH + bosExpansion)
    phaseHighestHigh      := high            // restart high tracker for this bull leg
    phaseLowestLow        := low             // v17.66.7: reset BOTH trackers on flip
    rangeAnchorBar        := bar_index       // v17.75.1: lock the new range's start bar
if isBearishFlip
    // ORIGIN RE-ANCHOR - Bearish flip: anchor PREMIUM top to the
    // DISPLACEMENT-ORIGIN swing high — the pivot high (bos_lastPH) that was broken
    // to create the bearish BOS. This is the swing that LAUNCHED the bearish
    // displacement, not merely the most recent phase extreme.
    // v17.67.0: was nz(prevPhaseHighestHigh, high). bos_lastPH is the last confirmed
    // H4 pivot high (request.security, lookahead_off) preceding the break, so the
    // anchor is the true displacement origin. Fallback to the snapshot/high if na.
    activeOriginHigh      := nz(bos_lastPH, nz(prevPhaseHighestHigh, high))
    activeTerminationLow  := math.min(low, bos_lastPL - bosExpansion)
    phaseLowestLow        := low             // restart low tracker for this bear leg
    phaseHighestHigh      := high            // v17.66.7: reset BOTH trackers on flip
    rangeAnchorBar        := bar_index       // v17.75.1: lock the new range's start bar

// === WITHIN-LEG ANCHOR MAINTENANCE — origin extends OUTWARD ONLY (the actual fix) ===
// CRITICAL: activeOriginLow is updated with math.min ONLY. This makes it
// mathematically IMPOSSIBLE for the origin to move UP onto a minor pullback /
// continuation pivot — the exact failure the user reported. It can ONLY move DOWN
// to a deeper, truer macro swing low (e.g. a real low printed after a weak early
// establishment). It is reset/re-anchored exclusively on a flip (block above).
// v17.66.8: this maintenance is SKIPPED on the flip bar itself (`and not isFlip`)
// so the flip bar's own forming extreme can never override the prior-phase anchor
// that was just set above. On every subsequent (continuation) bar it runs exactly
// as before, preserving the v17.66.6 "deepen to the true macro low" behaviour.
// v17.75.1 DEALING RANGE LOCK: when the lock is ON, the range is FROZEN between
// structural breaks — neither the origin nor the termination is allowed to move on
// continuation bars, so the EQ/P&D levels stay static (per the v17.75.1 brief). The
// range only ever re-anchors on a genuine flip (blocks above). When the lock is OFF,
// the legacy v17.75.0 within-leg maintenance runs (origin deepens outward-only,
// termination tracks new extremes).
if not lockDealingRange
    if macroTrend == 1 and not isBullishFlip
        // Bull leg: origin can only DEEPEN (math.min) — NEVER rises onto a pullback.
        activeOriginLow       := na(activeOriginLow)       ? low  : math.min(activeOriginLow, low)
        // Termination tracks the highest high of the leg.
        activeTerminationHigh := na(activeTerminationHigh) ? high : math.max(activeTerminationHigh, high)
    if macroTrend == -1 and not isBearishFlip
        // Bear leg: origin can only RISE (math.max) — NEVER drops onto a pullback.
        activeOriginHigh      := na(activeOriginHigh)      ? high : math.max(activeOriginHigh, high)
        // Termination tracks the lowest low of the leg.
        activeTerminationLow  := na(activeTerminationLow)  ? low  : math.min(activeTerminationLow, low)
else
    // Lock ON: still safely INITIALISE anchors if they are na (e.g. first bars
    // before any flip has fired) so the range can render, but never MOVE them.
    if macroTrend == 1 and not isBullishFlip
        activeOriginLow       := na(activeOriginLow)       ? low  : activeOriginLow
        activeTerminationHigh := na(activeTerminationHigh) ? high : activeTerminationHigh
    if macroTrend == -1 and not isBearishFlip
        activeOriginHigh      := na(activeOriginHigh)      ? high : activeOriginHigh
        activeTerminationLow  := na(activeTerminationLow)  ? low  : activeTerminationLow

// === Derive the rendered structural range from the locked anchors (every bar) ===
if macroTrend == 1 and not na(activeOriginLow) and not na(activeTerminationHigh)
    bosOrigin      := activeOriginLow
    bosTermination := activeTerminationHigh
    bosRangeLow    := activeOriginLow
    bosRangeHigh   := activeTerminationHigh
else if macroTrend == -1 and not na(activeOriginHigh) and not na(activeTerminationLow)
    bosOrigin      := activeOriginHigh
    bosTermination := activeTerminationLow
    bosRangeHigh   := activeOriginHigh
    bosRangeLow    := activeTerminationLow

// ----------------------------------------------------------------------------
// v17.59 FIX 2: BOS RANGE EXPANSION — "STRANDED PRICE" GUARD
// ----------------------------------------------------------------------------
// v17.58 only moved the BOS range on a fresh BOS event, so a runaway trend could
// leave current price OUTSIDE the dealing range (stranded), which then fed stale
// premium/discount/equilibrium values to every downstream consumer. v17.59 makes
// the range expand EVERY bar on new extremes and adds a hard safety clamp so the
// current bar's price is ALWAYS contained inside the range. rangeForceExpanded
// records when the safety clamp had to engage (surfaced in HUD + webhook).
// v17.66.5: This block now extends ONLY the TERMINATION side toward new price
// extremes in the trend direction. It NEVER writes activeOriginLow/High — the
// origin is hard-locked and re-anchored exclusively on a structural flip above.
// (The old v17.59 version reassigned the origin here every bar — root-cause BUG
// #1, now removed.) rangeForceExpanded now flags when price has CLOSED through
// the locked origin (i.e. a structural-break / stranded condition).
bool rangeForceExpanded = bullOriginBroken or bearOriginBroken
// v17.75.1 DEALING RANGE LOCK: when lockDealingRange is ON the termination side is
// FROZEN between structural flips, so the dealing range (and therefore EQ / P&D
// shading) stays anchored to the confirmed HTF swing high/low instead of drifting
// upward every bar on new price extremes. When OFF, legacy v17.75.0 behavior runs.
if not lockDealingRange
    if macroTrend == 1 and not na(activeTerminationHigh)
        // Bullish leg: a new high is structural continuation → extend termination up.
        if high > activeTerminationHigh
            activeTerminationHigh := high
            bosTermination        := activeTerminationHigh
            bosRangeHigh          := activeTerminationHigh
            rangeForceExpanded    := true
    else if macroTrend == -1 and not na(activeTerminationLow)
        // Bearish leg: a new low is structural continuation → extend termination down.
        if low < activeTerminationLow
            activeTerminationLow := low
            bosTermination       := activeTerminationLow
            bosRangeLow          := activeTerminationLow
            rangeForceExpanded   := true

// Override the rolling-window range with the BOS-anchored range when valid.
bool bosRangeValid = not na(bosRangeHigh) and not na(bosRangeLow) and (bosRangeHigh > bosRangeLow)

// ============================================================================
// v17.84.3 — STRUCTURAL-LEG DEALING RANGE (THE FORMULA GOING FORWARD)
// ----------------------------------------------------------------------------
// USER-DEFINED CANONICAL FORMULA (permanent, authoritative — not behind a toggle):
// The dealing range must represent the ACTUAL structural leg from where price
// STARTED to where it FLIPPED — exactly as drawn by hand on the chart:
//
//   • BEARISH structure (leg started from H4 SUPPLY):
//        Range TOP    = the HIGH where price STARTED at supply   (leg origin)
//        Range BOTTOM = the LOW  where price FLIPPED at demand    (leg extreme)
//
//   • BULLISH structure (leg started from H4 DEMAND):
//        Range BOTTOM = the LOW  where price STARTED at demand    (leg origin)
//        Range TOP    = the HIGH where price FLIPPED at supply    (leg extreme)
//
// IMPLEMENTATION (uses state this engine ALREADY maintains — zero new math):
//   • ORIGIN  = activeOriginHigh / activeOriginLow. Frozen the instant the leg
//     begins (a confirmed H4 CHoCH flip) at the swing that LAUNCHED the move,
//     i.e. "where price started" at supply (bearish) / demand (bullish). It is
//     re-anchored ONLY on the next opposite-direction flip and can NEVER ratchet
//     inward onto a pullback (math.min / math.max maintenance above).
//   • FLIP EXTREME = phaseLowestLow / phaseHighestHigh. The running extreme of
//     the CURRENT leg since the flip (reset at every flip, deepens outward only).
//     This is literally "where price flipped" — the deepest point reached at the
//     opposing demand/supply before the next structure break.
//
// Because the origin is frozen and the extreme deepens outward-only, this range
// can never squeeze inward. It is the single source of truth for the P&D visuals,
// EQ line, HUD, blockers and webhook from v17.84.3 onward.
// ============================================================================
float legRangeHigh = na
float legRangeLow  = na
if macroTrend == -1
    // Bearish leg: TOP = supply origin high, BOTTOM = deepest demand low reached.
    legRangeHigh := not na(activeOriginHigh) ? activeOriginHigh : bosRangeHigh
    legRangeLow  := not na(phaseLowestLow)   ? phaseLowestLow   : bosRangeLow
else if macroTrend == 1
    // Bullish leg: BOTTOM = demand origin low, TOP = highest supply high reached.
    legRangeLow  := not na(activeOriginLow)   ? activeOriginLow   : bosRangeLow
    legRangeHigh := not na(phaseHighestHigh)  ? phaseHighestHigh  : bosRangeHigh
bool legRangeValid = not na(legRangeHigh) and not na(legRangeLow) and (legRangeHigh > legRangeLow)

// ============================================================================
// v17.76.4: DEALING RANGE ENGINE — ONE SOURCE OF TRUTH (STRUCTURAL SWINGS ONLY)
// ----------------------------------------------------------------------------
// A single dedicated engine that consumes ONLY the H4 STRUCTURAL SWING HIGH and
// STRUCTURAL SWING LOW (confirmed H4 pivot highs / lows) and produces the range
// that EVERY subsystem reads (P&D shading, EQ line, HUD, Guardian, Macro-Express,
// POI, RR, alerts, webhook). No subsystem recomputes its own range.
//
//   structureHigh / structureLow : the confirmed H4 structural swings that define
//                                  the CURRENT dealing range (NOT supply/demand,
//                                  OB, institutional OB, local/LTF pivot, fractal,
//                                  sweep, MSS, CHoCH-internal — those are INSIDE
//                                  the range and never redefine it).
//   dealingRangeHigh / dealingRangeLow : = structureHigh / structureLow
//   dealingRangeMid  : EQ (Zero) = (High + Low) / 2   — ALWAYS the exact midpoint
//   premiumStart / discountEnd : the 50/50 boundary (both = EQ)
//
// ANCHOR & FREEZE RULES (per the v17.76.4 spec):
//   • The whole range is (re-)seeded ONLY on a confirmed HTF structural FLIP
//     (CHoCH: isBullishFlip / isBearishFlip). The old range is then retired and a
//     new one built from the swings that established the new structure.
//   • Within the established leg the range is FROZEN except that it EXTENDS to a
//     newly CONFIRMED H4 structural swing pivot (a genuine H4 BOS to a new higher
//     high / lower low). It never moves on intrabar noise, a new supply/demand,
//     an OB, a local pivot, a sweep, an MSS or an LTF break.
//
// WHY THIS FIXES THE EQ DRIFT (root cause across v17.67 → v17.75.x):
//   v17.67 re-pointed the origin to bos_lastPL/PH (a newer LOCAL pivot) + added an
//   ATR expansion → range shrank from the bottom, EQ drifted UP. v17.75.2 then
//   froze the range at the PRIOR-phase extreme → the high undershot the true
//   current structural high, EQ sat too LOW (near demand). Building the range from
//   CONFIRMED H4 structural pivots (extend on real structure, freeze otherwise)
//   captures the full structural high AND low with no overshoot and no undershoot.
// ============================================================================
// Engine state: the confirmed H4 structural swing HIGH & LOW that define the
// CURRENT dealing range. The range is FROZEN between structural events and only
// changes on a CONFIRMED H4 BOS / CHoCH (H4 close through a confirmed H4 pivot):
//   • CHoCH (opposite-direction BOS = isBullishFlip / isBearishFlip): full REBUILD
//     — the old range is retired and a new one is bracketed by the most recent
//     confirmed H4 swing high & low.
//   • Continuation BOS (same-direction confirmed H4 BOS): the range EXTENDS its
//     leading edge to the newly broken structural pivot; the origin stays put.
// Nothing else moves it — not intrabar highs/lows, not a new supply/demand zone,
// OB / institutional OB, local or LTF pivot, liquidity sweep, or MSS.
// The per-bar update is wrapped in a function (returns a tuple of the new state)
// so it does NOT consume the main-body statement budget (Pine CE10295).
f_updateRange(float _sH, float _sL, string _src, int _uBar, int _uTime, bool _reset, bool _cUp, bool _cDn, bool _bull, float _lastPH, float _prevPH, float _phHH, float _lastPL, float _prevPL, float _phLL) =>
    float  _nH   = _sH
    float  _nL   = _sL
    string _nSrc = _src
    int    _nBar = _uBar
    int    _nT   = _uTime
    if _reset
        float _hi = nz(_lastPH, nz(_prevPH, _phHH))
        float _lo = nz(_lastPL, nz(_prevPL, _phLL))
        if na(_hi) or na(_lo) or _hi <= _lo
            _hi := nz(_phHH, high)
            _lo := nz(_phLL, low)
        if not na(_hi) and not na(_lo) and _hi > _lo
            _nH   := _hi
            _nL   := _lo
            _nSrc := _bull ? "Confirmed H4 CHoCH ▲ (rebuilt)" : "Confirmed H4 CHoCH ▼ (rebuilt)"
            _nBar := bar_index
            _nT   := time
    else if _cUp and not na(_sH) and not na(_lastPH) and _lastPH > _sH
        _nH   := _lastPH
        _nSrc := "Confirmed H4 BOS ▲ (extended top)"
        _nBar := bar_index
        _nT   := time
    else if _cDn and not na(_sL) and not na(_lastPL) and _lastPL < _sL
        _nL   := _lastPL
        _nSrc := "Confirmed H4 BOS ▼ (extended bottom)"
        _nBar := bar_index
        _nT   := time
    [_nH, _nL, _nSrc, _nBar, _nT]

// Persistent structural range state. dealingRangeHigh/dealingRangeLow ARE the
// frozen structural swings (no separate structureHigh/Low globals — that keeps the
// main body under Pine's statement budget, CE10295). The whole per-bar update runs
// inside f_updateRange; the flip / continuation-BOS flags are passed inline.
var float dealingRangeHigh = na
var float dealingRangeLow  = na
var string rangeSrc     = "INIT (awaiting first confirmed H4 BOS)"
var int    rangeUpdBar  = na
var int    rangeUpdTime = na

[_srH, _srL, _srS, _srB, _srT] = f_updateRange(dealingRangeHigh, dealingRangeLow, rangeSrc, rangeUpdBar, rangeUpdTime, isBullishFlip or isBearishFlip, bosBull and macroTrend == 1 and not isBullishFlip, bosBear and macroTrend == -1 and not isBearishFlip, isBullishFlip, bos_lastPH, bos_prevPH, prevPhaseHighestHigh, bos_lastPL, bos_prevPL, prevPhaseLowestLow)
dealingRangeHigh := _srH
dealingRangeLow  := _srL
rangeSrc         := _srS
rangeUpdBar      := _srB
rangeUpdTime     := _srT
bool dealingRangeValid = not na(dealingRangeHigh) and not na(dealingRangeLow) and (dealingRangeHigh > dealingRangeLow)

// ============================================================================
// v17.78.0: VERIFIED PIVOT-SWING DEALING RANGE (exact logic from the standalone
// harness smc_dealing_range_test.pine). Detects the recent H4 swing high/low via
// confirmed pivots and derives the 50% equilibrium. When valid + enabled this is
// the AUTHORITATIVE P&D range that every subsystem reads (see override below).
// H4 anchoring is forced via request.security("240", ...) so the range is
// identical on any chart timeframe (matches the rest of this file's design).
// ============================================================================
f_pndHtfPivots() =>
    _ph = ta.pivothigh(high, pndSwingWindow, pndSwingWindow)
    _pl = ta.pivotlow(low,  pndSwingWindow, pndSwingWindow)
    // v17.79.0 TIME-ANCHORING: a pivot is confirmed pndSwingWindow bars AFTER it
    // actually printed, so its true Unix timestamp is time[pndSwingWindow]. We
    // return that authoritative H4 pivot time so a lower-timeframe chart (e.g. M5)
    // knows EXACTLY where the H4 peak/trough was, regardless of how many LTF bars
    // have elapsed. All time values are evaluated INSIDE the H4 security context.
    _pht = not na(_ph) ? time[pndSwingWindow] : na
    _plt = not na(_pl) ? time[pndSwingWindow] : na
    [_ph, _pl, _pht, _plt]
[_pndRawPH, _pndRawPL, _pndRawPHt, _pndRawPLt] = request.security(syminfo.tickerid, "240", f_pndHtfPivots(), lookahead=barmerge.lookahead_off)

// New-pivot-this-bar detection (the security value changes when a fresh HTF pivot
// confirms). Anchor bar/time captured for the diagnostic label.
float _pndNewPHprice = na
float _pndNewPLprice = na
int   _pndNewPHbar   = na
int   _pndNewPLbar   = na
int   _pndNewPHtime  = na
int   _pndNewPLtime  = na
bool _pndIsNewPH = not na(_pndRawPH) and (na(_pndRawPH[1]) or _pndRawPH != _pndRawPH[1])
bool _pndIsNewPL = not na(_pndRawPL) and (na(_pndRawPL[1]) or _pndRawPL != _pndRawPL[1])
_pndNewPHprice := _pndIsNewPH ? _pndRawPH : na
_pndNewPLprice := _pndIsNewPL ? _pndRawPL : na
_pndNewPHbar   := _pndIsNewPH ? bar_index : na
_pndNewPLbar   := _pndIsNewPL ? bar_index : na
// v17.79.0: anchor the AUTHORITATIVE H4 pivot timestamp (from the security call),
// NOT the chart bar time. This is the value used for time-based pruning below so
// the window is timeframe-agnostic.
_pndNewPHtime  := _pndIsNewPH ? _pndRawPHt : na
_pndNewPLtime  := _pndIsNewPL ? _pndRawPLt : na

// Rolling stores of recent pivots (pruned to the lookback window; front = oldest)
var array<float> _pndPhP = array.new_float()
var array<int>   _pndPhB = array.new_int()
var array<int>   _pndPhT = array.new_int()
var array<float> _pndPlP = array.new_float()
var array<int>   _pndPlB = array.new_int()
var array<int>   _pndPlT = array.new_int()

if not na(_pndNewPHprice)
    array.push(_pndPhP, _pndNewPHprice)
    array.push(_pndPhB, _pndNewPHbar)
    array.push(_pndPhT, _pndNewPHtime)
if not na(_pndNewPLprice)
    array.push(_pndPlP, _pndNewPLprice)
    array.push(_pndPlB, _pndNewPLbar)
    array.push(_pndPlT, _pndNewPLtime)

// v17.79.0 TIME-BASED PRUNING: keep pivots whose AUTHORITATIVE H4 timestamp is
// within pndLookback H4-bars-worth of wall-clock time from the current bar. Because
// this measures elapsed TIME (ms) rather than chart bar_index, the surviving pivot
// set is identical on M5, M15, H1 and H4 (1 H4 bar = 240 min). This is what keeps
// the M5 P&D anchors 1:1 with the H4 anchors.
int _pndLookbackMs = pndLookback * 240 * 60 * 1000
f_pndPrune(array<float> _p, array<int> _b, array<int> _t) =>
    while array.size(_t) > 0 and not na(array.get(_t, 0)) and (time - array.get(_t, 0)) > _pndLookbackMs
        array.shift(_p)
        array.shift(_b)
        array.shift(_t)
f_pndPrune(_pndPhP, _pndPhB, _pndPhT)
f_pndPrune(_pndPlP, _pndPlB, _pndPlT)

// Resolve swing high (max pivot high) / swing low (min pivot low) + anchors
float pndSwingHigh    = na
float pndSwingLow     = na
int   pndSwingHighBar = na
int   pndSwingLowBar  = na
int   pndSwingHighTs  = na
int   pndSwingLowTs   = na
if array.size(_pndPhP) > 0
    pndSwingHigh    := array.max(_pndPhP)
    int _pndIh      = array.indexof(_pndPhP, pndSwingHigh)
    pndSwingHighBar := array.get(_pndPhB, _pndIh)
    pndSwingHighTs  := array.get(_pndPhT, _pndIh)
if array.size(_pndPlP) > 0
    pndSwingLow     := array.min(_pndPlP)
    int _pndIl      = array.indexof(_pndPlP, pndSwingLow)
    pndSwingLowBar  := array.get(_pndPlB, _pndIl)
    pndSwingLowTs   := array.get(_pndPlT, _pndIl)

// Equilibrium + validity (identical to the harness)
bool  pndHaveSwings = not na(pndSwingHigh) and not na(pndSwingLow) and pndSwingHigh > pndSwingLow
float pndRng        = pndHaveSwings ? (pndSwingHigh - pndSwingLow) : na
float pndAmpPct     = pndHaveSwings and pndSwingLow != 0 ? (pndRng / pndSwingLow * 100.0) : na
bool  pndValid      = pndHaveSwings and pndAmpPct >= pndMinAmpPct
bool  pndActive     = usePndVerifiedRange and pndValid

// ============================================================================
// v17.84.4: H4 ACTIVE DEALING RANGE RESOLVER — INPUTS
// ============================================================================
grpH4Active         = "🎯 v17.84.4 H4 Active Dealing Range"
h4AnchorMode        = input.string("Active Leg", "H4 P&D Anchor Mode", options=["Active Leg", "Structural Phase", "Verified Pivot Extremes"], group=grpH4Active)
h4ActiveMaxAgeBars  = input.int(60, "Active: Max Anchor Age (H4 bars)", minval=1, group=grpH4Active)
h4ActiveMaxATR      = input.float(12.0, "Active: Max Range Size (ATR mult, 0=off)", minval=0.0, step=0.5, group=grpH4Active)
h4ActiveMaxPct      = input.float(15.0, "Active: Max Range Size (% of price, 0=off)", minval=0.0, step=0.5, group=grpH4Active)
showH4ActiveDebug   = input.bool(false, "Show Structural Leg Engine Debug Table", group=grpH4Active)

// ============================================================================
// v17.84.4: H4 ACTIVE DEALING RANGE RESOLVER — SELECTION LOGIC
// ----------------------------------------------------------------------------
// Reuses the confirmed-pivot stores (_pndPhP/_pndPhT/_pndPlP/_pndPlT) built above
// from request.security("240", ta.pivothigh/low, lookahead_off). Selects the
// FRESHEST confirmed pivot high + FRESHEST confirmed pivot low (the most recent
// opposite pair bracketing the active leg) — deliberately NOT array.max()/min()
// over the whole window — then applies stale + oversize guards.
// ============================================================================
float  h4_activeRangeHigh      = na
float  h4_activeRangeLow       = na
float  h4_activeRangeEQ        = na
int    h4_activeAnchorHighTime = array.size(_pndPhT) > 0 ? array.get(_pndPhT, array.size(_pndPhT) - 1) : na
int    h4_activeAnchorLowTime  = array.size(_pndPlT) > 0 ? array.get(_pndPlT, array.size(_pndPlT) - 1) : na
string h4_activeAnchorReason   = "warm-up: waiting for a confirmed H4 swing pair"
bool   h4_activeRangeValid     = false
bool   h4_activeStale          = false
bool   h4_activeOversize       = false
float  h4_activeAgeBars        = na

float _actPH = array.size(_pndPhP) > 0 ? array.get(_pndPhP, array.size(_pndPhP) - 1) : na
float _actPL = array.size(_pndPlP) > 0 ? array.get(_pndPlP, array.size(_pndPlP) - 1) : na

if not na(_actPH) and not na(_actPL) and _actPH > _actPL
    float _olderTs   = math.min(nz(h4_activeAnchorHighTime, time), nz(h4_activeAnchorLowTime, time))
    h4_activeAgeBars := (time - _olderTs) / (240.0 * 60.0 * 1000.0)
    h4_activeStale   := h4_activeAgeBars > h4ActiveMaxAgeBars
    float _actRng    = _actPH - _actPL
    float _atrCap    = h4ActiveMaxATR > 0 and not na(h4ATR) ? h4ATR * h4ActiveMaxATR : na
    float _pctCap    = h4ActiveMaxPct > 0 and _actPL != 0  ? _actPL * (h4ActiveMaxPct / 100.0) : na
    bool  _tooBigATR = not na(_atrCap) and _actRng > _atrCap
    bool  _tooBigPct = not na(_pctCap) and _actRng > _pctCap
    h4_activeOversize := _tooBigATR or _tooBigPct
    if not h4_activeStale and not h4_activeOversize
        h4_activeRangeHigh  := _actPH
        h4_activeRangeLow   := _actPL
        h4_activeRangeEQ    := (_actPH + _actPL) / 2.0
        h4_activeRangeValid := true
        h4_activeAnchorReason := "Active Leg: freshest confirmed H4 swing pair (PH " + str.tostring(_actPH, format.mintick) + " / PL " + str.tostring(_actPL, format.mintick) + ")"
    else
        h4_activeAnchorReason := h4_activeStale ? ("REJECTED stale: age " + str.tostring(h4_activeAgeBars, "#.0") + " > " + str.tostring(h4ActiveMaxAgeBars) + " H4 bars") : ("REJECTED oversize: range " + str.tostring(_actRng, format.mintick) + (_tooBigATR ? " > ATR cap" : "") + (_tooBigPct ? " > % cap" : ""))

// ============================================================================
// v17.85.0: STRUCTURAL LEG ENGINE — SINGLE DETERMINISTIC DEALING-RANGE AUTHORITY
// ----------------------------------------------------------------------------
// A finite state machine that TRACKS one active structural leg (institutional
// dealing range) instead of INFERRING it from collections of pivots. It replaces
// the competing resolvers (verified-pivot, active-leg, structural-phase, pivot
// arrays, rolling windows, BOS-anchored) as the SOLE authority: after the first
// confirmed BOS it always wins; the legacy chain below is warm-up fallback only.
//
// STATES: 0 Waiting · 1 Bull Leg Active · 2 Bear Leg Active.
//   • Origin is IMMUTABLE — assigned once at the flip zone (bos_lastPL for a bull
//     leg / bos_lastPH for a bear leg) and NEVER moved by pivots, HH/LL, sweeps,
//     ATR, nested/internal BOS or rescans. Only a state transition creates a new
//     origin.
//   • Extreme EXPANDS only, outward: bull leg high := max(high); bear leg low :=
//     min(low). Retracements and internal pivots are ignored.
//   • Protected swing (last HL in a bull leg / last LH in a bear leg) is the ONLY
//     level whose confirmed break — together with an opposite-direction BOS/CHoCH
//     — may invalidate the leg and trigger a transition. Before the first protected
//     swing prints, the immutable origin serves as the protection level.
// It consumes the ONE standardized BOS signal (bosBull / bosBear on confirmed H4
// closes, request.security "240" lookahead_off) — no second BOS implementation.
// Outputs activeRangeHigh / activeRangeLow are the single source of truth; every
// downstream module (Premium, Discount, EQ, HUD, Macro Bias/Location, Arch Trace,
// Executive Brief, webhook, alerts, blockers) reads them read-only.
// ============================================================================
var int    slState              = 0    // 0 waiting · 1 bull leg · 2 bear leg
var float  slOriginLow          = na   // bull leg origin (immutable flip-zone low)
var float  slOriginHigh         = na   // bear leg origin (immutable flip-zone high)
var float  slExtremeHigh        = na   // bull leg expanding structural high
var float  slExtremeLow         = na   // bear leg expanding structural low
var float  slProtectedHL        = na   // bull leg protected higher low
var float  slProtectedLH        = na   // bear leg protected lower high
var int    slOriginTime         = na   // chart time the current origin was fixed
var int    slLastTransitionTime = na   // chart time of the last state transition
var string slReason             = "Waiting: no confirmed BOS yet"
var string slLastEvent          = "none"

// ============================================================================
// v17.85.10: TRANSITION SNAPSHOT (debug-only — latched historical diagnostics)
// These var's are written ONCE, at the exact moment of INIT Bull / INIT Bear /
// RESET Bull→Bear / RESET Bear→Bull, then never recalculated. They capture the
// frozen state of that leg's birth so the debug table shows what ACTUALLY
// happened at the transition bar, not a live re-derivation. They feed NO signal,
// range, alert, webhook or trading logic — pure diagnostics.
// ============================================================================
var int    dbgSnapTime      = na    // Transition Time (closed H4 bar that fired the leg)
var int    dbgSnapPrevState = na    // Previous FSM state
var int    dbgSnapNewState  = na    // New FSM state
var string dbgSnapTrigger   = "—"   // Trigger Type (INIT / Bullish BOS / Bearish BOS / reset)
var float  dbgSnapTrigClose = na    // Trigger Close — the confirmed H4 close that validated it
var float  dbgSnapBrokenLvl = na    // Broken Structure Level — the pivot considered broken
var float  dbgSnapPrevProt  = na    // Previous Protected HL/LH — why the OLD leg was invalidated
var int    dbgSnapMethod    = na    // Origin Method at Latch (1 bounded · 3 BOS pivot · 4 warm-up)
var float  dbgSnapBoundPx   = na    // Boundary Start Price (parent structural high/low)
var int    dbgSnapBoundTime = na    // Boundary Start Time
var int    dbgSnapScanLen   = na    // Scan Length at Latch (H4 bars examined)
var float  dbgSnapCandidate = na    // Resolved Candidate Origin returned by the resolver
var float  dbgSnapLatched   = na    // Latched Origin — what actually became slOriginLow/High
var float  dbgSnapH4Ext     = na    // H4 Extreme at Latch — initial opposite edge of new range

// v17.85.61: Protection threshold — use the MOST RECENT confirmed H4 swing pivot
// as the primary gate, falling back to the protected intra-leg swing (if one has
// been set by a continuation BOS), then to the immutable macro origin as a last
// resort. Root-cause of USDJPY deadlock: old code used slOriginHigh (~163.78) as
// the bear-leg gate. Since no continuation bear BOS fired, slProtectedLH stayed
// na, and slBearProtLevel stayed at 163.78 permanently — a level price at ~159
// can never cross. Using bos_lastPH (~160.000, the Aug 13-15 confirmed H4 swing
// high) instead brings the gate within the achievable range of current price.
// v17.85.63: The flip gate is the leg ORIGIN edge. Once a leg is established the
// origin is authoritative — an internal retracement pivot can NEVER retire it.
// The pivot / protected-swing / current-H4 fallbacks apply ONLY during warm-up,
// before an origin has been latched (slOriginLow/High still na).
float slBullProtLevel = not na(slProtectedHL) ? slProtectedHL : nz(slOriginLow,  not na(bos_lastPL) ? bos_lastPL : bosH4Low)
float slBearProtLevel = not na(slProtectedLH) ? slProtectedLH : nz(slOriginHigh, not na(bos_lastPH) ? bos_lastPH : bosH4High)

// v17.85.61: Transition conditions — OR semantics so either a confirmed structural
// BOS event (bosBull / bosBear) OR a confirmed close beyond the updated protection
// threshold fires the leg retirement. Including slState==0 ensures a cold-start
// on the first bar works regardless of which direction forms first.
// The old AND semantics blocked the bear→bull transition because even when bosBull
// fired (~close above 160.000), the second clause bosH4Close > slBearProtLevel
// (~163.78) failed — a double-guard that created a permanent deadlock.
// v17.85.63: Origin-edge-only retirement. The internal-CHoCH OR-clause (bosBull /
// bosBear) is REMOVED so that a retracement pivot inside the range can never flip
// the leg. A leg retires ONLY on a confirmed H4 close beyond its origin edge.
bool slBullToBear = (slState == 1 or slState == 0) and bosBear and not na(bosH4Close) and not na(slBullProtLevel) and bosH4Close < slBullProtLevel
bool slBearToBull = (slState == 2 or slState == 0) and bosBull and not na(bosH4Close) and not na(slBearProtLevel) and bosH4Close > slBearProtLevel

if slState == 0
    // WAITING → first confirmed BOS establishes the first structural leg.
    if bosBull
        slState              := 1
        slOriginLow          := nz(bosBoundedLow, nz(bos_lastPL, bosH4Low))   // bounded impulse base, not the confirmation pivot
        slOriginTime         := time
        slExtremeHigh        := bosH4High   // v17.85.64: seed from THIS bar's confirmed high only (no stale bos_lastPH)
        slProtectedHL        := na
        slLastTransitionTime := time
        slLastEvent          := "INIT Bull"
        slReason             := "Bull leg established @ flip low " + str.tostring(slOriginLow, format.mintick)
        // v17.85.10 latch snapshot — INIT Bull (0 → 1)
        dbgSnapTime      := time
        dbgSnapPrevState := 0
        dbgSnapNewState  := 1
        dbgSnapTrigger   := "INIT · Bullish BOS"
        dbgSnapTrigClose := bosH4Close
        dbgSnapBrokenLvl := bos_lastPH        // bullish BOS broke this confirmed swing high
        dbgSnapPrevProt  := na                // no prior leg
        dbgSnapMethod    := bosMethodBull
        dbgSnapBoundPx   := bosBoundPxBull
        dbgSnapBoundTime := bosBoundTimeBull
        dbgSnapScanLen   := bosScanBull
        dbgSnapCandidate := bosBoundedLow
        dbgSnapLatched   := slOriginLow
        dbgSnapH4Ext     := slExtremeHigh
    else if bosBear
        slState              := 2
        slOriginHigh         := nz(bosBoundedHigh, nz(bos_lastPH, bosH4High))  // bounded impulse base, not the confirmation pivot
        slOriginTime         := time
        slExtremeLow         := bosH4Low    // v17.85.64: seed from THIS bar's confirmed low only (no stale bos_lastPL)
        slProtectedLH        := na
        slLastTransitionTime := time
        slLastEvent          := "INIT Bear"
        slReason             := "Bear leg established @ flip high " + str.tostring(slOriginHigh, format.mintick)
        // v17.85.10 latch snapshot — INIT Bear (0 → 2)
        dbgSnapTime      := time
        dbgSnapPrevState := 0
        dbgSnapNewState  := 2
        dbgSnapTrigger   := "INIT · Bearish BOS"
        dbgSnapTrigClose := bosH4Close
        dbgSnapBrokenLvl := bos_lastPL        // bearish BOS broke this confirmed swing low
        dbgSnapPrevProt  := na                // no prior leg
        dbgSnapMethod    := bosMethodBear
        dbgSnapBoundPx   := bosBoundPxBear
        dbgSnapBoundTime := bosBoundTimeBear
        dbgSnapScanLen   := bosScanBear
        dbgSnapCandidate := bosBoundedHigh
        dbgSnapLatched   := slOriginHigh
        dbgSnapH4Ext     := slExtremeLow
else if slState == 1
    if slBullToBear
        // TRANSITION Bull → Bear: freeze old leg, open a new bear leg at the flip high.
        slState              := 2
        // v17.85.62: Anchor new bear leg to the EXTREME of the completed bull leg.
        // slExtremeHigh = structural maximum H4 close accumulated across the entire bull
        // leg. Guaranteed non-na at RESET (leg ran ≥1 bar). Fall back to bounded impulse
        // origin only if no prior bull leg exists.
        slOriginHigh         := not na(slExtremeHigh) ? slExtremeHigh : nz(bosBoundedHigh, nz(bos_lastPH, bosH4High))
        slOriginTime         := time
        slExtremeLow         := bosH4Low    // v17.85.64: seed from THIS bar's confirmed low only (no stale bos_lastPL)
        // v17.85.10 latch snapshot — RESET Bull→Bear (1 → 2). Captured BEFORE the
        // protected levels are reset below so the OLD protected HL is preserved.
        dbgSnapTime      := time
        dbgSnapPrevState := 1
        dbgSnapNewState  := 2
        dbgSnapTrigger   := "RESET · Protected-Swing Break (Bearish CHoCH)"
        dbgSnapTrigClose := bosH4Close
        dbgSnapBrokenLvl := slBullProtLevel   // the protected HL that was broken
        dbgSnapPrevProt  := slProtectedHL     // old bull-leg protected HL (why it invalidated)
        dbgSnapMethod    := bosMethodBear
        dbgSnapBoundPx   := bosBoundPxBear
        dbgSnapBoundTime := bosBoundTimeBear
        dbgSnapScanLen   := bosScanBear
        dbgSnapCandidate := bosBoundedHigh
        dbgSnapLatched   := slOriginHigh
        dbgSnapH4Ext     := slExtremeLow
        slProtectedLH        := na
        slProtectedHL        := na
        slLastTransitionTime := time
        slLastEvent          := "RESET Bull→Bear"
        slReason             := "RESET → Bear: protected HL " + str.tostring(slBullProtLevel, format.mintick) + " broken + bearish CHoCH"
    else
        // CONTINUATION: origin frozen, extreme expands outward only — from CLOSED H4.
        slExtremeHigh := na(slExtremeHigh) ? bosH4High : math.max(slExtremeHigh, bosH4High)
        // A bullish continuation BOS confirms a new HH → the defended pivot low
        // (bos_lastPL) becomes the protected higher low.
        if bosBull and not na(bos_lastPL) and (na(slProtectedHL) or bos_lastPL > slProtectedHL) and bos_lastPL > slOriginLow
            slProtectedHL := bos_lastPL
            slLastEvent   := "Bull continuation → protected HL " + str.tostring(bos_lastPL, format.mintick)
else if slState == 2
    if slBearToBull
        // TRANSITION Bear → Bull: freeze old leg, open a new bull leg at the flip low.
        slState              := 1
        // v17.85.62: Anchor new bull leg to the EXTREME of the completed bear leg.
        // slExtremeLow = structural minimum H4 close accumulated across the entire bear
        // leg (e.g. 155.200 on USDJPY Aug 5). Guaranteed non-na at RESET (leg ran ≥1
        // bar). Fall back to bounded impulse origin only if no prior bear leg exists.
        slOriginLow          := not na(slExtremeLow) ? slExtremeLow : nz(bosBoundedLow, nz(bos_lastPL, bosH4Low))
        slOriginTime         := time
        slExtremeHigh        := bosH4High   // v17.85.64: seed from THIS bar's confirmed high only (no stale bos_lastPH)
        // v17.85.10 latch snapshot — RESET Bear→Bull (2 → 1). Captured BEFORE the
        // protected levels are reset below so the OLD protected LH is preserved.
        dbgSnapTime      := time
        dbgSnapPrevState := 2
        dbgSnapNewState  := 1
        dbgSnapTrigger   := "RESET · Protected-Swing Break (Bullish CHoCH)"
        dbgSnapTrigClose := bosH4Close
        dbgSnapBrokenLvl := slBearProtLevel   // the protected LH that was broken
        dbgSnapPrevProt  := slProtectedLH     // old bear-leg protected LH (why it invalidated)
        dbgSnapMethod    := bosMethodBull
        dbgSnapBoundPx   := bosBoundPxBull
        dbgSnapBoundTime := bosBoundTimeBull
        dbgSnapScanLen   := bosScanBull
        dbgSnapCandidate := bosBoundedLow
        dbgSnapLatched   := slOriginLow
        dbgSnapH4Ext     := slExtremeHigh
        slProtectedHL        := na
        slProtectedLH        := na
        slLastTransitionTime := time
        slLastEvent          := "RESET Bear→Bull"
        slReason             := "RESET → Bull: protected LH " + str.tostring(slBearProtLevel, format.mintick) + " broken + bullish CHoCH"
    else
        // CONTINUATION: origin frozen, extreme expands outward only — from CLOSED H4.
        slExtremeLow := na(slExtremeLow) ? bosH4Low : math.min(slExtremeLow, bosH4Low)
        if bosBear and not na(bos_lastPH) and (na(slProtectedLH) or bos_lastPH < slProtectedLH) and bos_lastPH < slOriginHigh
            slProtectedLH := bos_lastPH
            slLastEvent   := "Bear continuation → protected LH " + str.tostring(bos_lastPH, format.mintick)

// Authoritative dealing range — the SINGLE source of truth.
float activeRangeHigh = na
float activeRangeLow  = na
if slState == 1
    activeRangeLow  := slOriginLow
    activeRangeHigh := slExtremeHigh
else if slState == 2
    activeRangeHigh := slOriginHigh
    activeRangeLow  := slExtremeLow
float activeRangeEQ = not na(activeRangeHigh) and not na(activeRangeLow) ? (activeRangeHigh + activeRangeLow) / 2.0 : na
bool  slRangeValid  = not na(activeRangeHigh) and not na(activeRangeLow) and activeRangeHigh > activeRangeLow

// ============================================================================
// v17.85.60: FSM RETIREMENT — PIVOT-DIRECTION MISMATCH DETECTION
// ============================================================================
// ROOT CAUSE: The FSM only retires its macro origin on a confirmed opposite CHoCH
// (a close beyond the protected level). On USDJPY/GBPJPY the July→Aug crash and
// subsequent rally never triggered that CHoCH, so slState stayed in the old Bear
// Leg with slOriginHigh ≈ 164 and slExtremeLow ≈ 155, while price recovered to
// ~160. The v17.85.27 _pdPeakH peak-anchor then accumulated every high on the way
// up, expanding pdVizTop to ~164 and stranding the box above price.
//
// FIX (deterministic, non-repainting — NO FSM writes, NO slOrigin changes):
//   1. Detect staleness DIRECTLY: the last CONFIRMED H4 close (bosH4Close, from
//      request.security "240" lookahead_off) is outside the tracked leg range.
//      This is objective — no guessing about why the CHoCH didn't fire.
//   2. When stale (or slRangeValid is false), promote to the FRESHEST confirmed
//      H4 swing pair: _actPH / _actPL — the most recent opposite confirmed pivots
//      (already computed above by the Active-Leg resolver; last array element, NOT
//      array.max/min over the whole window).  On USDJPY this pair is ~155.2 → ~160;
//      EQ ≈ 157.6 — exactly the target spec.
//   3. Pairs whose FSM leg still contains the confirmed close are left untouched
//      (no promotion) → no regression on correctly-tracking pairs.
//   slOriginHigh/Low are NEVER written here → FSM write sites stay exactly 4.
// v17.85.60 FIX: Replace close-outside stale check with pivot-direction mismatch.
//   The v59 check (bosH4Close > activeRangeHigh OR < activeRangeLow) NEVER fires
//   when price sits inside a wide stale range (e.g. 155.2→164 on USDJPY), because
//   price at ~159.3 is inside that range. The correct signal is: FSM says Bear
//   (slState==2) but the most recent confirmed H4 pivot is a HIGH — direction
//   reversed. Similarly, FSM says Bull (slState==1) but the freshest pivot is a LOW.
bool   _actPairValid   = not na(_actPH) and not na(_actPL) and _actPH > _actPL
bool   _actHighIsNewer = not na(h4_activeAnchorHighTime) and not na(h4_activeAnchorLowTime) and h4_activeAnchorHighTime > h4_activeAnchorLowTime
bool   _actLowIsNewer  = not na(h4_activeAnchorHighTime) and not na(h4_activeAnchorLowTime) and h4_activeAnchorLowTime  > h4_activeAnchorHighTime
bool   _slMismatch     = (slState == 2 and _actHighIsNewer) or (slState == 1 and _actLowIsNewer)
string _slPromo        = "FSM structural leg (current)"
// v17.85.63: A valid FSM structural leg is the SOLE authority. A pivot-direction
// "mismatch" (freshest confirmed pivot opposing the leg) is a RETRACEMENT inside
// the range — it must NOT pull activeRangeHigh/Low in to the retracement pivot.
// Promotion to the freshest H4 pivot pair now fires ONLY during warm-up, when no
// valid leg exists yet (slRangeValid == false). _slMismatch is retained purely as
// a diagnostic on the held leg.
if (not slRangeValid) and _actPairValid
    activeRangeHigh := _actPH
    activeRangeLow  := _actPL
    activeRangeEQ   := (_actPH + _actPL) / 2.0
    slRangeValid    := true
    _slPromo := "v63 warm-up fallback → freshest H4 pair: " + str.tostring(_actPL, format.mintick) + " → " + str.tostring(_actPH, format.mintick)
else if slRangeValid
    _slPromo := _slMismatch ? "FSM structural leg (retracement inside range — held)" : "FSM structural leg (current)"

float slAgeH4Bars   = not na(slOriginTime) ? (time - slOriginTime) / (240.0 * 60.0 * 1000.0) : na

// v17.85.22a: Provisional recovery-level scalars (Part B qualifier uses these).
float slBearRecLvl = slState == 2 and slRangeValid ? activeRangeLow  + (activeRangeHigh - activeRangeLow) * 0.618 : na
float slBullRecLvl = slState == 1 and slRangeValid ? activeRangeHigh - (activeRangeHigh - activeRangeLow) * 0.618 : na

// SINGLE OVERRIDE POINT for h4RangeHigh / h4RangeLow.
// v17.78.0: PRIORITY 1 = the VERIFIED pivot-swing range (harness logic). When it
// is valid + enabled it is authoritative for EVERY subsystem (P&D shading, EQ
// line, HUD Location row, System 'Still in Premium/Discount' blockers, webhook).
// PRIORITY 2 = the structural dealing-range engine when the Dealing Range Lock is
// ON and a structural range exists. PRIORITY 3 = the legacy BOS-anchored range.
// The debug label reads the same predicates so it can never disagree.
// v17.81.1 STAGE B PART A: STRUCTURAL LEG RANGE PROMOTED TO AUTHORITATIVE.
// PRIORITY 1 is now the frozen structural dealing range (f_updateRange, locked)
// which is anchored to the BOS/CHoCH origin + displacement extreme and can never
// ratchet inward on a pullback. The rolling Verified Pivot-Swing range is DEMOTED
// to a fallback (PRIORITY 2), used only when no structural range exists yet. This
// is the fix for the rolling-pivot 'squeeze' / false 'Still in Premium' defect.
// v17.84.2 — VIDEO-ACCURATE STRUCTURAL-LEG ANCHOR (reverts v17.84.1 absolute-swing):
// Per the SMC methodology (The Trading Geek, "Premium & Discount"), the dealing
// range must anchor to the STRUCTURAL LEG that produced a Break of Structure — the
// most relevant recent swing high/low of the current impulsive wave — NOT to the
// absolute historical high/low over a fixed lookback (the instructor explicitly
// warns against the absolute-extreme approach). Therefore the AUTHORITATIVE range
// is the frozen structural dealing range (f_updateRange): it REBUILDS only on a
// confirmed opposite-direction H4 BOS (a CHoCH — a genuine break of structure) and
// EXTENDS its leading edge only on a continuation BOS (a new HH in an uptrend / a
// new LL in a downtrend). It never ratchets inward on a minor pullback pivot, so
// there is no "range squeeze". The rolling absolute-swing range (pndSwingHigh/Low)
// is DEMOTED to a fallback, used only when no structural leg exists yet.
// v17.84.3 — PRIORITY 0 (PERMANENT AUTHORITATIVE): the STRUCTURAL-LEG range
// (origin frozen at the supply/demand start + running flip extreme). This is the
// user's canonical formula and is ALWAYS preferred when a valid leg exists — it
// is deliberately NOT gated behind the structuralRangeFirst / lockDealingRange
// toggles so the on-chart P&D always maps the true supply→demand (or demand→
// supply) leg. The legacy sources below remain only as ordered fallbacks for the
// warm-up period before the first confirmed H4 CHoCH establishes a leg.
// v17.84.4 — ANCHOR-MODE BRIDGE. The "H4 P&D Anchor Mode" input selects which
// range is authoritative; each mode still falls through the ordered chain below
// when its own range is not yet valid (warm-up).
//   • Active Leg (default)      → h4_activeRange* from the resolver above.
//   • Verified Pivot Extremes   → pndSwing max/min range (v17.81.1).
//   • Structural Phase / default → the structural-leg range (v17.84.3) chain.
// v17.85.0 — PRIORITY 0 (SOLE AUTHORITY): the Structural Leg Engine. Once a leg
// exists (slRangeValid) it is ALWAYS authoritative and NOT gated behind any
// toggle. The entire chain below runs ONLY during warm-up (before the first
// confirmed BOS), so the competing resolvers can never override the tracked leg.
bool _modeActive = h4AnchorMode == "Active Leg"            and h4_activeRangeValid
bool _modePivot  = h4AnchorMode == "Verified Pivot Extremes" and pndActive
if slRangeValid
    h4RangeHigh := activeRangeHigh
    h4RangeLow  := activeRangeLow
    rangeSrc    := slReason
else if _modeActive
    h4RangeHigh := h4_activeRangeHigh
    h4RangeLow  := h4_activeRangeLow
    rangeSrc    := h4_activeAnchorReason
else if _modePivot
    h4RangeHigh := pndSwingHigh
    h4RangeLow  := pndSwingLow
    rangeSrc    := "Verified Pivot Extremes (mode v17.84.4)"
else if legRangeValid
    h4RangeHigh := legRangeHigh
    h4RangeLow  := legRangeLow
    rangeSrc    := macroTrend == -1 ? "Structural Leg ▼ Supply→Demand (v17.84.3)" : "Structural Leg ▲ Demand→Supply (v17.84.3)"
else if structuralRangeFirst and lockDealingRange and dealingRangeValid
    h4RangeHigh := dealingRangeHigh
    h4RangeLow  := dealingRangeLow
    // rangeSrc is kept as the structural source string set by f_updateRange
    // (e.g. "Confirmed H4 CHoCH ▲ (rebuilt)") so the debug label reflects it.
else if pndActive
    h4RangeHigh := pndSwingHigh
    h4RangeLow  := pndSwingLow
    rangeSrc    := "Verified Pivot Swing (fallback v17.81.1)"
else if lockDealingRange and dealingRangeValid
    h4RangeHigh := dealingRangeHigh
    h4RangeLow  := dealingRangeLow
else if bosRangeValid
    h4RangeHigh := bosRangeHigh
    h4RangeLow  := bosRangeLow

// Keep the BOS-range visual + webhook fields aligned to the same source of truth
// so the "BOS ▲ EQ" label / webhook can never disagree with the yellow EQ line.
// v17.81.1 PART A: mirror the promoted priority — structural leg range first.
// v17.84.2: reverts the v17.84.1 absolute-swing lead. The structural leg range is
// authoritative here too, so the BOS EQ label / webhook agree with the video-
// accurate on-chart range. The absolute pivot-swing range is the fallback.
// v17.84.3: mirror Priority 0 — the structural-leg range is authoritative here too
// so the BOS EQ label / webhook agree with the on-chart supply→demand leg.
// v17.84.4: mirror the anchor-mode selection so the BOS EQ label / webhook can
// never disagree with the on-chart P&D range chosen by the mode.
// v17.85.0: PRIORITY 0 — mirror the Structural Leg Engine so the BOS EQ label /
// webhook agree with the tracked dealing range whenever a leg is active.
if slRangeValid
    bosRangeHigh := activeRangeHigh
    bosRangeLow  := activeRangeLow
    bosRangeValid := true
else if _modeActive
    bosRangeHigh := h4_activeRangeHigh
    bosRangeLow  := h4_activeRangeLow
    bosRangeValid := true
else if _modePivot
    bosRangeHigh := pndSwingHigh
    bosRangeLow  := pndSwingLow
    bosRangeValid := true
else if legRangeValid
    bosRangeHigh := legRangeHigh
    bosRangeLow  := legRangeLow
    bosRangeValid := true
else if structuralRangeFirst and lockDealingRange and dealingRangeValid
    bosRangeHigh := dealingRangeHigh
    bosRangeLow  := dealingRangeLow
    bosRangeValid := true
else if pndActive
    bosRangeHigh := pndSwingHigh
    bosRangeLow  := pndSwingLow
    bosRangeValid := true
else if lockDealingRange and dealingRangeValid
    bosRangeHigh := dealingRangeHigh
    bosRangeLow  := dealingRangeLow
    bosRangeValid := true

float bosRangeEq = bosRangeValid ? (bosRangeHigh + bosRangeLow) / 2.0 : na

// ============================================================================
// v17.84.4: H4 ACTIVE RESOLVER DEBUG TABLE (bottom-right, default OFF)
// ============================================================================
f_h4ActCell(table _t, int _r, string _k, string _v, color _vc) =>
    table.cell(_t, 0, _r, _k, text_size=size.small, text_color=color.new(color.white, 0), bgcolor=color.new(color.black, 10), text_halign=text.align_left)
    table.cell(_t, 1, _r, _v, text_size=size.small, text_color=_vc, bgcolor=color.new(color.black, 10), text_halign=text.align_left)
var table _h4ActTbl = na
if showH4ActiveDebug
    if na(_h4ActTbl)
        _h4ActTbl := table.new(position.bottom_right, 2, 27, border_width=1, border_color=color.new(color.gray, 40))
    if barstate.islast
        string _stateStr = slState == 1 ? "1 · BULL LEG" : slState == 2 ? "2 · BEAR LEG" : "0 · WAITING"
        color  _stateC   = slState == 1 ? color.lime : slState == 2 ? color.red : color.gray
        float  _protLvl  = slState == 1 ? slBullProtLevel : slState == 2 ? slBearProtLevel : na
        float  _origin   = slState == 1 ? slOriginLow : slState == 2 ? slOriginHigh : na
        float  _extreme  = slState == 1 ? slExtremeHigh : slState == 2 ? slExtremeLow : na
        f_h4ActCell(_h4ActTbl, 0,  "STRUCTURAL LEG ENGINE", "v17.85.19",                                                               _stateC)
        f_h4ActCell(_h4ActTbl, 1,  "State",               _stateStr,                                                                   _stateC)
        string _origLbl = slState == 1 ? "Origin=ImpulseBaseLow" : slState == 2 ? "Origin=ImpulseBaseHigh" : "Origin (immutable)"
        f_h4ActCell(_h4ActTbl, 2,  _origLbl,              not na(_origin)  ? str.tostring(_origin,  format.mintick) : "—",             color.orange)
        f_h4ActCell(_h4ActTbl, 3,  "Extreme (expanding)", not na(_extreme) ? str.tostring(_extreme, format.mintick) : "—",             color.teal)
        f_h4ActCell(_h4ActTbl, 4,  "Protected Swing",     not na(_protLvl) ? str.tostring(_protLvl, format.mintick) : "—",             color.fuchsia)
        f_h4ActCell(_h4ActTbl, 5,  "activeRangeHigh",     not na(activeRangeHigh) ? str.tostring(activeRangeHigh, format.mintick) : "—", color.white)
        f_h4ActCell(_h4ActTbl, 6,  "activeRangeLow",      not na(activeRangeLow)  ? str.tostring(activeRangeLow,  format.mintick) : "—", color.white)
        f_h4ActCell(_h4ActTbl, 7,  "activeRangeEQ",       not na(activeRangeEQ)   ? str.tostring(activeRangeEQ,   format.mintick) : "—", color.yellow)
        f_h4ActCell(_h4ActTbl, 8,  "Origin Time",         not na(slOriginTime) ? str.format_time(slOriginTime, "yyyy-MM-dd HH:mm", "UTC") : "—", color.silver)
        f_h4ActCell(_h4ActTbl, 9,  "Leg Age (H4 bars)",   not na(slAgeH4Bars) ? str.tostring(slAgeH4Bars, "#.0") : "—",                color.white)
        f_h4ActCell(_h4ActTbl, 10, "Last Event",          slLastEvent,                                                                 color.aqua)
        f_h4ActCell(_h4ActTbl, 11, "Reason / Source",     slReason,                                                                    color.silver)
        // ====================================================================
        // v17.85.10: LATCHED TRANSITION SNAPSHOT — frozen at the leg's birth bar.
        // Every value below was captured ONCE at INIT/RESET and is never
        // recalculated live, so it shows what ACTUALLY happened at the transition.
        // v17.85.10 token-fix: the v17.85.9 LIVE bounded-origin rows (Origin Method / Boundary
        // Start / the misleading "Origin Boundary End" / Scan Bars / Deep Sweep / H4
        // Confirmed Extreme) were REMOVED — superseded by these latched rows (per the
        // brief: "show latched historical data, not live recalculated diagnostics")
        // and to reclaim compile tokens. The true scan-end BAR is "Boundary End Time".
        // ====================================================================
        string _snStateS = (not na(dbgSnapPrevState) ? str.tostring(dbgSnapPrevState) : "—") + " → " + (not na(dbgSnapNewState) ? str.tostring(dbgSnapNewState) : "—")
        string _snBndS   = not na(dbgSnapBoundPx) ? str.tostring(dbgSnapBoundPx, format.mintick) + (not na(dbgSnapBoundTime) ? " @ " + str.format_time(dbgSnapBoundTime, "MM-dd HH:mm", "UTC") : "") : "—"
        string _snMethS  = dbgSnapMethod == 1 ? "Bounded Impulse Base" : dbgSnapMethod == 3 ? "BOS Pivot Fallback" : dbgSnapMethod == 4 ? "Warm-up Fallback" : "—"
        bool   _snMatch  = not na(dbgSnapCandidate) and not na(dbgSnapLatched) and dbgSnapCandidate == dbgSnapLatched
        string _snMatchS = na(dbgSnapLatched) ? "—" : (_snMatch ? "PASS" : "FALLBACK (candidate≠latched)")
        f_h4ActCell(_h4ActTbl, 12, "── LATCHED SNAPSHOT ──", "@ transition",                                                            color.aqua)
        f_h4ActCell(_h4ActTbl, 13, "Transition Time",       not na(dbgSnapTime) ? str.format_time(dbgSnapTime, "yyyy-MM-dd HH:mm", "UTC") : "—", color.silver)
        f_h4ActCell(_h4ActTbl, 14, "Prev → New State",      _snStateS,                                                                 color.white)
        f_h4ActCell(_h4ActTbl, 15, "Trigger Type",          dbgSnapTrigger,                                                            color.aqua)
        f_h4ActCell(_h4ActTbl, 16, "Trigger Close",         not na(dbgSnapTrigClose) ? str.tostring(dbgSnapTrigClose, format.mintick) : "—", color.white)
        f_h4ActCell(_h4ActTbl, 17, "Broken Structure Lvl",  not na(dbgSnapBrokenLvl) ? str.tostring(dbgSnapBrokenLvl, format.mintick) : "—", color.fuchsia)
        f_h4ActCell(_h4ActTbl, 18, "Prev Protected HL/LH",  not na(dbgSnapPrevProt) ? str.tostring(dbgSnapPrevProt, format.mintick) : "—", color.fuchsia)
        f_h4ActCell(_h4ActTbl, 19, "Origin Method @ Latch", _snMethS,                                                                   dbgSnapMethod == 1 ? color.lime : color.orange)
        f_h4ActCell(_h4ActTbl, 20, "Boundary Start @ Latch", _snBndS,                                                                   color.silver)
        f_h4ActCell(_h4ActTbl, 21, "Boundary End Time",     not na(dbgSnapTime) ? str.format_time(dbgSnapTime, "yyyy-MM-dd HH:mm", "UTC") : "—", color.silver)
        f_h4ActCell(_h4ActTbl, 22, "Scan Length @ Latch",   not na(dbgSnapScanLen) ? str.tostring(dbgSnapScanLen) : "—",                color.white)
        f_h4ActCell(_h4ActTbl, 23, "Candidate Origin",      not na(dbgSnapCandidate) ? str.tostring(dbgSnapCandidate, format.mintick) : "—", color.orange)
        f_h4ActCell(_h4ActTbl, 24, "Latched Origin",        not na(dbgSnapLatched) ? str.tostring(dbgSnapLatched, format.mintick) : "—", color.orange)
        f_h4ActCell(_h4ActTbl, 25, "Match Check",           _snMatchS,                                                                  _snMatch ? color.lime : color.orange)
        f_h4ActCell(_h4ActTbl, 26, "H4 Extreme @ Latch",    not na(dbgSnapH4Ext) ? str.tostring(dbgSnapH4Ext, format.mintick) : "—",    color.teal)

// Canonical engine outputs (named per the v17.75.2 spec) — derived from the SAME
// h4RangeHigh / h4RangeLow that every subsystem consumes.
float dealingRangeMid = (h4RangeHigh + h4RangeLow) / 2.0
float premiumStart    = dealingRangeMid   // Premium = upper 50% (EQ → range high)
float discountEnd     = dealingRangeMid   // Discount = lower 50% (range low → EQ)

// Step 2: Derive equilibrium and range from (potentially adjusted) 4H values
h4Eq    = (h4RangeHigh + h4RangeLow) / 2.0
h4Range = h4RangeHigh - h4RangeLow

// Step 3: Premium & Discount zone levels (derived from the SAME dealing range)
// v17.75.2: Premium occupies exactly the UPPER 50% of the range and Discount the
// LOWER 50%, split at Equilibrium. premiumStart / discountEnd both equal EQ, so
// there is a single 50/50 boundary and no drifting neutral band. Setting the
// "Neutral Zone Width (%)" input above 0 re-introduces a symmetric EQ band around
// the midpoint for the three-way HUD classification (opt-in only).
h4PremiumTop     = h4RangeHigh
h4PremiumBottom  = premiumStart + (h4Range * neutralZoneWidth / 200.0)
h4DiscountTop    = discountEnd  - (h4Range * neutralZoneWidth / 200.0)
h4DiscountBottom = h4RangeLow

// Step 4: Get latest 4H close for bias determination
h4Close = request.security(syminfo.tickerid, "240", close, lookahead=barmerge.lookahead_off)

// Step 5a: RANGE bias — legacy range-location model (v17.54.x behavior)
// 1 = bullish (4H close above premium bottom), -1 = bearish (below discount top), 0 = neutral
int h4Bias_range = h4Close > h4PremiumBottom ? 1 : h4Close < h4DiscountTop ? -1 : 0

// Step 5b: STRUCTURAL bias — BOS swing structure model (v17.55.0)
// Computed on true H4 data via request.security with lookahead_off (no repaint)
[h4Bias_struct, h4StructSwH, h4StructSwL, h4StructFlipBar] = request.security(syminfo.tickerid, "240", f_h4_structure(structPivotLen), lookahead=barmerge.lookahead_off)

// Step 5c: Active bias wrapper — selects structural or range per user toggle
// v17.55.0: All consumers use h4ActiveBias instead of raw h4Bias
int h4ActiveBias = h4BiasMode == "STRUCTURAL" ? h4Bias_struct : h4Bias_range

// Backward-compatible alias — h4Bias now points to h4ActiveBias
// This ensures any references we may have missed still work correctly
h4Bias = h4ActiveBias

// Step 6: Zone Position Detection (v17.8 FIX — independent of bias direction)
// Uses CURRENT price vs 4H-locked zone boundaries to determine PZ/DZ/EQ
// NOTE: Zone detection always uses price vs zone boundaries, NOT structural bias
inPremiumZone  = close > h4PremiumBottom
inDiscountZone = close < h4DiscountTop
inEquilibriumZone = not inPremiumZone and not inDiscountZone
pdZone = inPremiumZone ? 1 : inDiscountZone ? 0 : -1

// Zone position string and color (purely based on price location in 4H range)
string h4ZoneStr = inPremiumZone ? "PZ (red)" : inDiscountZone ? "DZ (green)" : "EQ (gray)"

// v17.55.0: Bias direction string — reflects active bias mode
string h4DirStr = h4ActiveBias == 1 ? "BULLISH" : h4ActiveBias == -1 ? "BEARISH" : "NEUTRAL"
string h4ModeTag = h4BiasMode == "STRUCTURAL" ? "⚡" : "📊"  // visual mode indicator

// Combined display: "[MODE_ICON] [DIRECTION] | [ZONE POSITION]"
h4BiasStr = h4ModeTag + " " + h4DirStr + " | " + h4ZoneStr

// v17.10: Explicit H4 Bias neutral boolean — now based on h4ActiveBias
bool h4BiasNeutral  = h4ActiveBias == 0
bool h4BiasBullish  = h4ActiveBias == 1
bool h4BiasBearish  = h4ActiveBias == -1

// Fib level for reference (used by other components)
h4FibLevel = h4Range > 0 ? (close - h4RangeLow) / h4Range * 100 : 50.0

// =============================================================================
// v17.56.1: HTF Bias Layer — H4 Structural Bias (macro swing context)
// =============================================================================
// HTF = H4 ("240") with htfPivotLen (default 15) for major swing detection.
// This is DISPLAY ONLY — does not affect h4ActiveBias, alerts, or trading logic.
// v17.56.1 FIX 3: Changed from "D"/f_d1_structure to "240"/f_h4_structure.
// =============================================================================
[htfBias, htfSwH, htfSwL, htfFlipBar] = request.security(syminfo.tickerid, "240", f_h4_structure(htfPivotLen), lookahead=barmerge.lookahead_off)

// =============================================================================
// v17.56.1: LTF Bias Layer — M15 Structural Bias (execution timing)
// =============================================================================
// LTF = M15 ("15") with ltfPivotLen (default 5) for sensitive swing detection.
// This is DISPLAY ONLY — does not affect h4ActiveBias, alerts, or trading logic.
// v17.56.1 FIX 3: Changed from "240"/f_h4_structure(structPivotLen) to "15"/f_h4_structure(ltfPivotLen).
// v17.74.0: LTF now defaults to the responsive M15 MSS engine (f_m15_mss) so the
// LTF row flips on a single close-based structure shift instead of lagging behind
// a dual HH+HL / LL+LH confirmation. Both engines run on the SAME "15" resolution;
// useM15MssLtf selects which result feeds ltfBias. HTF (above) is unchanged (H4).
// =============================================================================
[ltfBiasMss, ltfSwHMss, ltfSwLMss, ltfFlipBarMss] = request.security(syminfo.tickerid, "15", f_m15_mss(ltfPivotLen, mssRightConfirm), lookahead=barmerge.lookahead_off)
[ltfBiasLegacy, ltfSwHLegacy, ltfSwLLegacy, ltfFlipBarLegacy] = request.security(syminfo.tickerid, "15", f_h4_structure(ltfPivotLen), lookahead=barmerge.lookahead_off)
int   ltfBias     = useM15MssLtf ? ltfBiasMss    : ltfBiasLegacy
float ltfSwH      = useM15MssLtf ? ltfSwHMss     : ltfSwHLegacy
float ltfSwL      = useM15MssLtf ? ltfSwLMss     : ltfSwLLegacy
int   ltfFlipBar  = useM15MssLtf ? ltfFlipBarMss : ltfFlipBarLegacy

// v17.85.20: M5 MSS REFERENCE ENGINE (DISPLAY-ONLY) — re-uses the SAME responsive
// close-based MSS engine (f_m15_mss) on the "5" resolution. m5MssBias is +1 bull /
// -1 bear / 0 neutral. This value is consumed ONLY by the optional M5 MSS Market
// Brief row and the optional M5 MSS marker — it NEVER feeds fvMssOk / fvAlertOk /
// finalVerdict / any alert lane. Fully isolated reference metric.
[m5MssBias, m5MssSwH, m5MssSwL, m5MssFlipBar] = request.security(syminfo.tickerid, "5", f_m15_mss(m5PivotLen, mssRightConfirm), lookahead=barmerge.lookahead_off)
// v17.85.20: optional diagnostic markers on each M5 MSS bias flip (reference only).
bool _m5MssChg  = ta.change(m5MssBias) != 0   // hoisted: avoids CW10002 in conditional
bool m5MssFlipBull = showM5MssTrace and m5MssBias == 1  and _m5MssChg
bool m5MssFlipBear = showM5MssTrace and m5MssBias == -1 and _m5MssChg
plotshape(m5MssFlipBull, title="M5 MSS ▲", style=shape.triangleup,   location=location.belowbar, color=color.new(color.teal, 0),   size=size.tiny, text="m5")
plotshape(m5MssFlipBear, title="M5 MSS ▼", style=shape.triangledown, location=location.abovebar, color=color.new(color.maroon, 0), size=size.tiny, text="m5")

// v17.85.22a: Provisional qualifiers — display-only, zero effect on signals/alerts.
bool provBearToBull = enableProvisionalLegVisuals and bosH4Close >= slBearRecLvl and ltfBias == 1
bool provBullToBear = enableProvisionalLegVisuals and bosH4Close <= slBullRecLvl and ltfBias == -1

// v17.56.1: HTF derived display variables (H4 structural bias)
string htfDirStr = htfBias == 1 ? "BULLISH" : htfBias == -1 ? "BEARISH" : "NEUTRAL"
color  htfColor  = htfBias == 1 ? color.lime : htfBias == -1 ? color.red : color.gray

// v17.56.1: LTF derived display variables (M15 structural bias)

// v17.56.1: Dual Bias Alignment (display only)
// isWithTrend: Both HTF (H4) and LTF (M15) agree in direction
// isCounterTrend: HTF (H4) and LTF (M15) oppose each other
bool isWithTrend    = (htfBias == 1 and ltfBias >= 0) or (htfBias == -1 and ltfBias <= 0)
bool isCounterTrend = (htfBias == 1 and ltfBias == -1) or (htfBias == -1 and ltfBias == 1)

// ============================================================================
// v17.59 FIX 1: DIRECT TREND LOGIC (FORCE RESET)  [HIGHEST PRIORITY]
// ============================================================================
// The headline fix. BOS-derived htfBias/ltfBias can lag badly during a violent
// expansion (they stay anchored to a stale structural pivot). This momentum-first
// override reads CURRENT price action and FORCES the trend when displacement is
// unambiguous, taking precedence over the BOS anchors.
//
//   • HTF override (H4): close < H4 SMA50 AND a fresh 20-bar low → FORCE BEARISH.
//                        close > H4 SMA50 AND a fresh 20-bar high → FORCE BULLISH.
//   • LTF override:      price > 1.5×ATR below the daily open → FORCE BEARISH.
//                        price > 1.5×ATR above the daily open → FORCE BULLISH.
// All request.security() calls use lookahead_off (non-repainting).
// ============================================================================
[h4Sma50, h4Prior20High, h4Prior20Low] = request.security(syminfo.tickerid, "240", [ta.sma(close, 50), ta.highest(high, 20)[1], ta.lowest(low, 20)[1]], lookahead=barmerge.lookahead_off)
float trendDayOpen = request.security(syminfo.tickerid, "D", open, lookahead=barmerge.lookahead_off)

// v17.67.4-fix: Normalized M15 ATR + close for LTF override (timeframe-independent)
[m15AtrNorm, m15CloseNorm] = request.security(syminfo.tickerid, "15", [ta.atr(14), close], lookahead=barmerge.lookahead_off)

// HTF momentum override (H4 SMA50 + fresh 20-bar break)
bool htfMakingNewLow  = not na(h4Prior20Low)  and close < h4Prior20Low
bool htfMakingNewHigh = not na(h4Prior20High) and close > h4Prior20High
bool htfForceBear = not na(h4Sma50) and close < h4Sma50 and htfMakingNewLow
bool htfForceBull = not na(h4Sma50) and close > h4Sma50 and htfMakingNewHigh

// LTF momentum override — uses M15 ATR + M15 close for timeframe-independent results
// v17.67.4-fix: Previously used local chart atrValue + close, causing LTF row to differ
// between M5/H1/H4 charts. Now pinned to M15 so the override is identical everywhere.
float ltfTrendAtr = nz(m15AtrNorm, 0.0)
// v17.72.0: ATR multiplier is now an input (default 1.0, was hard-coded 1.5) so
// the LTF momentum override (⚡OVR) snaps back ~33% faster and stops pinning the
// LTF trend against valid local reversals. Set ltfOvrAtrMult=1.5 for legacy behaviour.
bool ltfForceBear = not na(trendDayOpen) and ltfTrendAtr > 0 and m15CloseNorm < (trendDayOpen - ltfOvrAtrMult * ltfTrendAtr)
bool ltfForceBull = not na(trendDayOpen) and ltfTrendAtr > 0 and m15CloseNorm > (trendDayOpen + ltfOvrAtrMult * ltfTrendAtr)

// Final trend = override (when active) else the BOS-derived bias
int  finalHTFTrend     = htfForceBear ? -1 : htfForceBull ? 1 : htfBias
int  finalLTFTrend     = ltfForceBear ? -1 : ltfForceBull ? 1 : ltfBias
bool htfOverrideActive = htfForceBear or htfForceBull
bool ltfOverrideActive = ltfForceBear or ltfForceBull

// Strong-trend detection (both timeframes aligned AND price beyond H4 SMA50)
bool strongBearishTrend = finalHTFTrend == -1 and finalLTFTrend == -1 and not na(h4Sma50) and close < h4Sma50
bool strongBullishTrend = finalHTFTrend == 1  and finalLTFTrend == 1  and not na(h4Sma50) and close > h4Sma50

// ============================================================================
// v17.80.0 STAGE A — CENTRALIZED INSTITUTIONAL MTF MARKET MODELS (backbone)
// ============================================================================
// ONE source of truth for every timeframe. Each TfModel exposes a standardized
// set of fields (bias, trend, structure, dealing range, premium/discount/EQ,
// supply/demand, order blocks, liquidity, BOS/MSS, extension, narrative). In
// Stage A only the fields that ALREADY exist are populated (H4/M15 bias+trend,
// the H4 dealing range + P&D), and two NEW structural reads (H1 "60", M5 "5")
// are added to give H1/M5 a bias. Nothing here is consumed by legacy subsystems
// yet, so behaviour is byte-for-byte unchanged. Stages B–D progressively move
// each subsystem to read these models (nested ranges, hierarchical P&D,
// confidence, guardian, narrative, location, debug table).
//
// DESIGN RULE: models are populated FROM the existing verified values wherever
// those exist (mH4.bias := htfBias, mH4.rangeHigh := h4RangeHigh, …) so we never
// introduce a second, competing calculation path.
// ============================================================================
type TfModel
    string tf              = ""      // "H4" / "H1" / "M15" / "M5"
    int    bias            = 0       // structural bias  (-1 / 0 / +1)
    int    trend           = 0       // effective trend  (bias + momentum override)
    float  swH             = na      // last confirmed structural swing high
    float  swL             = na      // last confirmed structural swing low
    int    flipBar         = 0       // bar_index of last structural flip
    float  rangeHigh       = na      // dealing-range high
    float  rangeLow        = na      // dealing-range low
    float  eq              = na      // equilibrium (mid)
    float  premiumBottom   = na      // premium zone lower bound (= EQ or EQ-band top)
    float  discountTop     = na      // discount zone upper bound (= EQ or EQ-band bottom)
    bool   inPremium       = false   // live price in this TF's premium
    bool   inDiscount      = false   // live price in this TF's discount
    string zone            = "EQ"    // "Premium" / "Discount" / "Equilibrium"
    // ---- reserved for later stages (populated in Stage B/D) ----
    float  supplyTop       = na
    float  supplyBot       = na
    float  demandTop       = na
    float  demandBot       = na
    float  obTop           = na
    float  obBot           = na
    float  liqHigh         = na
    float  liqLow          = na
    bool   bos             = false
    bool   mss             = false
    float  extension       = na
    string narrative       = ""

// Helper: classify a live price into this model's own P&D zone string.
f_tfZone(float _c, float _premBot, float _discTop) =>
    na(_premBot) or na(_discTop) ? "EQ" : _c > _premBot ? "Premium" : _c < _discTop ? "Discount" : "Equilibrium"

// ---- NEW structural reads for the two added timeframes (H1, M5) ------------
// Same engine (f_h4_structure) the H4/M15 models already use, requested on true
// "60" / "5" resolution with lookahead_off so they are chart-independent.
[m80_h1Bias, m80_h1SwH, m80_h1SwL, m80_h1FlipBar] = request.security(syminfo.tickerid, "60", f_h4_structure(h1PivotLen), lookahead=barmerge.lookahead_off)
[m80_m5Bias, m80_m5SwH, m80_m5SwL, m80_m5FlipBar] = request.security(syminfo.tickerid, "5",  f_h4_structure(m5PivotLen), lookahead=barmerge.lookahead_off)

// ---- Instantiate + populate the four models --------------------------------
var TfModel mH4  = TfModel.new()
var TfModel mH1  = TfModel.new()
var TfModel mM15 = TfModel.new()
var TfModel mM5  = TfModel.new()

mH4.tf  := "H4"
mH1.tf  := "H1"
mM15.tf := "M15"
mM5.tf  := "M5"

// H4 model — macro governor. Bias/trend/range/P&D come from the EXISTING verified
// H4 values (single source; no new calculation).
mH4.bias          := htfBias
mH4.trend         := finalHTFTrend
mH4.swH           := htfSwH
mH4.swL           := htfSwL
mH4.flipBar       := htfFlipBar
mH4.rangeHigh     := h4RangeHigh
mH4.rangeLow      := h4RangeLow
mH4.eq            := h4Eq
mH4.premiumBottom := h4PremiumBottom
mH4.discountTop   := h4DiscountTop
mH4.inPremium     := inPremiumZone
mH4.inDiscount    := inDiscountZone
mH4.zone          := f_tfZone(close, h4PremiumBottom, h4DiscountTop)

// H1 model — structural bridge (NEW read; range/P&D added in Stage B).
mH1.bias          := m80_h1Bias
mH1.trend         := m80_h1Bias
mH1.swH           := m80_h1SwH
mH1.swL           := m80_h1SwL
mH1.flipBar       := m80_h1FlipBar

// M15 model — operational map. Bias/trend from EXISTING verified M15 values.
mM15.bias         := ltfBias
mM15.trend        := finalLTFTrend
mM15.swH          := ltfSwH
mM15.swL          := ltfSwL
mM15.flipBar      := ltfFlipBar

// M5 model — tactical execution (NEW read; range/P&D/OB/liquidity added later).
mM5.bias          := m80_m5Bias
mM5.trend         := m80_m5Bias
mM5.swH           := m80_m5SwH
mM5.swL           := m80_m5SwL
mM5.flipBar       := m80_m5FlipBar

// Inherited directional permission (macro governor). Consumed from Stage C
// onward; declared here so the backbone is complete. In Stage A it mirrors the
// existing H4 trend and changes nothing.
// ============================================================================
// END v17.80.0 STAGE A MODEL BACKBONE
// ============================================================================

// ============================================================================
// v17.81.0 STAGE B — NESTED BREATHING RANGES + HIERARCHICAL PREMIUM/DISCOUNT
// ----------------------------------------------------------------------------
// Each timeframe derives its OWN dealing range from its OWN confirmed structural
// swings (carried in the Stage A models), NESTED within the higher-TF range.
// Ranges BREATHE: a local swing extending beyond the parent expands the local
// range naturally (no hard clamp); a missing/degenerate local swing inherits the
// parent boundary. Premium/Discount/EQ are then computed per timeframe with the
// SAME band math the H4 range uses (neutralZoneWidth), so interpretation stays
// hierarchical and consistent — never a blind replica of the H4 zone.
// ============================================================================

// Helper: nested breathing range. Missing/inverted local swing inherits parent.
f_nestRange(float _locHi, float _locLo, float _parHi, float _parLo) =>
    float _hi = na(_locHi) ? _parHi : _locHi
    float _lo = na(_locLo) ? _parLo : _locLo
    if na(_hi) or na(_lo) or _hi <= _lo
        _hi := _parHi
        _lo := _parLo
    [_hi, _lo]

// Helper: fill a model's range-derived P&D fields from a nested range.
f_fillPD(float _hi, float _lo, float _nzw) =>
    float _eq   = (_hi + _lo) / 2.0
    float _pb   = _eq + ((_hi - _lo) * _nzw / 200.0)
    float _dt   = _eq - ((_hi - _lo) * _nzw / 200.0)
    [_eq, _pb, _dt]

// --- H1 nested within H4 -----------------------------------------------------
[m81_h1Hi, m81_h1Lo] = f_nestRange(mH1.swH, mH1.swL, mH4.rangeHigh, mH4.rangeLow)
[m81_h1Eq, m81_h1Pb, m81_h1Dt] = f_fillPD(m81_h1Hi, m81_h1Lo, neutralZoneWidth)
mH1.rangeHigh     := m81_h1Hi
mH1.rangeLow      := m81_h1Lo
mH1.eq            := m81_h1Eq
mH1.premiumBottom := m81_h1Pb
mH1.discountTop   := m81_h1Dt
mH1.inPremium     := close > m81_h1Pb
mH1.inDiscount    := close < m81_h1Dt
mH1.zone          := f_tfZone(close, m81_h1Pb, m81_h1Dt)

// --- M15 nested within H1 ----------------------------------------------------
[m81_m15Hi, m81_m15Lo] = f_nestRange(mM15.swH, mM15.swL, mH1.rangeHigh, mH1.rangeLow)
[m81_m15Eq, m81_m15Pb, m81_m15Dt] = f_fillPD(m81_m15Hi, m81_m15Lo, neutralZoneWidth)
mM15.rangeHigh     := m81_m15Hi
mM15.rangeLow      := m81_m15Lo
mM15.eq            := m81_m15Eq
mM15.premiumBottom := m81_m15Pb
mM15.discountTop   := m81_m15Dt
mM15.inPremium     := close > m81_m15Pb
mM15.inDiscount    := close < m81_m15Dt
mM15.zone          := f_tfZone(close, m81_m15Pb, m81_m15Dt)

// --- M5 nested within M15 ----------------------------------------------------
[m81_m5Hi, m81_m5Lo] = f_nestRange(mM5.swH, mM5.swL, mM15.rangeHigh, mM15.rangeLow)
[m81_m5Eq, m81_m5Pb, m81_m5Dt] = f_fillPD(m81_m5Hi, m81_m5Lo, neutralZoneWidth)
mM5.rangeHigh     := m81_m5Hi
mM5.rangeLow      := m81_m5Lo
mM5.eq            := m81_m5Eq
mM5.premiumBottom := m81_m5Pb
mM5.discountTop   := m81_m5Dt
mM5.inPremium     := close > m81_m5Pb
mM5.inDiscount    := close < m81_m5Dt
mM5.zone          := f_tfZone(close, m81_m5Pb, m81_m5Dt)

// --- Active-timeframe model selection (drives the on-chart P&D visual) -------
// The chart's own timeframe picks which model's nested range is shaded, so on a
// 15M chart you see the M15 nested P&D, on 1H the H1 P&D, etc. On H4+ it is the
// H4 macro range (identical to legacy behaviour → no regression on H4).
// v17.84.0 PHASE A — H4 AUTHORITY LOCK: when forceH4GlobalPD is ON (default) the
// active model is ALWAYS the H4 macro model, so no LTF nested range can redefine
// the on-chart P&D. When OFF, the legacy per-chart nested selector is used.
int _m81ChartSec = timeframe.in_seconds()
TfModel m81Active = forceH4GlobalPD ? mH4 : (_m81ChartSec <= 300 ? mM5 : _m81ChartSec <= 900 ? mM15 : _m81ChartSec <= 3600 ? mH1 : mH4)

// Scalars the drawing blocks consume. When Nested P&D is OFF (or the active
// model has no valid range), fall back to the legacy H4-anchored values so the
// visual is byte-identical to v17.80.
bool   _m81Use      = showNestedPD and not forceH4GlobalPD and not na(m81Active.rangeHigh) and not na(m81Active.rangeLow) and m81Active.rangeHigh > m81Active.rangeLow
float  pdVizTop     = _m81Use ? m81Active.rangeHigh     : h4PremiumTop
float  pdVizPremBot = _m81Use ? m81Active.premiumBottom : h4PremiumBottom
float  pdVizDiscTop = _m81Use ? m81Active.discountTop   : h4DiscountTop
float  pdVizBot     = _m81Use ? m81Active.rangeLow      : h4DiscountBottom
float  pdVizEq      = _m81Use ? m81Active.eq            : h4Eq
string pdVizTf      = _m81Use ? m81Active.tf            : "H4"

// v17.85.22a: Provisional P&D visual override (display-only; activeRangeHigh/Low unchanged).
bool _pActB2B  = provBearToBull and not _m81Use
bool _pActBl2B = provBullToBear and not _m81Use
if _pActB2B or _pActBl2B
    float _pHraw = _pActB2B ? slOriginHigh : bos_lastPH
    float _pLraw = _pActB2B ? bos_lastPL   : slOriginLow
    float _top   = math.max(_pHraw, _pLraw)  // v17.85.27: guard inversion
    float _bot   = math.min(_pHraw, _pLraw)
    pdVizTop     := _top
    pdVizBot     := _bot
    pdVizEq      := (_top + _bot) / 2.0
    pdVizPremBot := pdVizEq + (_top - _bot) * neutralZoneWidth / 200.0
    pdVizDiscTop := pdVizEq - (_top - _bot) * neutralZoneWidth / 200.0

// v17.85.59: PEAK-ANCHOR CLAMP REMOVED.
// The v17.85.27 _pdPeakH/_pdPeakL block expanded pdVizTop/pdVizBot every bar to
// encompass the running high/low since last FSM transition. This caused a floating
// / disconnected visual box on USDJPY/GBPJPY: after the July→Aug crash the peak
// accumulator held the stale ~164 extreme even while price traded 155→160, and the
// box appeared stranded above price. Per the v17.85.59 brief: pdVizTop/pdVizBot
// must consume h4RangeHigh/h4RangeLow directly without any synthetic scaling.

// ============================================================================
// END v17.81.0 STAGE B NESTED RANGES + HIERARCHICAL P&D
// (Developer MTF Debug Table removed in v17.85.16 token diet — see header.)
// ============================================================================

// Final-trend display helpers (consumed by HUD + webhook)
string finalHTFDirStr = finalHTFTrend == 1 ? "BULLISH" : finalHTFTrend == -1 ? "BEARISH" : "NEUTRAL"
string finalLTFDirStr = finalLTFTrend == 1 ? "BULLISH" : finalLTFTrend == -1 ? "BEARISH" : "NEUTRAL"
color  finalHTFColor  = finalHTFTrend == 1 ? color.lime : finalHTFTrend == -1 ? color.red : color.gray
color  finalLTFColor  = finalLTFTrend == 1 ? color.lime : finalLTFTrend == -1 ? color.red : color.gray
string htfRowSuffix   = htfOverrideActive ? " ⚡OVR" : ""
string ltfRowSuffix   = ltfOverrideActive ? " ⚡OVR" : ""

// ============================================================================
// v17.16 SECTION: DAILY HIGH/LOW & ASIAN SESSION HIGH/LOW
// ============================================================================

// --- Daily High/Low (current trading day) ---
// v17.85.14: dailyHigh/dailyLow + pdh/pdl bundled into ONE tuple request.security
// call (same symbol/"D"/lookahead_off) — identical values, fewer compiled tokens.
[dailyHigh, dailyLow, pdh, pdl] = request.security(syminfo.tickerid, "D", [high, low, high[1], low[1]], lookahead=barmerge.lookahead_off)

// ============================================================================
// v17.57: PREVIOUS DAY HIGH / LOW (PDH / PDL)
// ============================================================================
// Uses daily timeframe with [1] offset to get YESTERDAY's confirmed high/low.
// lookahead_off ensures no repainting — values lock at daily close.
// ============================================================================

// pdh / pdl are resolved above in the bundled daily tuple (v17.85.14).

// --- Asian Session High/Low (Tokyo 00:00-09:00 UTC) ---
// We track the Asian session range using intra-bar tracking
var float asianSessionHigh = na
var float asianSessionLow  = na
var bool  asianSessionActive = false

// Asian session: 00:00-09:00 UTC (19:00-04:00 EST approximately)
asianHourUTC = hour(time, "UTC")
isAsianSession = asianHourUTC >= 0 and asianHourUTC < 9

// Track Asian session H/L
if isAsianSession
    if not asianSessionActive
        // New Asian session start — reset
        asianSessionHigh := high
        asianSessionLow  := low
        asianSessionActive := true
    else
        asianSessionHigh := math.max(nz(asianSessionHigh, high), high)
        asianSessionLow  := math.min(nz(asianSessionLow, low), low)
else
    asianSessionActive := false

// Ensure valid values
float asiHi = nz(asianSessionHigh, high)
float asiLo = nz(asianSessionLow, low)

// --- Proximity scores for confluence (0 or 1, binary component) ---
// Daily H/L proximity: price within 0.3% of daily high or low = 1 point
float dailyRange = nz(dailyHigh - dailyLow, 1.0)
float dailyHiDist = math.abs(close - nz(dailyHigh, close))
float dailyLoDist = math.abs(close - nz(dailyLow, close))
float dailyProximityPct = math.min(dailyHiDist, dailyLoDist) / math.max(dailyRange, syminfo.mintick) * 100
bool nearDailyLevel = dailyProximityPct < 15.0  // within 15% of range from Daily H or L

// Asian H/L proximity: price within 15% of Asian range from Asian H or L
float asianRange = nz(asiHi - asiLo, 1.0)
float asianHiDist = math.abs(close - asiHi)
float asianLoDist = math.abs(close - asiLo)
float asianProximityPct = math.min(asianHiDist, asianLoDist) / math.max(asianRange, syminfo.mintick) * 100
bool nearAsianLevel = asianProximityPct < 15.0  // within 15% of Asian range from Asian H or L

// ============================================================================
// v17.57: PDH/PDL PROXIMITY DETECTION
// ============================================================================
// Price is considered "near" PDH or PDL when within 15% of the PDH-PDL range
// ============================================================================

float pdhDist = math.abs(close - nz(pdh, close))
float pdlDist = math.abs(close - nz(pdl, close))
float pdhlRange = nz(pdh - pdl, 1.0)

// Calculate proximity percentage
float pdhProximityPct = pdhDist / math.max(pdhlRange, syminfo.mintick) * 100
float pdlProximityPct = pdlDist / math.max(pdhlRange, syminfo.mintick) * 100

// Proximity flags (within 15% threshold)
bool nearPDH = pdhProximityPct < 15.0
bool nearPDL = pdlProximityPct < 15.0
bool nearPDHL = nearPDH or nearPDL

// ============================================================================
// v17.57: PDH/PDL SWEEP DETECTION
// ============================================================================
// A sweep occurs when price wicks THROUGH the level but CLOSES back on the
// other side - classic liquidity grab/stop hunt pattern
// ============================================================================

// PDH Sweep: High wick above PDH but close below (bearish trap)
bool pdhSwept = high > pdh and close < pdh

// PDL Sweep: Low wick below PDL but close above (bullish trap)
bool pdlSwept = low < pdl and close > pdl

// --- Draw Daily High/Low Lines ---
var line dailyHighLine = na
var line dailyLowLine  = na
var label dailyHighLabel = na
var label dailyLowLabel  = na

if showDailyHL and barstate.islast
    // Delete previous lines/labels
    line.delete(dailyHighLine)
    line.delete(dailyLowLine)
    label.delete(dailyHighLabel)
    label.delete(dailyLowLabel)
    // Draw new lines — v17.54.1: width 2, zero transparency for max visibility
    dailyHighLine := line.new(bar_index - 50, dailyHigh, bar_index + 50, dailyHigh, color=dailyLineColor, style=line.style_dashed, width=2, extend=extend.right)
    dailyLowLine  := line.new(bar_index - 50, dailyLow, bar_index + 50, dailyLow, color=dailyLineColor, style=line.style_dashed, width=2, extend=extend.right)
    // Labels — v17.54.1: fully opaque background, white text, size.small
    dailyHighLabel := label.new(bar_index + 5, dailyHigh, "Daily H", style=label.style_label_left, color=color.new(color.blue, 0), textcolor=color.new(color.white, 0), size=size.small)
    dailyLowLabel  := label.new(bar_index + 5, dailyLow, "Daily L", style=label.style_label_left, color=color.new(color.blue, 0), textcolor=color.new(color.white, 0), size=size.small)

// --- Draw Asian High/Low Lines ---
var line asianHighLine = na
var line asianLowLine  = na
var label asianHighLabel = na
var label asianLowLabel  = na

if showAsianHL and barstate.islast
    // Delete previous lines/labels
    line.delete(asianHighLine)
    line.delete(asianLowLine)
    label.delete(asianHighLabel)
    label.delete(asianLowLabel)
    // Draw new lines — v17.54.1: width 2, zero transparency for max visibility
    asianHighLine := line.new(bar_index - 50, asiHi, bar_index + 50, asiHi, color=asianLineColor, style=line.style_dotted, width=2, extend=extend.right)
    asianLowLine  := line.new(bar_index - 50, asiLo, bar_index + 50, asiLo, color=asianLineColor, style=line.style_dotted, width=2, extend=extend.right)
    // Labels — v17.54.1: fully opaque background, white text, size.small
    asianHighLabel := label.new(bar_index + 5, asiHi, "Asian H", style=label.style_label_left, color=color.new(color.orange, 0), textcolor=color.new(color.white, 0), size=size.small)
    asianLowLabel  := label.new(bar_index + 5, asiLo, "Asian L", style=label.style_label_left, color=color.new(color.orange, 0), textcolor=color.new(color.white, 0), size=size.small)

// --- v17.57: Draw Previous Day High/Low (PDH/PDL) Lines ---
var line pdhLine   = na
var line pdlLine   = na
var label pdhLabel = na
var label pdlLabel = na

// v17.65.1: PDH/PDL CHART LINES RESTORED. The on-chart PDH/PDL dashed lines and
//   labels are drawn again (respecting the showPDHL input toggle). NOTE: the HUD
//   PDH/PDL row remains removed (per v17.65.0) — only the chart visuals are back.
//   (D&P / Discount-Premium zone boxes are untouched.)
if showPDHL and barstate.islast and not na(pdh) and not na(pdl)
    // Delete previous lines/labels to avoid hatching
    line.delete(pdhLine)
    line.delete(pdlLine)
    label.delete(pdhLabel)
    label.delete(pdlLabel)
    // Draw new PDH/PDL lines — dashed, width 2, extend right
    pdhLine := line.new(bar_index - 50, pdh, bar_index + 50, pdh, color=pdhColor, style=line.style_dashed, width=2, extend=extend.right)
    pdlLine := line.new(bar_index - 50, pdl, bar_index + 50, pdl, color=pdlColor, style=line.style_dashed, width=2, extend=extend.right)
    // Labels — opaque background, white text, size.small
    pdhLabel := label.new(bar_index + 5, pdh, "PDH", style=label.style_label_left, color=pdhColor, textcolor=color.new(color.white, 0), size=size.small)
    pdlLabel := label.new(bar_index + 5, pdl, "PDL", style=label.style_label_left, color=pdlColor, textcolor=color.new(color.white, 0), size=size.small)


// Invalidation tracking (v16.9 Feature D)
var bool h4Invalidated = false
var float h4InvalLevel = na

// v17.1 directional invalidation state tracking
var bool longInvalidated  = false
var bool shortInvalidated = false
var bool activeLongSetup  = false
var bool activeShortSetup = false
var bool guardianWasWaiting = false
var int  invalidationReasonLong  = 0
var int  invalidationReasonShort = 0

// ============================================================================
// v17.3 PRIORITY 1: STATE MACHINE — Active Signal Tracking
// ============================================================================
// States: IDLE (0) = no signal, ACTIVE (1) = signal live, TERMINAL (2) = closed
// Only 1 active signal per direction. New signals BLOCKED while ACTIVE.
var int  smStateLong  = 0  // 0=IDLE, 1=ACTIVE
var int  smStateShort = 0  // 0=IDLE, 1=ACTIVE
var float smEntryLong  = na
var float smSLLong     = na
var float smTPLong     = na
var float smEntryShort = na
var float smSLShort    = na
var float smTPShort    = na
var int  smBarLong     = 0  // bar when signal was activated
var int  smBarShort    = 0

// TP/SL hit detection for state machine cleanup
smTPHitLong   = smStateLong == 1 and not na(smTPLong) and high >= smTPLong
smSLHitLong   = smStateLong == 1 and not na(smSLLong) and low <= smSLLong
smTPHitShort  = smStateShort == 1 and not na(smTPShort) and low <= smTPShort
smSLHitShort  = smStateShort == 1 and not na(smSLShort) and high >= smSLShort

// Timeout: auto-clear after 50 bars if no TP/SL hit (safety valve)
smTimeoutLong  = smStateLong == 1 and (bar_index - smBarLong) > 50
smTimeoutShort = smStateShort == 1 and (bar_index - smBarShort) > 50

// Terminal transitions (TP hit, SL hit, or timeout)
if smTPHitLong or smSLHitLong or smTimeoutLong
    smStateLong := 0
    smEntryLong := na
    smSLLong    := na
    smTPLong    := na

if smTPHitShort or smSLHitShort or smTimeoutShort
    smStateShort := 0
    smEntryShort := na
    smSLShort    := na
    smTPShort    := na

// ============================================================================

h4BiasChanged = ta.change(h4Bias) != 0
if h4BiasChanged
    h4Invalidated := false
    h4InvalLevel := na

// H4 bias alignment with signal direction
biasAlignedLong  = h4Bias == 1 or h4Bias == 0
biasAlignedShort = h4Bias == -1 or h4Bias == 0

// ============================================================================
// v17.3 PRIORITY 2: H4 BIAS DIRECTIONAL FILTER HELPERS
// ============================================================================
// Determine if a signal direction is WITH-TREND or COUNTER-TREND
isCounterTrendLong  = h4Bias == -1  // LONG in BEARISH = counter-trend
isCounterTrendShort = h4Bias == 1   // SHORT in BULLISH = counter-trend

// ============================================================================
// SECTION 4: STRUCTURE DETECTION (M5/M15)
// ============================================================================

// --- Swing highs and lows ---
swHigh = ta.pivothigh(high, swingLen, swingLen)
swLow  = ta.pivotlow(low, swingLen, swingLen)

// v17.85.32: Asymmetric S&D zone-creation pivots (left=swingLen, right=2).
// Fires 3 bars sooner than the symmetric pivot so Supply/Demand zones appear
// during fast-moving trends. These are ONLY used in the S&D zone creation
// blocks below — BOS/CHoCH structure detection continues to use swHigh/swLow.
float sdSwHigh = ta.pivothigh(high, swingLen, 2)
float sdSwLow  = ta.pivotlow(low,  swingLen, 2)

var float lastSwingHigh = na
var float lastSwingLow  = na
var int   lastSwHighBar = 0
var int   lastSwLowBar  = 0

if not na(swHigh)
    lastSwingHigh := swHigh
    lastSwHighBar := bar_index - swingLen

if not na(swLow)
    lastSwingLow := swLow
    lastSwLowBar := bar_index - swingLen

// --- BOS and CHoCH detection ---
var float prevSwingHigh = na
var float prevSwingLow  = na
var int   structureDir  = 0  // 1=bullish, -1=bearish

bosUp   = false
bosDn   = false
chochUp = false
chochDn = false

if not na(swHigh) and not na(prevSwingHigh)
    if close > lastSwingHigh and structureDir == 1
        bosUp := true
    if close > lastSwingHigh and structureDir == -1
        chochUp := true
        structureDir := 1

if not na(swLow) and not na(prevSwingLow)
    if close < lastSwingLow and structureDir == -1
        bosDn := true
    if close < lastSwingLow and structureDir == 1
        chochDn := true
        structureDir := -1

if not na(swHigh)
    prevSwingHigh := swHigh
if not na(swLow)
    prevSwingLow := swLow

// Structure state code
var int structureStateCode = 0
if bosUp or bosDn
    structureStateCode := 1
if chochUp or chochDn
    structureStateCode := 4

// M15 structure
// v17.85.14: M15 OHLC + CHoCH/BOS reversal proxies bundled into ONE tuple
// request.security call (same symbol/"15"/default lookahead) — identical values,
// fewer compiled tokens. Proxy used for hard invalidation.
[m15High, m15Low, m15Close, m15BullBreak, m15BearBreak] = request.security(syminfo.tickerid, "15", [high, low, close, ta.crossover(close, ta.highest(high, m15SwingLen)[1]), ta.crossunder(close, ta.lowest(low, m15SwingLen)[1])])

// MSS detection
var float mssLevel = na
var int   mssBar   = 0
var int   mssDir   = 0
var int   mssState = 0

mssUp = chochUp
mssDn = chochDn

if mssUp
    mssLevel := lastSwingLow
    mssBar   := bar_index
    mssDir   := 1
    mssState := 1

if mssDn
    mssLevel := lastSwingHigh
    mssBar   := bar_index
    mssDir   := -1
    mssState := 1

mssRetraceExpired = mssState == 1 and (bar_index - mssBar) > mssRetraceBars
if mssRetraceExpired
    mssState := 0

// ============================================================================
// SECTION 5: FVG DETECTION
// ============================================================================

bullFVG = low > high[2] and (low - high[2]) > atrValue * fvgMinSize / 100
bearFVG = high < low[2] and (low[2] - high) > atrValue * fvgMinSize / 100

var float fvgTop = na
var float fvgBot = na
var int   fvgDir = 0

if bullFVG
    fvgTop := low
    fvgBot := high[2]
    fvgDir := 1

if bearFVG
    fvgTop := low[2]
    fvgBot := high
    fvgDir := -1

fvgActive = not na(fvgTop) and ((fvgDir == 1 and close > fvgBot) or (fvgDir == -1 and close < fvgTop))

// ============================================================================
// SECTION 6: ORDER BLOCK DETECTION
// ============================================================================

bullOBCond = close[1] < open[1] and close > open and (close - open) > atrValue * 0.5
bearOBCond = close[1] > open[1] and close < open and (open - close) > atrValue * 0.5

var float obHigh = na
var float obLow  = na
var int   obDir  = 0
var int   obRefineLevel = 0
var int   obBar  = 0       // v17.56.4: Track OB origin bar_index for box left edge

if bullOBCond
    obHigh := high[1]
    obLow  := low[1]
    obDir  := 1
    obRefineLevel := math.min(obRefinementDepth, 3)
    obBar  := bar_index - 1  // v17.56.4: OB candle is previous bar

if bearOBCond
    obHigh := high[1]
    obLow  := low[1]
    obDir  := -1
    obRefineLevel := math.min(obRefinementDepth, 3)
    obBar  := bar_index - 1  // v17.56.4: OB candle is previous bar

obMid = (obHigh + obLow) / 2.0
priceInBullOB = obDir == 1 and close >= obLow and close <= obMid
priceInBearOB = obDir == -1 and close >= obMid and close <= obHigh

// ============================================================================
// v17.75: INSTITUTIONAL ORDER BLOCK VALIDATION (Level 2)
// ============================================================================
// A raw OB (above) is only promoted to a True Institutional OB when ALL pillars
// are satisfied within the confirmation window:
//   (1) Origin  : last opposing candle before expansion  -> obBar (already set)
//   (2) Displace: expansion candle body >> ATR            -> obInstDispMin
//   (3) Gap     : an FVG opens during the expansion       -> fvgActive/fvgDir
//   (4) Structure: expansion prints immediate BOS/CHoCH   -> bosUp/Dn, chochUp/Dn
//   (5) Liquidity: origin move swept a prior fractal      -> lastSwingHigh/Low
var bool obInstitutional = false
var bool obMitigated     = false
var int  _obCandDir      = 0      // direction of the OB candidate under validation
var int  _obCandAge      = -1     // bars since candidate opened (-1 = idle)
var bool _obCandDisp     = false
var bool _obCandGap      = false
var bool _obCandBos      = false
var bool _obCandSweep    = false
var bool _obLeftZone     = false  // true once price fully departs the fresh OB

// Displacement factor of the current expansion candle
_obDispFactor = atrValue > 0 ? math.abs(close - open) / atrValue : 0.0

// Open a fresh candidate the moment a raw OB forms
if bullOBCond or bearOBCond
    obInstitutional := false
    obMitigated     := false
    _obLeftZone     := false
    _obCandDir      := obDir
    _obCandAge      := 0
    // Pillar 2 — displacement of the impulse candle that created the OB
    _obCandDisp     := _obDispFactor >= obInstDispMin
    // Pillar 5 — liquidity: origin (opposing) candle swept a prior fractal
    _obCandSweep    := obDir == 1 ? (not na(lastSwingLow)  and low[1]  <= lastSwingLow) : (not na(lastSwingHigh) and high[1] >= lastSwingHigh)
    // Pillar 3 — gap seed: FVG already active in the OB direction on formation
    _obCandGap      := fvgActive and ((obDir == 1 and fvgDir == 1) or (obDir == -1 and fvgDir == -1))
    // Pillar 4 — structure: immediate BOS/CHoCH on the formation bar
    _obCandBos      := obDir == 1 ? (bosUp or chochUp) : (bosDn or chochDn)
    // Instant promotion if everything is already present on the formation bar
    if enableInstOB and _obCandDisp and _obCandGap and _obCandBos and _obCandSweep
        obInstitutional := true
        _obCandAge      := -1
// Accumulate evidence across the confirmation window
else if _obCandAge >= 0 and _obCandAge < obInstConfirmBars
    _obCandAge := _obCandAge + 1
    if _obDispFactor >= obInstDispMin
        _obCandDisp := true
    if fvgActive and ((_obCandDir == 1 and fvgDir == 1) or (_obCandDir == -1 and fvgDir == -1))
        _obCandGap := true
    if _obCandDir == 1 and (bosUp or chochUp)
        _obCandBos := true
    if _obCandDir == -1 and (bosDn or chochDn)
        _obCandBos := true
    if enableInstOB and _obCandDisp and _obCandGap and _obCandBos and _obCandSweep
        obInstitutional := true
        _obCandAge      := -1     // validated — stop tracking

// Retire an unconfirmed candidate once its window elapses
if _obCandAge >= obInstConfirmBars
    _obCandAge := -1

// Dynamic mitigation — the zone must first be vacated, then re-tested
if obDir == 1 and low  > obHigh
    _obLeftZone := true
if obDir == -1 and high < obLow
    _obLeftZone := true
if obDir != 0 and _obLeftZone and not obMitigated
    if obDir == 1 and low  <= obHigh
        obMitigated := true
    if obDir == -1 and high >= obLow
        obMitigated := true

// ============================================================================
// SECTION 7: POI SCORING SYSTEM
// ============================================================================

poiScore = 0
poiScore += (fvgActive ? 1 : 0)
// v17.75: Institutional OB dominates POI. Threshold gates downstream are integer-
// calibrated, so Simple OB keeps its +1 and Institutional OB adds a +2 bonus.
poiScore += (obInstitutional ? 2 : ((priceInBullOB or priceInBearOB) ? 1 : 0))
poiScore += (inKillZone() ? 1 : 0)
poiScore += (h4Bias != 0 ? 1 : 0)
poiScore += (structureStateCode >= 3 ? 1 : 0)

// v17.56.6: OTE Depth Bonus — "Picky Eater" Enhancement
// Rewards deep retests at optimal Fibonacci levels (70.5%-79% OTE zone)
// For Bullish: price deep in Discount/OTE (h4FibLevel <= 30%)
// For Bearish: price deep in Premium/OTE (h4FibLevel >= 70%)
// ========================================================================
bool oteDepthBonus = false

// For Bullish Bias: Check if price is deep in Discount/OTE area
if h4ActiveBias > 0
    if h4FibLevel <= 30.0  // Price at or below 30% = deep in OTE discount zone
        poiScore += 1
        oteDepthBonus := true

// For Bearish Bias: Check if price is deep in Premium/OTE area
if h4ActiveBias < 0
    if h4FibLevel >= 70.0  // Price at or above 70% = deep in OTE premium zone
        poiScore += 1
        oteDepthBonus := true

// v17.57: PDH/PDL Liquidity Bonus
// Rewards price interacting with previous-day institutional liquidity levels.
// +1 when price is near PDH or PDL (within 15% of the PDH-PDL range).
// Mirrors the OTE depth bonus pattern: max poiScore raised from 6 -> 7.
bool pdhlBonus = false
if nearPDHL
    poiScore += 1
    pdhlBonus := true

// ============================================================================
// SECTION 8: DISPLACEMENT TRAP (DT) STATE MACHINE
// ============================================================================

var int dtStage = 0
var int dtDir   = 0
var int dtLastProgressBar = 0  // v17.5: Track last bar where dtStage advanced

displacement = math.abs(close - open) / atrValue

sweepHigh = high > lastSwingHigh and close < lastSwingHigh
sweepLow  = low < lastSwingLow and close > lastSwingLow

// v17.5 FIX 2: dtStage RESET CONDITIONS (prevents permanent "Stage 5/5")
// Reset on H4 bias change
if h4BiasChanged
    dtStage := 0
    dtDir   := 0
    dtLastProgressBar := bar_index

// Reset on session/day boundary
if newDay != 0
    dtStage := 0
    dtDir   := 0
    dtLastProgressBar := bar_index

// Inactivity decay: auto-reset if no progression in 30 bars
if dtStage > 0 and (bar_index - dtLastProgressBar) > 30
    dtStage := 0
    dtDir   := 0

// --- Normal DT progression (unchanged from v17.5) ---
if dtStage == 0
    if h4Bias == 1 and sweepLow
        dtStage := 2
        dtDir   := 1
        dtLastProgressBar := bar_index
    if h4Bias == -1 and sweepHigh
        dtStage := 2
        dtDir   := -1
        dtLastProgressBar := bar_index

// v17.2: Relaxed from 1.5 to 1.2× ATR
if dtStage == 2 and displacement > 1.2
    dtStage := 3
    dtLastProgressBar := bar_index

if dtStage == 3 and fvgActive
    dtStage := 4
    dtLastProgressBar := bar_index

if dtStage == 4
    if dtDir == 1 and close <= fvgTop and close >= fvgBot
        dtStage := 5
        dtLastProgressBar := bar_index
    if dtDir == -1 and close >= fvgBot and close <= fvgTop
        dtStage := 5
        dtLastProgressBar := bar_index

if dtDir == 1 and chochDn
    dtStage := 0
    dtDir   := 0
if dtDir == -1 and chochUp
    dtStage := 0
    dtDir   := 0

// ============================================================================
// v17.58: 5-STATE SEQUENCE MACHINE (THE GATE)
// ----------------------------------------------------------------------------
// A latching state machine that enforces the institutional order of operations:
//   State1 LOCATION     — price in discount (longs) / premium (shorts) of BOS range
//   State2 LIQUIDITY    — a sweep of resting liquidity in the trade direction
//   State3 DISPLACEMENT — M5 Market-Structure-Shift (MSS) + displacement candle
//   State4 MITIGATION   — retrace into an OB or FVG in the trade direction
//   State5 EXECUTION    — inside the NY kill zone (08:00–12:00 EST)
// States only advance in order and latch until a BOS-trend flip or a new day
// resets the sequence. When strictSequence=true the alert layer requires the
// full sequence to be satisfied before firing.
// ============================================================================
// M5 Market Structure Shift (closed/confirmed bar, non-repaint)
// v17.85.14: M5 bull/bear MSS bundled into ONE tuple request.security call
// (same symbol/"5"/lookahead_off) — identical values, fewer compiled tokens.
[m5BullMSS, m5BearMSS] = request.security(syminfo.tickerid, "5", [ta.crossover(close, ta.highest(high, 10)[1]), ta.crossunder(close, ta.lowest(low, 10)[1])], lookahead=barmerge.lookahead_off)

var int  sequenceState  = 0
var bool state1Complete = false
var bool state2Complete = false
var bool state3Complete = false
var bool state4Complete = false
var bool state5Complete = false
var int  seqDir         = 0    // 1 = long, -1 = short, 0 = none

// Direction-aware raw conditions (evaluated every bar)
bool seqSweepLong  = pdlSwept or sweepLow
bool seqSweepShort = pdhSwept or sweepHigh
bool seqDispLong   = m5BullMSS and displacement > 1.0
bool seqDispShort  = m5BearMSS and displacement > 1.0
// v17.75: OB pathway to 'Ready' requires an Institutional OB when the toggle is on.
// FVG mitigation remains a valid alternative pathway.
bool _seqOBLong    = priceInBullOB and (obInstitutional or not requireInstOBForSeq)
bool _seqOBShort   = priceInBearOB and (obInstitutional or not requireInstOBForSeq)
bool seqMitLong    = _seqOBLong  or (fvgDir == 1 and close <= fvgTop and close >= fvgBot)
bool seqMitShort   = _seqOBShort or (fvgDir == -1 and close <= fvgTop and close >= fvgBot)
bool seqExecNow    = isNYSession

// Reset on BOS-trend flip or new trading day
if (bosTrend != seqDir and seqDir != 0) or newDay != 0
    state1Complete := false
    state2Complete := false
    state3Complete := false
    state4Complete := false
    state5Complete := false
    sequenceState  := 0
    seqDir         := 0

if enableSequence
    // STATE 1: LOCATION
    if not state1Complete
        if bosTrend == 1 and inDiscountZone
            state1Complete := true
            seqDir         := 1
            sequenceState  := 1
        else if bosTrend == -1 and inPremiumZone
            state1Complete := true
            seqDir         := -1
            sequenceState  := 1
    // STATE 2: LIQUIDITY SWEEP
    if state1Complete and not state2Complete
        if (seqDir == 1 and seqSweepLong) or (seqDir == -1 and seqSweepShort)
            state2Complete := true
            sequenceState  := 2
    // STATE 3: DISPLACEMENT (M5 MSS + displacement)
    if state2Complete and not state3Complete
        if (seqDir == 1 and seqDispLong) or (seqDir == -1 and seqDispShort)
            state3Complete := true
            sequenceState  := 3
    // STATE 4: MITIGATION (retrace into OB/FVG)
    if state3Complete and not state4Complete
        if (seqDir == 1 and seqMitLong) or (seqDir == -1 and seqMitShort)
            state4Complete := true
            sequenceState  := 4
    // STATE 5: EXECUTION (NY kill zone)
    if state4Complete and not state5Complete
        if seqExecNow
            state5Complete := true
            sequenceState  := 5

bool sequenceComplete    = state5Complete
bool liquiditySwept      = state2Complete
bool ltfShiftDetected    = state3Complete
bool displacementDetected = displacement > 1.0

string mitigationZone = "NONE"
if seqDir == 1
    mitigationZone := priceInBullOB ? "OB" : (fvgDir == 1 and close <= fvgTop and close >= fvgBot) ? "FVG" : "NONE"
else if seqDir == -1
    mitigationZone := priceInBearOB ? "OB" : (fvgDir == -1 and close <= fvgTop and close >= fvgBot) ? "FVG" : "NONE"

string sequenceStep = ""
string missingStep  = ""
if not enableSequence
    sequenceStep := "DISABLED"
    missingStep  := "SEQUENCE OFF"
else if not state1Complete
    sequenceStep := "LOCATION"
    missingStep  := "WAIT: PREMIUM/DISCOUNT LOCATION"
else if not state2Complete
    sequenceStep := "LIQUIDITY"
    missingStep  := "WAIT: LIQUIDITY SWEEP"
else if not state3Complete
    sequenceStep := "DISPLACEMENT"
    missingStep  := "WAIT: M5 MSS + DISPLACEMENT"
else if not state4Complete
    sequenceStep := "MITIGATION"
    missingStep  := "WAIT: RETRACE INTO OB/FVG"
else if not state5Complete
    sequenceStep := "EXECUTION"
    missingStep  := "WAIT: NY KILL ZONE"
else
    sequenceStep := "COMPLETE"
    missingStep  := "READY - WATCH FOR RETRACE"

// ============================================================================
// SECTION 9: KILL ZONE & LIQUIDITY
// ============================================================================

kzCode = killZoneCode()
kzActive = enableKZ ? inKillZone() : true

var float asianHigh = na
var float asianLow  = na
if isAsian()
    asianHigh := na(asianHigh) ? high : math.max(asianHigh, high)
    asianLow  := na(asianLow) ? low : math.min(asianLow, low)

if newDay != 0
    asianHigh := na
    asianLow  := na


sweepStrength = 0
if sweepHigh or sweepLow
    sweepStrength := displacement > 1.5 ? 3 : displacement > 1.0 ? 2 : 1

// ============================================================================
// SECTION 10: GUARDIAN SYSTEM v2.0 (3-Phase Detection)
// ============================================================================

var int guardianCode = 0

guardianEqHigh = h4Eq + (h4Range * guardianNeutralPct / 200.0)
guardianEqLow  = h4Eq - (h4Range * guardianNeutralPct / 200.0)

calcGuardian(sigDir) =>
    code = 0
    if enableGuardian
        if sigDir == 1
            if close < guardianEqLow
                code := 1
            else if close > guardianEqHigh
                if sweepStrength >= 2
                    code := 3
                else
                    code := 5
            else
                code := 1
        else if sigDir == -1
            if close > guardianEqHigh
                code := 2
            else if close < guardianEqLow
                if sweepStrength >= 2
                    code := 4
                else
                    code := 6
            else
                code := 2
    else
        code := sigDir == 1 ? 1 : 2
    code

// ============================================================================
// SECTION 11: MOMENTUM SCORING
// ============================================================================

var int momentumScore = 0
rsiVal  = ta.rsi(close, 14)
stochK  = ta.stoch(close, high, low, 14)

exhaustLong  = rsiVal > 70 or stochK > 80
exhaustShort = rsiVal < 30 or stochK < 20
momentumWickRatio = math.abs(close - open) > 0 ? (high - low) / math.abs(close - open) : 1.0
momentumExhaust   = momentumWickRatio > 3.0

momentumScore := 0
if exhaustLong and structureDir == 1
    momentumScore += 1
if exhaustShort and structureDir == -1
    momentumScore += 1
if momentumExhaust
    momentumScore += 1
momentumChange = ta.change(momentumScore)
if momentumScore >= 2 and momentumChange > 0
    momentumScore := 3

momentumFlags = momentumScore >= 2 ? "WICK_HEAVY" : momentumScore >= 1 ? "DECEL" : "CLEAN"

// ============================================================================
// SECTION 12: IPM DETECTION
// ============================================================================

var bool ipmLongSetup  = false
var bool ipmShortSetup = false
var int  ipmSweepBar   = 0

ipmSwH = ta.pivothigh(high, ipmMinorSwingLen, ipmMinorSwingLen)
ipmSwL = ta.pivotlow(low, ipmMinorSwingLen, ipmMinorSwingLen)

var float ipmInducementLevel = na
ipmInduceSweepLong  = not na(ipmSwL) and low < ipmSwL and close > ipmSwL
ipmInduceSweepShort = not na(ipmSwH) and high > ipmSwH and close < ipmSwH

if enableIPM
    if ipmInduceSweepLong and h4Bias == 1 and displacement > 1.0
        ipmLongSetup := true
        ipmSweepBar  := bar_index
        ipmInducementLevel := ipmSwL
    if ipmInduceSweepShort and h4Bias == -1 and displacement > 1.0
        ipmShortSetup := true
        ipmSweepBar   := bar_index
        ipmInducementLevel := ipmSwH

if ipmLongSetup and (bar_index - ipmSweepBar) > ipmSweepMaxBars
    ipmLongSetup := false
if ipmShortSetup and (bar_index - ipmSweepBar) > ipmSweepMaxBars
    ipmShortSetup := false

// ============================================================================
// SECTION 13: AMD STATE TRACKING (v17.56.8 — Context-Aware Classification)
// ============================================================================
// v17.56.8 UPGRADE: Replaced the range-only AMD classifier with a multi-factor
// context-aware engine that weighs structure (BOS/CHoCH), displacement,
// liquidity sweeps, premium/discount location and zone interaction.
// This is a HUD/diagnostics signal only — it does NOT feed trade signal logic.
//
// f_calculateAMDState() — single classifier returning one of:
//   "ACCUMULATION" | "MANIPULATION" | "DISTRIBUTION" | "MARKUP" | "MARKDOWN"
f_calculateAMDState(bool _recentBosUp, bool _recentBosDn, bool _recentChochUp, bool _recentChochDn, bool _strongBull, bool _strongBear, bool _buySweep, bool _sellSweep, bool _premium, bool _discount, bool _equilibrium, bool _inDemand, bool _inSupply, bool _inOB, float _disp, float _rangePct) =>
    // MARKUP: bullish expansion phase
    //  - strong bullish displacement, bullish BOS or reacting from demand, not capped in premium
    bool _isMarkup = _strongBull and (_recentBosUp or _inDemand) and not _premium
    // MARKDOWN: bearish expansion phase
    //  - strong bearish displacement, bearish BOS or rejecting from supply, not capped in discount
    bool _isMarkdown = _strongBear and (_recentBosDn or _inSupply) and not _discount
    // MANIPULATION: liquidity hunt preceding a move (sweep + rejection / CHoCH)
    bool _isManip = (_buySweep or _sellSweep) and (_recentChochUp or _recentChochDn or _inDemand or _inSupply or _inOB)
    // DISTRIBUTION: consolidation at an extreme with weakening displacement inside a zone
    bool _isDistribution = (_premium or _discount) and _disp < 0.8 and (_inSupply or _inDemand or _inOB)
    // ACCUMULATION: range-bound, low displacement, equilibrium, no sweeps
    bool _isAccumulation = _rangePct < 0.4 and _disp < 0.8 and _equilibrium and not (_buySweep or _sellSweep)
    // Priority resolution: expansion > manipulation > distribution > accumulation
    string _state = "ACCUMULATION"
    if _isMarkup
        _state := "MARKUP"
    else if _isMarkdown
        _state := "MARKDOWN"
    else if _isManip
        _state := "MANIPULATION"
    else if _isDistribution
        _state := "DISTRIBUTION"
    else if _isAccumulation
        _state := "ACCUMULATION"
    else
        _state := "ACCUMULATION"
    _state

rangeSize  = ta.highest(high, amdLookback) - ta.lowest(low, amdLookback)
rangePct   = rangeSize / close * 100

// --- v17.56.8: Recent-event trackers (windowed by amdLookback) ---
var int _barsSinceBosUp     = 100000
var int _barsSinceBosDn     = 100000
var int _barsSinceChochUp   = 100000
var int _barsSinceChochDn   = 100000
var int _barsSinceSweepHigh = 100000
var int _barsSinceSweepLow  = 100000
_barsSinceBosUp     := bosUp   ? 0 : _barsSinceBosUp + 1
_barsSinceBosDn     := bosDn   ? 0 : _barsSinceBosDn + 1
_barsSinceChochUp   := chochUp ? 0 : _barsSinceChochUp + 1
_barsSinceChochDn   := chochDn ? 0 : _barsSinceChochDn + 1
_barsSinceSweepHigh := sweepHigh ? 0 : _barsSinceSweepHigh + 1
_barsSinceSweepLow  := sweepLow  ? 0 : _barsSinceSweepLow + 1

bool amdRecentBosUp   = _barsSinceBosUp   <= amdLookback
bool amdRecentBosDn   = _barsSinceBosDn   <= amdLookback
bool amdRecentChochUp = _barsSinceChochUp <= amdLookback
bool amdRecentChochDn = _barsSinceChochDn <= amdLookback
bool amdBuySweep      = _barsSinceSweepHigh <= amdLookback   // buy-side liquidity taken (highs swept)
bool amdSellSweep     = _barsSinceSweepLow  <= amdLookback   // sell-side liquidity taken (lows swept)

// --- v17.56.8: Displacement strength (ATR-based, directional) ---
bool amdStrongBull = (close > open) and displacement > 1.5
bool amdStrongBear = (close < open) and displacement > 1.5

// --- v17.56.8: Zone interaction (OB available here; S&D arrays resolve later) ---
bool amdInDemand = priceInBullOB
bool amdInSupply = priceInBearOB
bool amdInOB     = priceInBullOB or priceInBearOB

// --- v17.56.8: Classify AMD state ---
string amdState = enableAMD ? f_calculateAMDState(amdRecentBosUp, amdRecentBosDn, amdRecentChochUp, amdRecentChochDn, amdStrongBull, amdStrongBear, amdBuySweep, amdSellSweep, inPremiumZone, inDiscountZone, inEquilibriumZone, amdInDemand, amdInSupply, amdInOB, displacement, rangePct) : "NONE"

// ----------------------------------------------------------------------------
// v17.59 FIX 4: AMD VELOCITY-BASED LOGIC (SPEED beats LOCATION)
// ----------------------------------------------------------------------------
// The v17.58 classifier is LOCATION-driven (zone + structure), so a fast selloff
// printing new lows could still read "ACCUMULATION" because price sat in a zone.
// v17.59 measures the SPEED of the move over the last 10 bars in ATR units and,
// when displacement is decisive, overrides the state: a hard down-thrust is a
// MARKDOWN (not accumulation) and a hard up-thrust is a MARKUP. Inside the
// ±150% band we defer to the v17.58 zone-based classification.
float amdVelocity = na(close[10]) ? 0.0 : (close - close[10]) / math.max(nz(atrValue, 0.0), syminfo.mintick) * 100.0
bool amdVelocityMarkdown = enableAMD and amdVelocity <= -150.0
bool amdVelocityMarkup   = enableAMD and amdVelocity >=  150.0
if amdVelocityMarkdown
    amdState := "MARKDOWN"
else if amdVelocityMarkup
    amdState := "MARKUP"

// Backward-compat: keep amdPhase int + amdPhaseStr (HUD uses amdPhaseStr)
var int amdPhase = 0
amdPhase := amdState == "ACCUMULATION" ? 1 : amdState == "MANIPULATION" ? 2 : amdState == "DISTRIBUTION" ? 3 : amdState == "MARKUP" ? 4 : amdState == "MARKDOWN" ? 5 : 0
amdPhaseStr = amdState

// ============================================================================
// v17.67.2: MSS-RETRACE BYPASS — LTF-GATE PRIORITY OVERRIDE
// ============================================================================
// Detects the specific, tightly-scoped situation in which the MSS close has
// already confirmed the displacement leg in the HTF direction, so the system
// should NOT keep waiting for the M15 (LTF) structure to flip before promoting
// the MSS-Retrace setup to EXECUTION grade.
//
// Requirements (ALL must hold):
//   • Entry mode is MSS-Retrace                       (entryModeInput)
//   • HTF bias is ESTABLISHED and matches the AMD phase
//       bearish: finalHTFTrend == -1  AND amdState == "MARKDOWN"
//       bullish: finalHTFTrend ==  1  AND amdState == "MARKUP"
//   • An MSS close exists in that same direction       (mssCloseDown / mssCloseUp)
//
// mssClose* combine the M15 MSS state-machine (mssState/mssDir, from CHoCH) with
// the M5 displacement-MSS close (m5BearMSS / m5BullMSS) so either confirmation
// path qualifies. All inputs are finalized above this line.
//
// This boolean is the SINGLE switch consumed by (1) the isExecutionAllowed OR-term
// and (2) the Guardian / Align / System HUD strings. It is false for every entry
// type other than MSS-Retrace, so all other paths behave exactly as in v17.67.1.
bool mssCloseDown = (mssState >= 1 and mssDir == -1) or m5BearMSS
bool mssCloseUp   = (mssState >= 1 and mssDir == 1)  or m5BullMSS
bool isMssBypassShort = entryModeInput == "MSS-Retrace" and finalHTFTrend == -1 and amdState == "MARKDOWN" and mssCloseDown
bool isMssBypassLong  = entryModeInput == "MSS-Retrace" and finalHTFTrend == 1  and amdState == "MARKUP"   and mssCloseUp
bool isMssBypass      = isMssBypassLong or isMssBypassShort

// ============================================================================
// SECTION 13B: v17.56.8 ENHANCED POI DISPLAY SCORE (HUD/diagnostics only)
// ============================================================================
// IMPORTANT: This is a SEPARATE weighted score for HUD + Stage messaging.
// The core `poiScore` (used by all trade-signal generation) is left UNCHANGED.
// This display score adds weight for liquidity levels, premium/discount depth
// and sweep events, then caps the result at the existing /6 scale.
float poiScoreDisplay = 0.0

// Factor 1: HTF/LTF Bias Alignment
if htfBias != 0 and htfBias == ltfBias
    poiScoreDisplay += 1.0

// Factor 2: Premium/Discount Location (increased weight for depth)
if inDiscountZone
    poiScoreDisplay += 1.0
    if h4FibLevel < 30.0
        poiScoreDisplay += 0.5   // deep discount bonus
else if inPremiumZone
    poiScoreDisplay += 1.0
    if h4FibLevel > 70.0
        poiScoreDisplay += 0.5   // deep premium bonus

// Factor 3: Active Zone Proximity (OB / S&D interaction — increased weight)
if priceInBullOB or priceInBearOB
    poiScoreDisplay += 1.5

// Factor 4: Liquidity Level Proximity (Daily / Asian High-Low)
if nearDailyLevel or nearAsianLevel
    poiScoreDisplay += 1.0

// Factor 5: Sweep Events (liquidity grab bonus)
if amdBuySweep or amdSellSweep
    poiScoreDisplay += 0.5

// Factor 6: OTE Depth (reuse existing v17.56.6 bonus)
if oteDepthBonus
    poiScoreDisplay += 1.0

// Factor 7 (v17.57): PDH/PDL Liquidity Proximity
if nearPDHL
    poiScoreDisplay += 1.0

// Normalize to /7 scale (cap) — v17.57: raised from 6.0 with PDH/PDL factor
poiScoreDisplay := math.min(poiScoreDisplay, 7.0)

// ============================================================================
// v17.62.0: DIRECTIONAL POI SCORE (DISPLAY-ONLY, max 3)
// ============================================================================
// A NEW display-only counter shown in the HUD "POI" row as X/3. It counts the
// directional confluence components that AGREE with the active HTF bias:
//   LONG  bias → Bullish FVG + Bullish OB + Discount EQ
//   SHORT bias → Bearish FVG + Bearish OB + Premium EQ
// This is COMPLETELY SEPARATE from the core `poiScore` (signal generation) and
// from `poiScoreDisplay`. It is wired only into the HUD and never mutates any
// variable used by alerts or signal logic. (Follows v17.56.8 display pattern.)
bool poiDirIsLong  = finalHTFTrend == 1
bool poiDirIsShort = finalHTFTrend == -1

bool poiDirFvg = poiDirIsLong  ? (fvgActive and fvgDir == 1)  : poiDirIsShort ? (fvgActive and fvgDir == -1) : false
bool poiDirOb  = poiDirIsLong  ? priceInBullOB                : poiDirIsShort ? priceInBearOB                : false
bool poiDirEq  = poiDirIsLong  ? inDiscountZone               : poiDirIsShort ? inPremiumZone               : false

int poiDirScore = (poiDirFvg ? 1 : 0) + (poiDirOb ? 1 : 0) + (poiDirEq ? 1 : 0)

// Directional sweep (aligned with bias) for the POI breakdown row.
//   LONG bias → sell-side sweep (lows swept) | SHORT bias → buy-side sweep (highs swept)
bool poiDirSweep = poiDirIsLong ? sweepLow : poiDirIsShort ? sweepHigh : false

// ============================================================================
// v17.65.0: POI 5-COMPONENT DISPLAY SCORE (DISPLAY-ONLY, max 5)
// ============================================================================
// Supersedes the v17.62 directional POI (which was max 3). The HUD "POI" and
// "POI+" rows now both show this 5-component, bias-aligned count as X/5.
// The 5 components (all evaluated relative to the active HTF bias):
//   (1) Sweep         → bias-aligned liquidity grab (poiDirSweep)
//   (2) Order Block   → bias-aligned OB interaction  (poiDirOb)
//   (3) Fair Value Gap→ bias-aligned FVG active      (poiDirFvg)
//   (4) Displacement  → strong momentum move          (displacementDetected)
//   (5) Price Location→ Discount for BUY / Premium for SELL (poiDirEq)
// This is COMPLETELY SEPARATE from the core `poiScore` (signal generation) and
// from `poiScoreDisplay`. It is wired only into the HUD and never mutates any
// variable used by alerts or signal logic. (Follows the v17.56.8 display pattern.)
int poiScore5 = (poiDirSweep ? 1 : 0) + (poiDirOb ? 1 : 0) + (poiDirFvg ? 1 : 0) + (displacementDetected ? 1 : 0) + (poiDirEq ? 1 : 0)

// ============================================================================
// v17.62.0: 5-PILLAR CONFLUENCE SCORE (DISPLAY-ONLY, max 5)
// ============================================================================
// A NEW display-only score shown in the HUD "Confl" row as X/5. The 5 pillars:
//   (1) Location  → directional POI fully aligned (poiDirScore >= 3)
//   (2) Timing    → Kill Zone active
//   (3) Direction → HTF and LTF trend aligned (same non-zero direction)
//   (4) Momentum  → displacement active OR a BOS is present
//   (5) Readiness → Sniper Progress (dtStage) >= 4
// This is COMPLETELY SEPARATE from `confluenceScore` / `confluenceRaw` (signal
// generation + plot 8). It is wired only into the HUD and never mutates any
// variable used by alerts or signal logic.
bool pillarLocation  = poiDirScore >= 3
bool pillarTiming    = kzActive
bool pillarDirection = finalHTFTrend != 0 and finalHTFTrend == finalLTFTrend
bool pillarMomentum  = displacement > 1.0 or bosTrend != 0
bool pillarReadiness = dtStage >= 4

int confluencePillarScore = (pillarLocation ? 1 : 0) + (pillarTiming ? 1 : 0) + (pillarDirection ? 1 : 0) + (pillarMomentum ? 1 : 0) + (pillarReadiness ? 1 : 0)

// ============================================================================
// SECTION 14: v17.1 COOLDOWN & ZONE-MERGE TRACKING
// ============================================================================

// --- Cooldown tracking: bar_index of last fire per signal type & direction ---
var int lastSniperLongBar   = 0
var int lastSniperShortBar  = 0
var int lastCTLiteLongBar   = 0
var int lastCTLiteShortBar  = 0
var int lastTier2LongBar    = 0
var int lastTier2ShortBar   = 0
var int lastBuildLongBar    = 0
var int lastBuildShortBar   = 0
var int lastLiteLongBar     = 0
var int lastLiteShortBar    = 0
var int lastReEntryLongBar  = 0
var int lastReEntryShortBar = 0
// v17.66.0: V-SHAPE ENTRY LOGIC - Immediate breakout entry cooldown trackers
var int lastVShapeLongBar   = 0
var int lastVShapeShortBar  = 0

// Cooldown check function
isCooledDown(lastBar) =>
    (bar_index - lastBar) >= cooldownWindow

// --- Zone-merge tracking: prevent multiple signals in same POI zone ---
var float lastSignalZoneHigh = na
var float lastSignalZoneLow  = na
var int   lastSignalZoneBar  = 0

isNewZone() =>
    if not enableZoneMerge
        true
    else
        zoneHigh = not na(obHigh) ? obHigh : not na(fvgTop) ? fvgTop : high
        zoneLow  = not na(obLow) ? obLow : not na(fvgBot) ? fvgBot : low
        noOverlap = na(lastSignalZoneHigh) or zoneLow > lastSignalZoneHigh or zoneHigh < lastSignalZoneLow
        expired   = (bar_index - lastSignalZoneBar) > cooldownWindow * 2
        noOverlap or expired

markZoneUsed() =>
    zH = not na(obHigh) ? obHigh : not na(fvgTop) ? fvgTop : high
    zL = not na(obLow) ? obLow : not na(fvgBot) ? fvgBot : low
    [zH, zL, bar_index]

// ============================================================================
// SECTION 15: SIGNAL GENERATION (v17.3 — STATE MACHINE + H4 HARD FILTER)
// ============================================================================

// --- v17.1 FIX 2: All signals gated by barstate.isconfirmed ---
confirmed = barstate.isconfirmed

// --- Alignment check ---
alignmentOK_long  = h4Bias >= 0 and not h4Invalidated
alignmentOK_short = h4Bias <= 0 and not h4Invalidated
alignmentConflict = (h4Bias == 1 and structureDir == -1) or (h4Bias == -1 and structureDir == 1)

// --- Quality score ---
qualityScore = 0.0
qualityScore += poiScore * 15.0
qualityScore += (displacement > 1.5 ? 15.0 : displacement > 1.0 ? 10.0 : 5.0)
qualityScore += (kzActive ? 10.0 : 0.0)
qualityScore += (fvgActive ? 10.0 : 0.0)
qualityScore += (obRefineLevel >= 2 ? 10.0 : 5.0)
qualityScore := math.min(qualityScore, 100.0)

// --- Entry/SL/TP calculation ---
calcEntryLong()  => obDir == 1 ? obMid : close
calcEntrySht()   => obDir == -1 ? obMid : close
calcSLLong()     => obDir == 1 ? obLow - atrValue * 0.2 : low - atrValue * 0.5
calcSLShort()    => obDir == -1 ? obHigh + atrValue * 0.2 : high + atrValue * 0.5

entryLong  = calcEntryLong()
entryShort = calcEntrySht()
slLong     = calcSLLong()
slShort    = calcSLShort()
tpLong     = tpModeInput == "Fixed R:R" ? entryLong + (entryLong - slLong) * defaultRR : h4PremiumBottom
tpShort    = tpModeInput == "Fixed R:R" ? entryShort - (slShort - entryShort) * defaultRR : h4DiscountTop

// =========================================================================
// v17.5 FIX 1: REAL-TIME CONFLUENCE SCORE (replaces cumulative signalCounter)
// =========================================================================
// Computed fresh every bar from 6 real-time conditions. Range: 0-6.
// Subject to caps from Guardian, Kill Zone, and State Machine.
confluenceRaw = 0
confluenceRaw += (dtStage >= 4 ? 1 : 0)             // (1) Sniper Progress advanced
confluenceRaw += (poiScore >= 3 ? 1 : 0)             // (2) POI quality threshold
confluenceRaw += (displacement >= 0.5 ? 1 : 0)       // (3) Displacement active
confluenceRaw += (momentumScore < 2 ? 1 : 0)          // (4) Momentum clean
confluenceRaw += (kzActive ? 1 : 0)                   // (5) Kill Zone active
confluenceRaw += (not alignmentConflict ? 1 : 0)      // (6) Alignment valid
confluenceRaw += (nearDailyLevel ? 1 : 0)             // (7) v17.16: Daily H/L proximity
confluenceRaw += (nearAsianLevel ? 1 : 0)             // (8) v17.16: Asian H/L proximity

// Hard gate: cannot exceed 3 unless minimum quality thresholds met
confluenceScore = confluenceRaw
if not (poiScore >= 3 and displacement >= 0.5)
    confluenceScore := math.min(confluenceScore, 3)

// v17.85.22a: Invalidation dedup — composite key (bar_index*10 + reason) vs bar-only.
var int lastInvalKeyLong  = -1
var int lastInvalKeyShort = -1

// --- Guardian for each direction (computed once, used everywhere) ---
guardLong  = calcGuardian(1)
guardShort = calcGuardian(-1)
guardianCode := h4Bias >= 0 ? guardLong : guardShort

sniperLabelLong  = guardLong == 1 ? "🎯 SNIPER BUY" : guardLong == 3 ? "🔄 CONTINUATION BUY" : guardLong == 5 ? "🚀 TREND EXPANSION" : ""
sniperLabelShort = guardShort == 2 ? "🎯 SNIPER SELL" : guardShort == 4 ? "🔄 CONTINUATION SELL" : guardShort == 6 ? "🚀 TREND EXPANSION" : ""

// Re-entry state vars
var bool reEntryLongArmed  = false
var bool reEntryShortArmed = false
var float reEntryLongLevel = na
var float reEntryShortLevel = na

// =========================================================================
// SECTION 15A: v17.3 HARD INVALIDATION ENGINE (directional + guardian aware)
// =========================================================================

// Guardian directional state + WAITING downgrade memory
guardianLongActionable  = guardLong == 1 or guardLong == 3 or guardLong == 5
guardianShortActionable = guardShort == 2 or guardShort == 4 or guardShort == 6
guardianWaiting = enableGuardian and (alignmentConflict or (h4Bias == 0 and dtStage < 3) or (not guardianLongActionable and not guardianShortActionable))
guardianDowngradeToWaiting = confirmed and guardianWaiting and not guardianWasWaiting

// Directional invalidation trigger components (6 hard rules)
structureFlipAgainstLong  = confirmed and (chochDn or bosDn or m15BearBreak)
structureFlipAgainstShort = confirmed and (chochUp or bosUp or m15BullBreak)
alignmentShiftAgainstLong  = confirmed and alignmentConflict and structureDir == -1
alignmentShiftAgainstShort = confirmed and alignmentConflict and structureDir == 1
// v17.2 FIX: POI drop only invalidates if score drops to 0
poiDropAgainstLong  = confirmed and activeLongSetup and poiScore == 0
poiDropAgainstShort = confirmed and activeShortSetup and poiScore == 0
// v17.2 FIX: P&D shift requires crossing equilibrium
pdShiftAgainstLong  = confirmed and close < h4Eq and close[1] >= h4Eq
pdShiftAgainstShort = confirmed and close > h4Eq and close[1] <= h4Eq
// v17.2 FIX: Liquidity reversal requires sweep AGAINST setup direction with displacement
liquidityReversalAgainstLong  = confirmed and sweepHigh and displacement > 1.0 and activeLongSetup
liquidityReversalAgainstShort = confirmed and sweepLow and displacement > 1.0 and activeShortSetup

longInvalidationTrigger  = structureFlipAgainstLong or alignmentShiftAgainstLong or (guardianDowngradeToWaiting and activeLongSetup) or poiDropAgainstLong or pdShiftAgainstLong or liquidityReversalAgainstLong
shortInvalidationTrigger = structureFlipAgainstShort or alignmentShiftAgainstShort or (guardianDowngradeToWaiting and activeShortSetup) or poiDropAgainstShort or pdShiftAgainstShort or liquidityReversalAgainstShort

longKilledThisBar  = confirmed and activeLongSetup and longInvalidationTrigger
shortKilledThisBar = confirmed and activeShortSetup and shortInvalidationTrigger

longInvalidationReason = structureFlipAgainstLong ? 1 : alignmentShiftAgainstLong ? 2 : guardianDowngradeToWaiting ? 3 : poiDropAgainstLong ? 4 : pdShiftAgainstLong ? 5 : liquidityReversalAgainstLong ? 6 : 0
shortInvalidationReason = structureFlipAgainstShort ? 1 : alignmentShiftAgainstShort ? 2 : guardianDowngradeToWaiting ? 3 : poiDropAgainstShort ? 4 : pdShiftAgainstShort ? 5 : liquidityReversalAgainstShort ? 6 : 0

// =========================================================================
// v17.3 PRIORITY 3: FUNCTIONAL INVALIDATION — Reset state machine on kill
// =========================================================================
if longKilledThisBar
    longInvalidated := true
    activeLongSetup := false
    reEntryLongArmed := false
    invalidationReasonLong := longInvalidationReason
    // v17.3: RESET STATE MACHINE — allow new signals after invalidation
    smStateLong := 0
    smEntryLong := na
    smSLLong    := na
    smTPLong    := na
    // v17.5 FIX 2: Reset Sniper Progress on invalidation
    dtStage := 0
    dtDir   := 0

if shortKilledThisBar
    shortInvalidated := true
    activeShortSetup := false
    reEntryShortArmed := false
    invalidationReasonShort := shortInvalidationReason
    // v17.3: RESET STATE MACHINE — allow new signals after invalidation
    smStateShort := 0
    smEntryShort := na
    smSLShort    := na
    smTPShort    := na
    // v17.5 FIX 2: Reset Sniper Progress on invalidation
    dtStage := 0
    dtDir   := 0

// =========================================================================
// SECTION 15B: RAW SIGNAL CONDITIONS (before hierarchy/cooldown)
// =========================================================================

// --- TIER 1 (SNIPER) --- 
// v17.2 FIX: Removed duplicate displacement >= 1.5 (already enforced at DT stage 2→3).
// v17.2 FIX: Relaxed POI from >= 4 to >= 3.
tier1LongRaw = dtStage >= 5 and dtDir == 1 and poiScore >= 3 and alignmentOK_long and kzActive and not h4Invalidated and momentumScore < 3
tier1ShortRaw = dtStage >= 5 and dtDir == -1 and poiScore >= 3 and alignmentOK_short and kzActive and not h4Invalidated and momentumScore < 3

// --- TIER 2 ---
tier2LongRaw = dtStage >= 4 and dtDir == 1 and poiScore >= 3 and alignmentOK_long and displacement >= 1.0 and not h4Invalidated
tier2ShortRaw = dtStage >= 4 and dtDir == -1 and poiScore >= 3 and alignmentOK_short and displacement >= 1.0 and not h4Invalidated

// MSS-Retrace aware override
tier2RetraceLong  = tier2LongRaw or (mssState >= 1 and mssDir == 1 and dtStage >= 4 and poiScore >= 3 and not h4Invalidated)
tier2RetraceShort = tier2ShortRaw or (mssState >= 1 and mssDir == -1 and dtStage >= 4 and poiScore >= 3 and not h4Invalidated)

// --- BUILDING ---
buildingLongRaw  = dtStage >= 3 and dtStage < 5 and dtDir == 1 and poiScore >= minPOIforAlerts and sweepStrength >= 1
buildingShortRaw = dtStage >= 3 and dtStage < 5 and dtDir == -1 and poiScore >= minPOIforAlerts and sweepStrength >= 1

// --- LITE ---
liteLongRaw  = biasAlignedLong and kzActive and poiScore >= 2 and not h4Invalidated and structureStateCode < 3 and sweepStrength >= 1
liteShortRaw = biasAlignedShort and kzActive and poiScore >= 2 and not h4Invalidated and structureStateCode < 3 and sweepStrength >= 1

// --- CT LITE ---
// v17.1 FIX 4: Guardian gates CT Lite too. Also suppress during CONFLICT.
ctLiteLongRaw  = h4Bias == -1 and structureDir == 1 and structureStateCode >= 3 and kzActive and poiScore >= 2 and not h4Invalidated and not alignmentConflict and (guardLong == 1 or guardLong == 3 or not enableGuardian)
ctLiteShortRaw = h4Bias == 1 and structureDir == -1 and structureStateCode >= 3 and kzActive and poiScore >= 2 and not h4Invalidated and not alignmentConflict and (guardShort == 2 or guardShort == 4 or not enableGuardian)

// ============================================================================
// SECTION 15C: v17.5 5-POINT COUNTER-TREND HARD GATE
// ============================================================================
// Applied BEFORE hierarchy/cooldown to enforce directional discipline.
//
// WITH-TREND: normal POI >= 3 threshold (already in raw conditions)
// COUNTER-TREND: ALL 5 MANDATORY checks must pass or signal is HARD BLOCKED:
//   1. POI >= 4/6 (strict, not 3/6)  // v17.56.6: denominator updated from /5 to /6
//   2. Displacement >= 0.7× ATR (strong qualifying move)
//   3. Momentum confirmation (momentumScore < 2, i.e. not exhausted)
//   4. Guardian in upgraded/confirming state (code 1-4), NOT TRAP (5/6)
//   5. Alignment NOT strongly opposed (not alignmentConflict)
//
// If ANY of the 5 checks fail → signal is COMPLETELY BLOCKED.

// --- Individual counter-trend check components (for debugging/HUD) ---
ctCheck1_poi_long   = poiScore >= 4
ctCheck1_poi_short  = poiScore >= 4
ctCheck2_disp_long  = displacement > 0.7
ctCheck2_disp_short = displacement > 0.7
ctCheck3_mom_long   = momentumScore < 2
ctCheck3_mom_short  = momentumScore < 2
ctCheck4_guard_long = guardLong >= 1 and guardLong <= 4   // NOT TRAP (5/6)
ctCheck4_guard_short= guardShort >= 1 and guardShort <= 4 // NOT TRAP (5/6)
ctCheck5_align_long = not alignmentConflict
ctCheck5_align_short= not alignmentConflict

// --- Combined 5-point counter-trend gate ---
ct5PassLong  = ctCheck1_poi_long and ctCheck2_disp_long and ctCheck3_mom_long and ctCheck4_guard_long and ctCheck5_align_long
ct5PassShort = ctCheck1_poi_short and ctCheck2_disp_short and ctCheck3_mom_short and ctCheck4_guard_short and ctCheck5_align_short

// --- Final filter: pass if WITH-TREND, or if counter-trend AND all 5 checks pass ---
ctFilterPassLong  = not isCounterTrendLong or ct5PassLong
ctFilterPassShort = not isCounterTrendShort or ct5PassShort

// Apply hard filter to ALL raw signals
tier1LongFiltered   = tier1LongRaw and ctFilterPassLong
tier1ShortFiltered  = tier1ShortRaw and ctFilterPassShort
tier2RetraceLongF   = tier2RetraceLong and ctFilterPassLong
tier2RetraceShortF  = tier2RetraceShort and ctFilterPassShort
buildingLongF       = buildingLongRaw and ctFilterPassLong
buildingShortF      = buildingShortRaw and ctFilterPassShort
liteLongF           = liteLongRaw and ctFilterPassLong
liteShortF          = liteShortRaw and ctFilterPassShort
// CT Lite is inherently counter-trend; apply ALL 5 strict checks always
ctLiteLongFiltered  = ctLiteLongRaw and ct5PassLong
ctLiteShortFiltered = ctLiteShortRaw and ct5PassShort

// ============================================================================
// SECTION 15D: v17.3 HIERARCHY, COOLDOWN, ZONE-MERGE & STATE MACHINE
// ============================================================================

// v17.1 reset logic: once fresh directional setup appears, clear invalidated gate
newLongSetupCandidate  = confirmed and (tier1LongFiltered or tier2RetraceLongF or buildingLongF or liteLongF or ctLiteLongFiltered) and not longInvalidationTrigger
newShortSetupCandidate = confirmed and (tier1ShortFiltered or tier2RetraceShortF or buildingShortF or liteShortF or ctLiteShortFiltered) and not shortInvalidationTrigger

// ============================================================================
// v17.84.0 — MULTI-TIMEFRAME DECISION ARCHITECTURE: SCOPED LAYER STATE
// ----------------------------------------------------------------------------
// SINGLE, unambiguous, layer-scoped state used by the voting / gating / HUD
// logic downstream. These variables REPLACE the ad-hoc use of generic globals
// (inPremiumZone / inDiscountZone / htfBias / ltfBias) inside the decision path.
// They are DERIVED from the already-verified values — NO detection math (FVG /
// OB / Liquidity / range) is recomputed here. This is purely the "chain of
// command" wiring: each layer publishes its verdict under a scoped name so the
// blockers, HUD and trace can read exactly one authoritative source per layer.
// ============================================================================

// ---- LAYER 1 · H4 (MASTER TRUTH) -------------------------------------------
// Macro bias + Master Dealing Range + authoritative Premium/Discount location.
// Reuses the audited h4RangeHigh/Low anchor (see SINGLE OVERRIDE POINT) — the
// "Still in Premium/Discount" blocker reads h4_macroLocation EXCLUSIVELY.
float  h4_rangeHigh     = h4RangeHigh
float  h4_rangeLow      = h4RangeLow
float  h4_rangeEQ       = h4Eq
int    h4_macroBias     = htfBias                                   // 1 Bull / -1 Bear / 0 Neutral
string h4_macroLocation = inPremiumZone ? "PREMIUM" : inDiscountZone ? "DISCOUNT" : "EQ"

// ---- LAYER 2 · H1 (REFINEMENT) ---------------------------------------------
// Structural alignment / continuation confirmation vs the H4 master bias.
int    h1_bias          = m80_h1Bias                               // structural H1 bias (chart-independent read)
bool   h1_structAlign   = h1_bias != 0 and h1_bias == h4_macroBias  // H1 agrees with H4 macro → refinement OK

// ---- LAYER 3 · M15 (SETUP VALIDATION) --------------------------------------
// Sequence detection (Sweep → Displacement → FVG → OB). Uses the existing
// verified sequence engine output — no re-detection.
bool   m15_sequenceValid = sequenceComplete
string m15_setupState    = m15_sequenceValid ? "READY" : "NOT READY"

// ---- LAYER 4 · M5 (EXECUTION / TIMING) -------------------------------------
// Precise execution trigger. m5_trigger = displacement + confirmed MSS present;
// m5_execReady = a fresh directional setup candidate exists on this bar.
bool   m5_trigger        = displacementDetected and (mssState >= 1)
bool   m5_execReady      = newLongSetupCandidate or newShortSetupCandidate

// v17.85.10 token-fix: f_archTrace() (v17.84 Architecture Trace label) REMOVED to reclaim
// compile tokens (CE10117). It was a developer-only diagnostic label superseded by
// the Structural Leg Engine debug table (showH4ActiveDebug), which reports the same
// H4 range anchors / location / source. No trading, P&D, alert or webhook impact.
if longInvalidated and newLongSetupCandidate
    longInvalidated := false
    invalidationReasonLong := 0
if shortInvalidated and newShortSetupCandidate
    shortInvalidated := false
    invalidationReasonShort := 0

// v17.2 FIX: Don't block direction if invalidation was just cleared
allowLongDirection  = not longInvalidated
allowShortDirection = not shortInvalidated

// =========================================================================
// v17.3 STATE MACHINE GATE: Block signals if already ACTIVE in that direction
// =========================================================================
smAllowLong  = smStateLong == 0   // IDLE — can accept new signal
smAllowShort = smStateShort == 0  // IDLE — can accept new signal

// TIER 1 FINAL (highest priority — no suppression from above)
sniperLong  = confirmed and allowLongDirection and smAllowLong and enableTier1 and tier1LongFiltered and isCooledDown(lastSniperLongBar) and isNewZone()
sniperShort = confirmed and allowShortDirection and smAllowShort and enableTier1 and tier1ShortFiltered and isCooledDown(lastSniperShortBar) and isNewZone()

// TIER 2 FINAL — suppressed if Sniper active in same direction
tier2LongFire  = confirmed and allowLongDirection and smAllowLong and enableTier2 and tier2RetraceLongF and not sniperLong and isCooledDown(lastTier2LongBar) and isNewZone()
tier2ShortFire = confirmed and allowShortDirection and smAllowShort and enableTier2 and tier2RetraceShortF and not sniperShort and isCooledDown(lastTier2ShortBar) and isNewZone()

// BUILDING FINAL — suppressed if Sniper or Tier2 active
buildLongFire  = confirmed and allowLongDirection and smAllowLong and enableBuilding and buildingLongF and kzActive and not sniperLong and not tier2LongFire and isCooledDown(lastBuildLongBar)
buildShortFire = confirmed and allowShortDirection and smAllowShort and enableBuilding and buildingShortF and kzActive and not sniperShort and not tier2ShortFire and isCooledDown(lastBuildShortBar)

// LITE FINAL — suppressed if any higher tier active in same direction
liteLongFire  = confirmed and allowLongDirection and smAllowLong and enableLite and liteLongF and not sniperLong and not tier2LongFire and not buildLongFire and isCooledDown(lastLiteLongBar) and isNewZone()
liteShortFire = confirmed and allowShortDirection and smAllowShort and enableLite and liteShortF and not sniperShort and not tier2ShortFire and not buildShortFire and isCooledDown(lastLiteShortBar) and isNewZone()

// CT LITE FINAL — lowest priority
trapActiveLong  = enableHierarchy and (guardLong == 5)
trapActiveShort = enableHierarchy and (guardShort == 6)

ctLiteLongFire  = confirmed and allowLongDirection and smAllowLong and enableCTLite and ctLiteLongFiltered and not sniperLong and not (enableHierarchy and trapActiveLong) and not tier2LongFire and isCooledDown(lastCTLiteLongBar) and isNewZone()
ctLiteShortFire = confirmed and allowShortDirection and smAllowShort and enableCTLite and ctLiteShortFiltered and not sniperShort and not (enableHierarchy and trapActiveShort) and not tier2ShortFire and isCooledDown(lastCTLiteShortBar) and isNewZone()

// RE-ENTRY — arm after valid signal, fire on zone re-tap
if sniperLong or tier2LongFire
    reEntryLongArmed := true
    reEntryLongLevel := fvgBot
if sniperShort or tier2ShortFire
    reEntryShortArmed := true
    reEntryShortLevel := fvgTop

reEntryLongFire  = confirmed and allowLongDirection and smAllowLong and reEntryLongArmed and close <= reEntryLongLevel and close > slLong and isCooledDown(lastReEntryLongBar)
reEntryShortFire = confirmed and allowShortDirection and smAllowShort and reEntryShortArmed and close >= reEntryShortLevel and close < slShort and isCooledDown(lastReEntryShortBar)

if reEntryLongFire
    reEntryLongArmed := false
if reEntryShortFire
    reEntryShortArmed := false

// ============================================================================
// V-SHAPE ENTRY LOGIC - Immediate breakout entry  (v17.66.1 — UNFILTERED MODE)
// ============================================================================
// PARALLEL entry mode — runs ALONGSIDE the MSS-Retrace / Sniper / Tier signals
// above; it does NOT replace or modify any of them. It captures liquidity-grab-
// and-go "V" moves where price sweeps a prior swing (liquidity capture) and then
// leaves a valid Supply/Demand zone on a strong displacement candle, so a retest
// never comes. We therefore enter IMMEDIATELY on the breakout close.
//
// v17.66.1 — MOST AGGRESSIVE / UNFILTERED BREAKOUT MODE:
//   V-SHAPE is now COMPLETELY INDEPENDENT of Guardian and Counter-Trend logic
//   and requires NO HTF trend alignment. The following filters were REMOVED:
//     • biasAlignedLong / biasAlignedShort   (HTF trend alignment)   → REMOVED
//     • ctFilterPassLong / ctFilterPassShort (counter-trend 5-pt gate)→ REMOVED
//     • guardianLongActionable / guardianShortActionable (Guardian)   → REMOVED
//   ⇒ Counter-trend V-SHAPE entries are ALLOWED; Guardian NEVER blocks them.
//
// V-SHAPE now triggers on ONLY three core conditions:
//     (A) a valid S&D zone exists  (B) liquidity was swept  (C) strong
//     displacement breakout candle.
// Non-trend structural gates are retained (they are NOT Guardian/CT/HTF filters):
// confirmed bar, state-machine IDLE (one position/direction), Kill Zone window,
// cooldown spacing and new-zone de-dup. SL/TP remain the STANDARD zone-based
// values (calcSLLong/calcSLShort) because V-shape still feeds anyLongFired/
// anyShortFired, driving the same state-machine entry/SL/TP assignment.
// ----------------------------------------------------------------------------
// (1) Strong displacement breakout candle: large body vs full range AND a
//     meaningful ATR move (configurable, defaults 70% body + 1.0× ATR).
vsCandleRange        = high - low
vsCandleBody         = math.abs(close - open)
vsBodyRatio          = vsCandleRange > 0 ? vsCandleBody / vsCandleRange : 0.0
vsStrongDisplacement = vsBodyRatio >= vShapeBodyRatio and displacement >= vShapeDispMin

// (2) A valid S&D zone must exist (current-TF order block is the in-engine S&D).
vsValidDemandZone = obDir == 1  and not na(obHigh) and not na(obLow)
vsValidSupplyZone = obDir == -1 and not na(obHigh) and not na(obLow)

// (3) Liquidity capture: sweep of a prior swing high/low (or a PDH/PDL sweep).
vsSweptForLong  = sweepLow  or pdlSwept    // sell-side liquidity grabbed → long bias
vsSweptForShort = sweepHigh or pdhSwept    // buy-side  liquidity grabbed → short bias

// (4) Direction of the breakout candle (must close in the trade direction).
vsBullBreakout = close > open and vsStrongDisplacement
vsBearBreakout = close < open and vsStrongDisplacement

// (5) Raw V-shape setups: valid S&D zone + liquidity sweep + strong displacement ONLY.
//     v17.66.1: HTF bias alignment (biasAlignedLong/biasAlignedShort) REMOVED — no
//     trend filter; counter-trend setups are intentionally allowed.
vShapeLongRaw  = enableVShape and vsValidDemandZone and vsSweptForLong  and vsBullBreakout
vShapeShortRaw = enableVShape and vsValidSupplyZone and vsSweptForShort and vsBearBreakout

// (6) v17.66.1: Counter-trend 5-point filter (ctFilterPassLong/ctFilterPassShort)
//     REMOVED — V-SHAPE never blocks counter-trend. Pass-through (no extra gate).
vShapeLongF  = vShapeLongRaw
vShapeShortF = vShapeShortRaw

// (7) Final fire: v17.66.1 — Guardian check (guardian*Actionable / enableGuardian)
//     REMOVED so Guardian is bypassed completely. Only non-trend structural gates
//     remain: confirmed bar, state-machine IDLE, Kill Zone, cooldown, new zone.
vShapeLongFire  = confirmed and allowLongDirection  and smAllowLong  and vShapeLongF  and kzActive and isCooledDown(lastVShapeLongBar)  and isNewZone()
vShapeShortFire = confirmed and allowShortDirection and smAllowShort and vShapeShortF and kzActive and isCooledDown(lastVShapeShortBar) and isNewZone()
// ============================================================================
// END V-SHAPE ENTRY LOGIC
// ============================================================================

// ============================================================================
// SECTION 15E: UPDATE COOLDOWN + STATE MACHINE TRACKERS
// ============================================================================

// Any long signal fired this bar  (v17.66.0: V-Shape added as a parallel source)
anyLongFired = sniperLong or tier2LongFire or buildLongFire or liteLongFire or ctLiteLongFire or reEntryLongFire or vShapeLongFire
anyShortFired = sniperShort or tier2ShortFire or buildShortFire or liteShortFire or ctLiteShortFire or reEntryShortFire or vShapeShortFire

// v17.3: STATE MACHINE — activate on signal fire
if anyLongFired
    smStateLong  := 1
    smEntryLong  := entryLong
    smSLLong     := slLong
    smTPLong     := tpLong
    smBarLong    := bar_index

if anyShortFired
    smStateShort := 1
    smEntryShort := entryShort
    smSLShort    := slShort
    smTPShort    := tpShort
    smBarShort   := bar_index

// Cooldown trackers
if sniperLong
    lastSniperLongBar := bar_index
    [zh1, zl1, zb1] = markZoneUsed()
    lastSignalZoneHigh := zh1
    lastSignalZoneLow  := zl1
    lastSignalZoneBar  := zb1

if sniperShort
    lastSniperShortBar := bar_index
    [zh2, zl2, zb2] = markZoneUsed()
    lastSignalZoneHigh := zh2
    lastSignalZoneLow  := zl2
    lastSignalZoneBar  := zb2

if tier2LongFire
    lastTier2LongBar := bar_index
    [zh3, zl3, zb3] = markZoneUsed()
    lastSignalZoneHigh := zh3
    lastSignalZoneLow  := zl3
    lastSignalZoneBar  := zb3

if tier2ShortFire
    lastTier2ShortBar := bar_index
    [zh4, zl4, zb4] = markZoneUsed()
    lastSignalZoneHigh := zh4
    lastSignalZoneLow  := zl4
    lastSignalZoneBar  := zb4

if buildLongFire
    lastBuildLongBar := bar_index
if buildShortFire
    lastBuildShortBar := bar_index
if liteLongFire
    lastLiteLongBar := bar_index
if liteShortFire
    lastLiteShortBar := bar_index
if ctLiteLongFire
    lastCTLiteLongBar := bar_index
if ctLiteShortFire
    lastCTLiteShortBar := bar_index
if reEntryLongFire
    lastReEntryLongBar := bar_index
if reEntryShortFire
    lastReEntryShortBar := bar_index
// v17.66.0: V-SHAPE ENTRY LOGIC - Immediate breakout entry cooldown updates
if vShapeLongFire
    lastVShapeLongBar := bar_index
if vShapeShortFire
    lastVShapeShortBar := bar_index

// v17.1 directional setup state updates
if anyLongFired
    activeLongSetup := true
    activeShortSetup := false
    longInvalidated := false
    invalidationReasonLong := 0
if anyShortFired
    activeShortSetup := true
    activeLongSetup := false
    shortInvalidated := false
    invalidationReasonShort := 0

// Guardian transition memory update
if confirmed
    guardianWasWaiting := guardianWaiting

// ============================================================================
// SECTION 15F: v17.5 CONFLUENCE/HUD SYNCHRONIZATION LAYER
// ============================================================================
// Apply caps AFTER all signal/invalidation logic has run, using final state.

// v17.5 FIX 3: Guardian ↔ Confluence sync
// If Guardian = TRAP (5/6), cap confluence at 2
guardianIsTrap = guardianCode == 5 or guardianCode == 6
if guardianIsTrap
    confluenceScore := math.min(confluenceScore, 2)

// v17.5 FIX 4: Kill Zone visual suppression
// When outside KZ, cap confluence at 3
if not kzActive
    confluenceScore := math.min(confluenceScore, 3)

// v17.54.4: REMOVED confluence deadlock (was v17.5 FIX 5)
// Previously: "if bothIdle and not anyLongFired and not anyShortFired → confluenceScore := 0"
// This created a circular dependency: signals require confluence >= 4, but confluence
// was forced to 0 whenever no signal was active — preventing organic signal generation.
// confluenceScore now reflects real-time market conditions at all times.
bothIdle = smStateLong == 0 and smStateShort == 0

// --- Sniper Progress display value (visual only, internal dtStage unchanged) ---
// When outside KZ, downgrade display by 1 stage
// When both SM sides IDLE (and no fresh signal), show "IDLE"
dtDisplayStage = dtStage
if not kzActive and dtDisplayStage > 0
    dtDisplayStage := dtDisplayStage - 1

// --- Guardian display value (visual sync) ---
// v17.10 FIX 1: Guardian shows WAITING when H4 Bias = NEUTRAL
// Cannot suggest directional bias without confirmed H4 structure
guardianDisplayCode = guardianCode
if h4BiasNeutral
    guardianDisplayCode := 0  // 0 = WAITING (no directional suggestion)
else
    // Guardian SNIPER mode (1/2) requires confluenceScore >= 6 (v17.16: 8-component scale), else downgrade to RETRACE
    if (guardianCode == 1 or guardianCode == 2) and confluenceScore < 6
        guardianDisplayCode := guardianCode == 1 ? 3 : 4  // downgrade to RETRACE
    // Block Guardian SNIPER display when both SM sides IDLE
    if bothIdle and not anyLongFired and not anyShortFired
        if guardianDisplayCode == 1 or guardianDisplayCode == 2
            guardianDisplayCode := guardianDisplayCode == 1 ? 3 : 4

// =========================================================================
// v17.6 FEATURE 1: ACTION STEP (replaces v17.5 "Readiness" row)
// =========================================================================
// 6-state lifecycle: STANDBY → HUNTING → MONITORING → READY → ACTIVE → INVALIDATED
// Priority order: most critical state wins (checked top-down)

// Helper: Is price in the CORRECT zone for the current H4 bias?
// Bullish bias wants Discount (buy low), Bearish bias wants Premium (sell high)
bool inCorrectZoneForBias = (h4Bias == 1 and inDiscountZone) or (h4Bias == -1 and inPremiumZone)

string actionStep = "STANDBY"
color  actionStepColor = color.new(color.silver, 0)  // v17.22: uniform default

// Priority 1: INVALIDATED — hard invalidation fired recently
if longInvalidated or shortInvalidated
    actionStep     := "INVALIDATED"
    actionStepColor := color.new(color.red, 0)  // v17.22: INVALIDATED stays red

// Priority 2: ACTIVE — trade being managed by state machine
else if smStateLong == 1 or smStateShort == 1
    actionStep     := "ACTIVE"
    actionStepColor := color.new(color.silver, 0)  // v17.22: uniform

// v17.10 FIX 2: All directional states require confirmed H4 Bias (not NEUTRAL)
// Priority 3: READY — all confluences met and sniper complete
else if confluenceScore >= 4 and dtStage >= 5 and not h4BiasNeutral
    actionStep     := "READY"
    actionStepColor := color.new(color.silver, 0)  // v17.22: uniform

// Priority 4: MONITORING — in correct P&D zone but sniper stage not ready
else if inCorrectZoneForBias and dtStage < 4 and not h4BiasNeutral
    actionStep     := "MONITORING"
    actionStepColor := color.new(color.silver, 0)  // v17.22: uniform

// Priority 5: HUNTING — in KZ, aligned, but price in equilibrium (no zone hit)
// v17.10: Cannot hunt without directional bias
else if kzActive and not alignmentConflict and inEquilibriumZone and not h4BiasNeutral
    actionStep     := "HUNTING"
    actionStepColor := color.new(color.silver, 0)  // v17.22: uniform

// Priority 6: STANDBY — default (outside KZ, or bias conflict, neutral bias, or no conditions)
else
    actionStep     := "STANDBY"
    actionStepColor := color.new(color.silver, 0)  // v17.22: uniform

// =========================================================================
// v17.6 FEATURE 2: ACTION PLAN (contextual forward-looking guidance)
// =========================================================================
// Tells the trader exactly what to do next based on current state.

string actionPlan = ""

if actionStep == "INVALIDATED"
    actionPlan := "Stand down — setup killed"

else if actionStep == "ACTIVE"
    actionPlan := "Manage trade per " + entryModeInput + " rules"

// v17.10: Neutral bias gate — prioritized BEFORE directional checks
else if h4BiasNeutral
    actionPlan := "Neutral bias — wait for H4 directional confirmation"

else if not kzActive
    actionPlan := "Standby for next Kill Zone session"

else if h4BiasBullish and not inDiscountZone
    actionPlan := "Wait for Dip to Discount (Green) for Long"

else if h4BiasBearish and not inPremiumZone
    actionPlan := "Wait for Retrace to Premium (Red) for Short"

else if inCorrectZoneForBias and dtStage >= 4
    actionPlan := "Watch for Sniper Momentum/Displacement Trigger"

else if inCorrectZoneForBias and dtStage < 4
    actionPlan := "In zone — wait for Sniper Progress to advance"

else if alignmentConflict
    actionPlan := "Bias conflict — wait for alignment resolution"

else
    actionPlan := "Assess bias and zone alignment"

// ============================================================================
// SECTION 16: TRADE CONTEXT
// ============================================================================

var string tradeContext = "NEUTRAL"

if sniperLong or tier2LongFire
    if mssState >= 1 and mssDir == 1
        tradeContext := entryModeInput == "MSS-Retrace" ? (mssState == 1 ? "CONTINUATION WAITING LONG" : "MSS-R ACTIVE LONG") : "CONTINUATION ACTIVE LONG"
    else
        tradeContext := "CONTINUATION WATCH LONG"
else if sniperShort or tier2ShortFire
    if mssState >= 1 and mssDir == -1
        tradeContext := entryModeInput == "MSS-Retrace" ? (mssState == 1 ? "CONTINUATION WAITING SHORT" : "MSS-R ACTIVE SHORT") : "CONTINUATION ACTIVE SHORT"
    else
        tradeContext := "CONTINUATION WATCH SHORT"
else if momentumScore >= 2
    tradeContext := "MOMENTUM WEAKENING " + str.tostring(momentumScore) + "/3"
else if alignmentConflict
    tradeContext := "CONFLICT"
else if ctLiteLongFire or ctLiteShortFire
    tradeContext := "REVERSAL ACTIVE"
else
    tradeContext := "NEUTRAL"

// ============================================================================
// SECTION 17: VISUAL LABELS (v17.5 — DOUBLE-GATED STATE MACHINE + CT FILTER)
// ============================================================================

// v17.1 FIX 5: Track whether a primary label was placed this bar
anySignalThisBar = sniperLong or sniperShort or tier2LongFire or tier2ShortFire or buildLongFire or buildShortFire or liteLongFire or liteShortFire or ctLiteLongFire or ctLiteShortFire

// v17.5: BELT-AND-SUSPENDERS ENFORCEMENT
// Even though signal booleans already include smAllowLong/smAllowShort checks,
// we add a SECOND gate directly before every label.new() call.
// This prevents any edge case where Pine Script execution order could allow
// a label when state machine is ACTIVE.
//
// Additionally, counter-trend labels are double-checked against the 5-point gate.

// v17.5: Pre-computed label guards (checked BEFORE every label.new)
labelGuardLong  = smStateLong == 0   // ABSOLUTE: no long labels if state ACTIVE
labelGuardShort = smStateShort == 0  // ABSOLUTE: no short labels if state ACTIVE
// Counter-trend label guard: if counter-trend, must pass 5-point check
ctLabelGuardLong  = not isCounterTrendLong or ct5PassLong
ctLabelGuardShort = not isCounterTrendShort or ct5PassShort

// --- Tier 1 (Sniper) labels --- DOUBLE-GATED
if sniperLong and labelGuardLong and ctLabelGuardLong
    label.new(bar_index, low, sniperLabelLong + " " + str.tostring(entryLong, "#.#####") + "\nPOI:" + str.tostring(poiScore) + "/7", style=label.style_label_up, color=color.new(color.green, 10), textcolor=color.white, size=size.small)

if sniperShort and labelGuardShort and ctLabelGuardShort
    label.new(bar_index, high, sniperLabelShort + " " + str.tostring(entryShort, "#.#####") + "\nPOI:" + str.tostring(poiScore) + "/7", style=label.style_label_down, color=color.new(color.red, 10), textcolor=color.white, size=size.small)

// --- Tier 2 labels --- DOUBLE-GATED
if tier2LongFire and labelGuardLong and ctLabelGuardLong
    label.new(bar_index, low, "T2 LONG\n" + str.tostring(entryLong, "#.#####") + " POI:" + str.tostring(poiScore), style=label.style_label_up, color=color.new(color.teal, 20), textcolor=color.white, size=size.tiny)

if tier2ShortFire and labelGuardShort and ctLabelGuardShort
    label.new(bar_index, high, "T2 SHORT\n" + str.tostring(entryShort, "#.#####") + " POI:" + str.tostring(poiScore), style=label.style_label_down, color=color.new(color.maroon, 20), textcolor=color.white, size=size.tiny)

// --- Building labels --- DOUBLE-GATED
if buildLongFire and labelGuardLong and ctLabelGuardLong
    label.new(bar_index, low, "BUILD LONG", style=label.style_label_up, color=color.new(color.blue, 30), textcolor=color.white, size=size.tiny)

if buildShortFire and labelGuardShort and ctLabelGuardShort
    label.new(bar_index, high, "BUILD SHORT", style=label.style_label_down, color=color.new(color.purple, 30), textcolor=color.white, size=size.tiny)

// --- Lite labels --- DOUBLE-GATED
if liteLongFire and labelGuardLong and ctLabelGuardLong
    label.new(bar_index, low, "LITE ↑", style=label.style_label_up, color=color.new(color.lime, 40), textcolor=color.black, size=size.tiny)

if liteShortFire and labelGuardShort and ctLabelGuardShort
    label.new(bar_index, high, "LITE ↓", style=label.style_label_down, color=color.new(color.orange, 40), textcolor=color.black, size=size.tiny)

// --- CT Lite labels --- DOUBLE-GATED (always counter-trend, always needs 5-point)
if ctLiteLongFire and labelGuardLong and ct5PassLong
    label.new(bar_index, low, "CT LITE ↑", style=label.style_label_up, color=color.new(color.yellow, 20), textcolor=color.black, size=size.tiny)

if ctLiteShortFire and labelGuardShort and ct5PassShort
    label.new(bar_index, high, "CT LITE ↓", style=label.style_label_down, color=color.new(color.yellow, 20), textcolor=color.black, size=size.tiny)

// --- v17.3 invalidation markers --- show reason and reset state
longReasonText = invalidationReasonLong == 1 ? "Structure Flip" : invalidationReasonLong == 2 ? "Alignment Shift" : invalidationReasonLong == 3 ? "Guardian WAITING" : invalidationReasonLong == 4 ? "POI Drop" : invalidationReasonLong == 5 ? "P&D Shift" : invalidationReasonLong == 6 ? "Sweep Reversal" : "Hard Rule"
shortReasonText = invalidationReasonShort == 1 ? "Structure Flip" : invalidationReasonShort == 2 ? "Alignment Shift" : invalidationReasonShort == 3 ? "Guardian WAITING" : invalidationReasonShort == 4 ? "POI Drop" : invalidationReasonShort == 5 ? "P&D Shift" : invalidationReasonShort == 6 ? "Sweep Reversal" : "Hard Rule"

// v17.85.22a: composite-key dedup — unique label per (bar, reason) pair.
int _iKeyL = bar_index * 10 + invalidationReasonLong
int _iKeyS = bar_index * 10 + invalidationReasonShort
if longKilledThisBar and _iKeyL != lastInvalKeyLong
    label.new(bar_index, high + atrValue * 0.2, "✗ LONG\n" + longReasonText, style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white, size=size.tiny)
    lastInvalKeyLong := _iKeyL
if shortKilledThisBar and _iKeyS != lastInvalKeyShort
    label.new(bar_index, low - atrValue * 0.2, "✗ SHORT\n" + shortReasonText, style=label.style_label_up, color=color.new(color.green, 0), textcolor=color.white, size=size.tiny)
    lastInvalKeyShort := _iKeyS

// --- v17.1 FIX 5: Secondary labels only when NO signal is active nearby ---
showSecondary = showSecondaryInfo and not anySignalThisBar

if showFibWarnings and showSecondary and h4FibLevel > 78.6 and structureDir == 1
    label.new(bar_index, high, "⚠ Fib " + str.tostring(h4FibLevel, "#.#") + "%", style=label.style_label_down, color=color.new(color.orange, 50), textcolor=color.orange, size=size.tiny)

if showFibWarnings and showSecondary and h4FibLevel < 23.6 and structureDir == -1
    label.new(bar_index, low, "⚠ Fib " + str.tostring(h4FibLevel, "#.#") + "%", style=label.style_label_up, color=color.new(color.orange, 50), textcolor=color.orange, size=size.tiny)

if showPOILabels and showSecondary and poiScore >= 4
    label.new(bar_index, low - atrValue * 0.3, "POI:" + str.tostring(poiScore), style=label.style_none, textcolor=color.gray, size=size.tiny)

// ============================================================================
// SECTION 18: STRUCTURE VISUALIZATIONS
// ============================================================================

if showChoch and chochUp
    line.new(lastSwLowBar, lastSwingHigh, bar_index, lastSwingHigh, color=color.green, style=line.style_dashed, width=1)

if showChoch and chochDn
    line.new(lastSwHighBar, lastSwingLow, bar_index, lastSwingLow, color=color.red, style=line.style_dashed, width=1)

if showBOS and bosUp
    line.new(lastSwLowBar, lastSwingHigh, bar_index, lastSwingHigh, color=color.green, style=line.style_solid, width=2)

if showBOS and bosDn
    line.new(lastSwHighBar, lastSwingLow, bar_index, lastSwingLow, color=color.red, style=line.style_solid, width=2)

// ============================================================================
// SECTION 19: ZONE VISUALIZATION (v17.5 — INSTITUTIONAL S&D ZONES)
// ============================================================================

// --- H4 Premium/Discount extending zones (v17.6 — BACKGROUND LAYER, max transparency) ---
// v17.6 FEATURE 3: P&D zones rendered FIRST for background layering.
// Uses extend=extend.right so zones always extend to current view.
// Increased transparency (92%) ensures candle bodies/wicks are clearly visible.
// Red = Premium zone (upper range), Green = Discount zone (lower range).
var box   pdPremiumBox  = na
var box   pdDiscountBox = na

var line  pdPremThreshLine = na
var line  pdDiscThreshLine = na

if showH4Zones and barstate.islast
    // Delete previous boxes/lines to prevent overlapping (hatching)
    if not na(pdPremiumBox)
        box.delete(pdPremiumBox)
    if not na(pdDiscountBox)
        box.delete(pdDiscountBox)
    if not na(pdPremThreshLine)
        line.delete(pdPremThreshLine)
    if not na(pdDiscThreshLine)
        line.delete(pdDiscThreshLine)
    // v17.6: BACKGROUND LAYER — drawn FIRST, highest transparency, wide right extension
    // These render behind S&D zones and candles for clean price action visibility
    // box.new uses large right offset (+500 bars) to simulate extend-right behavior
    // v17.65.4: BLACK text labels added inside the P&D zones for visibility
    //   ("PREMIUM"/"DISCOUNT"), left-anchored so they sit at the zone's left edge.
    // v17.75.1: left edge anchored to the dealing-range start (rangeAnchorBar) so the
    // P&D shading begins at the structural range origin, not a floating 50-bar offset.
    int _pdX1 = (not na(rangeAnchorBar) and (bar_index - rangeAnchorBar) <= 490) ? rangeAnchorBar : bar_index - 50
    // v17.81.0 STAGE B: consume the ACTIVE-timeframe nested range (pdViz* scalars).
    // On H4+ charts pdViz* == the H4 macro values (no regression); on LTF charts
    // they carry that timeframe's own nested P&D. The TF tag is shown in the box.
    pdPremiumBox  := box.new(_pdX1, pdVizTop, bar_index + 500, pdVizPremBot, bgcolor=color.new(color.red, 85), border_color=color.new(color.red, 70), border_width=1, text="PREMIUM (" + pdVizTf + ")", text_color=color.black, text_size=size.small, text_halign=text.align_left, text_valign=text.align_top)
    pdDiscountBox := box.new(_pdX1, pdVizDiscTop, bar_index + 500, pdVizBot, bgcolor=color.new(color.green, 85), border_color=color.new(color.green, 70), border_width=1, text="DISCOUNT (" + pdVizTf + ")", text_color=color.black, text_size=size.small, text_halign=text.align_left, text_valign=text.align_bottom)
    // v17.11.1: Premium/Discount threshold boundary lines (subtle dashed)
    pdPremThreshLine := line.new(_pdX1, pdVizPremBot, bar_index + 50, pdVizPremBot, color=color.new(color.red, 60), style=line.style_dashed, width=1, extend=extend.right)
    pdDiscThreshLine := line.new(_pdX1, pdVizDiscTop, bar_index + 50, pdVizDiscTop, color=color.new(color.green, 60), style=line.style_dashed, width=1, extend=extend.right)

// ============================================================================
// v17.58: BOS-ANCHORED RANGE VISUALS (box.new/line.new — zero plot-budget cost)
// ----------------------------------------------------------------------------
// Highlights the structural range termination (top), origin (bottom) and the
// equilibrium midline. Boxes are drawn behind price using delete-then-recreate
// on barstate.islast. Colored by BOS trend (green=bullish, red=bearish).
// ============================================================================
var box  bosRangeBox = na
var line bosEqLine   = na
var label bosTrendLbl = na
if showBOSRange and barstate.islast
    if not na(bosRangeBox)
        box.delete(bosRangeBox)
    if not na(bosEqLine)
        line.delete(bosEqLine)
    if not na(bosTrendLbl)
        label.delete(bosTrendLbl)
    if bosRangeValid
        color _bosCol = bosTrend == 1 ? color.green : bosTrend == -1 ? color.red : color.gray
        // v17.75.2: anchor the BOS box/EQ line to the frozen dealing-range start.
        int _bosX1 = (not na(rangeAnchorBar) and (bar_index - rangeAnchorBar) <= 490) ? rangeAnchorBar : bar_index - 60
        bosRangeBox := box.new(_bosX1, bosRangeHigh, bar_index + 500, bosRangeLow, bgcolor=color.new(_bosCol, 92), border_color=color.new(_bosCol, 50), border_width=1, border_style=line.style_dotted)
        bosEqLine   := line.new(_bosX1, bosRangeEq, bar_index + 50, bosRangeEq, color=color.new(color.yellow, 30), style=line.style_dashed, width=1, extend=extend.right)
        string _bosTxt = (bosTrend == 1 ? "BOS▲ " : bosTrend == -1 ? "BOS▼ " : "BOS ") + "EQ " + str.tostring(bosRangeEq, "#.#####")
        bosTrendLbl := label.new(bar_index + 5, bosRangeEq, _bosTxt, style=label.style_label_left, color=color.new(_bosCol, 20), textcolor=color.white, size=size.small)

// v17.66.5: Optional P&D BOS diagnostic table — confirms the origin stays LOCKED
// through continuation BOS. Shows raw bosTrend, robust macroTrend, the current
// flip/continuation classification and the live locked origin anchors.
// v17.85.4: legacy "P&D BOS DEBUG" table removed (token-limit hotfix). Its origin
//           anchors (activeOriginLow/High) are superseded by the Structural Leg
//           Engine Debug Table (showH4ActiveDebug), which is the single source of truth.

// ============================================================================
// v17.54.1 FIX: MULTI-ZONE SUPPLY & DEMAND (array-based)
// ============================================================================
// v17.54.1 restores proper multi-zone rendering for 5M charts.
// Uses array-based tracking so MULTIPLE Supply and Demand zones are visible
// simultaneously, matching expected SMC zone density on lower timeframes.
//
// Detects significant reversal zones from swing structure:
// - Demand: Area where price reversed UP after making a swing low with displacement
// - Supply: Area where price reversed DOWN after making a swing high with displacement
//
// Zones are drawn as labeled boxes matching user's design:
// - Demand: Green fill, Purple border, "⬤ DEMAND" text inside
// - Supply: Orange fill, Purple border, "⬤ SUPPLY" text inside
//
// Zone lifecycle:
//   1. Created when swing point + displacement threshold met
//   2. Invalidated when price closes significantly through the zone
//   3. Maximum 10 active zones per type (oldest trimmed first)
//   4. All zone boxes redrawn on last bar for clean rendering

int maxZones = 10  // Maximum active zones per type (supply / demand)

// --- Demand zone arrays (bullish reversal areas) ---
var array<float> dTop    = array.new_float(0)
var array<float> dBot    = array.new_float(0)
var array<int>   dBar    = array.new_int(0)
var array<box>   dBoxes  = array.new_box(0)
var array<bool>  dFlip   = array.new_bool(0)   // v17.56.5: Per-zone flip classification
var array<int>   dTime   = array.new_int(0)    // v17.85.25: UNIX time of pivot origin candle
int maxZoneAge = 500       // v17.54.4: Auto-prune standard zones older than this
int flipZoneAge = 1000     // v17.56.5: Flip zones persist 2× longer

// --- Supply zone arrays (bearish reversal areas) ---
var array<float> sTop    = array.new_float(0)
var array<float> sBot    = array.new_float(0)
var array<int>   sBar    = array.new_int(0)
var array<box>   sBoxes  = array.new_box(0)
var array<bool>  sFlip   = array.new_bool(0)   // v17.56.5: Per-zone flip classification
var array<int>   sTime   = array.new_int(0)    // v17.85.25: UNIX time of pivot origin candle

// =============================================================================
// v17.56.5: FLIP ZONE INTELLIGENCE — State Tracking
// =============================================================================
// Persistent state for 3-point flip zone classification:
//   1. hadSupplyZone / hadDemandZone: Opposing zone context (criterion 1)
//   2. lastSupplyReactionBar / lastDemandReactionBar: Reaction timing (criterion 2)
//   3. displacement > 1.0: Checked at zone creation time (criterion 3)
// =============================================================================
var bool hadSupplyZone         = false  // Has a supply zone ever existed?
var bool hadDemandZone         = false  // Has a demand zone ever existed?
var int  lastSupplyReactionBar = 0      // Bar when price last touched a supply zone
var int  lastDemandReactionBar = 0      // Bar when price last touched a demand zone

// v17.56.5: Track price reactions to existing zones (updates every bar)
// Supply reaction: price touches any active supply zone (close >= sBot AND close <= sTop)
if array.size(sTop) > 0
    for _ri = 0 to array.size(sTop) - 1
        if close >= array.get(sBot, _ri) and close <= array.get(sTop, _ri)
            lastSupplyReactionBar := bar_index
            break

// Demand reaction: price touches any active demand zone (close >= dBot AND close <= dTop)
if array.size(dTop) > 0
    for _ri = 0 to array.size(dTop) - 1
        if close >= array.get(dBot, _ri) and close <= array.get(dTop, _ri)
            lastDemandReactionBar := bar_index
            break

// =============================================================================
// v17.85.18: LOCAL ZONE CLOSE-THROUGH INVALIDATION (mitigated zones disappear)
// =============================================================================
// Runs EVERY confirmed bar, AFTER reaction tracking (so a zone is still seen by
// lastSupply/DemandReactionBar before it is removed) and BEFORE the
// barstate.islast redraw block (so only surviving zones are ever redrawn).
//   • Demand mitigated when a CONFIRMED close prints BELOW its bottom
//       (close < dBot) → drop that index from dTop/dBot/dBar/dFlip.
//   • Supply mitigated when a CONFIRMED close prints ABOVE its top
//       (close > sTop) → drop that index from sTop/sBot/sBar/sFlip.
// Back-to-front iteration keeps parallel-array indices valid across
// array.remove(). Gated by barstate.isconfirmed so live/forming bars never
// invalidate prematurely (no repaint). Flip zones follow the same rule — no
// special exemption. This is a pure lifecycle fix: creation, flip
// classification, and age pruning (maxZoneAge/flipZoneAge) are untouched.
if barstate.isconfirmed
    // Demand: remove zones where price CLOSED below the zone bottom.
    if array.size(dBot) > 0
        int _mi = array.size(dBot) - 1
        while _mi >= 0
            if close < array.get(dBot, _mi)
                array.remove(dTop,  _mi)
                array.remove(dBot,  _mi)
                array.remove(dBar,  _mi)
                array.remove(dFlip, _mi)
                if array.size(dTime) > _mi
                    array.remove(dTime, _mi)  // v17.85.25
            _mi -= 1
    // Supply: remove zones where price CLOSED above the zone top.
    if array.size(sTop) > 0
        int _mj = array.size(sTop) - 1
        while _mj >= 0
            if close > array.get(sTop, _mj)
                array.remove(sTop,  _mj)
                array.remove(sBot,  _mj)
                array.remove(sBar,  _mj)
                array.remove(sFlip, _mj)
                if array.size(sTime) > _mj
                    array.remove(sTime, _mj)  // v17.85.25
            _mj -= 1

// =============================================================================
// v17.56.5: FLIP ZONE CLASSIFICATION — Demand Zones (Bullish Flip)
// =============================================================================
// A new Demand zone qualifies as FLIP if ALL 3 criteria met:
//   1. hadSupplyZone = true (opposing Supply zone existed)
//   2. lastSupplyReactionBar within 20 bars (price reacted to that Supply zone)
//   3. displacement > 1.0 (violent breakout through the Supply zone)
// =============================================================================
if not na(sdSwLow) and displacement > 0.5
    float _dBot = sdSwLow
    float _dTop = sdSwLow + atrValue * 0.5
    int   _dBar = bar_index - 2  // v17.85.32: right=2 pivot fires 2 bars back

    // v17.56.5: 3-Point Flip Zone Classification
    bool _criterion1 = hadSupplyZone                                // 1. Opposing zone existed
    bool _criterion2 = (bar_index - lastSupplyReactionBar) <= 20    // 2. Recent reaction (≤20 bars)
    bool _criterion3 = displacement > 1.0                           // 3. Strong displacement breakthrough
    bool _isFlip     = _criterion1 and _criterion2 and _criterion3

    array.push(dBot, _dBot)
    array.push(dTop, _dTop)
    array.push(dBar, _dBar)
    array.push(dFlip, _isFlip)   // v17.56.5: Track flip status per zone
    array.push(dTime, time[2])  // v17.85.32: right=2 pivot origin is 2 bars back

    // Update opposing zone state
    hadDemandZone := true
    if _isFlip
        hadSupplyZone := false   // Invalidate opposing zone context after flip

    // Trim to max zones (remove oldest = index 0)
    if array.size(dTop) > maxZones
        array.shift(dTop)
        array.shift(dBot)
        array.shift(dBar)
        array.shift(dFlip)
        array.shift(dTime)  // v17.85.25

// =============================================================================
// v17.56.5: FLIP ZONE CLASSIFICATION — Supply Zones (Bearish Flip)
// =============================================================================
// A new Supply zone qualifies as FLIP if ALL 3 criteria met:
//   1. hadDemandZone = true (opposing Demand zone existed)
//   2. lastDemandReactionBar within 20 bars (price reacted to that Demand zone)
//   3. displacement > 1.0 (violent breakout through the Demand zone)
// =============================================================================
if not na(sdSwHigh) and displacement > 0.5
    float _sTop = sdSwHigh
    float _sBot = sdSwHigh - atrValue * 0.5
    int   _sBar = bar_index - 2  // v17.85.32: right=2 pivot fires 2 bars back

    // v17.56.5: 3-Point Flip Zone Classification
    bool _criterion1 = hadDemandZone                                // 1. Opposing zone existed
    bool _criterion2 = (bar_index - lastDemandReactionBar) <= 20    // 2. Recent reaction (≤20 bars)
    bool _criterion3 = displacement > 1.0                           // 3. Strong displacement breakthrough
    bool _isFlip     = _criterion1 and _criterion2 and _criterion3

    array.push(sTop, _sTop)
    array.push(sBot, _sBot)
    array.push(sBar, _sBar)
    array.push(sFlip, _isFlip)   // v17.56.5: Track flip status per zone
    array.push(sTime, time[2])  // v17.85.32: right=2 pivot origin is 2 bars back

    // Update opposing zone state
    hadSupplyZone := true
    if _isFlip
        hadDemandZone := false   // Invalidate opposing zone context after flip

    // Trim to max zones (remove oldest = index 0)
    if array.size(sTop) > maxZones
        array.shift(sTop)
        array.shift(sBot)
        array.shift(sBar)
        array.shift(sFlip)
        array.shift(sTime)  // v17.85.25

// Invalidate demand zones: price breach OR stale age
// v17.56.5: Flip zones get 2× maxZoneAge (flipZoneAge) for longer persistence
if array.size(dTop) > 0
    int _di = array.size(dTop) - 1
    while _di >= 0
        bool _priceBreach = close < array.get(dBot, _di)
        int  _ageLimit    = array.get(dFlip, _di) ? flipZoneAge : maxZoneAge  // v17.56.5
        bool _tooOld      = (bar_index - array.get(dBar, _di)) > _ageLimit
        if _priceBreach or _tooOld
            array.remove(dTop, _di)
            array.remove(dBot, _di)
            array.remove(dBar, _di)
            array.remove(dFlip, _di)   // v17.56.5: Keep flip array in sync
            if array.size(dTime) > _di
                array.remove(dTime, _di)  // v17.85.25
        _di -= 1

// Invalidate supply zones: price breach OR stale age
// v17.56.5: Flip zones get 2× maxZoneAge (flipZoneAge) for longer persistence
if array.size(sTop) > 0
    int _si = array.size(sTop) - 1
    while _si >= 0
        bool _priceBreach = close > array.get(sTop, _si)
        int  _ageLimit    = array.get(sFlip, _si) ? flipZoneAge : maxZoneAge  // v17.56.5
        bool _tooOld      = (bar_index - array.get(sBar, _si)) > _ageLimit
        if _priceBreach or _tooOld
            array.remove(sTop, _si)
            array.remove(sBot, _si)
            array.remove(sBar, _si)
            array.remove(sFlip, _si)   // v17.56.5: Keep flip array in sync
            if array.size(sTime) > _si
                array.remove(sTime, _si)  // v17.85.25
        _si -= 1

// =============================================================================
// v17.56.5: Flip Zone Boolean — is price currently inside a flip zone?
// =============================================================================
// Used by HUD to append "(FLIP)" to zone string
var bool priceInFlipZone = false
priceInFlipZone := false

// Check if price is in any demand flip zone
if array.size(dTop) > 0
    for _fi = 0 to array.size(dTop) - 1
        if array.get(dFlip, _fi) and close >= array.get(dBot, _fi) and close <= array.get(dTop, _fi)
            priceInFlipZone := true
            break

// Check if price is in any supply flip zone
if not priceInFlipZone and array.size(sTop) > 0
    for _fi = 0 to array.size(sTop) - 1
        if array.get(sFlip, _fi) and close >= array.get(sBot, _fi) and close <= array.get(sTop, _fi)
            priceInFlipZone := true
            break

// v17.56.5: Append (FLIP) marker to HUD zone string when price is in a flip zone
if priceInFlipZone
    h4ZoneStr := h4ZoneStr + " (FLIP)"
    h4BiasStr := h4ModeTag + " " + h4DirStr + " | " + h4ZoneStr

// Draw/update all Supply & Demand zone boxes on last bar
// v17.65.1: ORIGIN-BASED PLOTTING — zones are created the moment a swing + ATR
//   displacement occurs (see the array.push blocks above); they do NOT wait for
//   a flip or a close-confirmation. Flip is only a *classification*, never a
//   gating condition for plotting. The boxes are (re)drawn here on the last bar.
// v17.65.1: gated by showCurrentSD so the current-TF zones can be hidden while
//   the new multi-timeframe (H4/H1/M15) zones remain visible.
// v17.65.3: Current chart timeframe tag (e.g. "5M", "15M", "1H", "4H", "1D") used
//   to prefix the local S&D zone labels so they read "5M DEMAND" / "5M SUPPLY",
//   matching the MTF zone labelling convention ("H4 SUPPLY", "M15 DEMAND", ...).
// v17.65.5: STANDARDIZED prefix format matching the MTF tags (M15, H1, H4 …):
//   minutes <60 → "M" + n (M1/M5/M15/M30), minutes ≥60 → "H" + n (H1/H4),
//   seconds → "S" + n, daily/weekly/monthly → "1D"/"1W"/"1MO".
string curTfTag = timeframe.isseconds  ? "S" + str.tostring(timeframe.multiplier) : timeframe.isminutes ? (timeframe.multiplier % 60 == 0 and timeframe.multiplier >= 60 ? "H" + str.tostring(int(timeframe.multiplier / 60)) : "M" + str.tostring(timeframe.multiplier)) : timeframe.isdaily ? "1D" : timeframe.isweekly ? "1W" : timeframe.ismonthly ? "1MO" : timeframe.period

if barstate.islast and showCurrentSD
    // Clean up previous boxes
    for _b in dBoxes
        box.delete(_b)
    array.clear(dBoxes)
    for _b in sBoxes
        box.delete(_b)
    array.clear(sBoxes)

    // v17.54.4: Draw Demand zones with offset guard
    // v17.65.3: standardized GREEN demand zones — fill color.new(color.green,85),
    //   solid green border (w2), CENTERED WHITE TF-tagged label ("5M DEMAND").
    if array.size(dTop) > 0
        for _i = 0 to array.size(dTop) - 1
            // v17.85.26: bounds-check + na-guard so desync never anchors to epoch
            int _dPivotTime = array.size(dTime) > _i ? array.get(dTime, _i) : na
            int _dRightTime = time + int(timeframe.in_seconds(timeframe.period) * 1000 * 10)
            string _dLabel = curTfTag + (array.get(dFlip, _i) ? " FLIP DEMAND" : " DEMAND")
            if not na(_dPivotTime)
                array.push(dBoxes, box.new(_dPivotTime, array.get(dTop, _i), _dRightTime, array.get(dBot, _i), xloc=xloc.bar_time, bgcolor=color.new(color.green, 85), border_color=color.green, border_width=2, text=_dLabel, text_size=size.large, text_color=color.black, text_halign=text.align_center, text_valign=text.align_center))

    // v17.54.4: Draw Supply zones with offset guard
    // v17.65.3: standardized ORANGE supply zones — fill color.new(color.orange,85),
    //   solid orange border (w2), CENTERED WHITE TF-tagged label ("5M SUPPLY").
    if array.size(sTop) > 0
        for _i = 0 to array.size(sTop) - 1
            // v17.85.26: bounds-check + na-guard so desync never anchors to epoch
            int _sPivotTime = array.size(sTime) > _i ? array.get(sTime, _i) : na
            int _sRightTime = time + int(timeframe.in_seconds(timeframe.period) * 1000 * 10)
            string _sLabel = curTfTag + (array.get(sFlip, _i) ? " FLIP SUPPLY" : " SUPPLY")
            if not na(_sPivotTime)
                array.push(sBoxes, box.new(_sPivotTime, array.get(sTop, _i), _sRightTime, array.get(sBot, _i), xloc=xloc.bar_time, bgcolor=color.new(color.orange, 85), border_color=color.orange, border_width=2, text=_sLabel, text_size=size.large, text_color=color.black, text_halign=text.align_center, text_valign=text.align_center))

// --- FVG micro-zones REMOVED (v17.5 Final) ---
// REMOVED: These created overlapping boxes on candles every bar while FVG was active,
// producing the hatched overlay effect on individual candles.
// FVG detection logic remains 100% active for POI scoring, signal gating, and alerts.

// =============================================================================
// v17.75: ORDER BLOCK VISUAL BOX (Institutional palette + vanishing mitigation)
// =============================================================================
// Draws a single active OB box on barstate.islast using var box + delete-redraw.
//   • Fill  : color.new(_OB_LIGHTBLUE, 80)  • Border: _OB_LIGHTBLUE (RGB 129,199,245)
//   • Institutional OB = solid, width 2 + "INST OB" tag; Simple OB = dashed, width 1
//   • x1 (left)  strictly anchored to obBar (origin candle)
//   • x2 (right) only extended while UNMITIGATED. The instant price re-tests the
//     zone (obMitigated) the box is deleted — the "vanishing act" — so used
//     zones never linger as floating no-man's-land boxes.
// =============================================================================
var box obBox = na  // Persistent OB box — delete-then-create on last bar
color _OB_LIGHTBLUE = color.rgb(129, 199, 245)  // v17.75: Pine has no color.lightblue — define it

if barstate.islast
    // Always clear the prior box first (prevents overlap/hatching + handles vanish)
    box.delete(obBox)
    if showOB and obDir != 0 and not na(obHigh) and not na(obLow) and not obMitigated
        // OB left edge strictly anchored to origin bar, with offset guard
        int _obOffset  = bar_index - obBar
        int _obSafeBar = _obOffset >= 0 and _obOffset < 4990 ? obBar : bar_index - 4990
        obBox := box.new(
             _obSafeBar,
             obHigh,
             bar_index + 10,
             obLow,
             bgcolor      = color.new(_OB_LIGHTBLUE, 80),
             border_color = _OB_LIGHTBLUE,
             border_style = obInstitutional ? line.style_solid : line.style_dashed,
             border_width = obInstitutional ? 2 : 1,
             text         = obInstitutional ? "INST OB" : "",
             text_size    = size.tiny,
             text_color   = _OB_LIGHTBLUE,
             text_halign  = text.align_left,
             text_valign  = obDir == 1 ? text.align_bottom : text.align_top
             )

// --- OB micro-zones REMOVED (v17.5 Final) ---
// REMOVED: These created overlapping boxes on candles every bar while price was in OB,
// producing the hatched overlay effect on individual candles.
// OB detection logic remains 100% active for POI scoring, signal gating, and alerts.

// ============================================================================
// v17.65.3: MULTI-TIMEFRAME SUPPLY & DEMAND ZONE DETECTION (TOP-DOWN PROPAGATION + UNIFIED PALETTE)
// ============================================================================
// Detects and plots Supply/Demand zones from H4 / H1 / M15 timeframes onto the
// current chart, colour-coded by source timeframe. DISPLAY-ONLY — these zones
// feed NOTHING into signal generation, alerts, bias, Guardian, or POI scoring.
//
// No-repaint design:
//   • request.security() uses lookahead=barmerge.lookahead_off.
//   • We read the PREVIOUS (fully closed) HTF bar via the [1] offset, so the
//     zone is only created from confirmed candle data.
//   • A zone is created on the chart bar where a NEW HTF bar opens
//     (ta.change(time(tf))), gated additionally by barstate.isconfirmed.
//
// v17.65.2: Each zone is an MtfZone object (box + geometry + state). Every bar,
// active zones EXTEND their right edge to the live bar and INVALIDATE (delete)
// once price closes through them, so only untested zones remain on the chart.
//
// Memory management: each timeframe keeps one combined MtfZone array, trimmed to
// MAX_ZONES_PER_TF (oldest box.delete()'d first) — well under the 500-box ceiling.
// ============================================================================

// --- v17.65.3: STANDARDIZED COLOUR SCHEME (all timeframes share one palette) ---
//   Supply (all TFs) → orange  |  Demand (all TFs) → green.
//   Timeframe is identified by the WHITE text label inside each box, not by
//   colour. This unifies H4/H1/M15/Current-TF zones into one clean palette.
color sdSupplyColor = color.orange   // ALL supply zones
color sdDemandColor = color.green    // ALL demand zones

const int MAX_ZONES_PER_TF = 15   // Max boxes kept per timeframe (supply+demand combined); v17.85.29: raised from 10→15 so H1 zones survive on M5 chart

// --- v17.65.2: MTF zone object — tracks geometry + state so each zone can be
//     (a) continuously EXTENDED to the live bar every tick, and
//     (b) INVALIDATED (removed) once price closes through it. ---
type MtfZone
    box   zbox        // the rendered box handle
    float top         // zone upper bound (higher price)
    float bot         // zone lower bound (lower price)
    bool  isSupply    // true = supply (broken on close ABOVE top), false = demand (broken on close BELOW bot)
    bool  active      // still untested / valid
    int   sourceTime  // v17.85.17: UNIX time of the base/order-block candle (box left anchor, xloc.bar_time)

// --- Independent zone arrays per timeframe (supply + demand combined per TF) ---
var array<MtfZone> h4Zones  = array.new<MtfZone>(0)
var array<MtfZone> h1Zones  = array.new<MtfZone>(0)
var array<MtfZone> m15Zones = array.new<MtfZone>(0)

// --- v17.85.17: MTF BASE / ORDER-BLOCK zone finder (no-repaint, closed candles) ---
//   Evaluated INSIDE the HTF security context so every [n] offset below is an HTF
//   candle (never a chart bar). The just-closed displacement candle is [1]; the
//   base/order-block search scans candles [2..lb+1] (all fully CLOSED). Returns
//   [ok, isSupply, baseTop, baseBot, baseTime]:
//     • ok        — a valid displacement WITH structural intent AND a base found
//     • isSupply  — true = bearish impulse → SUPPLY (base = last BULLISH candle)
//                   false = bullish impulse → DEMAND (base = last BEARISH candle)
//     • baseTop/Bot = high/low of the selected base candle (its FULL range)
//     • baseTime  = UNIX open-time of the base candle → box left edge (xloc.bar_time)
//   Structural-intent proxy (safe, already-available data): the displacement close
//   must break the prior local structure — the highest high (bull) / lowest low
//   (bear) of the `lb` candles ending just before the impulse. A big candle with
//   no structural break creates NO zone.
f_mtfBaseZone(int _lb, float _dm) =>
    float _o1 = open[1]
    float _c1 = close[1]
    float _a1 = ta.atr(14)[1]
    bool  _bull = _c1 > _o1
    bool  _bear = _c1 < _o1
    bool  _disp = _a1 > 0 and math.abs(_c1 - _o1) / _a1 > _dm
    // v17.85.34 CHANGE 1: compare displacement close against the immediately
    // preceding closed candle (high[2]/low[2]) instead of the absolute highest/
    // lowest of the entire lookback window. The old ta.highest(high,_lb)[2] was
    // too restrictive — many valid displacement candles failed the intent gate
    // because they didn't break the all-time high/low of a multi-candle window.
    float _pH = high[2]
    float _pL = low[2]
    bool  _intent = _bull ? (not na(_pH) and _c1 > _pH) : (_bear and not na(_pL) and _c1 < _pL)
    float _top = na
    float _bot = na
    int   _bt  = na
    bool  _ok  = false
    if _disp and _intent
        for _j = 2 to _lb + 1
            bool _opp = _bull ? (close[_j] < open[_j]) : (close[_j] > open[_j])
            if _opp
                _top := high[_j]
                _bot := low[_j]
                _bt  := time[_j]
                _ok  := true
                break
        // v17.85.34 CHANGE 2: fallback — if displacement and intent are valid but
        // no opposing base candle was found in the lookback, use the displacement
        // candle's own closed range as the zone origin. This ensures strong impulse
        // candles that consumed all opposing candles still produce a visible zone.
        // Fallback is gated by _disp and _intent, so it cannot fire from arbitrary
        // or direction-neutral candles.
        if not _ok
            _top := high[1]
            _bot := low[1]
            _bt  := time[1]
            _ok  := true
    [_ok, _bear, _top, _bot, _bt]

// One bundled request.security() per timeframe (closed candles only, no lookahead).
[h4bOk, h4bSup, h4bTop, h4bBot, h4bTime]      = request.security(syminfo.tickerid, "240", f_mtfBaseZone(mtfBaseLookback, sdMtfDispMult), lookahead=barmerge.lookahead_off)
[h1bOk, h1bSup, h1bTop, h1bBot, h1bTime]      = request.security(syminfo.tickerid, "60",  f_mtfBaseZone(mtfBaseLookback, sdMtfDispMult), lookahead=barmerge.lookahead_off)
[m15bOk, m15bSup, m15bTop, m15bBot, m15bTime] = request.security(syminfo.tickerid, "15",  f_mtfBaseZone(mtfBaseLookback, sdMtfDispMult), lookahead=barmerge.lookahead_off)

// Right-edge projection in TIME (10 chart-bars ahead) — replaces bar_index+10 so
// xloc.bar_time boxes extend correctly on sparse/thin LTF sessions.
int mtfBoxRightMs = int(timeframe.in_seconds(timeframe.period) * 1000 * 10)

// --- New-HTF-bar detectors (true on the chart bar where a new HTF bar opens) ---
bool h4NewBar  = ta.change(time("240")) != 0
bool h1NewBar  = ta.change(time("60"))  != 0
bool m15NewBar = ta.change(time("15"))  != 0

// --- v17.65.3: TOP-DOWN PROPAGATION GATE ---
//   request.security() already paints HTF zones onto whatever chart you view, but
//   a zone is only meaningful when the chart resolution is AT or BELOW its source
//   timeframe (you don't draw "M15 zones" while viewing the H4 chart). We compute
//   the chart resolution in minutes and only allow each TF's zones to propagate
//   DOWN to equal/lower chart timeframes. On a 5M chart all three (H4/H1/M15)
//   propagate down and overlay together with the local 5M zones.
float chartTfMins = timeframe.in_seconds(timeframe.period) / 60.0
bool  allowH4SD   = chartTfMins <= 240
bool  allowH1SD   = chartTfMins <= 60
bool  allowM15SD  = chartTfMins <= 15

// --- v17.65.6: MTF BOX LEFT-EDGE ANCHOR — STATE TRACKING (CRITICAL FIX) ---
//   WHY v17.65.5's offset approach failed:
//     v17.65.5 anchored the left edge at `bar_index - (MTF_min / chart_min)` — a
//     FIXED CHART-BAR COUNT (e.g. M15→3 bars on a 5M chart). That arithmetic only
//     lands on the true formation candle if EVERY chart slot contains a bar. On
//     forex during thin/illiquid windows (e.g. the Asian session) 5M bars are
//     SPARSE, so "N bars back" ≠ "N×chart_min minutes back" and the box drifts /
//     floats away from the candle that actually formed it.
//
//   THE FIX: record the REAL bar_index at which each HTF candle OPENS, then anchor
//   the zone's left edge to the just-closed candle's recorded open-bar. This pins
//   the box to the exact candle that formed it, regardless of bar gaps.
//
//   For each TF we keep two persistent state vars:
//     *CurStart  = bar_index where the CURRENTLY-FORMING HTF candle opened
//     *PrevStart = bar_index where the PREVIOUS (just-closed) HTF candle opened
//   On every new-HTF-bar event we shift Cur→Prev and set Cur=bar_index. Because
//   the zone is detected from the just-CLOSED candle's OHLC (request.security
//   open[1]/high[1]/...), *PrevStart is exactly that candle's open bar — the
//   correct, gap-proof left anchor.
var int h4CurStart   = na
var int h4PrevStart  = na
var int h1CurStart   = na
var int h1PrevStart  = na
var int m15CurStart  = na
var int m15PrevStart = na
if h4NewBar
    h4PrevStart  := h4CurStart
    h4CurStart   := bar_index
if h1NewBar
    h1PrevStart  := h1CurStart
    h1CurStart   := bar_index
if m15NewBar
    m15PrevStart := m15CurStart
    m15CurStart  := bar_index

// --- v17.85.17: Zone creator — on a NEW confirmed HTF bar, plot the base/order-
//     block zone returned by f_mtfBaseZone(). The box is anchored with
//     xloc.bar_time: its LEFT edge = the base candle's actual UNIX time (_srcTime)
//     so it sits exactly on the base candle regardless of chart-bar gaps/sparse
//     LTF sessions, and its RIGHT edge projects `mtfBoxRightMs` ahead (advanced
//     each bar by f_maintainMtfZones). Geometry is the base candle's FULL range
//     (high→low), NOT the displacement candle's open/high/low. Memory-trimmed to
//     MAX_ZONES_PER_TF (oldest deleted first). Optional origin-debug label marks
//     the base candle for visual verification.
f_createMtfBaseZone(bool _show, bool _isNew, bool _ok, bool _isSup, float _top, float _bot, int _srcTime, color _supCol, color _demCol, string _tag, bool _dbg, array<MtfZone> _arr) =>
    if _show and _isNew and barstate.isconfirmed and _ok and not na(_srcTime) and not na(_top) and not na(_bot)
        color  _col = _isSup ? _supCol : _demCol
        string _lbl = _tag + (_isSup ? " SUPPLY" : " DEMAND")
        int    _rt  = time + mtfBoxRightMs
        box _zb = box.new(_srcTime, _top, _rt, _bot, xloc=xloc.bar_time, border_color=_col, border_width=2, bgcolor=color.new(_col, 85), text=_lbl, text_size=size.small, text_color=color.black, text_halign=text.align_center, text_valign=text.align_center)
        array.push(_arr, MtfZone.new(_zb, _top, _bot, _isSup, true, _srcTime))
        if _dbg
            label.new(_srcTime, _isSup ? _top : _bot, _tag + (_isSup ? " S Base" : " D Base"), xloc=xloc.bar_time, style=_isSup ? label.style_label_down : label.style_label_up, color=color.new(_col, 20), textcolor=color.white, size=size.tiny)
        if array.size(_arr) > MAX_ZONES_PER_TF
            MtfZone _old = array.shift(_arr)
            box.delete(_old.zbox)

// --- v17.65.2: Per-bar maintenance — for every active zone in a TF array:
//       • if the TF toggle is OFF → delete + remove (clean chart),
//       • else if price has CLOSED through it (supply: close > top, demand:
//         close < bot, confirmed bar only) → INVALIDATE: delete box + remove,
//       • else → EXTEND right edge to the live bar so the zone tracks price.
//     v17.65.5: ONLY the right edge is ever updated (box.set_right); the LEFT
//       edge stays pinned to the historical formation point set at creation.
//     Iterates back-to-front so array.remove() during the loop is safe.
f_maintainMtfZones(bool _show, array<MtfZone> _arr) =>
    // MTF ZONE INVALIDATION - Delete on close through zone
    // Runs EVERY bar for the H4 / H1 / M15 zone array passed in. For every
    // active zone: a SUPPLY zone is invalidated when price CLOSES above its top
    // (close > top); a DEMAND zone is invalidated when price CLOSES below its
    // bottom (close < bot). On invalidation the box (with its embedded text
    // label) is deleted and the element is removed from the array. Iterating
    // back-to-front keeps array indices valid across array.remove().
    if array.size(_arr) > 0                          // edge case: skip empty arrays entirely
        int _i = array.size(_arr) - 1
        while _i >= 0
            MtfZone _z = array.get(_arr, _i)
            if not _show
                // Timeframe toggle OFF → remove every zone for this TF immediately.
                box.delete(_z.zbox)                  // deletes box AND its embedded label
                array.remove(_arr, _i)
            else if _z.active
                // Only test confirmed bars so live zones never repaint mid-bar.
                bool _supplyBroken = _z.isSupply and (close > _z.top)   // supply: close ABOVE top
                bool _demandBroken = (not _z.isSupply) and (close < _z.bot) // demand: close BELOW bottom
                bool _invalid = barstate.isconfirmed and (_supplyBroken or _demandBroken)
                if _invalid
                    _z.active := false               // mark dead before deletion
                    box.delete(_z.zbox)              // delete box + embedded label together
                    array.remove(_arr, _i)           // drop from the active-zone array
                else
                    box.set_right(_z.zbox, time + mtfBoxRightMs) // still valid → extend right edge in TIME (xloc.bar_time)
            _i -= 1

// --- Run per-timeframe maintenance (extend / invalidate) then detection (create) ---
f_maintainMtfZones(showH4SD,  h4Zones)
f_maintainMtfZones(showH1SD,  h1Zones)
f_maintainMtfZones(showM15SD, m15Zones)

// v17.85.17: zones now sourced from f_mtfBaseZone() (base/order-block candle) and
// anchored by base-candle TIME — NOT the displacement candle's open/high/low range.
f_createMtfBaseZone(showH4SD  and allowH4SD,  h4NewBar,  h4bOk,  h4bSup,  h4bTop,  h4bBot,  h4bTime,  sdSupplyColor, sdDemandColor, "H4",  showMtfZoneOriginDebug, h4Zones)
f_createMtfBaseZone(showH1SD  and allowH1SD,  h1NewBar,  h1bOk,  h1bSup,  h1bTop,  h1bBot,  h1bTime,  sdSupplyColor, sdDemandColor, "H1",  showMtfZoneOriginDebug, h1Zones)
f_createMtfBaseZone(showM15SD and allowM15SD, m15NewBar, m15bOk, m15bSup, m15bTop, m15bBot, m15bTime, sdSupplyColor, sdDemandColor, "M15", showMtfZoneOriginDebug, m15Zones)

// ============================================================================
// EQ LINE — line.new() implementation, v17.54.1 FINAL FIX
// ============================================================================
// Uses line.new() with delete-and-redraw for proper flat horizontal EQ line.
// Spans from zone start (bar_index - 50) to current bar, matching P&D box extent.
// No title/label — nothing appears on right price scale.
// v17.54.1: Replaced plot() to eliminate price scale label and ensure flat line.
// ============================================================================

// v17.54.1 FINAL EQ FIX — line.new() replaces plot()
var line final_eq_line = na
// v17.65.4: BLACK "EQUILIBRIUM" text label on the EQ line (delete-redraw pattern)
var label final_eq_label = na

// 1. Delete the old line every single bar to ensure NO ghosting or squiggles
line.delete(final_eq_line)
label.delete(final_eq_label)

// 2. Only draw IF the zone is currently active and valid, and user has enabled it
if showH4Zones and showEquilibriumLine and not na(pdVizEq)
    // v17.81.0 STAGE B: EQ line follows the active-timeframe nested range.
    float eq_val = pdVizEq

    // v17.75.1: Anchor the EQ line's left edge to the bar where the current dealing
    // range was last re-anchored (rangeAnchorBar) so the shading spans from the
    // structural range start to the live bar. Falls back to the legacy 50-bar
    // offset when no anchor exists yet or the anchor is beyond Pine's 500-bar
    // line/box horizontal limit.
    int _eqX1 = (not na(rangeAnchorBar) and (bar_index - rangeAnchorBar) <= 490) ? rangeAnchorBar : bar_index - 50

    // 3. Create a NEW line that spans from the start of the zone to the current bar
    final_eq_line := line.new(
         x1 = _eqX1,
         y1 = eq_val,
         x2 = bar_index,
         y2 = eq_val,
         color = color.yellow,
         width = 3,
         style = line.style_solid
         )

    // v17.65.4: BLACK label identifying the equilibrium line
    final_eq_label := label.new(_eqX1, eq_val, "EQUILIBRIUM (" + pdVizTf + ")", style=label.style_none, textcolor=color.black, size=size.small, textalign=text.align_left)

// ============================================================================
// v17.76.4: DEALING RANGE DEBUG LABEL (visual proof of the single source of truth)
// Prints the exact numbers every subsystem reads so the shading, EQ line and the
// "Still in Premium/Discount" HUD logic can be confirmed to agree on one range.
// ============================================================================
// The ENTIRE debug emission (persistent label + text build + source derivation)
// lives inside this function so the main body pays only ONE statement for it
// (Pine CE10295 "main body too long"). The var label inside the function persists
// across bars for this single call site. The source string is recomputed here
// from the same lock/valid/bosValid predicates the override used, so it can never
// disagree with the range the consumers actually read.
// v17.85.4: legacy f_drawRangeDebug() label removed (token-limit hotfix). The
//           Dealing-Range debug label (v17.76.4) is superseded by the Structural
//           Leg Engine Debug Table (showH4ActiveDebug), the single source of truth.

// ============================================================================
// SECTION 20: PLOTS (v17.5 — 59/64, CONFLUENCE SCORE REPLACES SIGNAL COUNTER)
// ============================================================================

// ============================================================================
// v17.12 FIX: Consolidated Webhook Data Plots (Reduced from 38 to 18)
// These plots use display=display.none and are referenced in alertconditions.
// Removed: Asian High/Low/Pips, AMD Phase, IPM flags, CT Lite flags, 
// Re-Entry prices (shown visually), Tier3 metrics, MSS POI levels, 
// Entry/TP Mode flags (config info, not needed in webhook).
// ============================================================================

// Core Entry/SL/TP Data (6 plots — essential for all signals)
plot(entryLong, "Alert Entry Long", display=display.none)                          // plot 0
plot(slLong, "Alert SL Long", display=display.none)                                // plot 1
plot(tpLong, "Alert TP Long", display=display.none)                                // plot 2
plot(entryShort, "Alert Entry Short", display=display.none)                        // plot 3
plot(slShort, "Alert SL Short", display=display.none)                              // plot 4
plot(tpShort, "Alert TP Short", display=display.none)                              // plot 5

// Quality & Progression Metrics (4 plots)
plot(qualityScore, "Alert Quality Score", display=display.none)                    // plot 6
plot(poiScore, "Alert POI Score", display=display.none)                            // plot 7
plot(confluenceScore, "Alert Confluence Score", display=display.none)              // plot 8
plot(dtStage, "Alert DT State", display=display.none)                              // plot 9

// H4 Structure & Zone Position (4 plots)
plot(h4Bias, "Alert H4 Bias", display=display.none)                                // plot 10
plot(pdZone, "Alert P&D Zone", display=display.none)                               // plot 11
plot(kzCode, "Alert Kill Zone", display=display.none)                              // plot 12
plot(guardianCode, "Alert Guardian Code", display=display.none)                    // plot 13

// Technical Indicators (4 plots)
plot(displacement, "Alert Displacement", display=display.none)                     // plot 14
plot(momentumScore, "Alert Momentum Score", display=display.none)                  // plot 15
plot(h4FibLevel, "Alert H4 Fib Level", display=display.none)                       // plot 16
plot(structureStateCode, "Alert Structure State", display=display.none)            // plot 17

// Removed redundant plots (previously 19-37):
// - FVG Filter, OB Refinement: Can be inferred from poiScore
// - Asian High/Low/Pips: Not critical for real-time signals
// - MSS POI Top/Bot: Internal state, not essential for webhook
// - Tier3 Confluence/PoolMask: Redundant with poiScore
// - Entry/TP Mode Flags: Configuration (static), not dynamic data
// - Momentum Flags: Can be derived from momentumScore
// - Re-Entry prices: Visualized separately via plotshape
// - AMD Phase, IPM Long/Short, CT Lite flags: Secondary alerts

// v17.54.1 FIX: EQ line now uses line.new() with delete-and-redraw (yellow, width 3)
// This replaces the plot() approach which showed "SMC PD v17:EQ" on the price scale.
// line.new() gives a proper flat horizontal line spanning the zone extent.

// v17.1 FIX 5: Consolidated signal markers — one plotshape per direction
anySigLong  = sniperLong or tier2LongFire or buildLongFire or liteLongFire or ctLiteLongFire
anySigShort = sniperShort or tier2ShortFire or buildShortFire or liteShortFire or ctLiteShortFire
sigColorLong  = sniperLong ? color.green : tier2LongFire ? color.teal : buildLongFire ? color.blue : liteLongFire ? color.lime : color.yellow
sigColorShort = sniperShort ? color.red : tier2ShortFire ? color.maroon : buildShortFire ? color.purple : liteShortFire ? color.orange : color.yellow

plotshape(anySigLong, "Signal Long", shape.circle, location.belowbar, sigColorLong, size=size.small)   // plot 43
plotshape(anySigShort, "Signal Short", shape.circle, location.abovebar, sigColorShort, size=size.small) // plot 44

// Re-Entry visual
plotshape(reEntryLongFire, "Re-Entry Long", shape.flag, location.belowbar, color.teal, size=size.tiny)  // plot 47
plotshape(reEntryShortFire, "Re-Entry Short", shape.flag, location.abovebar, color.maroon, size=size.tiny) // plot 48

// ============================================================================
// v17.16 SECTION: SIGNAL PROOF-OF-LIFE
// ============================================================================
// Tracks signals per session and provides a visual heartbeat

// --- Session Signal Counter ---
var int sessionSignalCount = 0
var int lastSessionDay = -1
currentDay = dayofweek(time)
if currentDay != lastSessionDay
    sessionSignalCount := 0
    lastSessionDay := currentDay

// Count any signal fired this bar
if anySigLong or anySigShort or reEntryLongFire or reEntryShortFire
    sessionSignalCount += 1

// --- Heartbeat: system is active when KZ is active and confluence > 0 ---
bool systemActive = kzActive and confluenceScore > 0 and not bothIdle

// --- Visual heartbeat plotshape (small dot below price when system scanning) ---
plotshape(showProofOfLife and systemActive and barstate.islast ? true : false, "Heartbeat", shape.diamond, location.bottom, color.new(color.lime, 30), size=size.tiny)  // plot: heartbeat

// --- Signal counter as hidden plot for reference ---
plot(sessionSignalCount, "Session Signal Count", display=display.none)  // plot: session counter


// Invalidation marker
plot(h4Invalidated and showInvalidation ? close : na, "H4 Invalidated", color.new(color.gray, 50), style=plot.style_cross) // plot 51

// Kill zone background
bgcolor(kzActive and enableKZ ? color.new(color.gray, 96) : na) // plot 53

// Conflict background
bgcolor(alignmentConflict ? color.new(color.red, 97) : na) // plot 54

// v17.54.1: Equilibrium now uses line.new() (yellow, width 3) — flat horizontal, no price scale label
// Previous plot() approach removed to eliminate price scale label and ensure proper flat line


// v17.1: Hierarchy suppression indicator
plot(enableHierarchy ? 1 : 0, "Hierarchy Active", display=display.none) // plot 55
plot(cooldownWindow, "Cooldown Window", display=display.none)           // plot 56

// --- v17.57: PDH/PDL hidden plots for webhook/external consumption ---
plot(nz(pdh, 0.0), "Alert PDH Value", display=display.none)             // plot 57
plot(nz(pdl, 0.0), "Alert PDL Value", display=display.none)             // plot 58
plot(nearPDH ? 1 : 0, "Alert Near PDH", display=display.none)           // plot 59
plot(nearPDL ? 1 : 0, "Alert Near PDL", display=display.none)           // plot 60
plot(pdhSwept ? 1 : 0, "Alert PDH Swept", display=display.none)         // plot 61
plot(pdlSwept ? 1 : 0, "Alert PDL Swept", display=display.none)         // plot 62

// v17.59: +8 hidden plots mirroring the new emergency-fix webhook fields
plot(htfOverrideActive ? 1 : 0, "Alert HTF Override Active", display=display.none) // plot 63
plot(ltfOverrideActive ? 1 : 0, "Alert LTF Override Active", display=display.none) // plot 64
plot(finalHTFTrend, "Alert HTF Trend Final", display=display.none)                 // plot 65
plot(finalLTFTrend, "Alert LTF Trend Final", display=display.none)                 // plot 66
plot(nz(bosAnchorTime, 0), "Alert Range Anchor Time", display=display.none)        // plot 67
plot(rangeForceExpanded ? 1 : 0, "Alert Range Force Expanded", display=display.none) // plot 68
plot(amdVelocity, "Alert AMD Velocity", display=display.none)                      // plot 69
plot(strongBearishTrend ? -1 : strongBullishTrend ? 1 : 0, "Alert Strong Trend Mode", display=display.none) // plot 70

// v17.57: +6 hidden PDH/PDL plots → 34 plot() calls, request.security() = 24. Both well under limits (≤64 / ≤40).
// TOTAL after v17.54.1: 33/64 outputs ✓ SAFE MARGIN +31
// 22 plot() + 5 plotshape() + 2 bgcolor() + 4 alertcondition() = 33 total components
// v17.54.1: -1 plot (EQ line moved from plot() to line.new() — no plot budget cost)
// v17.16 additions: +1 plotshape (heartbeat), +1 plot (session signal counter)
// S&D zones use box.new (no plot budget cost).
// v17.6 Action Step + Action Plan use table.cell only (no plot cost).

// ============================================================================
// SECTION 20B: v17.56.7 DUAL MODE ALERT SYSTEM
// ============================================================================
// Implements DATA/EXECUTION dual mode with session gating, direction validation,
// hard block rules, and guardian state validation.
// ============================================================================

// --- v17.56.7: Alert Mode Variable ---
string alertMode = na

// --- v17.56.7: Hard Block Rules — prevent junk alerts ---
// Block if POI = 0 (no confluence) or setup is INVALIDATED
bool blockSignal = poiScore == 0 or actionStep == "INVALIDATED"

// --- v17.56.7: Guardian State Validation for EXECUTION mode ---
// Only active continuation states qualify for execution-grade alerts
bool isGuardianActive = guardianDisplayCode == 3 or guardianDisplayCode == 4  // CONTINUATION BUY (3) or CONTINUATION SELL (4)

// --- v17.56.7: Direction Fix — Zone Type Validation ---
// Determine if price is currently in a Demand zone (S&D system)
bool priceInAnyDemandZone = false
if array.size(dTop) > 0
    for _dzi = 0 to array.size(dTop) - 1
        if close >= array.get(dBot, _dzi) and close <= array.get(dTop, _dzi)
            priceInAnyDemandZone := true
            break

// Determine if price is currently in a Supply zone (S&D system)
bool priceInAnySupplyZone = false
if array.size(sTop) > 0
    for _szi = 0 to array.size(sTop) - 1
        if close >= array.get(sBot, _szi) and close <= array.get(sTop, _szi)
            priceInAnySupplyZone := true
            break

// LONG validation: HTF+LTF both bullish AND price in Demand zone or Bullish OB
bool longZoneValid  = priceInAnyDemandZone or priceInBullOB
bool longBiasValid  = htfBias >= 1 and ltfBias >= 0    // HTF bullish, LTF not bearish
bool validLong      = longZoneValid and longBiasValid

// SHORT validation: HTF+LTF both bearish AND price in Supply zone or Bearish OB
bool shortZoneValid = priceInAnySupplyZone or priceInBearOB
bool shortBiasValid = htfBias <= -1 and ltfBias <= 0   // HTF bearish, LTF not bullish
bool validShort     = shortZoneValid and shortBiasValid

// --- v17.56.7: Compute direction string (validated) ---
string alertDirection = na
if validLong
    alertDirection := "LONG"
else if validShort
    alertDirection := "SHORT"
// If neither valid → alertDirection stays na → no alert fires

// --- v17.56.7: Alignment string for payload ---
string alertAlign = isWithTrend ? "WITH TREND" : isCounterTrend ? "COUNTER TREND" : "NEUTRAL"

// --- v17.56.7: DATA MODE Logic ---
// Allowed during London OR NY sessions, POI >= 3, not blocked, direction validated
bool isDataAllowed = isTradeSession and poiScore >= 3 and not blockSignal and not na(alertDirection)
if isDataAllowed
    alertMode := "DATA"

// --- v17.56.7: EXECUTION MODE Logic (overrides DATA if both qualify) ---
// Strict: NY session only, POI >= 5, WITH TREND, Guardian = CONTINUATION, direction validated
// v17.67.2 MSS-RETRACE BYPASS: the LTF/Guardian sub-clause "(isWithTrend and
//   isGuardianActive)" gains "... or isMssBypass". ADDITIVE only — for every
//   non-MSS-Retrace path isMssBypass is false, so the gate is identical to
//   v17.67.1. The isNYSession / poiScore>=5 / blockSignal / alertDirection guards
//   are untouched, so a bypass can never fire without a real directional signal.
bool isExecutionAllowed = isNYSession and poiScore >= 5 and ((isWithTrend and isGuardianActive) or isMssBypass) and not blockSignal and not na(alertDirection)
if isExecutionAllowed
    alertMode := "EXECUTION"

// --- v17.56.7 alertSessionStr REMOVED in v17.85.14 ---
// Fed ONLY the removed legacy _jsonSuffix template; the live alerts use kzStr for
// the session field, so removal is a no-op for all live behavior.

// ============================================================================
// SECTION 21: v17.13 ALERT CONSOLIDATION & HARDENING SYSTEM
// ============================================================================

// ---- Setup ID Generation (deterministic, human-readable) ----
// v17.14: Stable setup_id uses DIRECTION + ZONE only (no confluence/stage).
// This prevents the setup_id from changing every bar as scores fluctuate.
// Example: "BULL_DZ" = Bullish bias, Discount Zone
f_generate_setup_id() =>
    string biasTag = h4Bias == 1 ? "BULL" : h4Bias == -1 ? "BEAR" : "NEUT"
    string zoneTag = inDiscountZone ? "DZ" : inPremiumZone ? "PZ" : "EQ"
    biasTag + "_" + zoneTag

// v17.14: Detailed setup_id for display/logging (includes scores)
f_generate_display_id() =>
    string biasTag = h4Bias == 1 ? "BULL" : h4Bias == -1 ? "BEAR" : "NEUT"
    string zoneTag = inDiscountZone ? "DZ" : inPremiumZone ? "PZ" : "EQ"
    string cfTag   = "CF" + str.tostring(confluenceScore)
    string stTag   = "S" + str.tostring(dtStage)
    biasTag + "_" + zoneTag + "_" + cfTag + "_" + stTag

// ---- Deduplication Tracking Variables ----
var string setup_id_last_sniper_long  = ""
var int    bar_last_sniper_long       = 0
var string setup_id_last_sniper_short = ""
var int    bar_last_sniper_short      = 0
var string setup_id_last_retrace_long = ""
var int    bar_last_retrace_long      = 0
var string setup_id_last_retrace_short= ""
var int    bar_last_retrace_short     = 0

var string last_alert_type     = ""
var int    last_alert_time     = 0
var string last_alert_setup_id = ""

// v17.54.4: Tracker counters — persist across refreshes (var)
var int sniperTrades    = 0   // Total sniper signals fired (long + short)
var int activeTrades    = 0   // Currently active trade count (placeholder for state machine)
var int totalAlertsFired = 0  // Total alerts fired across all types

// ---- Cooldown Check Function (v17.14 HARDENED) ----
// Returns true ONLY if enough bars have elapsed AND the setup has changed.
// v17.13 used OR (setup change bypassed cooldown) — caused spam on history.
// v17.14 uses AND: cooldown must expire AND setup must differ from last fire.
f_alert_ready(int last_bar, string last_setup_id, string current_setup_id, int cooldown_min) =>
    float tf_minutes = timeframe.in_seconds() / 60.0
    int cooldown_bars = tf_minutes > 0 ? math.ceil(cooldown_min / tf_minutes) : 1
    int bars_elapsed = bar_index - last_bar
    bool cooldown_ok = bars_elapsed >= cooldown_bars
    bool setup_changed = current_setup_id != last_setup_id
    cooldown_ok and setup_changed

// ---- Generate Current Setup IDs ----
string current_setup_id  = f_generate_setup_id()
string current_display_id = f_generate_display_id()

// ---- Firing Condition Booleans ----

// --- SNIPER LONG ---
sniper_long_action_ready    = (actionStep == "READY")
sniper_long_confluence_ok   = (confluenceScore >= confluence_threshold_sniper)
sniper_long_stage_ok        = (dtStage >= sniper_stage_threshold)
sniper_long_guardian_ok     = (guardLong != 5 and guardLong != 6)  // Not TRAP BUY/SELL
sniper_long_state_ok        = (smStateLong == 0)  // IDLE — not BLOCKED
sniper_long_not_duplicate   = f_alert_ready(bar_last_sniper_long, setup_id_last_sniper_long, current_setup_id, alert_cooldown_minutes)

fire_sniper_long = sniper_long_action_ready and sniper_long_confluence_ok and sniper_long_stage_ok and sniper_long_guardian_ok and sniper_long_state_ok and sniper_long_not_duplicate and barstate.isconfirmed

// --- SNIPER SHORT ---
sniper_short_action_ready   = (actionStep == "READY")
sniper_short_confluence_ok  = (confluenceScore >= confluence_threshold_sniper)
sniper_short_stage_ok       = (dtStage >= sniper_stage_threshold)
sniper_short_guardian_ok    = (guardShort != 5 and guardShort != 6)  // Not TRAP BUY/SELL
sniper_short_state_ok       = (smStateShort == 0)  // IDLE — not BLOCKED
sniper_short_not_duplicate  = f_alert_ready(bar_last_sniper_short, setup_id_last_sniper_short, current_setup_id, alert_cooldown_minutes)

fire_sniper_short = sniper_short_action_ready and sniper_short_confluence_ok and sniper_short_stage_ok and sniper_short_guardian_ok and sniper_short_state_ok and sniper_short_not_duplicate and barstate.isconfirmed

// --- RETRACE LONG ---
retrace_long_in_zone        = inDiscountZone  // P&D zone == DZ
retrace_long_mode_ok        = (guardLong == 3 or guardLong == 1 or actionStep == "MONITORING")  // Guardian allows retrace/sniper buy, OR monitoring
retrace_long_confluence_ok  = (confluenceScore >= retrace_confluence_threshold)
retrace_long_not_duplicate  = f_alert_ready(bar_last_retrace_long, setup_id_last_retrace_long, current_setup_id, alert_cooldown_minutes)

fire_retrace_long = retrace_long_in_zone and retrace_long_mode_ok and retrace_long_confluence_ok and retrace_long_not_duplicate and barstate.isconfirmed

// --- RETRACE SHORT ---
retrace_short_in_zone       = inPremiumZone  // P&D zone == PZ
retrace_short_mode_ok       = (guardShort == 4 or guardShort == 2 or actionStep == "MONITORING")  // Guardian allows retrace/sniper sell, OR monitoring
retrace_short_confluence_ok = (confluenceScore >= retrace_confluence_threshold)
retrace_short_not_duplicate = f_alert_ready(bar_last_retrace_short, setup_id_last_retrace_short, current_setup_id, alert_cooldown_minutes)

fire_retrace_short = retrace_short_in_zone and retrace_short_mode_ok and retrace_short_confluence_ok and retrace_short_not_duplicate and barstate.isconfirmed

// ---- Update Tracking Variables When Alerts Fire ----
if fire_sniper_long
    setup_id_last_sniper_long := current_setup_id
    bar_last_sniper_long      := bar_index
    last_alert_type           := "SNIPER LONG"
    last_alert_time           := time
    last_alert_setup_id       := current_display_id  // v17.14: display_id for HUD
    sniperTrades    += 1  // v17.54.4: tracker counter
    totalAlertsFired += 1

if fire_sniper_short
    setup_id_last_sniper_short := current_setup_id
    bar_last_sniper_short      := bar_index
    last_alert_type            := "SNIPER SHORT"
    last_alert_time            := time
    last_alert_setup_id        := current_display_id  // v17.14: display_id for HUD
    sniperTrades    += 1  // v17.54.4: tracker counter
    totalAlertsFired += 1

if fire_retrace_long
    setup_id_last_retrace_long := current_setup_id
    bar_last_retrace_long      := bar_index
    last_alert_type            := "CONTINUATION LONG"
    last_alert_time            := time
    last_alert_setup_id        := current_display_id  // v17.14: display_id for HUD
    activeTrades     += 1  // v17.54.4: non-sniper active trade counter
    totalAlertsFired += 1  // v17.54.4: all-alerts counter

if fire_retrace_short
    setup_id_last_retrace_short := current_setup_id
    bar_last_retrace_short      := bar_index
    last_alert_type             := "CONTINUATION SHORT"
    last_alert_time             := time
    last_alert_setup_id         := current_display_id  // v17.14: display_id for HUD
    activeTrades     += 1  // v17.54.4: non-sniper active trade counter
    totalAlertsFired += 1  // v17.54.4: all-alerts counter


// ============================================================================
// v17.56.8: SNIPER COUNTER REBUILD (daily-reset, exchange day boundary)
// ============================================================================
// Replaces cumulative counters with per-day counters that reset at the
// exchange day boundary. Displayed in HUD as "Sniper Today" / "Execution Alerts".
var int sniperCountToday    = 0
var int executionAlertsToday = 0
var int lastResetDay        = dayofmonth

// Reset on new exchange day
if dayofmonth != lastResetDay
    sniperCountToday     := 0
    executionAlertsToday := 0
    lastResetDay         := dayofmonth

// A sniper signal fired this bar (sniper or continuation entry trigger)
bool sniperSignalFired = (fire_sniper_long or fire_sniper_short or fire_retrace_long or fire_retrace_short) and (isExecutionAllowed or isDataAllowed)
if sniperSignalFired
    sniperCountToday += 1

// An EXECUTION-grade alert fired this bar
bool executionAlertFired = sniperSignalFired and isExecutionAllowed
if executionAlertFired
    executionAlertsToday += 1

// ---- v17.56.7 ALERT() ARCHITECTURE ----
// v17.56.8 alert() with full-context dynamic JSON payloads.
// Includes mode (DATA/EXECUTION), session, validated direction, entry/SL/TP.
// Dual mode gating ensures only qualified alerts fire.

// --- v17.56.7: Setup string (computed after fire_ booleans are known) ---

// --- v17.56.8: Build single validated AlertState + consistency check ---
// guardianLabel expressed in LONG/SHORT terms; non-directional guardian states
// inherit the alert direction so they never falsely contradict (block only on
// genuine direction conflict).
string _guardianLS = (guardianDisplayCode == 1 or guardianDisplayCode == 3 or guardianDisplayCode == 5) ? "LONG" : (guardianDisplayCode == 2 or guardianDisplayCode == 4 or guardianDisplayCode == 6) ? "SHORT" : (na(alertDirection) ? "NONE" : alertDirection)
string _consGuardianLabel = "CONTINUATION " + _guardianLS
// Derive setupID from the SAME bias source (htfBias) that authorizes alertDirection
// (validLong/validShort). Using f_generate_setup_id() here would be wrong because it
// is built from h4Bias (a separate active-bias engine) which can legitimately differ
// from htfBias, causing the consistency check to falsely block valid alerts.
string _consZoneTag = inDiscountZone ? "DZ" : inPremiumZone ? "PZ" : "EQ"
string _consSetupID = (htfBias == 1 ? "BULL_" : htfBias == -1 ? "BEAR_" : "NEUT_") + _consZoneTag
string _consBiasTag = htfBias == 1 ? "BULLISH" : htfBias == -1 ? "BEARISH" : "NEUTRAL"
AlertState alertState = AlertState.new(na(alertDirection) ? "NONE" : alertDirection, _consSetupID, _consBiasTag, _consGuardianLabel, "", false)
bool alertConsistencyOK = not na(alertDirection) and f_validateAlertConsistency(alertState)
alertState.isValid := alertConsistencyOK

// --- v17.56.7 alertEntryStr/alertSLStr/alertTPStr REMOVED in v17.85.14 ---
// These direction-based entry/SL/TP payload strings fed ONLY the removed legacy
// _jsonSuffix template and had no other reference. The live alerts compute their
// own SL/TP inline (zone-scan in the MB_EXECUTE block; entryLong/slLong/... in the
// V-Reversal block), so removal is a no-op for all live behavior.

// --- v17.56.7 htfBiasStr/ltfBiasStr REMOVED in v17.85.14 ---
// Payload-only bias strings that fed ONLY the removed legacy _jsonSuffix template.
// The live MB_EXECUTE / V-Reversal alerts carry ebBias instead, so removal is a
// no-op for all live behavior.

// ============================================================================
// GUARDIAN HTF-GATE (v17.56.9)
// ============================================================================
// Wraps the existing Guardian label with an HTF-alignment check. Computed once
// here (before the webhook payload and HUD) so both consume the same values.
// Depends only on already-finalized state: guardianDisplayCode (Section 14),
// htfBias (bias engine), alertAlign (v17.56.7). NO core logic is altered —
// this only produces a display label string and an integer risk flag.

// Base Guardian label — identical mapping to the HUD's guardDisplayStr (below).
string _guardianBaseLabel = guardianDisplayCode == 0 ? "WAITING" : guardianDisplayCode == 1 ? "SNIPER BUY" : guardianDisplayCode == 2 ? "SNIPER SELL" : guardianDisplayCode == 3 ? "CONTINUATION BUY" : guardianDisplayCode == 4 ? "CONTINUATION SELL" : guardianDisplayCode == 5 ? "TREND EXPANSION BUY" : guardianDisplayCode == 6 ? "TREND EXPANSION SELL" : "—"

// HTF bias state for gating (htfBias is int: 1=BULLISH, -1=BEARISH, 0=NEUTRAL)
bool _htfIsBull = htfBias == 1
bool _htfIsBear = htfBias == -1

string guardian_label_display = _guardianBaseLabel
int    guardian_risk          = 0

if guardian_require_htf_match
    // CONTINUATION BUY / LONG — safe only when HTF is bullish
    if str.contains(_guardianBaseLabel, "CONTINUATION BUY") or str.contains(_guardianBaseLabel, "CONTINUATION LONG")
        if _htfIsBull
            guardian_label_display := _guardianBaseLabel
            guardian_risk := 0
        else
            guardian_label_display := _guardianBaseLabel + " (HTF COUNTER — STANDBY)"
            guardian_risk := (alertAlign == "COUNTER TREND") ? 2 : 1
    // CONTINUATION SELL / SHORT — safe only when HTF is bearish
    else if str.contains(_guardianBaseLabel, "CONTINUATION SELL") or str.contains(_guardianBaseLabel, "CONTINUATION SHORT")
        if _htfIsBear
            guardian_label_display := _guardianBaseLabel
            guardian_risk := 0
        else
            guardian_label_display := _guardianBaseLabel + " (HTF COUNTER — STANDBY)"
            guardian_risk := (alertAlign == "COUNTER TREND") ? 2 : 1
    // Non-continuation states (WAITING, SNIPER, TRAP, —) are preserved as-is
    else
        guardian_label_display := _guardianBaseLabel
        guardian_risk := 0
else
    // Config disabled → preserve exact v17.56.8 behavior
    guardian_label_display := _guardianBaseLabel
    guardian_risk := 0

// --- v17.59 FIX 3: STRONG-TREND CONTINUATION OVERRIDE ---
// During a confirmed strong aligned trend, a discount (in a bull run) or a
// premium (in a bear run) is NOT a reversal trap — it is the optimal CONTINUATION
// entry. We therefore disable the discount/premium "trap" downgrade, reframe the
// label as TREND EXPANSION CONTINUATION and force risk back to 0 (the trend IS
// the edge). This deliberately overrides the HTF-counter standby above because
// finalHTFTrend/finalLTFTrend already agree with the direction.
bool guardianLongDir  = guardianDisplayCode == 1 or guardianDisplayCode == 3 or guardianDisplayCode == 5
bool guardianShortDir = guardianDisplayCode == 2 or guardianDisplayCode == 4 or guardianDisplayCode == 6
if strongBullishTrend and guardianLongDir
    guardian_label_display := _guardianBaseLabel + " · TREND EXPANSION (CONTINUATION)"
    guardian_risk := 0
else if strongBearishTrend and guardianShortDir
    guardian_label_display := _guardianBaseLabel + " · TREND EXPANSION (CONTINUATION)"
    guardian_risk := 0

// --- v17.58: GUARDIAN SEQUENCE RECALIBRATION ---
// Liquidity sweeps are now REQUIRED rather than treated as traps. Guardian
// green-lights a setup once a Sweep + M5 MSS (LTF shift) has confirmed in its
// direction, and a CONTINUATION break that lacks any LTF shift is flagged and
// blocked. Existing HTF gating (above) remains the base safety layer.
bool guardianIsContinuation = str.contains(_guardianBaseLabel, "CONTINUATION")
bool guardianDirLong  = guardianDisplayCode == 1 or guardianDisplayCode == 3 or guardianDisplayCode == 5
bool guardianDirShort = guardianDisplayCode == 2 or guardianDisplayCode == 4 or guardianDisplayCode == 6
bool guardianSweepMSS = (guardianDirLong and liquiditySwept and ltfShiftDetected and seqDir == 1) or (guardianDirShort and liquiditySwept and ltfShiftDetected and seqDir == -1)
bool guardianNoLTFShift = guardianIsContinuation and enableSequence and not ltfShiftDetected
if enableSequence
    if guardianSweepMSS
        guardian_label_display := guardian_label_display + " · SEQ CONFIRMED"
    else if guardianNoLTFShift
        guardian_label_display := guardian_label_display + " · NO LTF SHIFT — BLOCKED"
        guardian_risk := math.max(guardian_risk, 2)

// --- v17.57: PDH/PDL Sweep Annotation (display only) ---
// When a previous-day liquidity level is swept, append a flag to the Guardian
// label so it flows into the compact label, HUD text, and webhook payload.
// This does NOT change Guardian's risk gating or any trade decision.
// v17.85.14: dead `guardianPDHLSweep` flag + unused `guardian_compact` label
// (never wired) removed for token reclamation; the live guardian_label_display
// mutations below are retained verbatim.
if pdhSwept
    guardian_label_display := guardian_label_display + " · PDH SWEPT"
if pdlSwept
    guardian_label_display := guardian_label_display + " · PDL SWEPT"

// --- v17.56.7 templates REMOVED in v17.85.14 (token reclamation) ---
// The legacy _jsonPrefix / _jsonSuffix payload templates (plus their _modeStr /
// _dirStr helpers) fed ONLY the deprecated legacy alertcondition()/alert()
// pipeline shown commented below — they had NO live reference and were pure dead
// code. They were removed in v17.85.14 to reclaim ~450 compiler tokens so the new
// V-Reversal fast-lane + opposing-zone additions fit under TradingView's 100,256
// token ceiling. The active alerts (MB_SETUP_READY / MB_EXECUTE / MB_VREVERSAL)
// each build their own JSON inline in f_render_exec_brief(); nothing else used
// these templates, so removal is a no-op for all live behavior.

// v17.67.9: LEGACY alertcondition() calls DEPRECATED.
// These required perfect alignment that never fired in 14+ days of real trading.
// Kept commented for rollback if ever needed.  Market Brief alerts replace them.
// alertcondition(fire_sniper_long, title="Sniper Long", message=...)
// alertcondition(fire_sniper_short, title="Sniper Short", message=...)
// alertcondition(fire_retrace_long, title="Continuation Long", message=...)
// alertcondition(fire_retrace_short, title="Continuation Short", message=...)
// alertcondition(vShapeLongFire,  title="V-Shape Breakout Long", message=...)
// alertcondition(vShapeShortFire, title="V-Shape Breakout Short", message=...)

// ============================================================================
// v17.56.8: DUAL MODE ALERT FIRING — Final Trigger Logic + Consistency Gate
// ============================================================================
// Only fires when:
//   1. A signal condition is met (fire_sniper_* or fire_retrace_*)
//   2. Dual mode is active (isExecutionAllowed or isDataAllowed)
//   3. Direction is validated (alertDirection is not na)
//   4. v17.56.8: AlertState passes f_validateAlertConsistency (alertConsistencyOK)
// ============================================================================

// v17.58: SEQUENCE GATE — legacy seqGateLong/seqGateShort/seqGateAlerts helper
// booleans REMOVED in v17.85.14 (token reclamation). They belonged to the
// deprecated legacy alert pipeline above and had NO live reference; the Market
// Brief execution path applies its own sequence gate (_t3SeqOk) inline. Removal
// is a no-op for all live behavior.

// v17.67.9: LEGACY dynamic alert() calls DEPRECATED.
// Market Brief alerts (Recon + Execution) replace the entire legacy pipeline.
// Kept commented for rollback reference.
// if fire_sniper_long and ... → alert(_jsonPrefix + "A+ SNIPER BUY" + _jsonSuffix, ...)
// if fire_sniper_short and ... → alert(_jsonPrefix + "A+ SNIPER SELL" + _jsonSuffix, ...)
// if fire_retrace_long and ... → alert(_jsonPrefix + "CONTINUATION LONG" + _jsonSuffix, ...)
// if fire_retrace_short and ... → alert(_jsonPrefix + "CONTINUATION SHORT" + _jsonSuffix, ...)
// if vShapeLongFire and ... → alert(_jsonPrefix + "V-SHAPE BREAKOUT LONG" + _jsonSuffix, ...)
// if vShapeShortFire and ... → alert(_jsonPrefix + "V-SHAPE BREAKOUT SHORT" + _jsonSuffix, ...)

// ============================================================================
// SECTION 22: HUD TABLE (v17.18 — VERTICAL 2-COLUMN LAYOUT + POSITION TOGGLE)
// ============================================================================
// Layout: 2 columns × 17 rows  (Label | Value)
// Left column: dim grey labels (size.small)
// Right column: color-coded values (size.small)
// Background: color.new(color.black, 85) — 15% opacity glass tint
// Position: user-selectable (Left/Right/Center) via hudPositionInput
// ============================================================================

// --- Pre-compute display strings (same logic as v17.14, kept outside if-block) ---

// --- v17.20: HUD Colors — MOVED HERE FOR PROPER DECLARATION ORDER ---
bool _hudActive = hudModeInput == "Fixed" or barstate.islast or (last_alert_time > 0 and (timenow - last_alert_time) < 300000)
color _tr  = hudModeInput == "Fixed" ? color.new(#1a237e, 20) : (_hudActive ? color.new(#1a237e, 20) : color.new(#1a237e, 75))
color _hdr = color.new(#0d47a1, 10)      // v17.22: Header row — brighter navy
// v17.22: Text Priority Hierarchy (updated)
color _lbl = color.white                 // Labels: bright white
color _act = color.new(color.lime, 0)    // Active values: bright green
color _dim = color.new(color.silver, 0)  // Inactive: silver
color _wrn = color.new(color.orange, 0)  // Warnings: orange
color _inv = color.new(color.red, 0)     // Invalidated: red
color _frm = color.new(color.white, 60)  // v17.22: visible white border

// v17.5: State machine status strings (retained for internal use)

// Sniper Progress
sniperProgressStr = bothIdle and not anyLongFired and not anyShortFired ? "IDLE" : "Stage " + str.tostring(dtDisplayStage) + "/5"
sniperProgressColor = _dim  // v17.22: uniform HUD text

// Guardian
guardDisplayStr = guardianDisplayCode == 0 ? "WAITING" : guardianDisplayCode == 1 ? "SNIPER BUY" : guardianDisplayCode == 2 ? "SNIPER SELL" : guardianDisplayCode == 3 ? "CONTINUATION BUY" : guardianDisplayCode == 4 ? "CONTINUATION SELL" : guardianDisplayCode == 5 ? "TREND EXPANSION BUY" : guardianDisplayCode == 6 ? "TREND EXPANSION SELL" : "—"
guardDisplayColor = guardianDisplayCode == 5 or guardianDisplayCode == 6 ? _wrn : _dim  // v17.22: TRAP=orange, else uniform

// v17.56.9: HUD Guardian text uses the HTF-gated label + risk indicator.
// guardian_label_display / guardian_risk were computed before the alert payload.
string guardian_hud_text = guardian_label_display
if guardian_risk_mode == 1
    // Show risk as a number
    guardian_hud_text := guardian_hud_text + " [Risk:" + str.tostring(guardian_risk) + "]"
else if guardian_risk_mode == 2
    // Show risk as a colored/symbol tag
    string _riskTag = guardian_risk == 0 ? "✓" : guardian_risk == 1 ? "⚠" : "⚠⚠"
    guardian_hud_text := guardian_hud_text + " " + _riskTag
// Color escalates with risk; falls back to the original Guardian color at risk 0.
color guardian_hud_color = guardian_risk == 2 ? _inv : guardian_risk == 1 ? _wrn : guardDisplayColor

// Confluence (v17.62.0: HUD shows the NEW 5-pillar display score X/5)
// Core confluenceScore (signal logic + plot 8) is UNCHANGED.
confluenceStr = str.tostring(confluencePillarScore) + "/5"
confluenceColor = _dim  // v17.22: uniform HUD text

// v17.65.4: Confl+ row — NAMED CONFLUENCE PILLAR BREAKDOWN (display-only).
// Replaces the generic ✓/· glyphs with the 5 explicit confluence pillars the
// trader watches for an 8AM-EST continuation entry:
//   ALIGN | KZ | P&D | SWEEP | DISP
// v17.65.5: ACTIVE pillars render as the plain abbreviation; INACTIVE pillars
// render as a single dash "-". e.g. an active ALIGN + KZ + SWEEP shows
// "ALIGN | KZ | - | SWEEP | -".
//   ALIGN = LTF trend matches H4 bias          (pillarDirection)
//   KZ    = inside the active Kill Zone window  (kzActive)
//   P&D   = bias-aligned Premium/Discount price (poiDirEq: discount→long / premium→short)
//   SWEEP = bias-aligned liquidity sweep         (poiDirSweep)
//   DISP  = institutional displacement validated (displacementDetected)
bool conflAlign = pillarDirection
bool conflKZ    = kzActive
bool conflPD    = poiDirEq
bool conflSweep = poiDirSweep
bool conflDisp  = displacementDetected
string _cfAlign = conflAlign ? "ALIGN" : "-"
string _cfKZ    = conflKZ    ? "KZ"    : "-"
string _cfPD    = conflPD    ? "P&D"   : "-"
string _cfSwp   = conflSweep ? "SWEEP" : "-"
string _cfDisp  = conflDisp  ? "DISP"  : "-"
confluencePlusStr = _cfAlign + " | " + _cfKZ + " | " + _cfPD + " | " + _cfSwp + " | " + _cfDisp
confluencePlusColor = _dim  // uniform HUD text (matches Confl row)

// Kill Zone
kzStr = isLondon() ? "London" : isNYAM() ? "NY AM" : isNYPM() ? "NY PM" : isAsian() ? "Asian" : "Off-Session"
kzDisplayColor = _dim  // v17.22: uniform HUD text

// POI Score (v17.65.0: HUD shows the NEW 5-component display score X/5)
// Core poiScore (signal logic) and poiScoreDisplay are UNCHANGED. This counts
// bias-aligned components: Sweep + OB + FVG + Displacement + Price-Location.
poiStr = str.tostring(poiScore5) + "/5"
if oteDepthBonus
    poiStr := poiStr + " (OTE)"
poiColor = _dim  // v17.22: uniform HUD text

// v17.65.4: POI+ row — NAMED 5-STAGE POI DEVELOPMENT PATH (display-only).
// Replaces the generic ✓/· glyphs with the explicit SMC formation sequence:
//   SH | FVG | MSS | Mit | Flip
// v17.65.5: ACTIVE stage(s) render as the plain abbreviation; INACTIVE stages
// render as a single dash "-". e.g. an active SH + MSS shows
// "SH | - | MSS | - | -".
//   SH   = Stage 1 — Sweep / swing high-low liquidity grab  (poiDirSweep)
//   FVG  = Stage 2 — Fair Value Gap / displacement void      (poiDirFvg)
//   MSS  = Stage 3 — Market Structure Shift & OB identity     (ltfShiftDetected or poiDirOb)
//   Mit  = Stage 4 — Premium/Discount retrace & mitigation    (state4Complete or poiDirEq)
//   Flip = Stage 5 — Supply/Demand failure & structural flip  (priceInFlipZone)
bool poiStgSH   = poiDirSweep
bool poiStgFVG  = poiDirFvg
bool poiStgMSS  = ltfShiftDetected or poiDirOb
bool poiStgMit  = state4Complete or poiDirEq
bool poiStgFlip = priceInFlipZone
string _stSH   = poiStgSH   ? "SH"   : "-"
string _stFvg  = poiStgFVG  ? "FVG"  : "-"
string _stMss  = poiStgMSS  ? "MSS"  : "-"
string _stMit  = poiStgMit  ? "Mit"  : "-"
string _stFlip = poiStgFlip ? "Flip" : "-"
poiPlusStr = _stSH + " | " + _stFvg + " | " + _stMss + " | " + _stMit + " | " + _stFlip
// Colored green for LONG bias, red for SHORT, grey when neutral.
poiPlusColor = poiDirIsLong ? color.lime : poiDirIsShort ? color.red : _dim

// Momentum
momentumStr = str.tostring(momentumScore) + "/3 " + momentumFlags
momentumColor = _dim  // v17.22: uniform HUD text

// AMD Phase
amdColor = _dim  // v17.22: uniform HUD text

// Trade Context color

// Action Step + Plan combined

// ============================================================================
// v17.56.8: CONTEXT-AWARE ACTION MESSAGE (HUD display only)
// ============================================================================
// Respects HTF bias, premium/discount location and Guardian state.
// Does NOT affect signal logic — purely a guidance string for the HUD.
string actionMessage = "Neutral - Monitor Structure"
// v17.59: keyed off finalHTFTrend so the guidance flips with the momentum override.
if finalHTFTrend == 1
    if inDiscountZone
        if strongBullishTrend                                     // strong trend: discount = continuation, not a trap
            actionMessage := "Trend Expansion - Discount Continuation"
        else if guardianDisplayCode == 3 or guardianDisplayCode == 1   // CONTINUATION/SNIPER LONG
            actionMessage := "Watch for Bullish Confirmation"
        else
            actionMessage := "Scan for Long Entry"
    else if inPremiumZone
        actionMessage := strongBullishTrend ? "Trend Expansion - Premium Continuation" : "Wait for Discount Retrace"
    else
        actionMessage := "Bullish - Await Discount"
else if finalHTFTrend == -1
    if inPremiumZone
        if strongBearishTrend                                     // strong trend: premium = continuation, not a trap
            actionMessage := "Trend Expansion - Premium Continuation"
        else if guardianDisplayCode == 4 or guardianDisplayCode == 2   // CONTINUATION/SNIPER SHORT
            actionMessage := "Watch for Bearish Confirmation"
        else
            actionMessage := "Scan for Short Entry"
    else if inDiscountZone
        actionMessage := "Wait for Premium Retrace"
    else
        actionMessage := "Bearish - Await Premium"
else
    actionMessage := "Neutral - Monitor Structure"

// ============================================================================
// v17.56.8: SPECIFIC STAGE MESSAGE (HUD display only)
// ============================================================================
// Replaces the generic "READY" with explicit market stages.
// Uses enhanced display POI + dual-mode execution gating + trade session.
string stageMessage = "STAND DOWN"
color  stageMessageColor = _dim
if poiScoreDisplay >= 5 and isExecutionAllowed
    stageMessage := "EXECUTION READY"
    stageMessageColor := _act
else if poiScoreDisplay >= 4 and isTradeSession
    stageMessage := "CONFIRMING"
    stageMessageColor := _act
else if poiScoreDisplay >= 3 and isTradeSession
    stageMessage := "SCANNING"
    stageMessageColor := _dim
else if isTradeSession
    stageMessage := "WATCH"
    stageMessageColor := _dim
else
    stageMessage := "STAND DOWN"
    stageMessageColor := _dim

// v17.56.8: Daily-reset counter HUD string
string dailyCountStr = "Sniper " + str.tostring(sniperCountToday) + " | Exec " + str.tostring(executionAlertsToday)
color  dailyCountClr = (sniperCountToday > 0 or executionAlertsToday > 0) ? _act : _dim

// Last Alert
// v17.59.1: HUD-only alert staleness — alerts older than 30 min (1,800,000 ms)
// are REPLACED with "NO ACTIVE ALERT" (greyed-out) rather than appending a
// [STALE] tag, for a cleaner HUD that never displays an expired signal as if
// it were still relevant. This is purely a display concern: signal generation,
// alert firing, and the underlying last_alert_* state are all left untouched.
bool   lastAlertStale   = last_alert_time > 0 and (timenow - last_alert_time) > 1800000

// ============================================================================
// HUD TABLE — v17.54.4 NAVY BLUE COMPACT VERTICAL LAYOUT + FLOAT MODE
// ============================================================================
// Grid: 2 columns (Col 0: Label | Col 1: Value)
// v17.67.1 ROW MAP (always-visible block — MSS row removed, AMD up, System down):
// Row 0:  Header "SMC P&D"     Row 9:   Confl+
// Row 1:  HTF Bias             Row 10:  AMD Phase      (v17.67.1 moved up)
// Row 2:  LTF Bias             Row 11:  Momentum
// Row 3:  Alignment            Row 12:  Guardian (DIR|ACT)
// Row 4:  Kill Zone            Row 13:  System (Why-No-Alert + T:active/max)
// Row 5:  Sniper               Row 14:  Entry Mode
// Row 6:  POI Score            Row 15:  Signals Today
// Row 7:  POI+                 Row 16:  News (manual input)
// Row 8:  Confluence
// (v17.67.1: the old "MSS" row was removed entirely; the System row now carries
//  the "Why No Alert" diagnostic, replacing the old Stage|Alert|Trades string.)
// Rows 17-23: Zone / Structural / Alignment Debug (optional)
// ============================================================================

// v17.18: HUD position mapping
hudPos = hudPositionInput == "Right" ? position.top_right : hudPositionInput == "Center" ? position.top_center : position.top_left

// Signal Stage display string (maps sniper dtDisplayStage to readable text)

// Signals Today

// Session Levels

// ============================================================================
// v17.60: TRADER HUD REDESIGN — display-only derived strings
// ============================================================================
// NOTE: every variable below is consumed ONLY by the HUD render block.
// No signal, alert, calculation or state-machine value is read FROM or written
// TO by this block, so trading behaviour is byte-for-byte identical to v17.59.1.

// --- MSS row REMOVED in v17.67.1 ------------------------------------------
// The dedicated HUD "MSS" row was deleted. The mssState/mssDir machine itself
// is untouched upstream and still drives the signal engine; only its HUD row
// and the display-only helper strings (mss_confirmed_*/mss_display) were removed.

// --- Guardian row: simplified tokens + merged Action ----------------------
// Direction token derived from the already-finalized guardianDisplayCode.
// guardianDirRaw preserves the Guardian model's own directional suggestion
// (used by the optional Alignment Debug row for full auditability).
string guardianDirRaw = (guardianDisplayCode == 1 or guardianDisplayCode == 3 or guardianDisplayCode == 5) ? "BUY" : (guardianDisplayCode == 2 or guardianDisplayCode == 4 or guardianDisplayCode == 6) ? "SELL" : "STANDBY"
string guardianDir = guardianDirRaw
// v17.60.1 BUGFIX R2 (Option A): The Guardian row is an EXECUTION-PERMISSION
//   filter, NOT a competing directional bias. Previously its token came purely
//   from guardianDisplayCode, so it could contradict the HTF/LTF/Align rows
//   (e.g. NZDUSD HTF BULL + LTF BULL but Guardian "SELL"). Since execution is
//   only ever permitted in the prevailing HTF direction, the displayed BUY/SELL
//   token is reconciled to the SAME finalized HTF trend shown in the HTF row
//   (finalHTFTrend). CONFLICT and the counter-trend REVERSAL (ctLite) cases are
//   intentional exceptions and are preserved. DISPLAY-ONLY: guardianDisplayCode,
//   guardian_risk, alert firing and the webhook payload are untouched.
if alignmentConflict
    guardianDir := "CONFLICT"
else if ctLiteLongFire or ctLiteShortFire
    guardianDir := "REVERSAL"
else if guardianDir == "BUY" or guardianDir == "SELL"
    // Reconcile the directional token to the displayed HTF trend.
    guardianDir := finalHTFTrend == 1 ? "BUY" : finalHTFTrend == -1 ? "SELL" : "STANDBY"
// v17.67.2 MSS-RETRACE BYPASS: force the directional token to the (established)
//   HTF direction so the Guardian reads "SELL"/"BUY" rather than "CONFLICT" or
//   "STANDBY" while the LTF has not yet flipped. Scoped to the MSS bypass only.
if isMssBypass
    guardianDir := finalHTFTrend == 1 ? "BUY" : "SELL"
// Action token (merged into the Guardian row). EXECUTE only when the existing
// stage gate already reports execution readiness; STANDBY when HTF-counter risk.
string guardianAct = "—"
if guardianDir == "BUY" or guardianDir == "SELL" or guardianDir == "REVERSAL"
    guardianAct := guardian_risk == 2 ? "STANDBY" : (stageMessage == "EXECUTION READY" ? "EXECUTE" : "STANDBY")
// v17.67.2 MSS-RETRACE BYPASS: when the MSS close has confirmed the leg in the HTF
//   direction, the Guardian must read "ACTIVE" rather than the counter-trend
//   "STANDBY" it would otherwise show while the LTF has not yet flipped. This
//   takes priority over the guardian_risk==2 standby above, but ONLY for the
//   tightly-scoped MSS-Retrace bypass; all other entries are unaffected.
if isMssBypass and (guardianDir == "BUY" or guardianDir == "SELL")
    guardianAct := "ACTIVE"
string guardian_merged_text = guardianDir + " | " + guardianAct
// Preserve the existing risk-escalated Guardian colour coding.
color guardian_merged_color = guardian_hud_color

// --- High-Impact News row (manual input) ----------------------------------
// Pine cannot detect when an input was last edited, so "staleness" is modelled
// by severity: severity 0 (or empty text) renders grey/inactive. See README.
string news_display = news_manual == "" ? "No high-impact news" : news_manual
bool   news_active  = news_severity > 0 and news_manual != ""
color  news_display_color = not news_active ? color.new(color.gray, 0) : news_severity == 3 ? color.red : news_severity == 2 ? color.orange : color.yellow

// ============================================================================
// v17.67.1: "WHY NO ALERT" DIAGNOSTIC — drives the System row
// ============================================================================
// DISPLAY-ONLY. Surfaces, in priority order, the reason(s) no execution alert is
// firing. It reads existing finalized state (bias, zone, displacement, sequence,
// MSS, Kill Zone, Guardian, last alert) and writes NOTHING back. No signal, alert
// or state-machine value is modified, so trading behaviour is unchanged.
//
// Priority order (highest first):
//   1. Counter Trend            2. Wrong P&D zone (Discount/Premium)
//   3. LTF opposes HTF          4. No displacement
//   5. Sequence incomplete      6. Awaiting MSS
//   7. Outside Kill Zone        8. Guardian Standby
//   9. ACTIVE ALERT             10. SCANNING (no blockers)
// Up to the 2 most-important blockers are shown, joined with " | ". The existing
// trade counter (T:active/maxDaily) is preserved on a second line.

// v17.85.15: LIVE Market Brief / V-Reversal execution-alert trackers. The legacy
// last_alert_* variables are set ONLY by the deprecated sniper/continuation lane
// (fire_sniper_*/fire_retrace_*) and are NOT touched by MB_EXECUTE / MB_VREVERSAL,
// so the modern System row must not read them — it was showing a stale
// SNIPER/CONTINUATION direction that conflicts with the current market state.
// These bridge arrays are written inside f_render_exec_brief() the instant an MB
// or V-Reversal alert fires (see Tier 3 / Tier V), mirroring the gMacroPrimedArr
// pattern: a function cannot reassign a scalar global but can mutate a var array.
var array<int>    gMBAlertDirArr  = array.new_int(1, 0)     // 1=long, -1=short, 0=none
var array<int>    gMBAlertTimeArr = array.new_int(1, 0)     // bar time (ms) of last MB/V-Rev fire
var array<string> gMBAlertTypeArr = array.new_string(1, "") // "MB_EXECUTE_*"/"MB_VREVERSAL_*"
int    lastMBAlertDirection = array.get(gMBAlertDirArr, 0)
int    lastMBAlertTime      = array.get(gMBAlertTimeArr, 0)
string lastMBAlertType      = array.get(gMBAlertTypeArr, 0)
// "Fresh" = an MB/V-Reversal alert fired within the same freshness window used for
// the legacy staleness check (30 min). Only then may the System row show ACTIVE
// ALERT; otherwise it falls through to the normal no-alert diagnostic.
bool lastMBAlertStale = lastMBAlertTime > 0 and (timenow - lastMBAlertTime) > 1800000

// v17.85.15: sysAlertActive now reflects the LIVE MB / V-Reversal execution lane
// (used by the modern System row), NOT the legacy sniper/continuation tracker.
// v17.85.16 Fix 3: a tracked alert whose direction CONTRADICTS the live HTF bias
// (SHORT while HTF Bullish, or LONG while HTF Bearish) is suppressed — the System
// row must never show a SHORT alert when finalHTFTrend == 1 (or LONG when == -1).
bool _mbAlertContraBias = (finalHTFTrend == 1 and lastMBAlertDirection == -1) or (finalHTFTrend == -1 and lastMBAlertDirection == 1)
bool sysAlertActive = lastMBAlertDirection != 0 and lastMBAlertTime > 0 and not lastMBAlertStale and not _mbAlertContraBias
// v17.85.19: sysLegacyAlertActive REMOVED. The legacy fast-path that allowed the
// Market Brief to declare READY independently of the HUD/finalVerdict engine is
// gone. All READY/execution decisions now flow through the single finalVerdict
// source of truth (see the Daily Trading Plan Filter Engine block below).

// v17.78.0: Macro-Express fire flag surfaced from f_render_exec_brief() via a
// by-reference global (Pine functions cannot reassign a scalar global, but they
// CAN mutate a var array element). The Exec-Brief function sets index 0 to
// _execFireMacro every bar it renders; the System row below reads it. Because
// the brief renders AFTER this row, the value read here is from the previous
// realtime tick/bar (a negligible 1-tick lag on a live chart).
var array<bool> gMacroPrimedArr = array.new_bool(1, false)
bool gMacroPrimed = array.get(gMacroPrimedArr, 0)

// Priority-ordered blocker conditions (mutually-prioritised, evaluated below).
bool sysCounterTrend    = finalHTFTrend != 0 and finalLTFTrend != 0 and finalHTFTrend != finalLTFTrend
// v17.84.0 PHASE C — BLOCKER LOGIC BRIDGE: these two zone blockers now read the
// H4 MASTER location (h4_macroLocation) EXCLUSIVELY. An M5/nested local pullback
// can no longer flip the zone the blocker sees — if H4 says DISCOUNT the system
// is in Discount regardless of any LTF local range.
bool sysWrongZoneDisc   = finalHTFTrend == -1 and h4_macroLocation == "DISCOUNT"  // bearish bias, H4 still in discount
bool sysWrongZonePrem   = finalHTFTrend == 1  and h4_macroLocation == "PREMIUM"   // bullish bias, H4 still in premium
bool sysLtfBull         = finalHTFTrend == -1 and finalLTFTrend == 1   // LTF bullish vs bearish HTF
bool sysLtfBear         = finalHTFTrend == 1  and finalLTFTrend == -1  // LTF bearish vs bullish HTF
bool sysNoDisp          = not displacementDetected
bool sysSeqIncomplete   = not sequenceComplete
bool sysNoMSS           = not (mssState >= 1)
bool sysOutsideKZ       = not kzActive
bool sysGuardianStandby = guardian_risk == 2

// Build the blocker list in strict priority order.
var array<string> sysBlockers = array.new<string>()
array.clear(sysBlockers)
if sysCounterTrend
    array.push(sysBlockers, "Counter Trend")
if sysWrongZoneDisc
    array.push(sysBlockers, "Still in Discount")
else if sysWrongZonePrem
    array.push(sysBlockers, "Still in Premium")
if sysLtfBull
    array.push(sysBlockers, "LTF Bullish")
else if sysLtfBear
    array.push(sysBlockers, "LTF Bearish")
if sysNoDisp
    array.push(sysBlockers, "No Displacement")
if sysSeqIncomplete
    array.push(sysBlockers, "Sequence Incomplete (" + str.tostring(confluencePillarScore) + "/5)")
if sysNoMSS
    array.push(sysBlockers, "Awaiting MSS")
if sysOutsideKZ
    array.push(sysBlockers, "Outside Kill Zone")
if sysGuardianStandby
    array.push(sysBlockers, "Guardian Standby")

// Resolve the diagnostic headline + colour.
// v17.67.2 MSS-RETRACE BYPASS takes top priority: when active it means the LTF
//   gate has been intentionally overridden because the MSS close confirmed the
//   HTF-direction leg, so the row reports approval instead of any "Rejected: …"
//   blocker (e.g. Counter Trend / LTF Bullish) that would otherwise show.
string sysDiagnostic = "SCANNING"
color  sysDiagColor  = _dim
if isMssBypass
    sysDiagnostic := "Approved: MSS Alignment"
    sysDiagColor  := _act
else if gMacroPrimed
    // v17.78.0: the Macro-Express lane has fired — displacement is intentionally
    // bypassed, so report the primed state instead of a "No Displacement" reject.
    sysDiagnostic := "Macro-Express Primed (Displacement Bypassed)"
    sysDiagColor  := _act
else if sysAlertActive
    // v17.85.15: direction comes from the LIVE MB/V-Reversal tracker, never the
    // legacy sniper/continuation type — no stale SNIPER/CONTINUATION SHORT here.
    string _alDir = lastMBAlertDirection == 1 ? "LONG" : "SHORT"
    sysDiagnostic := "ACTIVE ALERT: " + _alDir
    sysDiagColor  := _act
else if array.size(sysBlockers) > 0
    // Combine up to the 2 most important blockers; second goes on its own line so
    // the cell wraps vertically and never expands the table horizontally.
    string _b1 = array.get(sysBlockers, 0)
    string _b2 = array.size(sysBlockers) > 1 ? "\n| " + array.get(sysBlockers, 1) : ""
    sysDiagnostic := "Rejected: " + _b1 + _b2
    sysDiagColor  := color.orange
else
    sysDiagnostic := "SCANNING"
    sysDiagColor  := _act

// Preserve the existing trade counter on a second line.
string systemDiagStr = sysDiagnostic + "\nT:" + str.tostring(activeTrades) + "/" + str.tostring(maxDailyTrades)

// ════════════════════════════════════════════════════════════════════════════
// v17.85.19 — DAILY TRADING PLAN FILTER ENGINE  (SINGLE SOURCE OF TRUTH)
// ════════════════════════════════════════════════════════════════════════════
// finalVerdict is the ONE variable the HUD, the Market Brief and EVERY alert
// lane read. It is declared exactly once, computed in THIS single block on every
// bar, and always holds exactly one of:
//     "READY" | "WAIT" | "MISSED" | "REENTRY" | "NO_TRADE"
// Six hard gates must all pass for a with-trend READY: (1) Session Window
// 02:30-12:30 EST, (2) Liquidity Sweep, (3) ATR Displacement (in the signal
// direction), (4) MSS / structure shift, (5) R:R >= 1:3, (6) Anti-Chase (price
// has NOT already travelled >=50% of the planned range). A dedicated counter-
// trend (CT) path and a MISSED->RE-ENTRY path run alongside. This block does NOT
// alter any entry/SL/TP math, zone detection, P&D or HTF-bias logic — it only
// READS finalized globals and produces the verdict + its display strings.
var string finalVerdict  = "NO_TRADE"
var string fvPrevVerdict = "NO_TRADE"
var bool   fvMissedArmed = false
var int    fvMissedDir   = 0
var array<string> fvBlockers = array.new<string>()

// --- Daily reset: each fresh trading day re-arms the plan ---
bool fvNewDay = ta.change(dayofmonth) != 0
if fvNewDay
    fvMissedArmed := false
    fvMissedDir   := 0

// --- Primary (with-trend) trade direction ---
int  fvDir     = finalHTFTrend            // +1 long, -1 short, 0 none
bool fvIsLong  = fvDir == 1
bool fvIsShort = fvDir == -1

// --- GATE 1: Session window (02:30-12:30 EST) ---
bool fvSessionOk = estMinOfDay >= 150 and estMinOfDay <= 750

// --- Persistent intraday arming (reset each new day / when session closes) ---
var bool fvSweepArmedLong  = false
var bool fvSweepArmedShort = false
var bool fvDispArmedLong    = false
var bool fvDispArmedShort   = false
if fvNewDay or not fvSessionOk
    fvSweepArmedLong  := false
    fvSweepArmedShort := false
    fvDispArmedLong   := false
    fvDispArmedShort  := false
if fvSessionOk
    if sweepLow or pdlSwept
        fvSweepArmedLong := true
    if sweepHigh or pdhSwept
        fvSweepArmedShort := true
    if displacementDetected and close > open
        fvDispArmedLong := true
    if displacementDetected and close < open
        fvDispArmedShort := true

// --- GATE 2: Liquidity sweep (directional) ---
bool fvSweepOk = fvIsLong ? fvSweepArmedLong : fvIsShort ? fvSweepArmedShort : false
// --- GATE 3: ATR displacement in the signal direction ---
bool fvDispOk  = fvIsLong ? fvDispArmedLong : fvIsShort ? fvDispArmedShort : false
// --- GATE 4: MSS / structure shift in the signal direction ---
bool fvMssOk   = fvIsLong ? mssCloseUp : fvIsShort ? mssCloseDown : false

// --- GATE 5: R:R >= 1:3 (live entry/SL/TP; math untouched) ---
float fvEntry = fvIsLong ? entryLong : entryShort
float fvSL    = fvIsLong ? slLong    : slShort
float fvTP    = fvIsLong ? tpLong    : tpShort
float fvRisk  = math.abs(fvEntry - fvSL)
float fvRew   = math.abs(fvTP - fvEntry)
float fvRR    = fvRisk > 0 ? fvRew / fvRisk : 0.0
bool  fvRRok  = fvRR >= 3.0

// --- GATE 6: Anti-Chase (MISSED if price already moved >=50% of planned range) ---
float fvRangeSz  = (not na(h4RangeHigh) and not na(h4RangeLow)) ? (h4RangeHigh - h4RangeLow) : na
float fvMoveFrac = na
if not na(fvRangeSz) and fvRangeSz > 0
    fvMoveFrac := fvIsLong ? (close - h4RangeLow) / fvRangeSz : fvIsShort ? (h4RangeHigh - close) / fvRangeSz : na
bool fvChased  = not na(fvMoveFrac) and fvMoveFrac >= 0.5
bool fvMoveOk  = not fvChased

// --- VSA CONVICTION (display; CAUTION downgrades a CT READY to WAIT) ---
float fvVolAvg    = ta.sma(volume, 20)
float fvSprd      = high - low
float fvSprdAvg   = ta.sma(fvSprd, 20)
float fvVolRatio  = (not na(fvVolAvg) and fvVolAvg > 0) ? volume / fvVolAvg : 1.0
bool  fvVolHigh   = fvVolRatio >= 1.5
bool  fvVolMod    = fvVolRatio >= 1.1 and fvVolRatio < 1.5
bool  fvVolNeut   = fvVolRatio >= 0.9 and fvVolRatio < 1.1
bool  fvSprdSmall = not na(fvSprdAvg) and fvSprd < fvSprdAvg * 0.8
bool  fvSprdProp  = not na(fvSprdAvg) and fvSprd >= fvSprdAvg
bool  fvVSACaution = fvVolHigh and fvSprdSmall
string fvVSA = "NEUTRAL"
color  fvVSAColor = color.gray
if fvVSACaution
    fvVSA := "CAUTION"
    fvVSAColor := color.orange
else if fvVolHigh and fvSprdProp
    fvVSA := "HIGH"
    fvVSAColor := color.lime
else if fvVolMod
    fvVSA := "MODERATE"
    fvVSAColor := color.aqua
else
    fvVSA := "NEUTRAL"
    fvVSAColor := color.gray

// --- COUNTER-TREND (CT) PATH — price mitigating an H1/H4 POI (opposing zone) ---
bool fvAtH1H4Supply = false
bool fvAtH1H4Demand = false
if array.size(h1Zones) > 0
    for _fi = 0 to array.size(h1Zones) - 1
        MtfZone _fz = array.get(h1Zones, _fi)
        if _fz.active and close >= _fz.bot and close <= _fz.top
            if _fz.isSupply
                fvAtH1H4Supply := true
            else
                fvAtH1H4Demand := true
if array.size(h4Zones) > 0
    for _fi = 0 to array.size(h4Zones) - 1
        MtfZone _fz = array.get(h4Zones, _fi)
        if _fz.active and close >= _fz.bot and close <= _fz.top
            if _fz.isSupply
                fvAtH1H4Supply := true
            else
                fvAtH1H4Demand := true
float fvCtRRLong  = (math.abs(entryLong - slLong) > 0)   ? math.abs(tpLong - entryLong)   / math.abs(entryLong - slLong)   : 0.0
float fvCtRRShort = (math.abs(entryShort - slShort) > 0) ? math.abs(tpShort - entryShort) / math.abs(entryShort - slShort) : 0.0
// CT core: at POI + sweep into POI + strong displacement away + LTF MSS in CT dir + momentum >= 2/3
bool fvCtLongCore  = fvAtH1H4Demand and (sweepLow  or pdlSwept) and displacementDetected and close > open and mssCloseUp   and momentumScore >= 2
bool fvCtShortCore = fvAtH1H4Supply and (sweepHigh or pdhSwept) and displacementDetected and close < open and mssCloseDown and momentumScore >= 2
bool fvCtReadyLong  = fvSessionOk and fvCtLongCore  and fvCtRRLong  >= 3.0 and not fvVSACaution
bool fvCtReadyShort = fvSessionOk and fvCtShortCore and fvCtRRShort >= 3.0 and not fvVSACaution
bool fvCtReady = fvCtReadyLong or fvCtReadyShort
// CT setup forming: at POI with at least one confirming element but not full-ready
bool fvCtSetupLong  = fvSessionOk and fvAtH1H4Demand and ((sweepLow  or pdlSwept) or mssCloseUp   or (displacementDetected and close > open)) and not fvCtReadyLong
bool fvCtSetupShort = fvSessionOk and fvAtH1H4Supply and ((sweepHigh or pdhSwept) or mssCloseDown or (displacementDetected and close < open)) and not fvCtReadyShort
bool fvCtSetup = fvCtSetupLong or fvCtSetupShort

// --- WITH-TREND: all 6 gates ---
bool fvAll6 = fvSessionOk and fvSweepOk and fvDispOk and fvMssOk and fvRRok and fvMoveOk and fvDir != 0
// Would have been READY but price already chased (>=50% of range) → MISSED
bool fvWouldReadyButChased = fvSessionOk and fvSweepOk and fvDispOk and fvMssOk and fvRRok and fvChased and fvDir != 0
// RE-ENTRY: previously MISSED, price retraced back into zone, FULL fresh 6-rule pass
bool fvReentry = fvMissedArmed and fvSessionOk and fvAll6 and fvDir == fvMissedDir

// --- DECISION CASCADE (priority-ordered) ---
string _fvNew   = "NO_TRADE"
int    _fvDirO  = fvDir
bool   _fvCT    = false
bool   _fvRE    = false
if not fvSessionOk
    _fvNew := "NO_TRADE"
else if fvCtReady
    _fvNew  := "READY"
    _fvCT   := true
    _fvDirO := fvCtReadyLong ? 1 : -1
else if fvReentry
    _fvNew := "REENTRY"
    _fvRE  := true
else if fvAll6
    _fvNew := "READY"
else if fvWouldReadyButChased
    _fvNew := "MISSED"
else if fvCtSetup
    _fvNew  := "WAIT"
    _fvCT   := true
    _fvDirO := fvCtSetupLong ? 1 : -1
else if fvDir == 0
    _fvNew := "NO_TRADE"
else
    _fvNew := "WAIT"

// MISSED arms the RE-ENTRY watch; a fresh READY/REENTRY clears it
if _fvNew == "MISSED"
    fvMissedArmed := true
    fvMissedDir   := fvDir
else if _fvNew == "REENTRY" or _fvNew == "READY"
    fvMissedArmed := false
    fvMissedDir   := 0

fvPrevVerdict := finalVerdict
finalVerdict  := _fvNew

// --- Direction / classification outputs (read by MB + alert lanes, same bar) ---
int  fvOutDir       = _fvDirO
bool fvVerdictLong  = _fvDirO == 1
bool fvVerdictShort = _fvDirO == -1
bool fvIsCT         = _fvCT
bool fvIsRE         = _fvRE
bool fvAlertOk      = finalVerdict == "READY" or finalVerdict == "REENTRY"

// --- Verdict display strings ---
string fvVerdictLabel = finalVerdict == "READY" ? "READY" : finalVerdict == "WAIT" ? "WAIT" : finalVerdict == "MISSED" ? "MISSED" : finalVerdict == "REENTRY" ? "RE-ENTRY" : "NO TRADE"
color  fvVerdictColor = finalVerdict == "READY" ? color.lime : finalVerdict == "WAIT" ? color.yellow : finalVerdict == "MISSED" ? color.red : finalVerdict == "REENTRY" ? color.aqua : color.gray
string fvDirWord = fvVerdictLong ? "LONG" : fvVerdictShort ? "SHORT" : ""
string fvActionLabel = "NO TRADE"
if finalVerdict == "READY"
    fvActionLabel := (fvIsCT ? "CT " : "") + (fvVerdictLong ? "▶ EXECUTE LONG" : "▶ EXECUTE SHORT")
else if finalVerdict == "REENTRY"
    fvActionLabel := fvVerdictLong ? "▶ RE-ENTRY LONG" : "▶ RE-ENTRY SHORT"
else if finalVerdict == "WAIT"
    fvActionLabel := fvIsCT ? "CT SETUP FORMING" : "WAIT"
else if finalVerdict == "MISSED"
    fvActionLabel := "MISSED — NO CHASE"
else
    fvActionLabel := "NO TRADE"
color fvActionColor = fvVerdictColor

// --- WHY-NO-ALERT blocker list (rebuilt each bar) ---
array.clear(fvBlockers)
if not fvAlertOk
    if not fvSessionOk
        array.push(fvBlockers, "Outside Session (02:30-12:30 EST)")
    if fvDir == 0 and not fvIsCT
        array.push(fvBlockers, "No HTF Bias")
    if fvSessionOk and fvDir != 0
        if not fvSweepOk
            array.push(fvBlockers, "No Liquidity Sweep")
        if not fvDispOk
            array.push(fvBlockers, "No ATR Displacement")
        if not fvMssOk
            array.push(fvBlockers, "No MSS Confirmation")
        if not fvRRok
            array.push(fvBlockers, "R:R < 1:3")
        if fvChased
            array.push(fvBlockers, "Price Chased (>50% range)")
    if fvVSACaution
        array.push(fvBlockers, "VSA Caution")

// --- Session / window display helpers for the HUD ---
string fvSessionStr   = f_safeText(kzStr)
color  fvSessionColor = kzActive ? color.lime : color.gray
string fvWindowStr    = fvSessionOk ? "OPEN 02:30-12:30" : "CLOSED"
color  fvWindowColor  = fvSessionOk ? color.lime : color.red

// ============================================================================
// v17.77.0 BUILD FIX (CE10295): Main HUD render wrapped into a function to
// shrink the main body. Reads finalized globals; creates/populates the table
// internally. Behaviour is identical to the previous inline render block.
// ============================================================================
f_render_trade_hud() =>
    // v17.54.4: Safe HUD initialization — var at global scope, na-guarded creation
    var table _hud = na
    if showHUD and na(_hud)
        _hud := table.new(hudPos, maxHudCols, maxHudRows, bgcolor=_tr, frame_color=_frm, frame_width=1, border_color=_tr, border_width=0)

    // v17.54.4: All HUD cell writes use f_setCell/f_setHdrCell/f_setDbgCell + f_safeText
    if showHUD and barstate.islast and not na(_hud)
        // ════════════════════════════════════════════════════════════════
        // v17.85.19 — DAILY TRADING PLAN FILTER HUD
        // Every row reads the finalVerdict engine globals (single source of
        // truth). Grouped: ① SESSION GATE ② MARKET BIAS ③ SETUP CONFIRMATION
        // ④ ENTRY QUALITY ⑤ VSA CONVICTION → FINAL VERDICT. Colours: Green =
        // confirmed, Yellow = forming, Red = failed, Cyan = re-entry, Gray = N/A.
        // ════════════════════════════════════════════════════════════════
        color _fvNA = color.gray
        // ── Row 0: Header ──
        f_setHdrCell(_hud, 0, 0, "DAILY PLAN",                        color.white,  _hdr)
        f_setHdrCell(_hud, 1, 0, VERSION,                            color.yellow, _hdr)

        // ── ① SESSION GATE ──
        f_setHdrCell(_hud, 0, 1, "① SESSION",                         color.new(color.white, 20), _hdr)
        f_setHdrCell(_hud, 1, 1, "",                                  color.new(color.white, 20), _hdr)
        f_setCell(_hud, 0, 2, "Session",                              _lbl, _tr)
        f_setCell(_hud, 1, 2, fvSessionStr,                           fvSessionColor, _tr)
        f_setCell(_hud, 0, 3, "Trade Window",                         _lbl, _tr)
        f_setCell(_hud, 1, 3, f_safeText(fvWindowStr),                fvWindowColor, _tr)

        // ── ② MARKET BIAS ──
        f_setHdrCell(_hud, 0, 4, "② BIAS",                            color.new(color.white, 20), _hdr)
        f_setHdrCell(_hud, 1, 4, "",                                  color.new(color.white, 20), _hdr)
        f_setCell(_hud, 0, 5, "HTF",                                  _lbl, _tr)
        f_setCell(_hud, 1, 5, f_safeText(finalHTFDirStr + htfRowSuffix), finalHTFColor, _tr)
        f_setCell(_hud, 0, 6, "LTF",                                  _lbl, _tr)
        f_setCell(_hud, 1, 6, f_safeText(finalLTFDirStr + ltfRowSuffix), finalLTFColor, _tr)
        bool   _hudAlBoth   = finalHTFTrend != 0 and finalLTFTrend != 0
        string _hudAlignStr = isMssBypass ? "ALIGNED (MSS)" : (_hudAlBoth and finalHTFTrend == finalLTFTrend) ? "ALIGNED ✓" : _hudAlBoth ? "CONFLICT ⚠" : "NEUTRAL"
        color  _hudAlignClr = isMssBypass ? color.lime : (_hudAlBoth and finalHTFTrend == finalLTFTrend) ? color.lime : _hudAlBoth ? color.orange : _fvNA
        f_setCell(_hud, 0, 7, "Alignment",                           _lbl, _tr)
        f_setCell(_hud, 1, 7, f_safeText(_hudAlignStr),              _hudAlignClr, _tr)

        // ── ③ SETUP CONFIRMATION ──
        f_setHdrCell(_hud, 0, 8, "③ SETUP",                           color.new(color.white, 20), _hdr)
        f_setHdrCell(_hud, 1, 8, "",                                  color.new(color.white, 20), _hdr)
        string _swStr = fvDir == 0 ? "N/A" : fvSweepOk ? "SWEPT ✓" : "None ✗"
        color  _swClr = fvDir == 0 ? _fvNA : fvSweepOk ? color.lime : color.red
        f_setCell(_hud, 0, 9, "Liq Sweep",                           _lbl, _tr)
        f_setCell(_hud, 1, 9, _swStr,                                _swClr, _tr)
        string _dpStr = fvDir == 0 ? "N/A" : fvDispOk ? "YES ✓" : "None ✗"
        color  _dpClr = fvDir == 0 ? _fvNA : fvDispOk ? color.lime : color.red
        f_setCell(_hud, 0, 10, "Displacement",                       _lbl, _tr)
        f_setCell(_hud, 1, 10, _dpStr,                               _dpClr, _tr)
        string _msStr = fvDir == 0 ? "N/A" : fvMssOk ? "CONFIRMED ✓" : "Pending ✗"
        color  _msClr = fvDir == 0 ? _fvNA : fvMssOk ? color.lime : color.red
        f_setCell(_hud, 0, 11, "MSS",                                _lbl, _tr)
        f_setCell(_hud, 1, 11, _msStr,                               _msClr, _tr)

        // ── ④ ENTRY QUALITY ──
        f_setHdrCell(_hud, 0, 12, "④ ENTRY",                          color.new(color.white, 20), _hdr)
        f_setHdrCell(_hud, 1, 12, "",                                 color.new(color.white, 20), _hdr)
        string _locStr = fvAtH1H4Demand ? "H1/H4 Demand POI" : fvAtH1H4Supply ? "H1/H4 Supply POI" : close < pdVizDiscTop ? "Discount" : close > pdVizPremBot ? "Premium" : "Equilibrium"
        color  _locClr = (fvAtH1H4Demand or fvAtH1H4Supply) ? color.aqua : (close < pdVizDiscTop or close > pdVizPremBot) ? color.lime : _fvNA
        f_setCell(_hud, 0, 13, "Location/POI",                       _lbl, _tr)
        f_setCell(_hud, 1, 13, f_safeText(_locStr),                  _locClr, _tr)
        string _rrStr = (fvRR > 0 and fvDir != 0) ? str.tostring(fvRR, "#.0") + ":1" : "N/A"
        color  _rrClr = fvDir == 0 ? _fvNA : fvRRok ? color.lime : color.red
        f_setCell(_hud, 0, 14, "R:R",                                _lbl, _tr)
        f_setCell(_hud, 1, 14, _rrStr,                               _rrClr, _tr)
        string _mvStr = not na(fvMoveFrac) ? str.tostring(fvMoveFrac * 100.0, "#") + "%" : "N/A"
        color  _mvClr = na(fvMoveFrac) ? _fvNA : fvChased ? color.red : color.lime
        f_setCell(_hud, 0, 15, "Move Used",                          _lbl, _tr)
        f_setCell(_hud, 1, 15, _mvStr,                               _mvClr, _tr)

        // ── ⑤ VSA CONVICTION ──
        f_setHdrCell(_hud, 0, 16, "⑤ VSA",                            color.new(color.white, 20), _hdr)
        f_setHdrCell(_hud, 1, 16, "",                                 color.new(color.white, 20), _hdr)
        f_setCell(_hud, 0, 17, "Volume Read",                        _lbl, _tr)
        f_setCell(_hud, 1, 17, f_safeText(fvVSA),                    fvVSAColor, _tr)

        // ── FINAL VERDICT ──
        string _fvDisp = fvVerdictLabel + (fvDirWord != "" ? " " + fvDirWord : "")
        f_setHdrCell(_hud, 0, 18, "VERDICT",                         color.white, _hdr)
        f_setHdrCell(_hud, 1, 18, f_safeText(_fvDisp),               fvVerdictColor, _hdr)

        // ── v17.65.1: HUD layout notes ──
        //   • POI+ shows the 5-STAGE POI development path (SH|FVG|MSS|Mit|Flip),
        //     active stages as plain text, inactive as "-"; not a score. (v17.65.5)
        //   • Confl moved directly below POI+ (row 8); Confl+ row (row 9) shows the
        //     5 named confluence pillars (ALIGN|KZ|P&D|SWEEP|DISP), active plain text,
        //     inactive as "-". (v17.65.5)
        //   • AMD Vel row REMOVED (amdVelocity calculation preserved upstream).
        //   v17.65.0 removals still in effect: Levels, PDH/PDL HUD row (chart lines
        //   restored in v17.65.1), Sequence, Steps, Next, RangeAnchor, TrendOvr,
        //   StrongTrend. D&P zone drawing and all signal/bias/EQ logic are intact.

        // ── Row 17: H4 Structural Debug (v17.67.1: shifted -1 after MSS row removal) ──
        if showDebugRows and structDebug
            string structBiasStr = h4Bias_struct == 1 ? "BULL" : h4Bias_struct == -1 ? "BEAR" : "NEUT"
            string structInfo = "BOS:" + structBiasStr + " SwH:" + str.tostring(h4StructSwH, "#.####") + " SwL:" + str.tostring(h4StructSwL, "#.####")
            string rangeBiasStr = h4Bias_range == 1 ? "BULL" : h4Bias_range == -1 ? "BEAR" : "NEUT"
            string modeStr = "Mode:" + h4BiasMode + " Range:" + rangeBiasStr
            color structDbgClr = h4Bias_struct == 1 ? color.lime : h4Bias_struct == -1 ? color.red : color.gray
            f_setDbgCell(_hud, 0, 20, "H4Struct",                     color.new(color.gray, 40), _tr)
            f_setDbgCell(_hud, 1, 20, f_safeText(structInfo + " | " + modeStr), structDbgClr, _tr)

        // ── Row 18: HTF Debug ──
        if showDebugRows and structDebug
            string htfDbgBiasStr = htfBias == 1 ? "BULL" : htfBias == -1 ? "BEAR" : "NEUT"
            string htfDbgInfo = "H4 BOS:" + htfDbgBiasStr + " SwH:" + str.tostring(htfSwH, "#.####") + " SwL:" + str.tostring(htfSwL, "#.####") + " PL:" + str.tostring(htfPivotLen)
            string htfAlignInfo = "HTF↔LTF:" + (isWithTrend ? "WITH" : isCounterTrend ? "COUNTER" : "NEUTRAL")
            color htfDbgClr = htfBias == 1 ? color.lime : htfBias == -1 ? color.red : color.gray
            f_setDbgCell(_hud, 0, 21, "HTFDbg",                      color.new(color.gray, 40), _tr)
            f_setDbgCell(_hud, 1, 21, f_safeText(htfDbgInfo + " | " + htfAlignInfo), htfDbgClr, _tr)

        // ── Row 19: LTF Debug ──
        if showDebugRows and structDebug
            string ltfDbgBiasStr = ltfBias == 1 ? "BULL" : ltfBias == -1 ? "BEAR" : "NEUT"
            string ltfDbgInfo = "M15 BOS:" + ltfDbgBiasStr + " SwH:" + str.tostring(ltfSwH, "#.####") + " SwL:" + str.tostring(ltfSwL, "#.####") + " PL:" + str.tostring(ltfPivotLen)
            color ltfDbgClr = ltfBias == 1 ? color.lime : ltfBias == -1 ? color.red : color.gray
            f_setDbgCell(_hud, 0, 22, "LTFDbg",                      color.new(color.gray, 40), _tr)
            f_setDbgCell(_hud, 1, 22, f_safeText(ltfDbgInfo), ltfDbgClr, _tr)


// v17.77.0: single call replaces the former inline HUD render block
f_render_trade_hud()

// ============================================================================
// v17.67.5: Fixed H1 AMD state for Market Brief Narrative (chart-independent)
// ============================================================================
// The Narrative row must read the SAME AMD phase regardless of which chart
// timeframe the user is viewing. H1 is the sweet spot: fast enough for
// intraday shifts, slow enough to filter M5 noise.
// ============================================================================
string ebNarrFixed = request.security(syminfo.tickerid, "60", amdState, lookahead = barmerge.lookahead_off)

// ============================================================================
// v17.67.4: EXECUTIVE MARKET BRIEF V2 — "SCAN & GO" VERDICT CARD
// ============================================================================
// DISPLAY-ONLY. Reads finalized state, writes nothing back. No signal, alert,
// or state-machine value is modified. Trading behaviour is unchanged.
//
// Separate table from the main HUD: anchored position.middle_right.
// v17.67.4 UPGRADES:
//   • Bias: directional HTF/LTF (no "CONFLICTING") + OVR flag
//   • Trigger: specific structural level (Break M5 Supply, Sweep PDH, etc.)
//   • Location: timeframe-labeled zones (H1 Demand Active, M15 Supply, etc.)
//   • Action: 4-level (WAIT / MONITOR / BUY READY / SELL READY), no AVOID
//   • Confidence: weighted percentage score above Action row
// ============================================================================

// ── v17.67.4: Helper — scan MTF zone array to find which zone price is IN ──
// Returns the TF tag ("H4"/"H1"/"M15") + type ("Supply"/"Demand") or "" if none.
// Also finds the NEAREST zone (by distance to midpoint) if price is not inside any.
f_findMtfZoneLabel(array<MtfZone> _arr, string _tag) =>
    string _result = ""
    float  _minDist = 1e10
    string _nearest = ""
    if array.size(_arr) > 0
        for _i = 0 to array.size(_arr) - 1
            MtfZone _z = array.get(_arr, _i)
            if _z.active
                string _type = _z.isSupply ? "Supply" : "Demand"
                // Check if price is INSIDE this zone
                if close >= _z.bot and close <= _z.top
                    _result := _tag + " " + _type
                    break
                // Track nearest zone by distance
                float _mid = (_z.top + _z.bot) / 2.0
                float _dist = math.abs(close - _mid)
                if _dist < _minDist
                    _minDist := _dist
                    _nearest := _tag + " " + _type
    [_result, _nearest, _minDist]

// ── v17.67.4: Helper — scan M5 local zones (sTop/sBot/dTop/dBot arrays) ──
f_findM5ZoneLabel() =>
    string _result = ""
    float  _minDist = 1e10
    string _nearest = ""
    // Check M5 supply zones
    if array.size(sTop) > 0
        for _i = 0 to array.size(sTop) - 1
            float _st = array.get(sTop, _i)
            float _sb = array.get(sBot, _i)
            if close >= _sb and close <= _st
                _result := curTfTag + " Supply"
                break
            float _mid = (_st + _sb) / 2.0
            float _dist = math.abs(close - _mid)
            if _dist < _minDist
                _minDist := _dist
                _nearest := curTfTag + " Supply"
    // Check M5 demand zones (only if not already inside a supply)
    if _result == "" and array.size(dTop) > 0
        for _i = 0 to array.size(dTop) - 1
            float _dt = array.get(dTop, _i)
            float _db = array.get(dBot, _i)
            if close >= _db and close <= _dt
                _result := curTfTag + " Demand"
                break
            float _mid = (_dt + _db) / 2.0
            float _dist = math.abs(close - _mid)
            if _dist < _minDist
                _minDist := _dist
                _nearest := curTfTag + " Demand"
    [_result, _nearest, _minDist]

// ── v17.85.15: Directional opposing-obstacle scan (DISPLAY-ONLY) ──
// Finds the nearest ACTIVE opposing zone in the trend direction, measured by the
// nearest ACCESSIBLE boundary (zone.bot-close for supply above / close-zone.top
// for demand below) — NOT midpoint. Returns [nearest boundary distance (na if
// none), atIn] where atIn is true when price is inside the zone OR within the
// proximity band (_frac). _wantSupply = true for a bull (supply overhead is the
// obstacle); false for a bear (demand underfoot). Reads nothing, writes nothing.
f_nearOppDist(array<MtfZone> _arr, bool _wantSupply, float _frac) =>
    float _best = na
    bool  _atIn = false
    if array.size(_arr) > 0
        for _i = 0 to array.size(_arr) - 1
            MtfZone _z = array.get(_arr, _i)
            if _z.active and _z.isSupply == _wantSupply
                float _d = na
                bool  _in = false
                if close >= _z.bot and close <= _z.top
                    _d  := 0.0
                    _in := true
                else if _wantSupply and _z.bot > close
                    _d  := _z.bot - close
                    _in := close >= _z.bot * (1.0 - _frac)
                else if not _wantSupply and _z.top < close
                    _d  := close - _z.top
                    _in := close <= _z.top * (1.0 + _frac)
                if not na(_d) and (na(_best) or _d < _best)
                    _best := _d
                    _atIn := _in
    [_best, _atIn]

// v17.77.0 BUILD FIX (CE10295): Executive Market Brief (render + alert JSON +
// anti-spam state) wrapped into a function to shrink the main body. Reads
// finalized globals; all eb*/anti-spam vars are function-local. alert() is
// permitted in function scope. Behaviour identical to former inline block.
// ============================================================================
f_render_exec_brief() =>
    var table _eb = na
    if showExecBrief and na(_eb)
        // v17.85.19: 12 rows — Header, Bias, Action(finalVerdict), TRADE LEVELS
        // (Entry/SL/TP), QUALITY (Setup Conf, VSA), WHY NO ALERT (blocker list).
        // v17.85.20: 13 rows — row 12 reserved for the OPTIONAL M5 MSS reference row.
        _eb := table.new(position.middle_right, 2, 13, bgcolor=color.new(color.black, 15), frame_color=color.new(color.gray, 40), frame_width=1, border_color=color.new(color.gray, 70), border_width=1)

    if showExecBrief and barstate.islast and not na(_eb)

        // ════════════════════════════════════════════════════════════════
        // ROW 0: HEADER
        // ════════════════════════════════════════════════════════════════
        table.cell(_eb, 0, 0, "MARKET", text_color=color.white, text_size=size.normal, bgcolor=color.new(#1a1a2e, 0), text_halign=text.align_right)
        table.cell(_eb, 1, 0, "BRIEF",  text_color=color.yellow, text_size=size.normal, bgcolor=color.new(#1a1a2e, 0), text_halign=text.align_left)

        // ════════════════════════════════════════════════════════════════
        // ROW 1: NARRATIVE — AMD Phase (fixed H1 via request.security, v17.67.5)
        // ════════════════════════════════════════════════════════════════
        string ebNarrative = not na(ebNarrFixed) ? ebNarrFixed : amdState
        color  ebNarrColor = ebNarrative == "MARKUP" ? color.lime : ebNarrative == "MARKDOWN" ? color.red : ebNarrative == "ACCUMULATION" ? color.yellow : ebNarrative == "MANIPULATION" ? color.orange : ebNarrative == "DISTRIBUTION" ? color.aqua : color.gray
        // _narrativeDiverges: True when H1 AMD (global anchor) differs from the
        // chart-local AMD state. Used to flag the Narrative row with ⚠ so the
        // trader knows the H1 context and the current chart are telling different
        // stories. Does NOT change the H1 anchor — display only.
        bool _narrativeDiverges = ebNarrative != amdState
        string _narrDisplay = _narrativeDiverges ? ebNarrative + " ⚠" : ebNarrative
        // v17.85.19: Narrative row no longer rendered as its own cell (kept as a
        // computed value for the alert JSON). The MB layout is rebuilt at the end
        // of this function from the finalVerdict engine (single source of truth).

        // ════════════════════════════════════════════════════════════════
        // ROW 2: LOCATION — TF-labeled structural zone (Fix 3)
        // ════════════════════════════════════════════════════════════════
        // Scan all TF zone arrays to find which zone price is inside, with TF label.
        // Priority: M5 (curTfTag) → M15 → H1 → H4 → PDH/PDL → P&D zone
        [m5In, m5Near, m5Dist]     = f_findM5ZoneLabel()
        [m15In, m15Near, m15Dist]  = f_findMtfZoneLabel(m15Zones, "M15")
        [h1In, h1Near, h1Dist]     = f_findMtfZoneLabel(h1Zones, "H1")
        [h4In, h4Near, h4Dist]     = f_findMtfZoneLabel(h4Zones, "H4")

        string ebLocation = "Equilibrium"
        color  ebLocColor = color.gray

        // ── v17.85.15: Directional / blocker-aware Location (DISPLAY-ONLY) ──
        // When NOT inside a zone, the Location row is now bias-aware: it points at
        // the nearest ACTIVE opposing obstacle in the trend direction (measured by
        // accessible boundary, not midpoint) instead of the closest midpoint of any
        // zone. Hard-blocker scope is unchanged (M15 + H1 only); H4 is context.
        bool   _locBull   = finalHTFTrend == 1
        bool   _locDir    = finalHTFTrend != 0
        float  _locFrac   = oppZoneProxPct / 100.0
        string _oppKind   = _locBull ? "Supply" : "Demand"
        string _entSide   = _locBull ? "Long"  : "Short"
        string _entSidePl = _locBull ? "Longs" : "Shorts"
        // opposing = supply overhead for a bull, demand underfoot for a bear
        [_m15OppD, _m15OppAt] = f_nearOppDist(m15Zones, _locBull, _locFrac)
        [_h1OppD,  _h1OppAt]  = f_nearOppDist(h1Zones,  _locBull, _locFrac)
        [_h4OppD,  _h4OppAt]  = f_nearOppDist(h4Zones,  _locBull, _locFrac)

        // Check if price is INSIDE any zone (priority: smallest TF first)
        // v17.85.15: AT an M15/H1 opposing zone (inside OR within band) = hard
        // blocker — takes priority so the row shows the entry is blocked.
        if _locDir and (_m15OppAt or _h1OppAt)
            string _blkTf = _h1OppAt ? "H1" : "M15"
            ebLocation := "At " + _blkTf + " " + _oppKind + " — " + _entSide + " Entry Blocked"
            ebLocColor := color.red
        // v17.85.16 Fix 2: Multi-TF inside-priority is now HIGHER-TF-FIRST
        // (H4 > H1 > M15 > M5). A higher-timeframe zone can no longer be masked by a
        // smaller-TF zone at the same price — e.g. price inside an H4 Supply always
        // reads "In H4 Supply" rather than a nested "M5 Demand".
        else if h4In != ""
            ebLocation := "In " + h4In
            ebLocColor := str.contains(h4In, "Supply") ? color.red : color.lime
        else if h1In != ""
            ebLocation := "In " + h1In
            ebLocColor := str.contains(h1In, "Supply") ? color.red : color.lime
        else if m15In != ""
            ebLocation := "In " + m15In
            ebLocColor := str.contains(m15In, "Supply") ? color.red : color.lime
        else if m5In != ""
            ebLocation := m5In + " (Active)"
            ebLocColor := str.contains(m5In, "Supply") ? color.red : color.lime
        else if priceInBullOB
            ebLocation := "OB Demand (Active)"
            ebLocColor := color.lime
        else if priceInBearOB
            ebLocation := "OB Supply (Active)"
            ebLocColor := color.red
        else if nearPDH
            ebLocation := "Near PDH"
            ebLocColor := color.orange
        else if nearPDL
            ebLocation := "Near PDL"
            ebLocColor := color.aqua
        else
            // v17.85.15: directional obstacle scan — nearest opposing zone in the
            // trend direction by accessible boundary. H1/H4 win over M15 when
            // similarly close (structural tie-break within _tol). M15/H1 = hard
            // blocker scope → "Longs/Shorts Limited"; H4 = context → "No Fresh".
            float  _tol    = syminfo.mintick * ((syminfo.type == "forex") ? 10.0 : 1.0) * 5.0
            float  _obstD  = na
            string _obstTf = ""
            if _locDir
                if not na(_m15OppD)
                    _obstD  := _m15OppD
                    _obstTf := "M15"
                if not na(_h1OppD) and (na(_obstD) or _h1OppD < _obstD + _tol)
                    _obstD  := _h1OppD
                    _obstTf := "H1"
                if not na(_h4OppD) and (na(_obstD) or _h4OppD < _obstD + _tol)
                    _obstD  := _h4OppD
                    _obstTf := "H4"
            if _obstTf != ""
                string _sfx = _obstTf == "H4" ? (" — No Fresh " + _entSide) : (" — " + _entSidePl + " Limited")
                ebLocation := "Approaching " + _obstTf + " " + _oppKind + _sfx
                ebLocColor := color.orange
            else
                // No opposing obstacle in the trend direction (or neutral bias) —
                // fall back to nearest zone across all TFs (supporting / context).
                float  bestDist = 1e10
                string bestLabel = ""
                if m5Dist < bestDist
                    bestDist  := m5Dist
                    bestLabel := m5Near
                if m15Dist < bestDist
                    bestDist  := m15Dist
                    bestLabel := m15Near
                if h1Dist < bestDist
                    bestDist  := h1Dist
                    bestLabel := h1Near
                if h4Dist < bestDist
                    bestDist  := h4Dist
                    bestLabel := h4Near
                if bestLabel != ""
                    ebLocation := "Near " + bestLabel + (_locDir ? " (support)" : "")
                    ebLocColor := str.contains(bestLabel, "Supply") ? color.new(color.red, 30) : color.new(color.lime, 30)
                else if inPremiumZone
                    ebLocation := "Premium Zone"
                    ebLocColor := color.red
                else if inDiscountZone
                    ebLocation := "Discount Zone"
                    ebLocColor := color.lime
                else
                    ebLocation := "Equilibrium"
                    ebLocColor := color.gray

        // v17.85.19 (render moved): table.cell(_eb, 0, 2, "Location", text_color=color.new(color.white, 30), text_size=size.normal, bgcolor=color.new(color.black, 20), text_halign=text.align_right)
        // v17.85.19 (render moved): table.cell(_eb, 1, 2, f_safeText(ebLocation), text_color=ebLocColor, text_size=size.normal, bgcolor=color.new(color.black, 20), text_halign=text.align_left)

        // ════════════════════════════════════════════════════════════════
        // ROW 3: BIAS — Directional HTF/LTF with OVR flag (Fix 1)
        // ════════════════════════════════════════════════════════════════
        // When both agree: "BULLISH" / "BEARISH"
        // When they conflict: show the DOMINANT side (HTF carries more weight)
        //   + if LTF has OVR flag, show the LTF with "(OVR)" suffix
        // When neutral: "Neutral"
        string ebBias = "Neutral"
        color  ebBiasColor = color.gray
        if finalHTFTrend == 1 and finalLTFTrend == 1
            ebBias := "BULLISH"
            ebBiasColor := color.lime
        else if finalHTFTrend == -1 and finalLTFTrend == -1
            ebBias := "BEARISH"
            ebBiasColor := color.red
        else if finalHTFTrend != 0 and finalLTFTrend != 0 and finalHTFTrend != finalLTFTrend
            // HTF and LTF disagree — show HTF as dominant
            if ltfOverrideActive
                // LTF has momentum override active — show LTF direction with OVR tag
                ebBias := finalLTFTrend == 1 ? "LTF Bullish (OVR)" : "LTF Bearish (OVR)"
                ebBiasColor := finalLTFTrend == 1 ? color.lime : color.red
            else
                // Standard conflict: HTF dominates
                ebBias := finalHTFTrend == 1 ? "HTF Bullish" : "HTF Bearish"
                ebBiasColor := finalHTFTrend == 1 ? color.lime : color.red
        else if finalHTFTrend == 0 and finalLTFTrend == 0
            ebBias := "Neutral"
            ebBiasColor := color.gray
        else if finalHTFTrend != 0
            // HTF directional, LTF neutral
            ebBias := finalHTFTrend == 1 ? "HTF Bullish" : "HTF Bearish"
            ebBiasColor := finalHTFTrend == 1 ? color.new(color.lime, 20) : color.new(color.red, 20)
        else
            // LTF directional, HTF neutral
            string _ovrTag = ltfOverrideActive ? " (OVR)" : ""
            ebBias := finalLTFTrend == 1 ? "LTF Bullish" + _ovrTag : "LTF Bearish" + _ovrTag
            ebBiasColor := finalLTFTrend == 1 ? color.new(color.lime, 30) : color.new(color.red, 30)

        // v17.85.19 (render moved): table.cell(_eb, 0, 3, "Bias", text_color=color.new(color.white, 30), text_size=size.normal, bgcolor=color.new(color.black, 20), text_halign=text.align_right)
        // v17.85.19 (render moved): table.cell(_eb, 1, 3, f_safeText(ebBias), text_color=ebBiasColor, text_size=size.normal, bgcolor=color.new(color.black, 20), text_halign=text.align_left)

        // ════ v17.72.0: HTF-EXTREME DETECTION (Dynamic Risk Tolerance) ════
        // Direction-aware: is price mitigating a MAJOR H4/Daily zone right now?
        //   Demand extreme (CT-long edge) : inside H4 Demand, or at Daily Low / PDL
        //   Supply extreme (CT-short edge) : inside H4 Supply, or at Daily High / PDH
        // Computed early so the Confidence engine, CT detection and the alert gate
        // can all reference the same booleans. h4In is already resolved (Location row).
        bool _h4DemandHere = h4In != "" and str.contains(h4In, "Demand")
        bool _h4SupplyHere = h4In != "" and str.contains(h4In, "Supply")
        float _htfPxTol = math.max((syminfo.mintick * ((syminfo.type == "forex") ? 10.0 : 1.0)) * 5.0, atrValue * 0.05)
        bool _atDailyLow  = not na(dailyLow)  and math.abs(close - dailyLow)  <= _htfPxTol
        bool _atDailyHigh = not na(dailyHigh) and math.abs(close - dailyHigh) <= _htfPxTol
        bool _atPDLx = not na(pdl) and math.abs(close - pdl) <= _htfPxTol
        bool _atPDHx = not na(pdh) and math.abs(close - pdh) <= _htfPxTol
        bool _htfDemandExtreme = enableHtfCtBypass and (_h4DemandHere or _atDailyLow or _atPDLx)
        bool _htfSupplyExtreme = enableHtfCtBypass and (_h4SupplyHere or _atDailyHigh or _atPDHx)
        bool _atHtfExtreme     = _htfDemandExtreme or _htfSupplyExtreme

        // --- Early Confidence calculation (needed by Trigger P3 check) ---
        // Full rendering happens in ROW 5; here we just compute the int.
        float _confPoi   = math.min(poiScore, 5) / 5.0
        float _confConfl = math.min(confluencePillarScore, 5) / 5.0
        float _confMom   = math.min(momentumScore, 3) / 3.0
        float _confAlign = (finalHTFTrend != 0 and finalHTFTrend == finalLTFTrend) ? 1.0 : (finalHTFTrend != 0 and finalLTFTrend != 0 and finalHTFTrend != finalLTFTrend) ? 0.0 : 0.5
        float _confLoc   = 0.5
        if finalHTFTrend == 1
            _confLoc := inDiscountZone ? 1.0 : inPremiumZone ? 0.0 : 0.5
        else if finalHTFTrend == -1
            _confLoc := inPremiumZone ? 1.0 : inDiscountZone ? 0.0 : 0.5
        // v17.72.0: At a major HTF extreme the LOCATION itself is the edge — a deep
        // Daily/H4 zone IS the confluence. Treat location as high-quality and stop
        // penalising the (expected) HTF↔LTF conflict so legitimate reversals aren't
        // scored to death by with-trend assumptions.
        if _atHtfExtreme
            _confLoc := math.max(_confLoc, 0.9)
            if _confAlign == 0.0
                _confAlign := 0.5
        int ebConfInt = math.round((_confPoi * 0.20 + _confConfl * 0.25 + _confMom * 0.20 + _confAlign * 0.20 + _confLoc * 0.15) * 100.0)

        // ════════════════════════════════════════════════════════════════
        // v17.73.0: MACRO-EXPRESS LANE — macro-aligned micro-filter bypass
        // ════════════════════════════════════════════════════════════════
        // Detect whether price is currently mitigating a valid LOCAL demand (for
        // longs) or supply (for shorts) zone across M5 / M15 / H1 (or a bull/bear OB).
        // All array loops are guarded by size>0 (Pine `for 0 to -1` would run on -1).
        // v17.75: Institutional OB is the PRIMARY (highest-conviction) local anchor;
        // a Simple OB or MTF S&D zone is the fallback.
        bool _meInstDemand  = priceInBullOB and obInstitutional
        bool _meInstSupply  = priceInBearOB and obInstitutional
        bool _meLocalDemand = _meInstDemand or priceInBullOB
        bool _meLocalSupply = _meInstSupply or priceInBearOB
        if not _meLocalDemand and array.size(dTop) > 0
            for _mi = 0 to array.size(dTop) - 1
                if close >= array.get(dBot, _mi) and close <= array.get(dTop, _mi)
                    _meLocalDemand := true
                    break
        if not _meLocalSupply and array.size(sTop) > 0
            for _mi = 0 to array.size(sTop) - 1
                if close >= array.get(sBot, _mi) and close <= array.get(sTop, _mi)
                    _meLocalSupply := true
                    break
        if (not _meLocalDemand or not _meLocalSupply) and array.size(m15Zones) > 0
            for _mi = 0 to array.size(m15Zones) - 1
                MtfZone _mz = array.get(m15Zones, _mi)
                if _mz.active and close >= _mz.bot and close <= _mz.top
                    if _mz.isSupply
                        _meLocalSupply := true
                    else
                        _meLocalDemand := true
        if (not _meLocalDemand or not _meLocalSupply) and array.size(h1Zones) > 0
            for _mi = 0 to array.size(h1Zones) - 1
                MtfZone _mz = array.get(h1Zones, _mi)
                if _mz.active and close >= _mz.bot and close <= _mz.top
                    if _mz.isSupply
                        _meLocalSupply := true
                    else
                        _meLocalDemand := true
        // Macro alignment: HTF bias == LTF bias (both non-neutral) + correct half +
        // a valid local zone in the trade direction.
        bool _macroBiasAligned  = enableMacroExpress and finalHTFTrend != 0 and finalHTFTrend == finalLTFTrend
        bool _macroAlignedLong   = _macroBiasAligned and finalHTFTrend == 1  and inDiscountZone and _meLocalDemand
        bool _macroAlignedShort  = _macroBiasAligned and finalHTFTrend == -1 and inPremiumZone  and _meLocalSupply
        bool macroAligned        = _macroAlignedLong or _macroAlignedShort
        // Confidence auto-boost: floor confidence so it clears the 70% gate, prints in
        // the Market Brief and unlocks execution. Applied before the Trigger/Action rows.
        if macroAligned
            ebConfInt := math.max(ebConfInt, macroExpressConfFloor)

        // v17.70.0: Continuance detection — true when Guardian is in Continuation (3/4)
        // or Trend Expansion (5/6) mode, indicating a second-leg setup.
        // Defined here so both Trigger row (appends "Cont") and Action row can use it.
        bool _isContinuance = guardianDisplayCode >= 3 and guardianDisplayCode <= 6

        // ════════════════════════════════════════════════════════════════
        // ROW 4: TRIGGER — Proximity & Catalyst Engine (v17.67.8)
        // ════════════════════════════════════════════════════════════════
        // v17.67.8: "Proximity-First" hierarchy.  Answers "what is the
        //   IMMEDIATE next event for price?" rather than naming distant
        //   structural levels.
        //   P0: Fast-paths (MSS bypass active, alert already live)
        //   P1: Location Interaction — price AT a key level (ATR-based)
        //   P2: Liquidity Sweep & Reclaim — level just swept / MANIPULATION
        //   P3: Low-Confidence MSS — Conf<50 & system idle → need MSS
        //   P4: Distant Structural Target — mid-range, bias set → displacement
        //   D2: ATR guardrail — distant level (>1.5× ATR) → fallback
        //   _trigCtx bridges Trigger → Action row alignment (D3)
        string ebTrigger = "Await Setup"
        color  ebTrigColor = color.gray
        int    _trigCtx = 0  // 0=default, 1=watching_reaction, 2=sweep_reclaim,
                             // 3=need_mss, 4=displacement, 5=ready, 6=ct_setup

        // --- Proximity threshold: dynamic, ATR-adjusted ---
        // Tight tolerance = max(5 pips, 5% of ATR) — catches "sitting on" a level
        float _isForex = (syminfo.type == "forex") ? 1.0 : 0.0
        float _pipSize = syminfo.mintick * (_isForex == 1.0 ? 10.0 : 1.0)
        float _proxTol = math.max(_pipSize * 5.0, atrValue * 0.05)

        // --- ATR guardrail threshold (D2) ---
        float _atrGuard = atrValue * 1.5

        // --- Bias direction helpers ---
        bool _isBullBias = finalHTFTrend == 1
        bool _isBearBias = finalHTFTrend == -1

        // --- P1 helper: check proximity to each key level ---
        // Build an ordered cascade: PDL → PDH → Daily Low → Daily High
        //   → Asian Low → Asian High → H4 Zone
        // First match wins (closest / most significant level).
        string _proxLevel = ""    // name of the level price is sitting on
        float  _proxDist  = 1e10  // distance to that level

        // PDL proximity
        float _dPDL = math.abs(close - nz(pdl, close))
        if _dPDL <= _proxTol and _dPDL < _proxDist
            _proxLevel := "PDL"
            _proxDist  := _dPDL
        // PDH proximity
        float _dPDH = math.abs(close - nz(pdh, close))
        if _dPDH <= _proxTol and _dPDH < _proxDist
            _proxLevel := "PDH"
            _proxDist  := _dPDH
        // Daily Low proximity
        float _dDLo = math.abs(close - nz(dailyLow, close))
        if _dDLo <= _proxTol and _dDLo < _proxDist
            _proxLevel := "Daily Low"
            _proxDist  := _dDLo
        // Daily High proximity
        float _dDHi = math.abs(close - nz(dailyHigh, close))
        if _dDHi <= _proxTol and _dDHi < _proxDist
            _proxLevel := "Daily High"
            _proxDist  := _dDHi
        // Asian Low proximity
        float _dAsiL = math.abs(close - nz(asiLo, close))
        if _dAsiL <= _proxTol and _dAsiL < _proxDist
            _proxLevel := "Asian Low"
            _proxDist  := _dAsiL
        // Asian High proximity
        float _dAsiH = math.abs(close - nz(asiHi, close))
        if _dAsiH <= _proxTol and _dAsiH < _proxDist
            _proxLevel := "Asian High"
            _proxDist  := _dAsiH
        // H4 Zone proximity (already computed by Location row: h4In != "")
        if h4In != "" and _proxLevel == ""
            _proxLevel := h4In  // e.g. "H4 Supply", "H4 Demand"
            _proxDist  := 0.0

        // --- D1 (v17.68.0): Counter-Trend Setup Detection ---
        // Triple-gate: CT conflict + key level proximity + LTF structural confirmation.
        // _isCTSetup is true ONLY when all three pass simultaneously.
        // The CT direction is determined by finalLTFTrend (the flip direction).
        bool _ctConflict = finalHTFTrend != 0 and finalLTFTrend != 0 and finalHTFTrend != finalLTFTrend
        // CT long (LTF bullish flip): price must be at support levels
        bool _ctLongLevel = _proxLevel == "PDL" or _proxLevel == "Daily Low" or _proxLevel == "Asian Low" or str.contains(not na(_proxLevel) ? _proxLevel : "", "Demand")
        // CT short (LTF bearish flip): price must be at resistance levels
        bool _ctShortLevel = _proxLevel == "PDH" or _proxLevel == "Daily High" or _proxLevel == "Asian High" or str.contains(not na(_proxLevel) ? _proxLevel : "", "Supply")
        // LTF structural confirmation: MSS developing in the counter direction
        bool _ctLTFConfirm = mssState >= 1

        // --- LEGACY CT LANE (v17.68.0, unchanged) ---
        // Requires the LTF trend to have ALREADY flipped (finalLTFTrend) + full MSS.
        // Gated by mbAllowCT. This is the conservative lane.
        bool _ctLongStd  = _ctConflict and finalLTFTrend == 1  and _ctLongLevel  and _ctLTFConfirm and _proxLevel != ""
        bool _ctShortStd = _ctConflict and finalLTFTrend == -1 and _ctShortLevel and _ctLTFConfirm and _proxLevel != ""

        // --- v17.72.0 HTF-EXTREME CT LANE (Sweep-Reversal model) ---
        // At a major H4/Daily extreme, "loosen the leash":
        //   #1 KZ BYPASS — P1.5 fires above the "Await Kill Zone" check, so the
        //      Kill-Zone time filter is bypassed for these setups automatically.
        //   #2 SWEEP-REVERSAL ENTRY — replace the lagging full-MSS requirement with
        //      an immediate sweep/reclaim or M5 structure shift (buy the wick).
        //   #3 OVR BYPASS — does NOT require finalLTFTrend to have flipped, so a
        //      ⚡OVR pinning the LTF against the reversal no longer blocks the setup.
        // A wick sweep + reclaim (sweepLow/High) or an M5 MSS in the CT direction
        // is sufficient catalyst.
        bool _ctBullCatalyst = sweepLow  or m5BullMSS or (mssState >= 1 and mssDir == 1)
        bool _ctBearCatalyst = sweepHigh or m5BearMSS or (mssState >= 1 and mssDir == -1)
        bool _ctLongHtf  = _htfDemandExtreme and finalHTFTrend == -1 and _ctBullCatalyst
        bool _ctShortHtf = _htfSupplyExtreme and finalHTFTrend == 1  and _ctBearCatalyst

        // Assemble the two lanes
        bool _isCTLong  = _ctLongStd  or _ctLongHtf
        bool _isCTShort = _ctShortStd or _ctShortHtf
        // _htfCtMode = this CT setup is firing via the aggressive HTF-extreme lane.
        // Drives the relaxed confidence gate (#4), the relaxed alert gate, and the
        // "Sweep-Reversal" entry-mode tag.
        bool _htfCtMode = enableHtfCtBypass and (_ctLongHtf or _ctShortHtf)
        bool _isCTSetup = (mbAllowCT or _htfCtMode) and (_isCTLong or _isCTShort)

        // --- P2 helper: sweep state ---
        bool _anySwept = pdhSwept or pdlSwept
        bool _isManip  = amdState == "MANIPULATION"
        string _sweepLabel = ""
        if pdhSwept
            _sweepLabel := "PDH"
        else if pdlSwept
            _sweepLabel := "PDL"

        // --- P4 helper: nearest obstacle for displacement target ---
        // Reuse the M5/M15 scan from v17.67.7 but apply ATR guardrail (D2).
        string _localObstacle = ""
        float  _obstacleDist  = 1e10
        if _isBullBias
            // M5 supply above
            if array.size(sTop) > 0
                for _i = 0 to array.size(sTop) - 1
                    float _mid = (array.get(sTop, _i) + array.get(sBot, _i)) / 2.0
                    if _mid > close
                        float _dist = _mid - close
                        if _dist < _obstacleDist
                            _obstacleDist := _dist
                            _localObstacle := curTfTag + " Supply"
            // M15 supply above (fallback)
            if _localObstacle == "" and array.size(m15Zones) > 0
                for _i = 0 to array.size(m15Zones) - 1
                    MtfZone _z = array.get(m15Zones, _i)
                    if _z.active and _z.isSupply and _z.bot > close
                        float _dist = _z.bot - close
                        if _dist < _obstacleDist
                            _obstacleDist := _dist
                            _localObstacle := "M15 Supply"
        else if _isBearBias
            // M5 demand below
            if array.size(dTop) > 0
                for _i = 0 to array.size(dTop) - 1
                    float _mid = (array.get(dTop, _i) + array.get(dBot, _i)) / 2.0
                    if _mid < close
                        float _dist = close - _mid
                        if _dist < _obstacleDist
                            _obstacleDist := _dist
                            _localObstacle := curTfTag + " Demand"
            // M15 demand below (fallback)
            if _localObstacle == "" and array.size(m15Zones) > 0
                for _i = 0 to array.size(m15Zones) - 1
                    MtfZone _z = array.get(m15Zones, _i)
                    if _z.active and not _z.isSupply and _z.top < close
                        float _dist = close - _z.top
                        if _dist < _obstacleDist
                            _obstacleDist := _dist
                            _localObstacle := "M15 Demand"

        // ========== PRIORITY CASCADE ==========

        // --- P0: Fast-path exits ---
        if isMssBypass
            ebTrigger   := finalHTFTrend == -1 ? "MSS Down ✓" : "MSS Up ✓"
            ebTrigColor := color.lime
            _trigCtx    := 5
        // v17.85.19: legacy "Alert Live ✓" fast-path REMOVED — the MB no longer
        // reports READY independently of the finalVerdict engine.

        // --- P1: Location Interaction (HIGHEST non-fast-path) ---
        // Price is physically AT a major liquidity level or inside an H4 zone.
        // v17.68.0: Skip P1 when _isCTSetup is true — let P1.5 handle the CT catalyst.
        else if _proxLevel != "" and not _isCTSetup
            // Determine "Watch Reaction" vs "Hold" based on bias alignment
            if str.contains(_proxLevel, "Supply")
                // At/in Supply — bearish confirmation, bullish risk
                if _isBearBias
                    ebTrigger   := "Hold " + _proxLevel
                    ebTrigColor := color.lime
                    _trigCtx    := 1
                else
                    ebTrigger   := "Watch " + _proxLevel + " Reaction"
                    ebTrigColor := color.orange
                    _trigCtx    := 1
            else if str.contains(_proxLevel, "Demand")
                // At/in Demand — bullish confirmation, bearish risk
                if _isBullBias
                    ebTrigger   := "Hold " + _proxLevel
                    ebTrigColor := color.lime
                    _trigCtx    := 1
                else
                    ebTrigger   := "Watch " + _proxLevel + " Reaction"
                    ebTrigColor := color.orange
                    _trigCtx    := 1
            else if str.contains(_proxLevel, "Low")
                // PDL / Daily Low / Asian Low — support → bullish watch
                if _isBullBias
                    ebTrigger   := "Hold " + _proxLevel
                    ebTrigColor := color.lime
                    _trigCtx    := 1
                else
                    ebTrigger   := "Watch " + _proxLevel + " Reaction"
                    ebTrigColor := color.orange
                    _trigCtx    := 1
            else
                // PDH / Daily High / Asian High — resistance → bearish watch
                if _isBearBias
                    ebTrigger   := "Hold " + _proxLevel
                    ebTrigColor := color.lime
                    _trigCtx    := 1
                else
                    ebTrigger   := "Watch " + _proxLevel + " Reaction"
                    ebTrigColor := color.orange
                    _trigCtx    := 1

        // --- P1.5: Counter-Trend Catalyst (v17.68.0) ---
        // Fires when _isCTSetup is true: HTF/LTF conflict + at key level + MSS confirmed.
        // This sits BELOW P1 intentionally: if P1 already handled the level
        // (price is AT the level but no LTF flip yet), P1 gives "Watch Reaction".
        // P1.5 only fires when the LTF flip is structurally CONFIRMED at the level.
        else if _isCTSetup
            // v17.72.0: when firing via the HTF-extreme lane, label the level by the
            // HTF zone (fallback to _proxLevel) and tag the Sweep-Reversal model.
            string _ctLevelName = _proxLevel != "" ? _proxLevel : (_h4DemandHere or _h4SupplyHere ? h4In : _atDailyLow ? "Daily Low" : _atDailyHigh ? "Daily High" : "HTF Zone")
            string _ctModeTag   = _htfCtMode ? " (Sweep-Rev)" : ""
            if _isCTLong
                ebTrigger   := "CT: Bull Flip at " + _ctLevelName + _ctModeTag
                ebTrigColor := color.fuchsia
                _trigCtx    := 6
            else
                ebTrigger   := "CT: Bear Flip at " + _ctLevelName + _ctModeTag
                ebTrigColor := color.fuchsia
                _trigCtx    := 6

        // --- P2: Liquidity Sweep & Reclaim ---
        else if _anySwept or _isManip
            if _sweepLabel != ""
                ebTrigger   := "Reclaim " + _sweepLabel
                ebTrigColor := color.orange
            else
                ebTrigger   := "Sweep & Reclaim"
                ebTrigColor := color.orange
            _trigCtx := 2

        // --- P3: Low-Confidence Structural Shift ---
        // If Confidence < 50% and the system is not in displacement / has no
        // active setup, the trader needs the FIRST sign of life: an MSS.
        else if ebConfInt < 50 and (sysNoDisp or sysCounterTrend)
            if _isBullBias
                ebTrigger   := "Need Bullish MSS"
                ebTrigColor := color.yellow
            else if _isBearBias
                ebTrigger   := "Need Bearish MSS"
                ebTrigColor := color.yellow
            else
                ebTrigger   := "Need MSS"
                ebTrigColor := color.yellow
            _trigCtx := 3

        // --- P4: Distant Structural Target (default fallback) ---
        // Price is floating mid-range with directional bias established.
        // Apply ATR guardrail (D2): obstacle > 1.5× ATR → "Watch Price Action"
        else if _isBullBias or _isBearBias
            if _localObstacle != "" and _obstacleDist <= _atrGuard
                ebTrigger   := (_isBullBias ? "Bull" : "Bear") + " Disp thru " + _localObstacle
                ebTrigColor := color.yellow
                _trigCtx    := 4
            else
                // Guardrail triggered OR no obstacle found → generic wait
                ebTrigger   := "Watch Price Action"
                ebTrigColor := color.yellow
                _trigCtx    := 4

        // --- P5: Remaining system-gate states (no directional bias) ---
        else if not (mssState >= 1)
            ebTrigger   := "Await MSS"
            ebTrigColor := color.yellow
            _trigCtx    := 3
        else if not sequenceComplete
            ebTrigger   := "Seq " + str.tostring(confluencePillarScore) + "/5"
            ebTrigColor := color.yellow
            _trigCtx    := 4
        else if not kzActive
            ebTrigger   := "Await Kill Zone"
            ebTrigColor := color.orange
            _trigCtx    := 4
        else
            ebTrigger   := finalHTFTrend == -1 ? "SELL Trigger" : "BUY Trigger"
            ebTrigColor := color.lime
            _trigCtx    := 5

        // v17.70.0: Append continuation context to trigger text when second-leg detected
        if _isContinuance and _trigCtx >= 3
            ebTrigger := ebTrigger + " (Cont)"
        // v17.85.19 (render moved): table.cell(_eb, 0, 4, "Trigger", text_color=color.new(color.white, 30), text_size=size.normal, bgcolor=color.new(color.black, 20), text_halign=text.align_right)
        // v17.85.19 (render moved): table.cell(_eb, 1, 4, f_safeText(ebTrigger), text_color=ebTrigColor, text_size=size.normal, bgcolor=color.new(color.black, 20), text_halign=text.align_left)

        // ════════════════════════════════════════════════════════════════
        // ROW 5: CONFIDENCE — Weighted percentage score (Fix 5)
        // ════════════════════════════════════════════════════════════════
        // ebConfInt was already computed above (before Trigger row) so the
        // P3 low-confidence check could use it.  Just derive the color here.
        color ebConfColor = ebConfInt >= 86 ? color.rgb(0, 255, 100) : ebConfInt >= 66 ? color.lime : ebConfInt >= 34 ? color.yellow : color.red

        // v17.85.19 (render moved): table.cell(_eb, 0, 5, "Confidence", text_color=color.new(color.white, 30), text_size=size.normal, bgcolor=color.new(color.black, 20), text_halign=text.align_right)
        // v17.85.19 (render moved): table.cell(_eb, 1, 5, str.tostring(ebConfInt) + "%", text_color=ebConfColor, text_size=size.normal, bgcolor=color.new(color.black, 20), text_halign=text.align_left)

        // ════════════════════════════════════════════════════════════════
        // ROW 6: ACTION — Trigger-Aligned Verdict (v17.67.8)
        // ════════════════════════════════════════════════════════════════
        // D3: The Action row now PARSES _trigCtx from the Trigger row so the
        //   two rows always pair logically:
        //   _trigCtx=1 (watching reaction) → MONITOR (orange)
        //   _trigCtx=2 (sweep & reclaim)   → MONITOR (orange)
        //   _trigCtx=3 (need MSS) + mssState≥1 → directional READY
        //              (need MSS) without  → WAIT (yellow)
        //   _trigCtx=4 (distant/displacement) → WAIT (yellow)
        //   _trigCtx=5 (ready / fast-path) → BUY/SELL READY
        //   _trigCtx=0 (default / no trigger matched) → WAIT
        // Legacy buyReady/sellReady/isMonitor remain as sub-checks within
        //   _trigCtx=5 to preserve full Guardian/System gate logic.
        string ebAction = "WAIT"
        color  ebActTextColor = color.black
        color  ebActBgColor   = color.yellow
        string ebRiskMsg = ""   // v17.85.16: display-only risk annotation (BLOCKED BY BIAS / opposing-zone / momentum)

        // Guardian direction detection (unchanged)
        bool guardianBuy  = guardianDisplayCode == 1 or guardianDisplayCode == 3 or guardianDisplayCode == 5
        bool guardianSell = guardianDisplayCode == 2 or guardianDisplayCode == 4 or guardianDisplayCode == 6

        // ════ v17.73.1: COUNTER-TREND ALIGNMENT GUARDS + CONFIDENCE FLOOR ════
        // Block CT execution / READY when HTF and LTF biases are strongly synchronized,
        // and require the STANDARD execution floor (no sub-70 leak via htfCtMinConf).
        // Computed here so both the HUD CT block (_trigCtx==6) and the _execFireHtfCt
        // gate downstream reference identical safeguards.
        bool _isBullishOverExtended = finalHTFTrend == 1  and finalLTFTrend == 1
        bool _isBearishOverExtended = finalHTFTrend == -1 and finalLTFTrend == -1
        bool _allowCtSell = not _isBullishOverExtended
        bool _allowCtBuy  = not _isBearishOverExtended
        bool _ctHasConfidence = ebConfInt >= mbAlertConfThresh

        // Full-readiness sub-checks (used when _trigCtx == 5)
        bool buyReady  = (isMssBypassLong or (guardianBuy and isWithTrend and isGuardianActive)) and momentumScore > 0 and confluencePillarScore >= 4 and (array.size(sysBlockers) == 0 or isMssBypass)
        bool sellReady = (isMssBypassShort or (guardianSell and isWithTrend and isGuardianActive)) and momentumScore > 0 and confluencePillarScore >= 4 and (array.size(sysBlockers) == 0 or isMssBypass)

        if _trigCtx == 5
            // Trigger says READY / fast-path — full system gate applies
            if isMssBypass
                if finalHTFTrend == -1
                    ebAction      := _isContinuance ? "CONT SELL READY" : "SELL READY"
                    ebActTextColor := color.white
                    ebActBgColor   := _isContinuance ? color.aqua : color.red
                else
                    ebAction      := _isContinuance ? "CONT BUY READY" : "BUY READY"
                    ebActTextColor := _isContinuance ? color.white : color.black
                    ebActBgColor   := _isContinuance ? color.aqua : color.lime
            else if isExecutionAllowed
                if finalHTFTrend == -1 or (guardianSell and not guardianBuy)
                    ebAction      := _isContinuance ? "CONT SELL READY" : "SELL READY"
                    ebActTextColor := color.white
                    ebActBgColor   := _isContinuance ? color.aqua : color.red
                else
                    ebAction      := _isContinuance ? "CONT BUY READY" : "BUY READY"
                    ebActTextColor := _isContinuance ? color.white : color.black
                    ebActBgColor   := _isContinuance ? color.aqua : color.lime
            else if buyReady
                ebAction      := _isContinuance ? "CONT BUY READY" : "BUY READY"
                ebActTextColor := _isContinuance ? color.white : color.black
                ebActBgColor   := _isContinuance ? color.aqua : color.lime
            else if sellReady
                ebAction      := _isContinuance ? "CONT SELL READY" : "SELL READY"
                ebActTextColor := color.white
                ebActBgColor   := _isContinuance ? color.aqua : color.red
            else
                // _trigCtx=5 but sub-gates not met — upgrade to MONITOR
                ebAction      := "MONITOR"
                ebActTextColor := color.black
                ebActBgColor   := color.orange

        else if _trigCtx == 6
            // Counter-trend setup — gate by confidence.
            // v17.72.0 (#4): at an HTF extreme the Daily/H4 POI IS the confluence, so
            // use the relaxed htfCtMinConf gate instead of the strict mbAlertConfThresh.
            // v17.73.1: lock to the standard floor AND apply the alignment guard so a
            // CT READY cannot leak below 70% or fire against a strongly aligned trend.
            bool _ctReadyOk = _ctHasConfidence and (_isCTLong ? _allowCtBuy : _allowCtSell)
            if _ctReadyOk
                if _isCTLong
                    ebAction      := "CT BUY READY"
                    ebActTextColor := color.white
                    ebActBgColor   := color.fuchsia
                else
                    ebAction      := "CT SELL READY"
                    ebActTextColor := color.white
                    ebActBgColor   := color.fuchsia
            else
                ebAction      := "CT MONITOR"
                ebActTextColor := color.black
                ebActBgColor   := color.orange

        else if _trigCtx == 1 or _trigCtx == 2
            // Watching a reaction or sweep/reclaim — always MONITOR
            ebAction      := "MONITOR"
            ebActTextColor := color.black
            ebActBgColor   := color.orange

        else if _trigCtx == 3
            // Need MSS — if MSS already developing, upgrade to directional READY
            if mssState >= 1
                if _isBearBias or mssDir == -1
                    ebAction      := _isContinuance ? "CONT SELL READY" : "SELL READY"
                    ebActTextColor := color.white
                    ebActBgColor   := _isContinuance ? color.aqua : color.red
                else
                    ebAction      := _isContinuance ? "CONT BUY READY" : "BUY READY"
                    ebActTextColor := _isContinuance ? color.white : color.black
                    ebActBgColor   := _isContinuance ? color.aqua : color.lime
            else
                // MSS not yet — stay WAIT
                ebAction      := "WAIT"
                ebActTextColor := color.black
                ebActBgColor   := color.yellow

        else
            // _trigCtx == 4 (distant displacement) or 0 (default) → WAIT
            ebAction      := "WAIT"
            ebActTextColor := color.black
            ebActBgColor   := color.yellow

        // ════ v17.73.0: MACRO-EXPRESS ACTION OVERRIDE ════
        // When macro-aligned, force the Action to a directional READY state so the
        // trigger cascade no longer parks an aligned continuation at WAIT/MONITOR.
        // Only UPGRADES — never downgrades an existing READY (CT / Continuance) state.
        bool _meAlreadyReady = str.contains(ebAction, "READY")
        if macroAligned and not _meAlreadyReady
            if _macroAlignedLong
                ebAction      := _isContinuance ? "CONT BUY READY" : "BUY READY"
                ebActTextColor := _isContinuance ? color.white : color.black
                ebActBgColor   := _isContinuance ? color.aqua : color.lime
            else
                ebAction      := _isContinuance ? "CONT SELL READY" : "SELL READY"
                ebActTextColor := color.white
                ebActBgColor   := _isContinuance ? color.aqua : color.red

        // ════ v17.74.1: HARD ALIGNMENT + BASELINE CONFIDENCE GATE ════
        // Final, authoritative safety net applied AFTER every upgrade path (Guardian,
        // MSS-bypass, system-alert, Macro-Express). Even when Guardian is active, a
        // setup is hard-relegated to MONITOR when:
        //   (1) confidence < mbHardBaselineConf (default 55%), OR
        //   (2) it is a NON-counter-trend READY and finalHTFTrend != finalLTFTrend
        //       (in-conflict structural alignment — e.g. CONT SELL while HTF Bearish /
        //       LTF Bullish, selling into an active M15 demand zone).
        // Counter-trend (CT) READY is exempt from the alignment rule (it is
        // deliberately HTF≠LTF) but still subject to the baseline confidence floor.
        bool _ebIsReady     = str.contains(ebAction, "READY")
        bool _ebIsCT        = str.startswith(ebAction, "CT ")
        bool _ebTrendsAgree = finalHTFTrend != 0 and finalHTFTrend == finalLTFTrend
        bool _ebBaselineOk  = ebConfInt >= mbHardBaselineConf
        bool _ebAlignBlock  = mbRequireTrendAlign and not _ebIsCT and not _ebTrendsAgree
        if _ebIsReady and (not _ebBaselineOk or _ebAlignBlock)
            ebAction      := "MONITOR"
            ebActTextColor := color.black
            ebActBgColor   := color.orange

        // ════ v17.85.14 — OPPOSING-ZONE PROXIMITY (Safety Blocker) ════
        // Scan active M15 + H1 zones. A NEW long is unsafe when price is at/into an
        // overhead SUPPLY zone (buying the top); a NEW short is unsafe at/into an
        // underfoot DEMAND zone. "Near" = within oppZoneProxPct of the zone's near
        // edge, or already inside the zone. Consumed by BOTH the HUD label override
        // (below) and the V-Reversal fast-lane alert (Tier V), and — because it can
        // relabel ebAction away from a READY state — also gates the standard MB_EXECUTE.
        float _oppProxFrac = oppZoneProxPct / 100.0
        bool  _nearOppSupply = false   // overhead supply → blocks NEW longs
        bool  _nearOppDemand = false   // underfoot demand → blocks NEW shorts
        if _oppProxFrac > 0
            if array.size(m15Zones) > 0
                for _zi = 0 to array.size(m15Zones) - 1
                    MtfZone _oz = array.get(m15Zones, _zi)
                    if _oz.active
                        if _oz.isSupply and close >= _oz.bot * (1 - _oppProxFrac) and close <= _oz.top
                            _nearOppSupply := true
                        if (not _oz.isSupply) and close <= _oz.top * (1 + _oppProxFrac) and close >= _oz.bot
                            _nearOppDemand := true
            if array.size(h1Zones) > 0
                for _zi = 0 to array.size(h1Zones) - 1
                    MtfZone _oz = array.get(h1Zones, _zi)
                    if _oz.active
                        if _oz.isSupply and close >= _oz.bot * (1 - _oppProxFrac) and close <= _oz.top
                            _nearOppSupply := true
                        if (not _oz.isSupply) and close <= _oz.top * (1 + _oppProxFrac) and close >= _oz.bot
                            _nearOppDemand := true

        // ════ v17.85.14 — HUD LABEL OVERRIDE ════
        // If the brief reads a NEW-entry long (BUY / CONT BUY / CT BUY READY) but price
        // sits at/into overhead supply, relabel to MANAGE LONG / NO NEW ENTRY (mirror
        // for shorts). This also flips ebAction out of "READY", so the standard
        // execution alert below will NOT fire into the opposing zone.
        bool _ebLongReady  = ebAction == "BUY READY" or ebAction == "CONT BUY READY" or ebAction == "CT BUY READY"
        bool _ebShortReady = ebAction == "SELL READY" or ebAction == "CONT SELL READY" or ebAction == "CT SELL READY"
        if _ebLongReady and _nearOppSupply
            ebAction       := "MANAGE LONG / NO NEW ENTRY"
            ebActTextColor := color.black
            ebActBgColor   := color.orange
        if _ebShortReady and _nearOppDemand
            ebAction       := "MANAGE SHORT / NO NEW ENTRY"
            ebActTextColor := color.black
            ebActBgColor   := color.orange

        // ════ v17.85.16 — FINAL HUD SYNCHRONISATION GATES (DISPLAY-ONLY) ════
        // Applied AFTER every upgrade/override path so the Action row can never
        // contradict the live HTF bias. Mirrors the v17.85.14 opposing-zone pattern:
        // relabelling ebAction here keeps the HUD, the MB_EXECUTE alert (which parses
        // ebAction downstream) and the risk annotation mutually consistent. The
        // internal alert-gating primitives (sysLegacyAlertActive, isExecutionAllowed,
        // confidence floors, entry/SL/TP math) are untouched.
        bool _mb16Long  = str.contains(ebAction, "BUY")
        bool _mb16Short = str.contains(ebAction, "SELL")
        bool _mb16Ready = str.contains(ebAction, "READY")
        // Fix 4: surface the opposing-zone safety blocker on the brief (visible risk).
        if (_nearOppSupply and finalHTFTrend == 1) or (_nearOppDemand and finalHTFTrend == -1) or (_ebLongReady and _nearOppSupply) or (_ebShortReady and _nearOppDemand)
            ebRiskMsg := "RISK: NEAR OPPOSING ZONE"
        // Fix 1: Strict Bias-Action Lock. During a directional HTF bias, a NON-CT
        // READY pointing against the bias (SHORT while Bullish / LONG while Bearish)
        // is a contradiction → forced to MONITOR (gray) and flagged BLOCKED BY BIAS.
        // CT (counter-trend) READY states are exempt here (handled by Fix 5).
        bool _mb16BiasBlock = _mb16Ready and not _ebIsCT and ((finalHTFTrend == 1 and _mb16Short) or (finalHTFTrend == -1 and _mb16Long))
        if _mb16BiasBlock
            ebAction       := "MONITOR"
            ebActTextColor := color.white
            ebActBgColor   := color.gray
            ebRiskMsg      := "BLOCKED BY BIAS"
        // Fix 5: Contra-trend momentum requirement. A CT READY (intentionally against
        // finalHTFTrend) demands momentumScore >= 2 (of 3). With 0-1 momentum it is
        // downgraded to WAITING FOR MOMENTUM so the brief never green-lights a
        // counter-trend entry that momentum does not yet support.
        bool _mb16Contra = _mb16Ready and _ebIsCT and ((finalHTFTrend == 1 and _mb16Short) or (finalHTFTrend == -1 and _mb16Long))
        if _mb16Contra and momentumScore < 2
            ebAction       := "WAITING FOR MOMENTUM"
            ebActTextColor := color.black
            ebActBgColor   := color.yellow
            ebRiskMsg      := ebRiskMsg == "" ? "CT NEEDS MOMENTUM 2/3" : ebRiskMsg

        // Compose the display string: Action + optional risk annotation (display-only;
        // ebAction itself is unchanged in the alert JSON below).
        string _ebActDisp = ebRiskMsg == "" ? ebAction : ebAction + "  •  " + ebRiskMsg

        // ════════════════════════════════════════════════════════════════
        // v17.85.19 — MARKET BRIEF RENDER (driven by finalVerdict engine)
        // Single source of truth: the Action row + all execution levels reflect
        // finalVerdict, NOT the legacy ebAction cascade (which is retained ONLY as
        // internal input to the alert-direction/transition logic below).
        // Layout: Bias · Action · TRADE LEVELS (Entry/SL/TP) · QUALITY
        // (Setup Confidence / VSA Conviction) · WHY NO ALERT? (blocker list).
        // ════════════════════════════════════════════════════════════════
        color _mbHdrBg  = color.new(#1a1a2e, 0)
        color _mbRowBg  = color.new(color.black, 20)
        color _mbSecBg  = color.new(#101820, 0)
        // Trade levels follow the finalVerdict direction (CT/RE-ENTRY may oppose HTF).
        bool  _mbLong   = fvVerdictLong
        float _mbEntry  = _mbLong ? entryLong : entryShort
        float _mbSL     = _mbLong ? slLong    : slShort
        float _mbTP     = _mbLong ? tpLong    : tpShort
        float _mbRisk   = math.abs(_mbEntry - _mbSL)
        float _mbRew    = math.abs(_mbTP - _mbEntry)
        float _mbRRv    = _mbRisk > 0 ? _mbRew / _mbRisk : 0.0
        float _mbSlPips = pipSize > 0 ? _mbRisk / pipSize : na
        float _mbTpPips = pipSize > 0 ? _mbRew  / pipSize : na
        bool  _mbShowLevels = fvAlertOk and (fvVerdictLong or fvVerdictShort)
        string _mbEntryStr = _mbShowLevels ? str.tostring(_mbEntry, format.mintick) : (finalVerdict == "MISSED" ? "N/A (chased)" : "PENDING")
        string _mbSlStr    = _mbShowLevels ? str.tostring(_mbSL, format.mintick) + "  (" + str.tostring(_mbSlPips, "#.0") + "p)" : (finalVerdict == "MISSED" ? "N/A" : "PENDING")
        string _mbTpStr    = _mbShowLevels ? str.tostring(_mbTP, format.mintick) + "  (" + str.tostring(_mbTpPips, "#.0") + "p, " + str.tostring(_mbRRv, "#.0") + "R)" : (finalVerdict == "MISSED" ? "N/A" : "PENDING")
        color _mbLvlClr    = _mbShowLevels ? color.white : color.gray

        // Row 0: Header
        table.cell(_eb, 0, 0, "MARKET", text_color=color.white,  text_size=size.normal, bgcolor=_mbHdrBg, text_halign=text.align_right)
        table.cell(_eb, 1, 0, "BRIEF",  text_color=color.yellow, text_size=size.normal, bgcolor=_mbHdrBg, text_halign=text.align_left)
        // Row 1: Bias (retained ebBias computation)
        table.cell(_eb, 0, 1, "Bias", text_color=color.new(color.white, 30), text_size=size.normal, bgcolor=_mbRowBg, text_halign=text.align_right)
        table.cell(_eb, 1, 1, f_safeText(ebBias), text_color=ebBiasColor, text_size=size.normal, bgcolor=_mbRowBg, text_halign=text.align_left)
        // Row 2: Action — from finalVerdict (single source of truth)
        table.cell(_eb, 0, 2, "Action", text_color=color.white, text_size=size.normal, bgcolor=fvActionColor, text_halign=text.align_right)
        table.cell(_eb, 1, 2, f_safeText(fvActionLabel), text_color=color.black, text_size=size.normal, bgcolor=fvActionColor, text_halign=text.align_left)
        // Row 3: TRADE LEVELS section header
        table.cell(_eb, 0, 3, "TRADE", text_color=color.new(color.white, 20), text_size=size.small, bgcolor=_mbSecBg, text_halign=text.align_right)
        table.cell(_eb, 1, 3, "LEVELS", text_color=color.new(color.white, 20), text_size=size.small, bgcolor=_mbSecBg, text_halign=text.align_left)
        // Row 4: Entry
        table.cell(_eb, 0, 4, "Entry", text_color=color.new(color.white, 30), text_size=size.normal, bgcolor=_mbRowBg, text_halign=text.align_right)
        table.cell(_eb, 1, 4, f_safeText(_mbEntryStr), text_color=_mbLvlClr, text_size=size.normal, bgcolor=_mbRowBg, text_halign=text.align_left)
        // Row 5: Stop Loss
        table.cell(_eb, 0, 5, "Stop Loss", text_color=color.new(color.white, 30), text_size=size.normal, bgcolor=_mbRowBg, text_halign=text.align_right)
        table.cell(_eb, 1, 5, f_safeText(_mbSlStr), text_color=_mbShowLevels ? color.red : color.gray, text_size=size.normal, bgcolor=_mbRowBg, text_halign=text.align_left)
        // Row 6: Take Profit
        table.cell(_eb, 0, 6, "Take Profit", text_color=color.new(color.white, 30), text_size=size.normal, bgcolor=_mbRowBg, text_halign=text.align_right)
        table.cell(_eb, 1, 6, f_safeText(_mbTpStr), text_color=_mbShowLevels ? color.lime : color.gray, text_size=size.normal, bgcolor=_mbRowBg, text_halign=text.align_left)
        // Row 7: QUALITY section header
        table.cell(_eb, 0, 7, "QUALITY", text_color=color.new(color.white, 20), text_size=size.small, bgcolor=_mbSecBg, text_halign=text.align_right)
        table.cell(_eb, 1, 7, "ASSESSMENT", text_color=color.new(color.white, 20), text_size=size.small, bgcolor=_mbSecBg, text_halign=text.align_left)
        // Row 8: Setup Confidence
        color _mbConfClr = ebConfInt >= 86 ? color.rgb(0, 255, 100) : ebConfInt >= 66 ? color.lime : ebConfInt >= 34 ? color.yellow : color.red
        table.cell(_eb, 0, 8, "Setup Conf", text_color=color.new(color.white, 30), text_size=size.normal, bgcolor=_mbRowBg, text_halign=text.align_right)
        table.cell(_eb, 1, 8, str.tostring(ebConfInt) + "%", text_color=_mbConfClr, text_size=size.normal, bgcolor=_mbRowBg, text_halign=text.align_left)
        // Row 9: VSA Conviction (from finalVerdict engine)
        table.cell(_eb, 0, 9, "VSA", text_color=color.new(color.white, 30), text_size=size.normal, bgcolor=_mbRowBg, text_halign=text.align_right)
        table.cell(_eb, 1, 9, f_safeText(fvVSA), text_color=fvVSAColor, text_size=size.normal, bgcolor=_mbRowBg, text_halign=text.align_left)
        // Row 10: WHY NO ALERT? section header
        table.cell(_eb, 0, 10, "WHY NO", text_color=color.new(color.white, 20), text_size=size.small, bgcolor=_mbSecBg, text_halign=text.align_right)
        table.cell(_eb, 1, 10, "ALERT?", text_color=color.new(color.white, 20), text_size=size.small, bgcolor=_mbSecBg, text_halign=text.align_left)
        // Row 11: blocker list (or NONE when a verdict is live)
        string _mbWhy = ""
        if fvAlertOk
            _mbWhy := "NONE — " + fvActionLabel
        else if array.size(fvBlockers) == 0
            _mbWhy := "—"
        else
            for _bi = 0 to array.size(fvBlockers) - 1
                _mbWhy := _mbWhy + (_bi > 0 ? "\n" : "") + "• " + array.get(fvBlockers, _bi)
        color _mbWhyClr = fvAlertOk ? color.lime : color.orange
        table.cell(_eb, 0, 11, "Blockers", text_color=color.new(color.white, 30), text_size=size.small, bgcolor=_mbRowBg, text_halign=text.align_right)
        table.cell(_eb, 1, 11, f_safeText(_mbWhy), text_color=_mbWhyClr, text_size=size.small, bgcolor=_mbRowBg, text_halign=text.align_left)

        // Row 12 (v17.85.20): OPTIONAL M5 MSS REFERENCE ROW — DISPLAY-ONLY.
        // Compares the isolated m5MssBias to the current display bias (fvDir).
        // This NEVER feeds fvMssOk / fvAlertOk / finalVerdict / any alert lane.
        if showM5MssRow
            string _m5State = fvDir == 0 ? "NA" : (m5MssBias == fvDir ? "CONFIRMED" : "PENDING")
            color  _m5Clr   = _m5State == "CONFIRMED" ? color.lime : _m5State == "PENDING" ? color.gray : color.new(color.gray, 55)
            string _m5Tip   = "M5 MSS is displayed for reference only — does not change alerts."
            table.cell(_eb, 0, 12, "M5 MSS", text_color=color.new(color.white, 30), text_size=size.small, bgcolor=_mbRowBg, text_halign=text.align_right, tooltip=_m5Tip)
            table.cell(_eb, 1, 12, f_safeText(_m5State), text_color=_m5Clr, text_size=size.small, bgcolor=_mbRowBg, text_halign=text.align_left, tooltip=_m5Tip)
        else
            table.cell(_eb, 0, 12, "", bgcolor=color.new(color.black, 100))
            table.cell(_eb, 1, 12, "", bgcolor=color.new(color.black, 100))

        // ════════════════════════════════════════════════════════════════
        // MARKET BRIEF ALERTS (v17.69.0) — Execution-Only Alert Architecture
        // ════════════════════════════════════════════════════════════════
        // Three-tier system: Tier 1 (RECON) = internal only, no alert().
        // Tier 2 (SETUP READY) = optional, gated by enableSetupReadyAlerts.
        // Tier 3 (EXECUTE) = primary, fires only on state transition with
        //   full MSS-Retrace model alignment.
        // Anti-spam: var state memory prevents duplicate alerts on same bar
        //   and while conditions remain unchanged.

        // --- State trackers (persist across bars via `var`) ---
        var string _prevAction   = "WAIT"
        var int    _prevAlertBar  = 0
        var int    _vRevLastAlertBar = 0   // v17.85.14: V-Reversal fast-lane anti-spam tracker
        var int    _reentryLastAlertBar = 0 // v17.85.19: RE-ENTRY lane anti-spam tracker
        var string _prevAlertDir  = ""

        // --- Shared time string ---
        string _mbTime = str.tostring(year) + '-' + str.tostring(month, '00') + '-' + str.tostring(dayofmonth, '00') + ' ' + str.tostring(hour, '00') + ':' + str.tostring(minute, '00')

        // --- Tier 1: RECON (internal only) ---
        // Detect MONITOR transitions for HUD state tracking.
        // NO alert() call.  No webhook.  No mobile notification.
        bool _reconDetected = (ebAction == "MONITOR" or ebAction == "CT MONITOR") and (_prevAction != "MONITOR" and _prevAction != "CT MONITOR")
        // _reconDetected is available for debug logging / HUD use if needed.
        // It does NOT fire alert().

        // --- Action state booleans ---
        bool _isBuyReady     = ebAction == "BUY READY"
        bool _isSellReady    = ebAction == "SELL READY"
        bool _isCTBuyReady   = ebAction == "CT BUY READY"
        bool _isCTSellReady  = ebAction == "CT SELL READY"
        bool _isContBuyReady = ebAction == "CONT BUY READY"
        bool _isContSellReady= ebAction == "CONT SELL READY"
        bool _isAnyReady    = _isBuyReady or _isSellReady or _isCTBuyReady or _isCTSellReady or _isContBuyReady or _isContSellReady
        bool _isLong        = _isBuyReady or _isCTBuyReady or _isContBuyReady
        bool _isMonitor     = ebAction == "MONITOR" or ebAction == "CT MONITOR"

        // --- State transition detection (anti-spam core) ---
        // Only fire on the bar where Action TRANSITIONS to a READY state.
        bool _wasReady   = _prevAction == "BUY READY" or _prevAction == "SELL READY" or _prevAction == "CT BUY READY" or _prevAction == "CT SELL READY" or _prevAction == "CONT BUY READY" or _prevAction == "CONT SELL READY"
        bool _isTransition = _isAnyReady and not _wasReady
        // Block duplicate: same direction on same bar
        string _curDir   = _isLong ? "LONG" : "SHORT"
        bool _isDuplicate = _isTransition and (_curDir == _prevAlertDir) and (bar_index == _prevAlertBar)

        // --- Tier 2: SETUP READY (optional, gated by enableSetupReadyAlerts) ---
        // Fires when a setup is approaching completion but not yet fully ready.
        // Conditions: MONITOR + Conf>=65 + Guardian aligned + HTF/LTF aligned + Seq>=4
        bool _setupReadyFire = false
        if enableSetupReadyAlerts and _isMonitor and not _wasReady
            bool _t2ConfOk    = ebConfInt >= 65
            bool _t2AlignOk   = isWithTrend
            bool _t2GuardOk   = isGuardianActive
            bool _t2SeqOk     = sequenceState >= 4
            bool _t2Transition = _prevAction != "MONITOR" and _prevAction != "CT MONITOR"
            _setupReadyFire := _t2ConfOk and _t2AlignOk and _t2GuardOk and _t2SeqOk and _t2Transition
        if _setupReadyFire
            string _t2Bias = ebBias
            string _t2Json = '{"version":"' + VERSION + '","alert":"MB_SETUP_READY","symbol":"' + syminfo.ticker + '","timeframe":"' + timeframe.period + '","message":"' + syminfo.ticker + ' Setup Ready | ' + _t2Bias + ' Bias | Conf: ' + str.tostring(ebConfInt) + '% | Waiting for Displacement","action":"' + ebAction + '","bias":"' + str.replace_all(_t2Bias, '"', "'") + '","confidence":' + str.tostring(ebConfInt) + ',"sequence":' + str.tostring(sequenceState) + ',"trigger":"' + str.replace_all(ebTrigger, '"', "'") + '","location":"' + str.replace_all(ebLocation, '"', "'") + '","price":' + str.tostring(close) + ',"time":"' + _mbTime + '"}'
            alert(_t2Json, alert.freq_once_per_bar_close)

        // --- Tier 3: EXECUTION ALERT (primary) ---
        // The ONLY alert that fires by default.  Full MSS-Retrace model alignment:
        //   1. Action = BUY/SELL READY (or CT variants)
        //   2. Confidence >= mbAlertConfThresh (default 70)
        //   3. State TRANSITION (was not READY on previous bar)
        //   4. Guardian aligned with direction
        //   5. Displacement confirmed
        //   6. MSS confirmed (mssCloseUp for longs, mssCloseDown for shorts)
        //   7. Sequence >= 4 (near-complete or complete)
        //   8. Not a duplicate (same dir + same bar)
        // --- Standard (with-trend / legacy CT) execution gate — UNCHANGED ---
        bool _t3ConfOk   = ebConfInt >= mbAlertConfThresh
        bool _t3DispOk   = displacementDetected
        bool _t3MssOk    = _isLong ? mssCloseUp : mssCloseDown
        bool _t3SeqOk    = sequenceState >= 4
        bool _t3GuardOk  = _isLong ? guardianBuy : guardianSell
        bool _execFireStd = _isTransition and _t3ConfOk and _t3DispOk and _t3MssOk and _t3SeqOk and _t3GuardOk and not _isDuplicate

        // --- v17.72.0: RELAXED HTF COUNTER-TREND EXECUTION GATE ---
        // At a major H4/Daily extreme the Guardian (with-trend) never aligns and a
        // full MSS lags the V-reversal. Replace Guardian + full-MSS + displacement +
        // Seq>=4 with: a Sweep-Reversal catalyst (wick sweep / M5 MSS), the relaxed
        // htfCtMinConf gate, and a low structural floor (Seq>=2 OR Confl>=2). The
        // KZ filter is already bypassed because P1.5 sets the CT trigger above the
        // "Await Kill Zone" branch.
        bool _htfCtReady    = _htfCtMode and (_isCTBuyReady or _isCTSellReady)
        bool _htfCtCatalyst = _isLong ? (sweepLow or m5BullMSS) : (sweepHigh or m5BearMSS)
        bool _execFireHtfCt = _htfCtReady and _isTransition and (ebConfInt >= htfCtMinConf) and _htfCtCatalyst and (sequenceState >= 2 or confluencePillarScore >= 2) and not _isDuplicate
        // v17.73.1: harden CT gate — require the standard confidence floor and block CT
        // against a strongly synchronized HTF/LTF trend (no counter-trend chasing).
        _execFireHtfCt := _execFireHtfCt and _ctHasConfidence and (_isLong ? _allowCtBuy : _allowCtSell)

        // v17.73.0: MACRO-EXPRESS execution gate. Displacement filter BYPASSED;
        // sequence/confluence relaxed to macroExpressMinPillars (default 3); confidence
        // already floored to clear mbAlertConfThresh; Guardian/full-MSS not required
        // because the aligned macro structure + local zone mitigation supply the edge.
        bool _execFireMacro = macroAligned and _isTransition and (ebConfInt >= mbAlertConfThresh) and (confluencePillarScore >= macroExpressMinPillars) and not _isDuplicate

        // ════ v17.74.1: HARD GATE ON EXECUTION FIRES (mirrors the HUD Action gate) ════
        // Apply the same absolute safeguards to the webhook so a blocked HUD state can
        // never fire an execution alert. Standard + Macro fires (with-trend / continuation)
        // require BOTH baseline confidence AND HTF≡LTF alignment. The CT fire is exempt
        // from alignment (counter-trend by design) but still must clear the baseline.
        bool _execAlignOk = _ebTrendsAgree or not mbRequireTrendAlign
        _execFireStd   := _execFireStd   and _ebBaselineOk and _execAlignOk
        _execFireMacro := _execFireMacro and _ebBaselineOk and _execAlignOk
        _execFireHtfCt := _execFireHtfCt and _ebBaselineOk

        // ════ v17.85.19: UNIFIED finalVerdict GATE (single source of truth) ════
        // Every execution lane now defers to the central Daily Trading Plan engine.
        // An execution alert can fire ONLY when finalVerdict == "READY" AND the lane's
        // direction agrees with the engine's verdict direction. This guarantees NOTHING
        // fires while finalVerdict is WAIT / MISSED / NO_TRADE. The RE-ENTRY verdict is
        // handled by its own dedicated lane (Tier RE below), so the standard/macro/CT
        // lanes intentionally require READY (not REENTRY) here to avoid double-firing.
        bool _fvDirOk = _isLong ? fvVerdictLong : fvVerdictShort
        bool _fvReady = finalVerdict == "READY"
        _execFireStd   := _execFireStd   and _fvReady and _fvDirOk
        _execFireMacro := _execFireMacro and _fvReady and _fvDirOk
        _execFireHtfCt := _execFireHtfCt and _fvReady and _fvDirOk
        // v17.78.0/v17.79.0 — MACRO-EXPRESS EXECUTION INTEGRITY:
        // gMacroPrimedArr is a DISPLAY-ONLY bridge. It surfaces the Macro-Express
        // fire state to the System-row HUD text (the main body reads
        // gMacroPrimedArr[0]); because the main body runs BEFORE this renderer, that
        // HUD text can lag the live state by at most one realtime tick. This lag is
        // COSMETIC ONLY. The actual trade decision below uses the LIVE, current-bar
        // _execFireMacro value directly (never the array), so the alert() fires in
        // real time on the current bar close with zero delay. Set unconditionally so
        // the flag self-resets to false on bars where the macro lane does not fire.
        array.set(gMacroPrimedArr, 0, _execFireMacro)

        // Real-time execution gate — evaluated on the LIVE _execFireMacro (NOT the
        // 1-tick-lagged HUD bridge above). This is the authoritative trigger.
        bool _execFire   = _execFireStd or _execFireHtfCt or _execFireMacro
        if _execFire
            string _dirTag  = _isLong ? "BUY" : "SELL"
            string _typeTag = (_isCTBuyReady or _isCTSellReady) ? "COUNTER_TREND" : (_isContBuyReady or _isContSellReady) ? "CONTINUATION" : "WITH_TREND"
            // v17.85.19: dedicated lane tags — CT (counter-trend) and MACRO (macro-express)
            // now emit their own MB_CT_* / MB_MACRO_* alert names so downstream webhooks can
            // route each lane. Continuation and standard execution retain their prior tags.
            string _alertName = _execFireHtfCt ? (_isLong ? "MB_CT_LONG" : "MB_CT_SHORT") : (_execFireMacro and not _execFireStd) ? (_isLong ? "MB_MACRO_LONG" : "MB_MACRO_SHORT") : (_isContBuyReady or _isContSellReady) ? (_isLong ? "MB_CONTINUE_LONG" : "MB_CONTINUE_SHORT") : (_isLong ? "MB_EXECUTE_LONG" : "MB_EXECUTE_SHORT")
            string _msgPrefix = (_isContBuyReady or _isContSellReady) ? "TREND CONTINUANCE - HOLD/ADD " : (_execFireHtfCt ? "HTF CT REVERSAL - EXECUTE " : (_execFireMacro and not _execFireStd) ? "MACRO-EXPRESS - EXECUTE " : "EXECUTE ")
            // v17.72.0 (#2): dynamic entry-mode tag — Sweep-Reversal for HTF CT, else the configured mode
            // v17.73.0: Macro-Express tag when the macro lane (not the standard lane) fired.
            string _ctEntryMode = _htfCtMode ? "Sweep-Reversal" : ((_execFireMacro and not _execFireStd) ? "Macro-Express" : entryModeInput)

            // v17.71.1: Calculate SL/TP from zone boundaries for accurate paper-trading
            // Scan all TF zones to find which zone we're executing from, use its boundary as SL
            float _slPrice = na
            float _tpPrice = na
            float _zoneSL  = na

            // Check M5 local zones first (highest priority)
            if _isLong and array.size(dTop) > 0
                for _i = 0 to array.size(dTop) - 1
                    float _dt = array.get(dTop, _i)
                    float _db = array.get(dBot, _i)
                    if close >= _db and close <= _dt
                        _zoneSL := _db  // Demand zone bottom = SL for longs
                        break
            else if not _isLong and array.size(sTop) > 0
                for _i = 0 to array.size(sTop) - 1
                    float _st = array.get(sTop, _i)
                    float _sb = array.get(sBot, _i)
                    if close >= _sb and close <= _st
                        _zoneSL := _st  // Supply zone top = SL for shorts
                        break

            // If not in M5 zone, check M15 zones
            if na(_zoneSL) and array.size(m15Zones) > 0
                for _i = 0 to array.size(m15Zones) - 1
                    MtfZone _z = array.get(m15Zones, _i)
                    if _z.active and close >= _z.bot and close <= _z.top
                        _zoneSL := _isLong ? _z.bot : _z.top
                        break

            // If not in M15, check H1 zones
            if na(_zoneSL) and array.size(h1Zones) > 0
                for _i = 0 to array.size(h1Zones) - 1
                    MtfZone _z = array.get(h1Zones, _i)
                    if _z.active and close >= _z.bot and close <= _z.top
                        _zoneSL := _isLong ? _z.bot : _z.top
                        break

            // If not in H1, check H4 zones
            if na(_zoneSL) and array.size(h4Zones) > 0
                for _i = 0 to array.size(h4Zones) - 1
                    MtfZone _z = array.get(h4Zones, _i)
                    if _z.active and close >= _z.bot and close <= _z.top
                        _zoneSL := _isLong ? _z.bot : _z.top
                        break

            // Fallback: if no zone detected, use ATR-based SL (0.5× ATR from entry)
            if na(_zoneSL)
                _zoneSL := _isLong ? close - (atrValue * 0.5) : close + (atrValue * 0.5)

            // Apply small buffer (2 pips) beyond zone edge to account for spread/slippage
            float _pipBuffer = syminfo.mintick * 20  // 2 pips = 20 micro-pips for most FX pairs
            _slPrice := _isLong ? _zoneSL - _pipBuffer : _zoneSL + _pipBuffer

            // Calculate TP at 1:3 R:R
            float _riskPips = math.abs(close - _slPrice)
            _tpPrice := _isLong ? close + (_riskPips * 3.0) : close - (_riskPips * 3.0)

            string _execJson = '{"version":"' + VERSION + '","alert":"' + _alertName + '","type":"' + _typeTag + '","symbol":"' + syminfo.ticker + '","timeframe":"' + timeframe.period + '","message":"' + _msgPrefix + _dirTag + ' ' + syminfo.ticker + ' | Conf: ' + str.tostring(ebConfInt) + '% | ' + str.replace_all(ebTrigger, '"', "'") + '","action":"' + ebAction + '","direction":"' + _dirTag + '","confidence":' + str.tostring(ebConfInt) + ',"entry":"' + _ctEntryMode + '","macro_express":' + ((_execFireMacro and not _execFireStd) ? "1" : "0") + ',"sequence":' + str.tostring(sequenceState) + ',"displacement":' + str.tostring(displacement, "#.##") + ',"sl":' + str.tostring(_slPrice, format.mintick) + ',"tp":' + str.tostring(_tpPrice, format.mintick) + ',"trigger":"' + str.replace_all(ebTrigger, '"', "'") + '","narrative":"' + str.replace_all(ebNarrative, '"', "'") + '","location":"' + str.replace_all(ebLocation, '"', "'") + '","bias":"' + str.replace_all(ebBias, '"', "'") + '","session":"' + kzStr + '","poi":' + str.tostring(poiScore) + ',"price":' + str.tostring(close) + ',"time":"' + _mbTime + '"}'
            alert(_execJson, alert.freq_once_per_bar_close)
            // Update anti-spam state
            _prevAlertBar := bar_index
            _prevAlertDir := _curDir
            // v17.85.15: record the LIVE MB fire so the HUD System row reflects it
            array.set(gMBAlertDirArr,  0, _isLong ? 1 : -1)
            array.set(gMBAlertTimeArr, 0, time)
            array.set(gMBAlertTypeArr, 0, _alertName)

        // ════════════════════════════════════════════════════════════════
        // TIER RE (v17.85.19) — RE-ENTRY LANE
        // ════════════════════════════════════════════════════════════════
        // Fires ONCE on the bar where the unified engine transitions INTO
        // finalVerdict == "REENTRY": a setup that was previously MISSED (anti-chase),
        // then retraced back into its zone and passed the FULL fresh 6-rule validation
        // a second time. Direction comes straight from the engine verdict. Respects the
        // alertCooldownBars anti-spam window. Because REENTRY only occurs inside the
        // session window (fvSessionOk is a hard gate), this lane is implicitly
        // session-bounded. Standard/Macro/CT lanes above require READY (not REENTRY),
        // so this lane never double-fires alongside them.
        bool _reEntryFire = (finalVerdict == "REENTRY") and (fvPrevVerdict != "REENTRY") and ((bar_index - _reentryLastAlertBar) >= alertCooldownBars)
        if _reEntryFire
            bool   _reLong   = fvVerdictLong
            string _reDir    = _reLong ? "BUY" : "SELL"
            string _reAlert  = _reLong ? "MB_REENTRY_LONG" : "MB_REENTRY_SHORT"
            string _reAction = _reLong ? "RE-ENTRY LONG" : "RE-ENTRY SHORT"
            float  _reEntry  = _reLong ? entryLong : entryShort
            float  _reSL     = _reLong ? slLong : slShort
            float  _reTP     = _reLong ? tpLong : tpShort
            string _reJson = '{"version":"' + VERSION + '","alert":"' + _reAlert + '","type":"RE_ENTRY","symbol":"' + syminfo.ticker + '","timeframe":"' + timeframe.period + '","message":"RE-ENTRY ' + _reDir + ' ' + syminfo.ticker + ' | Conf: ' + str.tostring(ebConfInt) + '% | Fresh 6-rule re-validation passed","action":"' + _reAction + '","direction":"' + _reDir + '","confidence":' + str.tostring(ebConfInt) + ',"entry":"Re-Entry","re_entry":1,"entry_price":' + str.tostring(_reEntry, format.mintick) + ',"sl":' + str.tostring(_reSL, format.mintick) + ',"tp":' + str.tostring(_reTP, format.mintick) + ',"session":"' + kzStr + '","poi":' + str.tostring(poiScore) + ',"price":' + str.tostring(close) + ',"time":"' + _mbTime + '"}'
            alert(_reJson, alert.freq_once_per_bar_close)
            _reentryLastAlertBar := bar_index
            // record the LIVE RE-ENTRY fire for the HUD System row
            array.set(gMBAlertDirArr,  0, _reLong ? 1 : -1)
            array.set(gMBAlertTimeArr, 0, time)
            array.set(gMBAlertTypeArr, 0, _reAlert)

        // ════════════════════════════════════════════════════════════════
        // TIER V (v17.85.14) — V-REVERSAL FAST LANE (immediate breakout alert)
        // ════════════════════════════════════════════════════════════════
        // Fires the instant a V-Shape displacement candle closes, so the signal is
        // NOT delayed ~15-20 min waiting for the Market Brief to reach READY (which
        // needs m5 MSS + Seq>=4 + Guardian). vShapeLongFire/vShapeShortFire already
        // bypass Guardian and require neither MSS nor sequence; they carry their own
        // Kill-Zone + cooldown. SAFETY: hard-blocked at/into the opposing HTF zone
        // (_nearOppSupply for longs, _nearOppDemand for shorts). ANTI-SPAM: an extra
        // alertCooldownBars gate on top of the V-Shape cooldown, so one V-reversal
        // cannot machine-gun a burst of alerts.
        if enableVRevAlert
            // v17.85.19: V-reversal fast lane is now also bound to the unified verdict.
            // It may fire only when finalVerdict authorises a trade (READY/REENTRY) in
            // the matching direction — so nothing fires on WAIT / MISSED / NO_TRADE.
            bool _vRevLong  = vShapeLongFire  and not _nearOppSupply and fvAlertOk and fvVerdictLong
            bool _vRevShort = vShapeShortFire and not _nearOppDemand and fvAlertOk and fvVerdictShort
            bool _vRevCool  = (bar_index - _vRevLastAlertBar) >= alertCooldownBars
            if (_vRevLong or _vRevShort) and _vRevCool
                string _vrDir    = _vRevLong ? "BUY" : "SELL"
                string _vrAlert  = _vRevLong ? "MB_VREVERSAL_LONG" : "MB_VREVERSAL_SHORT"
                string _vrAction = _vRevLong ? "BUY NOW" : "SELL NOW"
                float  _vrEntry  = _vRevLong ? entryLong : entryShort
                float  _vrSL     = _vRevLong ? slLong : slShort
                float  _vrTP     = _vRevLong ? tpLong : tpShort
                string _vrJson = '{"version":"' + VERSION + '","alert":"' + _vrAlert + '","type":"V_REVERSAL","symbol":"' + syminfo.ticker + '","timeframe":"' + timeframe.period + '","message":"V-REVERSAL ' + _vrDir + ' NOW ' + syminfo.ticker + ' | Conf: ' + str.tostring(ebConfInt) + '% | Fast-Lane (no MSS wait)","action":"' + _vrAction + '","direction":"' + _vrDir + '","confidence":' + str.tostring(ebConfInt) + ',"entry":"V-Shape-Breakout","fast_lane":1,"entry_price":' + str.tostring(_vrEntry, format.mintick) + ',"sl":' + str.tostring(_vrSL, format.mintick) + ',"tp":' + str.tostring(_vrTP, format.mintick) + ',"session":"' + kzStr + '","poi":' + str.tostring(poiScore) + ',"price":' + str.tostring(close) + ',"time":"' + _mbTime + '"}'
                alert(_vrJson, alert.freq_once_per_bar_close)
                _vRevLastAlertBar := bar_index
                // v17.85.15: record the LIVE V-Reversal fire for the HUD System row
                array.set(gMBAlertDirArr,  0, _vRevLong ? 1 : -1)
                array.set(gMBAlertTimeArr, 0, time)
                array.set(gMBAlertTypeArr, 0, _vrAlert)

        // --- Update state tracker for next bar ---
        _prevAction := ebAction


// v17.77.0: single call replaces the former inline Executive Market Brief block
f_render_exec_brief()


// v17.85.10 token-fix: MTF ARCHITECTURE HUD (v17.84 Phase B) + Architecture Trace call
// REMOVED to reclaim compile tokens (CE10117). Both were developer-only diagnostic
// overlays superseded by the Structural Leg Engine debug table (showH4ActiveDebug).
// The underlying layer variables (h4_macroLocation, h1_structAlign, m15_setupState,
// m5_trigger, etc.) are UNCHANGED and still drive all real logic — only the two
// diagnostic displays were removed. No trading, P&D, alert or webhook impact.
// ════════════════════════════════════════════════════════════════
// v17.69.1 — ALERT REGISTRATION HOOK
// ════════════════════════════════════════════════════════════════
// Pine Script requires at least one alertcondition() for the indicator
// to appear in TradingView's "Condition" dropdown when creating alerts.
// This dummy condition NEVER fires (condition = false).
// All real alerts are fired dynamically via alert() in the Market Brief block.
alertcondition(false, title="SMC PD — Alert() Function Calls Only",
  message="This alert uses dynamic alert() calls. See Market Brief block.")

